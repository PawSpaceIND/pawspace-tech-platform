{
  // PawSpace ISOLATED STAGING worker — for human UAT only. Never production.
  // One-time: `npx wrangler d1 create pawspace-staging` then paste its id into database_id below.
  // Secrets (sandbox only) are set with `wrangler secret put …` — never committed. See docs/STAGING_DEPLOY.md.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pawspace-staging",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    // sandbox posture — every external integration stays fail-closed until its secret is set
    "PAWSPACE_PAYMENT_ENV": "sandbox"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pawspace-staging",
      "database_id": "REPLACE_WITH_STAGING_D1_ID",
      "preview_database_id": "pawspace-staging-local"
    }
  ],
  "ai": { "binding": "AI" }
}
