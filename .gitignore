# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!backend/.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/.sites-runtime/
/outputs/
/work/

.dev.vars
.dev.vars.*
.runtime-d1/
scratchpad/
*.tsbuildinfo

# Dependency trees anywhere in the workspace. "/node_modules" only anchored the root, so
# backend/node_modules was tracked — 3,616 files and 76 MB of installed packages that CI overwrites
# with `npm ci` on every run.
node_modules/

# Compiled output anywhere, not just the root. "/dist/" was root-anchored, so backend/dist was tracked
# even though `npm test` in backend rebuilds it via tsc before every run.
dist/

# Local wrangler/miniflare D1 persistence written by the D1 regression workers. Only .runtime-d1 was
# listed, so the other three reappeared as untracked noise after every local run.
.runtime-d1/
.pricing-control-d1/
.scheduler-d1/
.production-readiness-d1/

# D1 database dumps. These are FULL COPIES of customer data - names, phone numbers,
# addresses, payment records. scripts/d1-backup.mjs writes here by default, and a dump
# committed to a repository is a data breach that survives in history forever.
backups/
*.sql.manifest.json

# Browser E2E local artefacts
/test-results/
/playwright-report/
/dist/server/.wrangler/

# Generated runtime artifacts (test/e2e evidence, local reports)
artifacts/
