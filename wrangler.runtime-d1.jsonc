{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pawspace-runtime-d1-regression",
  "main": "tests/runtime-d1-worker.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Declared explicitly, as every documented deployment does. The sandbox payment simulators no
    // longer treat an ABSENT PAWSPACE_PAYMENT_ENV as a sandbox declaration (PTJA W2-07-PAY-003):
    // an undeclared runtime used to unlock a staff endpoint that records a full-value capture with
    // zero gateway contact. This harness exercises the sandbox payment path, so it says so.
    "PAWSPACE_PAYMENT_ENV": "sandbox",
    "PAWSPACE_UAT_LOGIN": "on",
    "PAWSPACE_UAT_SIGNING_KEY": "runtime-d1-regression-only-not-a-real-signing-key-20260825",
    "PAWSPACE_IDENTITY_ASSERTION_SECRET_UAT": "runtime-d1-regression-only-not-a-real-secret-32chars"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pawspace-runtime-d1-regression",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "preview_database_id": "pawspace-runtime-d1-local"
    }
  ]
}
