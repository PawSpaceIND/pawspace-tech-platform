# PawSpace Fastlane Appfile
# Configuration for Customer and Partner distributions

# Apple App Store Connect configuration
app_identifier(ENV["PAWSPACE_IOS_BUNDLE_ID"] || "com.pawspace.customer")
apple_id(ENV["APPLE_ID"] || "mobile-dev@pawspace.in")
team_id(ENV["APPLE_TEAM_ID"] || "PAWSPACE123")
itc_team_id(ENV["ITC_TEAM_ID"] || "PAWSPACE_ITC")

# Google Play Console configuration
package_name(ENV["PAWSPACE_ANDROID_PACKAGE_NAME"] || "com.pawspace.customer")
json_key_file(ENV["GOOGLE_PLAY_JSON_KEY_PATH"] || "")

for_platform :ios do
  for_lane :partner_beta do
    app_identifier("com.pawspace.partner")
  end
end

for_platform :android do
  for_lane :partner_beta do
    package_name("com.pawspace.partner")
  end
end
