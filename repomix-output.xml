Id=String(body.subscriptionId||"").trim(),snapshot=await getFoodSubscriptionSnapshot(db,{subscriptionId});await ownerForSnapshot(db,snapshot,actor);const result=await setFoodSubscriptionStatus(db,{subscriptionId,status:action==="pause"?"paused":action==="resume"?"active":"cancelled",actorId:actor.email,reason:String(body.reason||action)});await securityAudit(db,actor,`food.subscription.${action}`,"food_subscription",subscriptionId,"completed",{reason:String(body.reason||action)});return json({data:result})}if(action==="process_due"){requirePermission(actor,"finance.manage");const result=await processDueFoodSubscriptionRenewals(db,{actorId:actor.email,subscriptionId:body.subscriptionId?String(body.subscriptionId):undefined,at:body.at?Number(body.at):undefined});await securityAudit(db,actor,"food.subscription.process_due","food_subscription",String(body.subscriptionId||"due_batch"),"completed",{processed:result.processed,schedulerConnected:false,autoCharge:false});return json({data:result})}if(action==="record_payment"){requirePermission(actor,"finance.manage");const renewalId=String(body.renewalId||"").trim(),paymentReference=String(body.paymentReference||"").trim();if(!renewalId||!paymentReference)return json({error:"Renewal and canonical payment reference are required"},400);const result=await recordFoodSubscriptionRenewalPayment(db,{renewalId,paymentReference,actorId:actor.email});await securityAudit(db,actor,"food.subscription.record_payment","food_subscription_renewal",renewalId,"completed",{invoiceId:result.invoiceId,confirmationQueued:true,invoiceQueued:true,liveMoney:false});return json({data:result})}return json({error:"Unsupported Food subscription action"},400)}catch(error){return authError(error,"Unable to update Food subscription")}}
