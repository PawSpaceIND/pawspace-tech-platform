<file path="lib/whatsapp-interactive-capture.ts">
import{ensureConversationGovernance}from"./conversation-governance";
import{ensureLeadWorkItemsTable}from"./lead-conversion-attribution";

type Db=D1Database;type Row=Record<string,unknown>;const text=(value:unknown)=>String(value??"").trim();const uid=(prefix:string)=>`${prefix}-${crypto.randomUUID().slice(0,12).toUpperCase()}`;
export type WhatsAppInteractiveKind="reply_buttons"|"list"|"location_request"|"button_reply"|"list_reply"|"flow";

export async function ensureWhatsAppInteractiveCapture(db:Db){await ensureConversationGovernance(db);await ensureLeadWorkItemsTable(db);await db.batch([
 db.prepare("CREATE TABLE IF NOT EXISTS whatsapp_interactive_submissions (id TEXT PRIMARY KEY,provider TEXT NOT NULL,external_event_id TEXT NOT NULL,thread_id TEXT NOT NULL,customer_id TEXT NOT NULL,lead_id TEXT,message_type TEXT NOT NULL,schema_key TEXT,response_json TEXT NOT NULL,canonical_target TEXT NOT NULL,status TEXT NOT NULL,created_at INTEGER NOT NULL,UNIQUE(provider,external_event_id))"),
 db.prepare("CREATE INDEX IF NOT EXISTS whatsapp_interactive_submission_thread_idx ON whatsapp_interactive_submissions(thread_id,created_at)"),
]);}

const cleanLabel=(value:unknown,max=80)=>{const out=text(value);if(!out||out.length>max)throw new Response("Interactive label is invalid",{status:400});return out;};
export function buildWhatsAppInteractiveContract(input:{kind:"reply_buttons"|"list"|"location_request";body:string;buttons?:Array<{id:string;title:string}>;sections?:Array<{title:string;rows:Array<{id:string;title:string;description?:string}>}>}){const body=cleanLabel(input.body,1024);if(input.kind==="reply_buttons"){const buttons=input.buttons||[];if(buttons.length<1||buttons.length>3)throw new Response("WhatsApp reply buttons require 1 to 3 options",{status:400});const ids=new Set<string>();const normalized=buttons.map(button=>{const id=cleanLabel(button.id,64),title=cleanLabel(button.title,20);if(ids.has(id))throw new Response("Interactive reply ids must be unique",{status:400});ids.add(id);return{id,title};});return{kind:input.kind,body,buttons:normalized,governed:true,externalDelivery:false};}if(input.kind==="list"){const sections=input.sections||[];const rows=sections.flatMap(section=>section.rows||[]);if(!sections.length||rows.length<1||rows.length>10)throw new Response("WhatsApp list requires 1 to 10 rows",{status:400});const ids=new Set<string>();return{kind:input.kind,body,sections:sections.map(section=>({title:cleanLabel(section.title,24),rows:(section.rows||[]).map(row=>{const id=cleanLabel(row.id,64);if(ids.has(id))throw new Response("Interactive list row ids must be unique",{status:400});ids.add(id);return{id,title:cleanLabel(row.title,24),description:text(row.description).slice(0,72)||undefined};})})),governed:true,externalDelivery:false};}return{kind:input.kind,body,governed:true,externalDelivery:false};}

function validateFlow(schemaKey:string,response:Record<string,unknown>){if(schemaKey==="lead_qualification_v1"){const serviceCode=text(response.serviceCode),city=text(response.city);if(!serviceCode||!city)throw new Response("Lead qualification flow requires serviceCode and city",{status:400});return{serviceCode,city,petId:text(response.petId)||null};}if(schemaKey==="booking_details_v1"){const serviceCode=text(response.serviceCode),preferredDate=text(response.preferredDate),city=text(response.city);if(!serviceCode||!/^\d{4}-\d{2}-\d{2}/.test(preferredDate)||!city)throw new Response("Booking details flow requires serviceCode, city and ISO preferredDate",{status:400});return{serviceCode,preferredDate,city};}if(schemaKey==="survey_v1"||schemaKey==="feedback_v1"){const rating=Number(response.rating);if(!Number.isInteger(rating)||rating<1||rating>5)throw new Response("Feedback flow rating must be 1 to 5",{status:400});return{rating,comment:text(response.comment).slice(0,500)};}throw new Response("Unapproved WhatsApp Flow schema",{status:409});}

export async function recordWhatsAppInteractiveSubmission(db:Db,input:{provider:string;externalEventId:string;threadId:string;customerId:string;leadId?:string|null;messageType:"button_reply"|"list_reply"|"flow";schemaKey?:string|null;response:Record<string,unknown>;now?:number}){await ensureWhatsAppInteractiveCapture(db);const eventId=text(input.externalEventId),provider=text(input.provider);if(!eventId||!provider)throw new Response("Provider event identity is required",{status:400});const thread=await db.prepare("SELECT customer_id,lead_id FROM communication_threads WHERE id=?").bind(input.threadId).first<Row>();if(!thread||text(thread.customer_id)!==input.customerId)throw new Response("Canonical conversation/customer link is required",{status:409});const canonicalLead=text(thread.lead_id),leadId=text(input.leadId)||canonicalLead;if(leadId&&canonicalLead&&leadId!==canonicalLead)throw new Response("Interactive response lead does not match canonical thread",{status:409});if(leadId){const lead=await db.prepare("SELECT customer_id FROM lead_work_items WHERE id=?").bind(leadId).first<Row>();if(!lead||text(lead.customer_id)!==input.customerId)throw new Response("Canonical lead/customer link is required",{status:409});}const existing=await db.prepare("SELECT * FROM whatsapp_interactive_submissions WHERE provider=? AND external_event_id=?").bind(provider,eventId).first<Row>();if(existing)return{submission:existing,duplicatePrevented:true,externalDelivery:false};let response:Record<string,unknown>;let target="conversation";if(input.messageType==="flow"){const schemaKey=text(input.schemaKey);response=validateFlow(schemaKey,input.response);target=schemaKey==="booking_details_v1"?"governed_booking_tool":schemaKey.startsWith("lead_")?"canonical_lead":"conversation_feedback";}else{const id=cleanLabel(input.response.id,64),title=cleanLabel(input.response.title,80);response={id,title};}const now=input.now??Date.now(),id=uid("WINT");await db.prepare("INSERT INTO whatsapp_interactive_submissions (id,provider,external_event_id,thread_id,customer_id,lead_id,message_type,schema_key,response_json,canonical_target,status,created_at) VALUES (?,?,?,?,?,?,?,?,?,?, 'validated',?)").bind(id,provider,eventId,input.threadId,input.customerId,leadId||null,input.messageType,text(input.schemaKey)||null,JSON.stringify(response),target,now).run();return{submission:await db.prepare("SELECT * FROM whatsapp_interactive_submissions WHERE id=?").bind(id).first<Row>(),duplicatePrevented:false,canonicalTarget:target,parallelCustomerOrOrderStore:false,externalDelivery:false};}
