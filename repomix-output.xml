<file path="app/api/i18n/route.ts">
import{authError,database,requirePermission,resolveActor}from"../../../lib/server-auth";
import{resolveMessages,resolveLocale,setTranslation,publishTranslation,aiTranslateMissing,setUserLocale,getUserLocale,i18nCoverage,SUPPORTED_LOCALES}from"../../../lib/i18n-governance";

const json=(value:unknown,status=200)=>Response.json(value,{status,headers:{"cache-control":"no-store"}});
function sameOrigin(request:Request){const origin=request.headers.get("origin");if(origin&&origin!==new URL(request.url).origin)throw new Response("Cross-origin i18n write blocked",{status:403});}
async function runtime(){const {env}=await import("cloudflare:workers");return env as unknown as Record<string,unknown>;}

// UI translations for the active locale (any authenticated user), + i18n administration (settings.manage).
export async function GET(request:Request){
  try{
    const url=new URL(request.url),db=await database(),actor=await resolveActor(request);
    if(url.searchParams.get("mode")==="coverage"){requirePermission(actor,"settings.manage");return json({data:await i18nCoverage(db)});}
    const preferred=await getUserLocale(db,actor.principalKey||actor.email);
    const locale=resolveLocale({explicit:url.searchParams.get("locale"),preferred,acceptLanguage:request.headers.get("accept-language")});
    return json({data:{...await resolveMessages(db,{locale}),supportedLocales:SUPPORTED_LOCALES}});
  }catch(error){return authError(error,"Unable to load translations");}
}

export async function POST(request:Request){
  try{
    sameOrigin(request);
    const db=await database(),actor=await resolveActor(request);
    const b=await request.json().catch(()=>({})) as Record<string,unknown>;
    const action=String(b.action||"").trim();
    if(action==="set_user_locale"){const data=await setUserLocale(db,{subjectId:actor.principalKey||actor.email,locale:String(b.locale||"")});return json({data},201);}
    // management actions require settings.manage
    requirePermission(actor,"settings.manage");
    if(action==="set_translation"){const data=await setTranslation(db,{messageKey:String(b.messageKey||""),locale:String(b.locale||""),text:String(b.text||""),publish:Boolean(b.publish),aiAssisted:Boolean(b.aiAssisted),actorId:actor.email});return json({data},201);}
    if(action==="publish"){const data=await publishTranslation(db,{messageKey:String(b.messageKey||""),locale:String(b.locale||""),actorId:actor.email});return json({data},201);}
    if(action==="ai_translate"){const env=await runtime();const data=await aiTranslateMissing(db,env,{locale:String(b.locale||""),limit:b.limit as number,actorEmail:actor.email});return json({data},data.connected?201:200);}
    return json({error:"Unsupported action. Use set_user_locale | set_translation | publish | ai_translate"},400);
  }catch(error){return authError(error,"Unable to update translations");}
}
</file>

<file path="app/api/identity-bindings/route.ts">
import{authError,requirePermission,resolveActor,securityAudit}from"../../../lib/server-auth";
import{ensureIdentityBindingTables,revokeIdentityBinding,upsertIdentityBinding,type IdentitySource,type IdentitySubjectType,type PrincipalType}from"../../../lib/identity-binding";

type Row=Record<string,unknown>;
const json=(value:unknown,status=200)=>Response.json(value,{status});
async function database(){const{env}=await import("cloudflare:workers");return env.DB;}

export async function GET(request:Request){try{const actor=await resolveActor(request);requirePermission(actor,"users.manage");const db=await database();await ensureIdentityBindingTables(db);const url=new URL(request.url),subjectType=url.searchParams.get("subjectType"),subjectId=url.searchParams.get("subjectId");let query="SELECT * FROM identity_bindings",args:unknown[]=[];if(subjectType&&subjectId){query+=" WHERE subject_type=? AND subject_id=?";args=[subjectType,subjectId];}else if(subjectType){query+=" WHERE subject_type=?";args=[subjectType];}query+=" ORDER BY updated_at DESC LIMIT 200";const bindings=await db.prepare(query).bind(...args).all<Row>();const audit=await db.prepare("SELECT * FROM identity_binding_audit ORDER BY created_at DESC LIMIT 100").all<Row>();return json({data:{bindings:bindings.results,audit:audit.results}});}catch(error){return authError(error,"Unable to load identity bindings");}}

export async function POST(request:Request){try{const actor=await resolveActor(request);requirePermission(actor,"users.manage");const db=await database();await ensureIdentityBindingTables(db);const body=await request.json() as Record<string,unknown>,action=String(body.action||"bind"),reason=String(body.reason||"").trim();if(reason.length<5)return json({error:"A clear identity change reason is required"},400);
  if(action==="revoke"){const id=String(body.id||"");if(!id)return json({error:"Binding ID is required"},400);const result=await revokeIdentityBinding(db,{id,actorId:actor.email,reason});await securityAudit(db,actor,"identity.binding.revoke","identity_binding",id,"completed",{reason});return json({data:result});}
  if(action!=="bind")return json({error:"Identity action must be bind or revoke"},400);
  const identitySource=String(body.identitySource||"workspace") as IdentitySource,principalType=String(body.principalType||"email") as PrincipalType,principalKey=String(body.principalKey||""),subjectType=String(body.subjectType||"") as IdentitySubjectType,subjectId=String(body.subjectId||"");
  if(!["workspace","customer_otp","partner_otp","migration"].includes(identitySource))return json({error:"Unsupported identity source"},400);if(!["email","identity_subject"].includes(principalType))return json({error:"Unsupported principal type"},400);if(!["customer","provider"].includes(subjectType)||!subjectId||!principalKey)return json({error:"Principal, subject type and subject ID are required"},400);if(identitySource==="workspace"&&principalType!=="email")return json({error:"Workspace bindings must use email principals"},400);if(principalType==="email"&&!principalKey.includes("@"))return json({error:"A valid email principal is required"},400);
  const result=await upsertIdentityBinding(db,{identitySource,principalType,principalKey,subjectType,subjectId,cityId:body.cityId?String(body.cityId):null,verificationState:body.verificationState==="pending"?"pending":"verified",expiresAt:body.expiresAt?Number(body.expiresAt):null,metadata:typeof body.metadata==="object"&&body.metadata?body.metadata as Record<string,unknown>:{},actorId:actor.email,reason});await securityAudit(db,actor,"identity.binding.upsert","identity_binding",String((result as Row)?.id||""),"completed",{identitySource,principalType,subjectType,subjectId,reason});return json({data:result},201);
}catch(error){return authError(error,"Unable to update identity binding");}}
