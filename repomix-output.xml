import {apiSend} from "./api-fetch";

export type TrainingCancellationRequest={caseId:string;status:string;calculation?:{calculatedRefund:number;capturedAmount:number;chargeableSessions:number;outstandingServiceValue:number}|null;duplicatePrevented:boolean;liveRefund:false};
