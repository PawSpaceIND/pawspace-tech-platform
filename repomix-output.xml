export async function ensureProviderOnboardingHumanActivation(db:D1Database){await ensureProviderOnboardingTransactional(db);await ensureProviderCapacityTables(db);await db.batch([
 db.prepare("CREATE TABLE IF NOT EXISTS provider_onboarding_interviews (id TEXT PRIMARY KEY,application_id TEXT NOT NULL,start_at TEXT NOT NULL,end_at TEXT NOT NULL,duration_minutes INTEGER NOT NULL,ops_email TEXT NOT NULL,status TEXT NOT NULL,notes TEXT,ai_summary_draft TEXT,ai_provider_ref TEXT,ai_model_ref TEXT,outcome TEXT,decision_notes TEXT,decision_actor TEXT,decision_at INTEGER,created_by TEXT NOT NULL,created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL)"),
