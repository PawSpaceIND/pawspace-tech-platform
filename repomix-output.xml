<file path="lib/idfy-callback-boundary.ts">
/**
 * IDfy verification callback boundary.
 *
 * WHY THIS EXISTS. `verifyWithIdfy` submits a check and reads whatever the synchronous HTTP response
 * happens to carry. Real IDfy verification is asynchronous: the POST enqueues a task and returns a
 * request_id, and the OUTCOME arrives later on a webhook. Without a callback boundary an automatable
 * check submitted to a live IDfy account could only ever settle as `manual_review` - the tri-state
 * default - so every provider would queue for a human, and the one path that could set `verified`
 * automatically did not exist. There was no route, no signature check, no correlation and no replay
 * protection for the callback IDfy would actually send.
 *
 * SHAPE. Deliberately the same shape as the telephony callback in lib/voice-telephony-provider.ts,
 * because the threat is the same: an endpoint a carrier/provider posts to with no session cookie.
 *
 *   - HMAC-SHA256 over `${timestamp}.${rawBody}` in `x-idfy-signature`, hex, constant-time compared.
 *   - A freshness window on the timestamp, so a captured body cannot be replayed indefinitely.
 *   - IDFY_WEBHOOK_SECRET absent => 503 and NOTHING is accepted. There is no unverified path in.
 *   - Deduplication on the provider's own event id with a UNIQUE index, so a redelivery (providers
 *     retry on any non-2xx) answers 200 and changes no state.
 *
 * WHAT IT DELIBERATELY WILL NOT DO.
 *   - It will not create a verification. A callback may only settle a check that THIS system already
 *     submitted: the correlated row must be automated and must already carry the provider reference
 *     the callback names. No submission, no provider_ref, no settlement - so with IDfy switched off
 *     (provider_ref stays NULL) a callback can never correlate to anything at all.
 *   - It will not touch a manual check. Police/house/pet-proofing outcomes are recorded by a human
 *     through recordManualVerification; letting a webhook write them would collapse the separation
 *     between automated and human verification authority into one forgeable channel.
 *   - It will not invent an outcome. The pass/fail/review mapping is mapStatus() from the submission
 *     adapter, reused rather than restated, so the two channels cannot drift apart.
 */

import { mapStatus } from "./idfy-verification-client";

type Db = D1Database;
type Row = Record<string, unknown>;
type Env = Record<string, unknown> | null | undefined;

export const IDFY_SIGNATURE_HEADER = "x-idfy-signature";
export const IDFY_TIMESTAMP_HEADER = "x-idfy-timestamp";
/** Same window the telephony callback uses. A signature older than this is refused even if it verifies. */
export const IDFY_SIGNATURE_FRESHNESS_MS = 300_000;

/** The two states that represent a decision. Anything else is work still in progress. */
export const TERMINAL_VERIFICATION_STATUSES = ["verified", "failed"];

const text = (value: unknown) => String(value ?? "").trim();
const hex = (bytes: ArrayBuffer) => Array.from(new Uint8Array(bytes)).map(b => b.toString(16).padStart(2, "0")).join("");
function safeEqual(a: string, b: string) { if (a.length !== b.length) return false; let out = 0; for (let i = 0; i < a.length; i++) out |= a.charCodeAt(i) ^ b.charCodeAt(i); return out === 0; }
export async function idfyHmacHex(secret: string, body: string) {
  const key = await crypto.subtle.importKey("raw", new TextEncoder().encode(secret), { name: "HMAC", hash: "SHA-256" }, false, ["sign"]);
  return hex(await crypto.subtle.sign("HMAC", key, new TextEncoder().encode(body)));
}

export async function ensureIdfyCallbackTables(db: Db) {
  await db.batch([
    db.prepare("CREATE TABLE IF NOT EXISTS provider_verification_callbacks (id TEXT PRIMARY KEY,provider_event_id TEXT NOT NULL UNIQUE,provider_ref TEXT NOT NULL,application_id TEXT,verification_type TEXT,outcome TEXT NOT NULL,accepted INTEGER NOT NULL,rejection_reason TEXT,payload_sha256 TEXT NOT NULL,received_at INTEGER NOT NULL)"),
    db.prepare("CREATE INDEX IF NOT EXISTS idx_provider_verification_callbacks_ref ON provider_verification_callbacks(provider_ref)"),
  ]);
}

export type CallbackResult =
  | { accepted: true; status: number; applicationId: string; verificationType: string; outcome: string; duplicate: boolean }
  | { accepted: false; status: number; reason: string };

/**
 * Verify and apply one IDfy callback.
 *
 * `rawBody` is the exact bytes as received. It is what the signature covers, so it must never be
 * re-serialised from a parsed object before verification - a re-serialised body is a different string
 * and would either fail valid signatures or, worse, invite a "parse first, verify later" ordering.
 */
export async function applyIdfyCallback(db: Db, env: Env, input: { rawBody: string; headers: Headers }): Promise<CallbackResult> {
  const secret = text(env?.IDFY_WEBHOOK_SECRET);
  // Fail closed, and say so with 503 rather than 401: the caller is not unauthorised, this deployment
  // simply has no verification channel switched on. A 401 would invite a credential hunt that cannot
  // succeed, and would be indistinguishable from a wrong signature.
  if (!secret) return { accepted: false, status: 503, reason: "IDfy callbacks are not connected (IDFY_WEBHOOK_SECRET not configured)" };

  const signature = text(input.headers.get(IDFY_SIGNATURE_HEADER)), stamp = text(input.headers.get(IDFY_TIMESTAMP_HEADER));
  if (!signature || !stamp) return { accepted: false, status: 401, reason: "Signature and timestamp headers are required" };
  const stampMs = Number(stamp);
  if (!Number.isFinite(stampMs)) return { accepted: false, status: 401, reason: "Signature timestamp is not a number" };
  // Absolute difference, so a timestamp in the FUTURE is as unacceptable as one in the past. Comparing
  // only `now - stamp` would let a far-future timestamp keep one captured body replayable forever.
  if (Math.abs(Date.now() - stampMs) > IDFY_SIGNATURE_FRESHNESS_MS) return { accepted: false, status: 401, reason: "Signature timestamp is outside the freshness window" };
  // The provider signs the exact header value it sent. `${stampMs}` re-serialises Number(stamp), so any
  // non-canonical numeric form the provider might send - "1700000000000.0", "+1700000000000", a leading
  // zero, exponent notation - all pass Number.isFinite and then serialise differently, breaking a
  // legitimate signature and 401-ing a callback that would never settle. stampMs is for freshness only.
  const expected = await idfyHmacHex(secret, `${stamp}.${input.rawBody}`);
  if (!safeEqual(expected, signature)) return { accepted: false, status: 401, reason: "Signature verification failed" };

  // Only now is the body worth parsing.
  let body: Record<string, unknown>;
  try { body = JSON.parse(input.rawBody) as Record<string, unknown>; }
  catch { return { accepted: false, status: 400, reason: "Callback body is not valid JSON" }; }

  const eventId = text(body.event_id || body.id), providerRef = text(body.request_id || body.reference_id);
  if (!eventId) return { accepted: false, status: 400, reason: "Callback event id is required" };
  if (!providerRef) return { accepted: false, status: 400, reason: "Callback provider reference is required" };

  await ensureIdfyCallbackTables(db);
  const payloadHash = hex(await crypto.subtle.digest("SHA-256", new TextEncoder().encode(input.rawBody)));

  // Replay check BEFORE any mutation. A redelivery is normal - providers retry on any non-2xx - so it
  // answers 200 (stop retrying) and changes nothing.
  // ONLY an accepted record is terminal. Keying this on the event id alone meant a REFUSED delivery
  // poisoned that id: the 404 recorded the event, IDfy retried once the row was readable, and the retry
  // matched here and was answered `{accepted:true, status:200, outcome:"unmatched"}` - so the provider
  // stopped retrying, the response claimed success, and the verification stayed manual_review forever.
  //
  // A duplicate is the SAME event carrying the SAME content. Matching on the event id alone meant a
  // second correctly-signed, fresh delivery bearing that id and the OPPOSITE outcome was answered
  // 200 {ok:true, outcome:"verified", duplicate:true} - a revocation answered success, reporting the
  // outcome it had just contradicted, with provider_verifications untouched. The payload hash is
  // already computed and already stored; it decides which of the two this is. [PTJA-P0-07]
  //
  // A same-id-different-payload delivery is NOT applied as a new outcome either: a real revocation
  // carries its own event id (and is applied - the monotonicity rule permits verified -> failed), so an
  // id contradicting itself is the provider disagreeing with its own record. It is refused 409, and
  // recorded under a derived id so the accepted delivery that actually took effect is preserved beside
  // it rather than overwritten.
  const seen = await db.prepare("SELECT application_id,verification_type,outcome,payload_sha256 FROM provider_verification_callbacks WHERE provider_event_id=? AND accepted=1").bind(eventId).first<Row>();
  if (seen && text(seen.payload_sha256) === payloadHash) return { accepted: true, status: 200, applicationId: text(seen.application_id), verificationType: text(seen.verification_type), outcome: text(seen.outcome), duplicate: true };
  if (seen) {
    await db.prepare("INSERT OR IGNORE INTO provider_verification_callbacks (id,provider_event_id,provider_ref,application_id,verification_type,outcome,accepted,rejection_reason,payload_sha256,received_at) VALUES (?,?,?,?,?,?,0,?,?,?)")
      .bind(`IDFYCB-${crypto.randomUUID().slice(0, 12).toUpperCase()}`, `${eventId}#conflict:${payloadHash.slice(0, 16)}`, providerRef, text(seen.application_id) || null, text(seen.verification_type) || null, "conflicting_payload", "event_id_replayed_with_a_different_payload", payloadHash, Date.now()).run();
    return { accepted: false, status: 409, reason: "This event id was already settled with a different payload; a new outcome must carry its own event id" };
  }

  const record = async (outcome: string, accepted: boolean, reason: string | null, appId: string, vType: string) => {
    // provider_event_id is UNIQUE, so INSERT OR IGNORE alone would leave the earlier REFUSED row in
    // place and the accepted=1 replay check above would never match - the retry would settle the
    // verification but every later duplicate would correlate and settle it again. Upserting keeps the
    // one row per event id and makes it describe the delivery that actually took effect.
    await db.prepare("INSERT INTO provider_verification_callbacks (id,provider_event_id,provider_ref,application_id,verification_type,outcome,accepted,rejection_reason,payload_sha256,received_at) VALUES (?,?,?,?,?,?,?,?,?,?) ON CONFLICT(provider_event_id) DO UPDATE SET provider_ref=excluded.provider_ref,application_id=excluded.application_id,verification_type=excluded.verification_type,outcome=excluded.outcome,accepted=excluded.accepted,rejection_reason=excluded.rejection_reason,payload_sha256=excluded.payload_sha256,received_at=excluded.received_at")
      .bind(`IDFYCB-${crypto.randomUUID().slice(0, 12).toUpperCase()}`, eventId, providerRef, appId || null, vType || null, outcome, accepted ? 1 : 0, reason, payloadHash, Date.now()).run();
  };

  // Correlation. The row must exist, must be one WE submitted (automated=1 with a provider_ref set by
  // the submission), and its provider_ref must be the one the callback names. An unknown or mismatched
  // reference is refused and recorded - a rejected callback is evidence too, so it is never dropped.
  // No .catch here. Swallowing a read failure into `null` answered a transient D1 error with the same
  // 404 as a genuinely unknown reference; the error must surface so the route answers 5xx and the
  // provider retries.
  const row = await db.prepare("SELECT id,application_id,verification_type,status,automated,provider_ref FROM provider_verifications WHERE provider_ref=?").bind(providerRef).first<Row>();
  if (!row) { await record("unmatched", false, "no_verification_for_provider_reference", "", ""); return { accepted: false, status: 404, reason: "No submitted verification matches this provider reference" }; }
  const applicationId = text(row.application_id), verificationType = text(row.verification_type);
  if (Number(row.automated || 0) !== 1) {
    await record("refused", false, "manual_verification_cannot_be_settled_by_callback", applicationId, verificationType);
    return { accepted: false, status: 409, reason: "Manual verification outcomes are recorded by a human, not by a provider callback" };
  }

  const outcome = mapStatus(body);
  // MONOTONIC. IDfy delivery is asynchronous and unordered, so a callback that merely reports progress
  // can arrive AFTER the one carrying the decision. Applying it unconditionally rewrote a `verified`
  // row back to `manual_review`, and because assignment eligibility requires every mandated check to be
  // `verified`, that silently revoked a provider who had already passed.
  //
  // Only the two decided states are terminal, and both are the provider's own judgement: verified may
  // still become failed (a later revocation) and failed may still become verified (a correction). What
  // may never happen is a NON-decision overwriting a decision. No new status is introduced.
  // ONE atomic conditional UPDATE. The rule lives in the WHERE clause, so there is no window between
  // deciding and writing for a concurrent delivery to slip through: IDfy delivers callbacks in parallel,
  // and read-decide-write let a stale nonterminal delivery commit over a `verified` that landed while it
  // was in flight - measured, from a `pending` start, as canTakeAssignments going true -> false.
  //
  // A terminal outcome may overwrite anything (verified -> failed is a revocation, failed -> verified a
  // correction; both are the provider's own judgement and both were already approved). A NON-decision
  // may only overwrite a row that has not been decided. Same rule as before, expressed where it is
  // enforced atomically rather than in a variable computed from a stale read. No new status.
  // An AND-chain of inequalities rather than a NOT IN list, deliberately. tests/d1-in-clause-fanout
  // forbids assembling an IN list in lib/ because a list built at runtime can outgrow D1's bound
  // parameter cap. This one is a two-element compile-time constant and could not, but the equivalent
  // chain (status is NOT NULL, so the two forms mean the same thing) needs no exemption at all, and
  // stays correct if the constant ever changes.
  const notDecided = TERMINAL_VERIFICATION_STATUSES.map(() => "status<>?").join(" AND ");
  const outcomeIsTerminal = TERMINAL_VERIFICATION_STATUSES.includes(outcome) ? 1 : 0;
  await db.prepare(`UPDATE provider_verifications SET status=?,detail_json=?,updated_by='idfy_callback',updated_at=? WHERE id=? AND (?=1 OR (${notDecided})) AND status!=?`)
    .bind(outcome, JSON.stringify({ via: "idfy_callback", providerRef, eventId }), Date.now(), text(row.id), outcomeIsTerminal, ...TERMINAL_VERIFICATION_STATUSES, outcome).run();

  // What actually stands, read back rather than assumed - `row.status` is now known to be stale. This
  // one value is used for the evidence record, the supersession reason and the returned outcome, so a
  // caller can never be told something the database does not say.
  const effective = text((await db.prepare("SELECT status FROM provider_verifications WHERE id=?").bind(text(row.id)).first<Row>())?.status) || outcome;
  // A callback can REVOKE a mandated check, and the assignment pool has to hear about it. The matching
  // engine reads provider_capacity_profiles and never provider_verifications, so without this a provider
  // whose check IDfy just failed kept being offered work - the same defect as the manual revocation path,
  // through the door IDfy actually uses. De-lists only when the mandate is genuinely unsatisfied, and
  // never re-lists anybody. [PTJA-P1-F50]
  const { syncProviderPoolEligibility } = await import("./provider-verification-mandate");
  await syncProviderPoolEligibility(db, applicationId);

  // Recorded either way - a superseded callback is evidence that it arrived and was declined.
  await record(effective, true, effective === outcome ? null : `nonterminal_${outcome}_ignored_after_${effective}`, applicationId, verificationType);
  return { accepted: true, status: 200, applicationId, verificationType, outcome: effective, duplicate: false };
}
</file>

<file path="lib/idfy-verification-client.ts">
/**
 * Fail-closed IDfy verification adapter. IDfy is the KYC/verification provider that runs the automatable
 * provider checks (Aadhaar, PAN, address). Gated on IDFY_API_KEY + IDFY_ACCOUNT_ID + IDFY_URL: with any
 * missing it returns connected:false and verifies nothing - so no provider is ever auto-approved until
 * IDfy is deliberately switched on (in isolated staging first), exactly like the Razorpay/Haptik/voice
 * adapters. Non-automatable checks (police, house, pet-proofing) are never sent here - they are photo /
 * physical / agent verifications recorded by a human.
 */

type Env = Record<string, unknown>;
const val = (env: Env, key: string) => String(env?.[key] ?? "").trim();

export type IdfyResult =
  | { connected: true; status: "verified" | "manual_review" | "failed"; reference: string; raw?: Record<string, unknown> }
  | { connected: false; reason: string };

export function idfyConfigured(env: Env): boolean {
  return Boolean(val(env, "IDFY_API_KEY") && val(env, "IDFY_ACCOUNT_ID") && val(env, "IDFY_URL"));
}

/** Map an IDfy task status to our tri-state. IDfy typically returns completed/in_progress/failed with a
 * sub-result; anything not clearly a pass/fail routes to human manual review (never a silent approve). */
export function mapStatus(body: Record<string, unknown>): "verified" | "manual_review" | "failed" {
  const status = String(body.status ?? "").toLowerCase();
  const result = String((body.result as Record<string, unknown> | undefined)?.verification_status ?? body.verification_status ?? "").toLowerCase();
  if (status === "failed" || result === "not_verified" || result === "no_match") return "failed";
  if (result === "verified" || result === "match" || result === "source_verified") return "verified";
  return "manual_review";
}

/** Run an automatable check through IDfy. Fail-closed when not configured. */
export async function verifyWithIdfy(env: Env, input: { checkType: string; referenceId: string; payload: Record<string, unknown> }): Promise<IdfyResult> {
  const apiKey = val(env, "IDFY_API_KEY"), accountId = val(env, "IDFY_ACCOUNT_ID"), url = val(env, "IDFY_URL");
  if (!apiKey || !accountId || !url) return { connected: false, reason: "IDfy is not connected (IDFY_API_KEY / IDFY_ACCOUNT_ID / IDFY_URL not configured)" };
  try {
    const response = await fetch(url, { method: "POST", headers: { "api-key": apiKey, "account-id": accountId, "content-type": "application/json" }, body: JSON.stringify({ task_id: input.referenceId, group_id: input.referenceId, checkType: input.checkType, data: input.payload }) });
    const body = await response.json().catch(() => ({})) as Record<string, unknown>;
    if (!response.ok) return { connected: false, reason: `IDfy request failed (${response.status}): ${String((body.error as Record<string, unknown> | undefined)?.message || body.message || "request failed")}` };
    const reference = String(body.request_id || body.id || input.referenceId || "").trim();
    return { connected: true, status: mapStatus(body), reference, raw: body };
  } catch (error) {
    return { connected: false, reason: `IDfy request failed: ${error instanceof Error ? error.message : String(error)}` };
  }
}
</file>

<file path="lib/incentive-engine.ts">
type Db=D1Database;
type Row=Record<string,unknown>;
export type IncentiveMetric="net_collected_revenue"|"collected_revenue"|"booking_conversions"|"first_response_rate"|"qualified_leads"|"meaningful_actions";
export type IncentiveFormula={metric:IncentiveMetric;target:number;payoutType:"flat_on_target"|"amount_per_unit_above_target"|"percent_of_revenue_above_target";payoutValue:number;cap?:number|null};
export type QualityGuardrail={metric:"refunds"|"cx_escalations"|"opt_out_or_consent_blocks"|"data_quality_blocks"|"first_response_breached";operator:"gt"|"gte";threshold:number;action:"hold"|"zero"|"multiplier";multiplier?:number|null};
export type PayrollIncentiveEntry={sourceType:"incentive_result"|"incentive_reversal";sourceId:string;label:string;kind:"earning"|"deduction";amount:number;policyVersion:string};
const text=(v:unknown)=>String(v??"").trim();
const uid=(p:string)=>`${p}-${crypto.randomUUID().slice(0,12).toUpperCase()}`;
const money=(v:unknown)=>Math.round(Number(v||0)*100)/100;
const parse=<T>(v:unknown,fallback:T):T=>{try{return JSON.parse(String(v??"")) as T;}catch{return fallback;}};
const revenueMetrics=new Set<IncentiveMetric>(["net_collected_revenue","collected_revenue"]);

export async function ensureIncentiveTables(db:Db){await db.batch([
 db.prepare("CREATE TABLE IF NOT EXISTS incentive_scheme_versions (id TEXT PRIMARY KEY,scheme_code TEXT NOT NULL,version INTEGER NOT NULL,status TEXT NOT NULL DEFAULT 'draft',role_code TEXT NOT NULL,team_code TEXT NOT NULL,effective_from INTEGER NOT NULL,effective_until INTEGER,formula_json TEXT NOT NULL,quality_rules_json TEXT NOT NULL DEFAULT '[]',approval_reference TEXT,created_by TEXT NOT NULL,created_at INTEGER NOT NULL,UNIQUE(scheme_code,version))"),
 db.prepare("CREATE TABLE IF NOT EXISTS employee_incentive_periods (id TEXT PRIMARY KEY,idempotency_key TEXT NOT NULL UNIQUE,scheme_id TEXT NOT NULL,period_start INTEGER NOT NULL,period_end INTEGER NOT NULL,status TEXT NOT NULL DEFAULT 'calculated',calculated_by TEXT NOT NULL,created_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS employee_incentive_results (id TEXT PRIMARY KEY,period_id TEXT NOT NULL,employee_id TEXT NOT NULL,employee_email TEXT NOT NULL,source_fact_run_id TEXT NOT NULL,metric_value REAL NOT NULL,calculated_amount REAL NOT NULL,approved_amount REAL NOT NULL DEFAULT 0,status TEXT NOT NULL DEFAULT 'calculated',evidence_json TEXT NOT NULL,approved_by TEXT,approved_at INTEGER,UNIQUE(period_id,employee_id))"),
 db.prepare("CREATE TABLE IF NOT EXISTS incentive_result_lines (id TEXT PRIMARY KEY,result_id TEXT NOT NULL,line_type TEXT NOT NULL,label TEXT NOT NULL,amount REAL NOT NULL,source_reference TEXT,policy_version TEXT NOT NULL,detail_json TEXT NOT NULL DEFAULT '{}',created_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS incentive_adjustments (id TEXT PRIMARY KEY,result_id TEXT NOT NULL,amount REAL NOT NULL,reason TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'pending',requested_by TEXT NOT NULL,requested_at INTEGER NOT NULL,approved_by TEXT,approved_at INTEGER)"),
 db.prepare("CREATE TABLE IF NOT EXISTS incentive_disputes (id TEXT PRIMARY KEY,result_id TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'open',reason TEXT NOT NULL,opened_by TEXT NOT NULL,opened_at INTEGER NOT NULL,resolved_by TEXT,resolved_at INTEGER,resolution_note TEXT)"),
 db.prepare("CREATE TABLE IF NOT EXISTS incentive_reversals (id TEXT PRIMARY KEY,result_id TEXT NOT NULL,amount REAL NOT NULL,reason TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'approved',effective_at INTEGER NOT NULL,actor_id TEXT NOT NULL,created_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS incentive_approval_events (id TEXT PRIMARY KEY,result_id TEXT NOT NULL,event_type TEXT NOT NULL,actor_id TEXT NOT NULL,detail_json TEXT NOT NULL DEFAULT '{}',created_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS incentive_payroll_links (id TEXT PRIMARY KEY,source_type TEXT NOT NULL,source_id TEXT NOT NULL,payroll_run_id TEXT NOT NULL,payroll_result_id TEXT NOT NULL,employee_id TEXT NOT NULL,amount REAL NOT NULL,created_at INTEGER NOT NULL,UNIQUE(source_type,source_id))"),
 db.prepare("CREATE INDEX IF NOT EXISTS incentive_results_employee_idx ON employee_incentive_results(employee_id,status)"),
]);}

function validateFormula(formula:IncentiveFormula){if(!["net_collected_revenue","collected_revenue","booking_conversions","first_response_rate","qualified_leads","meaningful_actions"].includes(formula.metric))throw new Error("Unsupported incentive metric");if(!Number.isFinite(formula.target)||formula.target<0||!Number.isFinite(formula.payoutValue)||formula.payoutValue<0)throw new Error("Incentive target and payout value must be explicit non-negative numbers");if(!["flat_on_target","amount_per_unit_above_target","percent_of_revenue_above_target"].includes(formula.payoutType))throw new Error("Unsupported incentive payout formula");if(formula.payoutType==="percent_of_revenue_above_target"&&!revenueMetrics.has(formula.metric))throw new Error("Revenue percentage formula requires a canonical revenue metric");if(formula.cap!=null&&(!Number.isFinite(formula.cap)||formula.cap<0))throw new Error("Incentive cap must be an explicit non-negative amount");}
function validateGuardrail(rule:QualityGuardrail){if(!["refunds","cx_escalations","opt_out_or_consent_blocks","data_quality_blocks","first_response_breached"].includes(rule.metric))throw new Error("Unsupported incentive quality guardrail metric");if(!["gt","gte"].includes(rule.operator)||!Number.isFinite(rule.threshold)||rule.threshold<0)throw new Error("Quality guardrail threshold is invalid");if(!["hold","zero","multiplier"].includes(rule.action))throw new Error("Quality guardrail action is invalid");if(rule.action==="multiplier"&&(rule.multiplier==null||!Number.isFinite(rule.multiplier)||rule.multiplier<0||rule.multiplier>1))throw new Error("Quality multiplier must be explicitly configured between 0 and 1");}

export async function saveIncentiveScheme(db:Db,input:{schemeCode:string;roleCode:string;teamCode:string;effectiveFrom:number;effectiveUntil?:number|null;formula:IncentiveFormula;qualityRules:QualityGuardrail[];actorId:string}){await ensureIncentiveTables(db);if(!text(input.schemeCode)||!text(input.roleCode)||!text(input.teamCode)||!Number.isFinite(input.effectiveFrom)||input.effectiveFrom<=0)throw new Error("Scheme code, role, team and effective date are required");if(input.effectiveUntil!=null&&input.effectiveUntil<=input.effectiveFrom)throw new Error("Scheme end date must follow start date");validateFormula(input.formula);for(const r of input.qualityRules)validateGuardrail(r);const prior=await db.prepare("SELECT * FROM incentive_scheme_versions WHERE scheme_code=? ORDER BY version DESC LIMIT 1").bind(input.schemeCode).first<Row>();if(prior&&text(prior.status)==="active_uat")throw new Error("Active incentive scheme is immutable; create a new scheme version after retiring it");const version=Number(prior?.version||0)+1,id=uid("ISV"),now=Date.now();await db.prepare("INSERT INTO incentive_scheme_versions (id,scheme_code,version,status,role_code,team_code,effective_from,effective_until,formula_json,quality_rules_json,created_by,created_at) VALUES (?,?,?,'draft',?,?,?,?,?,?,?,?)").bind(id,input.schemeCode,version,input.roleCode,input.teamCode,input.effectiveFrom,input.effectiveUntil??null,JSON.stringify(input.formula),JSON.stringify(input.qualityRules),input.actorId,now).run();return db.prepare("SELECT * FROM incentive_scheme_versions WHERE id=?").bind(id).first<Row>();}
export async function activateIncentiveScheme(db:Db,input:{schemeId:string;approvalReference:string;actorId:string}){await ensureIncentiveTables(db);if(input.approvalReference.trim().length<4)throw new Error("Incentive scheme approval reference is required");const row=await db.prepare("SELECT * FROM incentive_scheme_versions WHERE id=?").bind(input.schemeId).first<Row>();if(!row||text(row.status)!=="draft")throw new Error("Only a draft incentive scheme can be activated");validateFormula(parse<IncentiveFormula>(row.formula_json,{} as IncentiveFormula));for(const r of parse<QualityGuardrail[]>(row.quality_rules_json,[]))validateGuardrail(r);await db.prepare("UPDATE incentive_scheme_versions SET status='active_uat',approval_reference=? WHERE id=?").bind(input.approvalReference.trim(),input.schemeId).run();return db.prepare("SELECT * FROM incentive_scheme_versions WHERE id=?").bind(input.schemeId).first<Row>();}

function metricValue(fact:Row,metric:IncentiveMetric){if(metric==="first_response_rate"){const total=Number(fact.first_response_clocks||0);return total?money(Number(fact.first_response_met||0)/total*100):0;}return money(fact[metric]||0);}
function payout(formula:IncentiveFormula,value:number){let amount=0;if(formula.payoutType==="flat_on_target")amount=value>=formula.target?formula.payoutValue:0;else if(formula.payoutType==="amount_per_unit_above_target")amount=Math.max(0,value-formula.target)*formula.payoutValue;else amount=Math.max(0,value-formula.target)*(formula.payoutValue/100);if(formula.cap!=null)amount=Math.min(amount,formula.cap);return money(amount);}
function guardrailTriggered(value:number,rule:QualityGuardrail){return rule.operator==="gt"?value>rule.threshold:value>=rule.threshold;}
async function eligibleEmployees(db:Db,scheme:Row){const rows=await db.prepare("SELECT e.id,e.work_email,e.user_email,v.team_code,u.role_code FROM employees e JOIN employee_employment_versions v ON v.employee_id=e.id AND v.effective_until IS NULL LEFT JOIN app_users u ON u.email=COALESCE(e.user_email,e.work_email) WHERE e.employment_status='active' AND v.team_code=? AND u.role_code=? ORDER BY e.id").bind(scheme.team_code,scheme.role_code).all<Row>();return rows.results;}
async function factFor(db:Db,email:string,teamCode:string,start:number,end:number){return db.prepare("SELECT f.*,r.id source_fact_run_id,r.policy_id,r.policy_version FROM sales_productivity_facts f JOIN sales_productivity_fact_runs r ON r.id=f.run_id WHERE f.employee_email=? AND f.team_code=? AND f.period_start=? AND f.period_end=? AND r.status='completed' ORDER BY r.generated_at DESC LIMIT 1").bind(email,teamCode,start,end).first<Row>();}

export async function calculateIncentivePeriod(db:Db,input:{schemeId:string;periodStart:number;periodEnd:number;idempotencyKey:string;actorId:string}){await ensureIncentiveTables(db);if(!text(input.idempotencyKey)||!Number.isFinite(input.periodStart)||!Number.isFinite(input.periodEnd)||input.periodEnd<=input.periodStart)throw new Error("Valid incentive period and idempotency key are required");const prior=await db.prepare("SELECT * FROM employee_incentive_periods WHERE idempotency_key=?").bind(input.idempotencyKey).first<Row>();if(prior)return{period:prior,results:(await db.prepare("SELECT * FROM employee_incentive_results WHERE period_id=? ORDER BY employee_id").bind(prior.id).all<Row>()).results,duplicatePrevented:true};const scheme=await db.prepare("SELECT * FROM incentive_scheme_versions WHERE id=? AND status='active_uat'").bind(input.schemeId).first<Row>();if(!scheme)throw new Error("Active incentive scheme is required");if(input.periodStart<Number(scheme.effective_from)||(scheme.effective_until!=null&&input.periodEnd>Number(scheme.effective_until)))throw new Error("Incentive period is outside scheme validity");const formula=parse<IncentiveFormula>(scheme.formula_json,{} as IncentiveFormula),rules=parse<QualityGuardrail[]>(scheme.quality_rules_json,[]);validateFormula(formula);for(const r of rules)validateGuardrail(r);const periodId=uid("IPER"),now=Date.now();await db.prepare("INSERT INTO employee_incentive_periods (id,idempotency_key,scheme_id,period_start,period_end,status,calculated_by,created_at) VALUES (?,?,?,?,?,'calculated',?,?)").bind(periodId,input.idempotencyKey,input.schemeId,input.periodStart,input.periodEnd,input.actorId,now).run();for(const employee of await eligibleEmployees(db,scheme)){const email=text(employee.user_email||employee.work_email),fact=await factFor(db,email,text(scheme.team_code),input.periodStart,input.periodEnd);if(!fact)continue;const value=metricValue(fact,formula.metric);let amount=payout(formula,value),status="calculated";const applied:Record<string,unknown>[]=[];for(const rule of rules){const q=money(fact[rule.metric]||0);if(!guardrailTriggered(q,rule))continue;applied.push({rule,actual:q});if(rule.action==="hold")status="held";else if(rule.action==="zero")amount=0;else amount=money(amount*Number(rule.multiplier));}const resultId=uid("IRES"),evidence={employeeEmail:email,sourceFactRunId:fact.source_fact_run_id,productivityPolicyId:fact.policy_id,productivityPolicyVersion:fact.policy_version,metric:formula.metric,metricValue:value,formula,qualityRules:rules,appliedGuardrails:applied,pipelineRevenueExcluded:true};await db.prepare("INSERT INTO employee_incentive_results (id,period_id,employee_id,employee_email,source_fact_run_id,metric_value,calculated_amount,status,evidence_json) VALUES (?,?,?,?,?,?,?,?,?)").bind(resultId,periodId,employee.id,email,fact.source_fact_run_id,value,amount,status,JSON.stringify(evidence)).run();await db.prepare("INSERT INTO incentive_result_lines (id,result_id,line_type,label,amount,source_reference,policy_version,detail_json,created_at) VALUES (?,?,?,?,?,?,?,?,?)").bind(uid("IRL"),resultId,"calculation",`${formula.metric} incentive`,amount,text(fact.source_fact_run_id),`incentive_scheme:${text(scheme.scheme_code)}:v${Number(scheme.version)}`,JSON.stringify({metricValue:value,formula,appliedGuardrails:applied}),now).run();}return{period:await db.prepare("SELECT * FROM employee_incentive_periods WHERE id=?").bind(periodId).first<Row>(),results:(await db.prepare("SELECT * FROM employee_incentive_results WHERE period_id=? ORDER BY employee_id").bind(periodId).all<Row>()).results,duplicatePrevented:false};}

export async function addIncentiveAdjustment(db:Db,input:{resultId:string;amount:number;reason:string;actorId:string}){await ensureIncentiveTables(db);if(!Number.isFinite(input.amount)||input.amount===0||input.reason.trim().length<8)throw new Error("Non-zero adjustment and clear reason are required");const result=await db.prepare("SELECT status FROM employee_incentive_results WHERE id=?").bind(input.resultId).first<Row>();if(!result||["approved","reversed"].includes(text(result.status)))throw new Error("Finalized incentive cannot be silently adjusted");const id=uid("IADJ"),now=Date.now();await db.prepare("INSERT INTO incentive_adjustments (id,result_id,amount,reason,status,requested_by,requested_at) VALUES (?,?,?,?, 'pending',?,?)").bind(id,input.resultId,money(input.amount),input.reason.trim(),input.actorId,now).run();return{id,status:"pending"};}
export async function approveIncentiveAdjustment(db:Db,input:{adjustmentId:string;actorId:string}){await ensureIncentiveTables(db);const row=await db.prepare("SELECT * FROM incentive_adjustments WHERE id=?").bind(input.adjustmentId).first<Row>();if(!row||text(row.status)!=="pending")throw new Error("Pending incentive adjustment is required");if(text(row.requested_by)===input.actorId)throw new Error("Adjustment requester cannot approve their own change");await db.prepare("UPDATE incentive_adjustments SET status='approved',approved_by=?,approved_at=? WHERE id=?").bind(input.actorId,Date.now(),input.adjustmentId).run();return{adjustmentId:input.adjustmentId,status:"approved"};}
export async function openIncentiveDispute(db:Db,input:{resultId:string;reason:string;actorId:string}){await ensureIncentiveTables(db);if(input.reason.trim().length<8)throw new Error("Dispute reason is required");const linked=await db.prepare("SELECT id FROM incentive_payroll_links WHERE source_type='incentive_result' AND source_id=?").bind(input.resultId).first<Row>();if(linked)throw new Error("Payroll-included incentive requires reversal/correction rather than reopening history");const result=await db.prepare("SELECT status FROM employee_incentive_results WHERE id=?").bind(input.resultId).first<Row>();if(!result||text(result.status)==="reversed")throw new Error("Incentive result cannot be disputed");const id=uid("IDSP"),now=Date.now();await db.batch([db.prepare("INSERT INTO incentive_disputes (id,result_id,status,reason,opened_by,opened_at) VALUES (?,?,'open',?,?,?)").bind(id,input.resultId,input.reason.trim(),input.actorId,now),db.prepare("UPDATE employee_incentive_results SET status='disputed' WHERE id=?").bind(input.resultId)]);return{id,status:"open"};}
export async function resolveIncentiveDispute(db:Db,input:{disputeId:string;resolutionNote:string;actorId:string;release:boolean}){await ensureIncentiveTables(db);if(input.resolutionNote.trim().length<8)throw new Error("Dispute resolution note is required");const dispute=await db.prepare("SELECT * FROM incentive_disputes WHERE id=? AND status='open'").bind(input.disputeId).first<Row>();if(!dispute)throw new Error("Open incentive dispute not found");const now=Date.now();await db.batch([db.prepare("UPDATE incentive_disputes SET status='resolved',resolved_by=?,resolved_at=?,resolution_note=? WHERE id=?").bind(input.actorId,now,input.resolutionNote.trim(),input.disputeId),db.prepare("UPDATE employee_incentive_results SET status=? WHERE id=?").bind(input.release?"calculated":"held",dispute.result_id)]);return{disputeId:input.disputeId,status:"resolved"};}
export async function approveIncentiveResult(db:Db,input:{resultId:string;actorId:string}){await ensureIncentiveTables(db);const result=await db.prepare("SELECT r.*,p.calculated_by FROM employee_incentive_results r JOIN employee_incentive_periods p ON p.id=r.period_id WHERE r.id=?").bind(input.resultId).first<Row>();if(!result||text(result.status)!=="calculated")throw new Error("Only calculated and unheld incentive can be approved");if(text(result.calculated_by)===input.actorId)throw new Error("Incentive calculator cannot approve their own result");const adjustments=await db.prepare("SELECT COALESCE(SUM(amount),0) amount FROM incentive_adjustments WHERE result_id=? AND status='approved'").bind(input.resultId).first<Row>();const approved=money(Number(result.calculated_amount||0)+Number(adjustments?.amount||0));if(approved<0)throw new Error("Approved incentive cannot be negative; use explicit reversal/correction workflow");const now=Date.now();
 // Conditional claim on status='calculated': two managers clicking approve at once would otherwise
 // both "succeed", each writing an approval event for the same money.
 const claim=await db.prepare("UPDATE employee_incentive_results SET status='approved',approved_amount=?,approved_by=?,approved_at=? WHERE id=? AND status='calculated'").bind(approved,input.actorId,now,input.resultId).run();
 if(!Number(claim.meta.changes)){const winner=await db.prepare("SELECT status,approved_amount,approved_by FROM employee_incentive_results WHERE id=?").bind(input.resultId).first<Row>();return{resultId:input.resultId,status:text(winner?.status)||"approved",approvedAmount:money(winner?.approved_amount),duplicatePrevented:true,approvedBy:text(winner?.approved_by)||null};}
 await db.prepare("INSERT INTO incentive_approval_events (id,result_id,event_type,actor_id,detail_json,created_at) VALUES (?,?,?,?,?,?)").bind(uid("IAE"),input.resultId,"approved",input.actorId,JSON.stringify({approvedAmount:approved}),now).run();return{resultId:input.resultId,status:"approved",approvedAmount:approved,duplicatePrevented:false};}
export async function reverseIncentiveResult(db:Db,input:{resultId:string;amount?:number|null;reason:string;effectiveAt:number;actorId:string}){await ensureIncentiveTables(db);if(input.reason.trim().length<8||!Number.isFinite(input.effectiveAt)||input.effectiveAt<=0)throw new Error("Reversal reason and effective date are required");const result=await db.prepare("SELECT * FROM employee_incentive_results WHERE id=? AND status='approved'").bind(input.resultId).first<Row>();if(!result)throw new Error("Approved incentive result is required for reversal");const prior=await db.prepare("SELECT COALESCE(SUM(amount),0) amount FROM incentive_reversals WHERE result_id=? AND status='approved'").bind(input.resultId).first<Row>();const remaining=money(Number(result.approved_amount||0)-Number(prior?.amount||0)),amount=money(input.amount??remaining);if(amount<=0||amount>remaining)throw new Error("Reversal amount must be positive and cannot exceed the remaining approved incentive");const id=uid("IREV"),now=Date.now();
 // Guarded INSERT...SELECT: the remaining balance is re-checked inside the same statement, so two
 // concurrent reversals cannot each pass the read above and together claw back more than was ever
 // approved (which would become a double deduction on the employee's payslip).
 const claimed=await db.prepare("INSERT INTO incentive_reversals (id,result_id,amount,reason,status,effective_at,actor_id,created_at) SELECT ?,?,?,?, 'approved',?,?,? WHERE (SELECT COALESCE(SUM(amount),0) FROM incentive_reversals WHERE result_id=? AND status='approved')+?<=(SELECT approved_amount FROM employee_incentive_results WHERE id=?)").bind(id,input.resultId,amount,input.reason.trim(),input.effectiveAt,input.actorId,now,input.resultId,amount,input.resultId).run();
 if(!Number(claimed.meta.changes))throw new Error("Reversal amount must be positive and cannot exceed the remaining approved incentive");// Recomputed after the guarded insert, not from the stale pre-claim figure, so a partial reversal
 // that completes the clawback still flips the result to 'reversed'.
 await db.prepare("UPDATE employee_incentive_results SET status='reversed' WHERE id=? AND approved_amount<=(SELECT COALESCE(SUM(amount),0) FROM incentive_reversals WHERE result_id=? AND status='approved')").bind(input.resultId,input.resultId).run();await db.prepare("INSERT INTO incentive_approval_events (id,result_id,event_type,actor_id,detail_json,created_at) VALUES (?,?,?,?,?,?)").bind(uid("IAE"),input.resultId,"reversal_created",input.actorId,JSON.stringify({reversalId:id,amount,effectiveAt:input.effectiveAt}),now).run();return{id,amount,status:"approved"};}

export async function approvedIncentiveEntriesForPayroll(db:Db,input:{employeeId:string;periodStart:number;periodEnd:number}):Promise<PayrollIncentiveEntry[]>{await ensureIncentiveTables(db);const results=await db.prepare("SELECT r.id,r.approved_amount,s.scheme_code,s.version FROM employee_incentive_results r JOIN employee_incentive_periods p ON p.id=r.period_id JOIN incentive_scheme_versions s ON s.id=p.scheme_id LEFT JOIN incentive_payroll_links l ON l.source_type='incentive_result' AND l.source_id=r.id WHERE r.employee_id=? AND r.status='approved' AND p.period_start>=? AND p.period_end<=? AND l.id IS NULL AND r.approved_amount>0").bind(input.employeeId,input.periodStart,input.periodEnd).all<Row>();const reversals=await db.prepare("SELECT v.id,v.amount,s.scheme_code,s.version FROM incentive_reversals v JOIN employee_incentive_results r ON r.id=v.result_id JOIN employee_incentive_periods p ON p.id=r.period_id JOIN incentive_scheme_versions s ON s.id=p.scheme_id LEFT JOIN incentive_payroll_links l ON l.source_type='incentive_reversal' AND l.source_id=v.id WHERE r.employee_id=? AND v.status='approved' AND v.effective_at>=? AND v.effective_at<? AND l.id IS NULL").bind(input.employeeId,input.periodStart,input.periodEnd).all<Row>();return[...results.results.map(r=>({sourceType:"incentive_result" as const,sourceId:text(r.id),label:`Approved incentive · ${text(r.scheme_code)}`,kind:"earning" as const,amount:money(r.approved_amount),policyVersion:`incentive_scheme:${text(r.scheme_code)}:v${Number(r.version)}`})),...reversals.results.map(r=>({sourceType:"incentive_reversal" as const,sourceId:text(r.id),label:`Incentive reversal · ${text(r.scheme_code)}`,kind:"deduction" as const,amount:money(r.amount),policyVersion:`incentive_scheme:${text(r.scheme_code)}:v${Number(r.version)}`}))];}
export async function markIncentiveEntriesIncluded(db:Db,input:{entries:PayrollIncentiveEntry[];payrollRunId:string;payrollResultId:string;employeeId:string}){await ensureIncentiveTables(db);const now=Date.now();for(const e of input.entries)await db.prepare("INSERT INTO incentive_payroll_links (id,source_type,source_id,payroll_run_id,payroll_result_id,employee_id,amount,created_at) VALUES (?,?,?,?,?,?,?,?)").bind(uid("IPL"),e.sourceType,e.sourceId,input.payrollRunId,input.payrollResultId,input.employeeId,e.kind==="deduction"?-e.amount:e.amount,now).run();}
export async function incentiveDirectory(db:Db){await ensureIncentiveTables(db);const schemes=await db.prepare("SELECT * FROM incentive_scheme_versions ORDER BY scheme_code,version DESC").all<Row>(),periods=await db.prepare("SELECT p.*,s.scheme_code,s.version FROM employee_incentive_periods p JOIN incentive_scheme_versions s ON s.id=p.scheme_id ORDER BY p.period_end DESC LIMIT 24").all<Row>(),results=await db.prepare("SELECT r.*,p.period_start,p.period_end,s.scheme_code,s.version FROM employee_incentive_results r JOIN employee_incentive_periods p ON p.id=r.period_id JOIN incentive_scheme_versions s ON s.id=p.scheme_id ORDER BY p.period_end DESC,r.employee_id LIMIT 250").all<Row>(),disputes=await db.prepare("SELECT * FROM incentive_disputes WHERE status='open' ORDER BY opened_at DESC LIMIT 100").all<Row>();return{schemes:schemes.results,periods:periods.results,results:results.results,disputes:disputes.results,truth:{formulaValuesConfiguredNotHardcoded:true,pipelineRevenueEligible:false,humanApprovalRequired:true,payrollInclusionOneTime:true,productionReady:false}};}
