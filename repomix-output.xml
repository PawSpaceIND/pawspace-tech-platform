import type{FoodFulfilmentAction}from"./food-fulfilment-governance";
export type FoodOrderSnapshot=Record<string,unknown>&{id:string;customer_id:string;status:string;sku:string;item_name:string;quantity:number;fulfilment_status?:string|null;lot_id?:string|null;dispatch_reference?:string|null;events?:Array<Record<string,unknown>>;stockRecovery?:Record<string,unknown>|null;deliveryPayment?:Record<string,unknown>|null};
export async function loadFoodFulfilment(input:{orderId?:string;customerId?:string;scope?:"customer"}){const query=new URLSearchParams();if(input.orderId)query.set("orderId",input.orderId);if(input.customerId)query.set("customerId",input.customerId);if(input.scope)query.set("scope",input.scope);const response=await fetch(`/api/food-fulfilment?${query}`,{cache:"no-store"});const body=await response.json() as {data?:FoodOrderSnapshot[];error?:string};if(!response.ok||!body.data)throw new Error(body.error??"Unable to load Food fulfilment");return body.data}
export async function loadCustomerFoodOrder(orderId:string){return loadFoodFulfilment({orderId,scope:"customer"})}
export async function updateFoodFulfilment(input:{orderId:string;action:FoodFulfilmentAction;idempotencyKey:string;lotId?:string;dispatchReference?:string;handoverMethod?:"customer"|"building_staff";reason?:string}){const response=await fetch("/api/food-fulfilment",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(input)});const body=await response.json() as {data?:Record<string,unknown>;error?:string};if(!response.ok||!body.data)throw new Error(body.error??"Unable to update Food fulfilment");return body.data}
</file>

<file path="lib/food-fulfilment-governance.ts">
import{ensureFoodGovernanceTables}from"./food-governance";
type Row=Record<string,unknown>;
export type FoodFulfilmentAction="accept_order"|"pick_order"|"pack_order"|"dispatch_order"|"confirm_delivery"|"report_stock_issue";
export type FoodFulfilmentInput={orderId:string;action:FoodFulfilmentAction;actorId:string;idempotencyKey:string;lotId?:string;dispatchReference?:string;handoverMethod?:"customer"|"building_staff";reason?:string};
const parse=<T>(value:unknown,fallback:T):T=>{try{return JSON.parse(String(value??"")) as T}catch{return fallback}};
export async function ensureFoodFulfilmentTables(db:D1Database){await ensureFoodGovernanceTables(db);await db.batch([
 db.prepare("CREATE TABLE IF NOT EXISTS food_fulfilment_action_keys (idempotency_key TEXT PRIMARY KEY,order_id TEXT NOT NULL,action TEXT NOT NULL,result_json TEXT NOT NULL,created_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS food_uat_lots (id TEXT PRIMARY KEY,sku TEXT NOT NULL,zone_id TEXT NOT NULL,lot_label TEXT NOT NULL,expiry_date TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'uat_available',production_lot_verified INTEGER NOT NULL DEFAULT 0,created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS food_order_fulfilment (order_id TEXT PRIMARY KEY,status TEXT NOT NULL DEFAULT 'reserved',lot_id TEXT,dispatch_reference TEXT,delivery_adapter_status TEXT NOT NULL DEFAULT 'not_connected',handover_status TEXT NOT NULL DEFAULT 'pending',updated_by TEXT NOT NULL,created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS food_fulfilment_events (id TEXT PRIMARY KEY,order_id TEXT NOT NULL,event_type TEXT NOT NULL,actor_id TEXT NOT NULL,detail_json TEXT NOT NULL DEFAULT '{}',created_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS food_delivery_handover_events (order_id TEXT PRIMARY KEY,method TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'uat_confirmed',otp_status TEXT NOT NULL DEFAULT 'not_connected',confirmed_by TEXT NOT NULL,confirmed_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS food_stock_recovery_cases (id TEXT PRIMARY KEY,order_id TEXT NOT NULL,sku TEXT NOT NULL,reason TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'ops_review_required',substitution_allowed INTEGER NOT NULL DEFAULT 0,opened_by TEXT NOT NULL,opened_at INTEGER NOT NULL,resolved_at INTEGER,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS food_order_payment_events (id TEXT PRIMARY KEY,order_id TEXT NOT NULL UNIQUE,amount REAL NOT NULL,currency TEXT NOT NULL DEFAULT 'INR',status TEXT NOT NULL DEFAULT 'due',gateway TEXT NOT NULL DEFAULT 'uat_sandbox',reference TEXT,detail_json TEXT NOT NULL DEFAULT '{}',created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL)"),
]);const now=Date.now();for(const row of[["FLOT-DOG-A-01","food-uat-dog-adult-2kg","Dog Adult UAT lot A"],["FLOT-DOG-P-01","food-uat-dog-puppy-2kg","Dog Puppy UAT lot A"],["FLOT-CAT-A-01","food-uat-cat-adult-1kg","Cat Adult UAT lot A"]])await db.prepare("INSERT OR IGNORE INTO food_uat_lots (id,sku,zone_id,lot_label,expiry_date,status,production_lot_verified,created_at,updated_at) VALUES (?,?,'blr-east',?,'2027-12-31','uat_available',0,?,?)").bind(...row,now,now).run()}
async function context(db:D1Database,orderId:string){await ensureFoodFulfilmentTables(db);const row=await db.prepare("SELECT o.*,l.sku,l.item_name,l.quantity,l.unit_price,l.line_total,r.id reservation_id,r.status reservation_status,r.quantity reserved_quantity,f.status fulfilment_status,f.lot_id,f.dispatch_reference FROM food_orders o JOIN food_order_lines l ON l.order_id=o.id JOIN food_inventory_reservations r ON r.order_id=o.id LEFT JOIN food_order_fulfilment f ON f.order_id=o.id WHERE o.id=?").bind(orderId).first<Row>();if(!row)throw new Response("Canonical Food order not found",{status:404});return row}
async function prior(db:D1Database,key:string){const row=await db.prepare("SELECT result_json FROM food_fulfilment_action_keys WHERE idempotency_key=?").bind(key).first<Row>();return row?parse<Record<string,unknown>>(row.result_json,{}):null}
async function remember(db:D1Database,input:FoodFulfilmentInput,result:unknown){await db.prepare("INSERT INTO food_fulfilment_action_keys (idempotency_key,order_id,action,result_json,created_at) VALUES (?,?,?,?,?)").bind(input.idempotencyKey,input.orderId,input.action,JSON.stringify(result),Date.now()).run();return result}
async function event(db:D1Database,orderId:string,eventType:string,actorId:string,detail:unknown={}){await db.prepare("INSERT INTO food_fulfilment_events (id,order_id,event_type,actor_id,detail_json,created_at) VALUES (?,?,?,?,?,?)").bind(crypto.randomUUID(),orderId,eventType,actorId,JSON.stringify(detail),Date.now()).run()}
export async function listFoodOrders(db:D1Database,input:{customerId?:string;orderId?:string}){await ensureFoodFulfilmentTables(db);const where=["1=1"],binds:unknown[]=[];if(input.customerId){where.push("o.customer_id=?");binds.push(input.customerId)}if(input.orderId){where.push("o.id=?");binds.push(input.orderId)}const rows=await db.prepare(`SELECT o.*,l.sku,l.item_name,l.quantity,l.unit_price,l.line_total,r.status reservation_status,f.status fulfilment_status,f.lot_id,f.dispatch_reference,f.delivery_adapter_status,f.handover_status,p.status payment_status,p.amount_due_now FROM food_orders o JOIN food_order_lines l ON l.order_id=o.id JOIN food_inventory_reservations r ON r.order_id=o.id LEFT JOIN food_order_fulfilment f ON f.order_id=o.id LEFT JOIN food_order_payments p ON p.order_id=o.id WHERE ${where.join(" AND ")} ORDER BY o.created_at DESC`).bind(...binds).all<Row>(),out=[];for(const row of rows.results){const[events,stock,payment]=await Promise.all([db.prepare("SELECT * FROM food_fulfilment_events WHERE order_id=? ORDER BY created_at DESC LIMIT 50").bind(row.id).all<Row>(),db.prepare("SELECT * FROM food_stock_recovery_cases WHERE order_id=? ORDER BY opened_at DESC LIMIT 1").bind(row.id).first<Row>(),db.prepare("SELECT * FROM food_order_payment_events WHERE order_id=?").bind(row.id).first<Row>()]);out.push({...row,events:events.results.map(item=>({...item,detail:parse(item.detail_json,{})})),stockRecovery:stock??null,deliveryPayment:payment??null})}return out}
export async function mutateFoodFulfilment(db:D1Database,input:FoodFulfilmentInput){if(!input.orderId||!input.action||!input.actorId||!input.idempotencyKey)throw new Response("Order, action, actor and idempotency key are required",{status:400});await ensureFoodFulfilmentTables(db);const old=await prior(db,input.idempotencyKey);if(old)return{...old,duplicatePrevented:true};const order=await context(db,input.orderId),now=Date.now(),status=String(order.status),fulfilment=String(order.fulfilment_status||"reserved");
 if(input.action==="accept_order"){if(status!=="uat_reserved"||!["reserved","null"].includes(fulfilment)&&order.fulfilment_status)throw new Response("Food order is not awaiting fulfilment acceptance",{status:409});await db.batch([db.prepare("INSERT INTO food_order_fulfilment (order_id,status,lot_id,dispatch_reference,delivery_adapter_status,handover_status,updated_by,created_at,updated_at) VALUES (?,'accepted',NULL,NULL,'not_connected','pending',?,?,?) ON CONFLICT(order_id) DO UPDATE SET status='accepted',updated_by=excluded.updated_by,updated_at=excluded.updated_at").bind(order.id,input.actorId,now,now),db.prepare("UPDATE food_orders SET status='accepted',delivery_status='accepted',updated_at=? WHERE id=?").bind(now,order.id)]);await event(db,String(order.id),"fulfilment_accepted",input.actorId,{inventoryMode:"uat_seed",productionInventoryVerified:false});return remember(db,input,{orderId:order.id,status:"accepted"})}
 if(input.action==="pick_order"){if(fulfilment!=="accepted")throw new Response("Food order must be accepted before picking",{status:409});const lotId=String(input.lotId||"").trim(),lot=await db.prepare("SELECT * FROM food_uat_lots WHERE id=? AND sku=? AND zone_id=? AND status='uat_available'").bind(lotId,order.sku,order.zone_id).first<Row>();if(!lot)throw new Response("Select an available UAT lot for the exact ordered SKU and zone",{status:409});if(Number(lot.production_lot_verified)!==0)throw new Response("Food Gate 2 expects explicitly non-production UAT lot traceability",{status:409});await db.batch([db.prepare("UPDATE food_order_fulfilment SET status='picked',lot_id=?,updated_by=?,updated_at=? WHERE order_id=?").bind(lotId,input.actorId,now,order.id),db.prepare("UPDATE food_orders SET status='picked',delivery_status='picked',updated_at=? WHERE id=?").bind(now,order.id)]);await event(db,String(order.id),"food_picked",input.actorId,{lotId,productionLotVerified:false,sku:order.sku});return remember(db,input,{orderId:order.id,status:"picked",lotId,productionLotVerified:false})}
 if(input.action==="pack_order"){if(fulfilment!=="picked"||!order.lot_id)throw new Response("Picked UAT lot is required before packing",{status:409});const inventory=await db.prepare("SELECT * FROM food_inventory_uat WHERE sku=? AND zone_id=?").bind(order.sku,order.zone_id).first<Row>(),quantity=Number(order.quantity);if(!inventory||Number(inventory.reserved_units)<quantity||Number(inventory.available_units)<quantity)throw new Response("UAT Food inventory reservation is no longer packable",{status:409});await db.batch([db.prepare("UPDATE food_inventory_uat SET available_units=available_units-?,reserved_units=reserved_units-?,updated_at=? WHERE sku=? AND zone_id=?").bind(quantity,quantity,now,order.sku,order.zone_id),db.prepare("UPDATE food_inventory_reservations SET status='consumed',updated_at=? WHERE order_id=? AND status='reserved'").bind(now,order.id),db.prepare("UPDATE food_order_fulfilment SET status='packed',updated_by=?,updated_at=? WHERE order_id=?").bind(input.actorId,now,order.id),db.prepare("UPDATE food_orders SET status='packed',delivery_status='packed',updated_at=? WHERE id=?").bind(now,order.id)]);await event(db,String(order.id),"food_packed",input.actorId,{lotId:order.lot_id,quantity,inventoryMode:"uat_seed"});return remember(db,input,{orderId:order.id,status:"packed",inventoryReservation:"consumed",liveInventory:false})}
 if(input.action==="dispatch_order"){if(fulfilment!=="packed")throw new Response("Food order must be packed before dispatch",{status:409});const reference=String(input.dispatchReference||"").trim();if(reference.length<5||reference.includes("://"))throw new Response("An opaque UAT dispatch reference is required",{status:400});await db.batch([db.prepare("UPDATE food_order_fulfilment SET status='dispatched',dispatch_reference=?,delivery_adapter_status='not_connected',updated_by=?,updated_at=? WHERE order_id=?").bind(reference,input.actorId,now,order.id),db.prepare("UPDATE food_orders SET status='dispatched',delivery_status='sandbox_dispatched',updated_at=? WHERE id=?").bind(now,order.id)]);await event(db,String(order.id),"food_dispatched",input.actorId,{dispatchReference:reference,deliveryAdapterConnected:false});return remember(db,input,{orderId:order.id,status:"dispatched",dispatchReference:reference,deliveryAdapterConnected:false})}
 if(input.action==="confirm_delivery"){if(fulfilment!=="dispatched")throw new Response("Sandbox dispatch is required before Food delivery handover",{status:409});const method=input.handoverMethod;if(!method||!["customer","building_staff"].includes(method))throw new Response("A governed UAT Food delivery handover method is required",{status:400});const paymentEventId=crypto.randomUUID(),amount=Number(order.total_amount);await db.batch([db.prepare("INSERT INTO food_delivery_handover_events (order_id,method,status,otp_status,confirmed_by,confirmed_at) VALUES (?,?,'uat_confirmed','not_connected',?,?) ON CONFLICT(order_id) DO UPDATE SET method=excluded.method,status='uat_confirmed',confirmed_by=excluded.confirmed_by,confirmed_at=excluded.confirmed_at").bind(order.id,method,input.actorId,now),db.prepare("UPDATE food_order_fulfilment SET status='delivered',handover_status='uat_confirmed',updated_by=?,updated_at=? WHERE order_id=?").bind(input.actorId,now,order.id),db.prepare("UPDATE food_orders SET status='delivered',delivery_status='uat_delivered',updated_at=? WHERE id=?").bind(now,order.id),db.prepare("INSERT INTO food_order_payment_events (id,order_id,amount,currency,status,gateway,reference,detail_json,created_at,updated_at) VALUES (?,?,?,'INR','due','uat_sandbox',NULL,?,?,?)").bind(paymentEventId,order.id,amount,JSON.stringify({captureRequired:true,liveMoney:false,productionPaymentTimingPolicy:"pending",trigger:"canonical_food_uat_delivery"}),now,now)]);const dueEvent=await db.prepare("SELECT id FROM food_order_payment_events WHERE id=? AND order_id=? AND status='due'").bind(paymentEventId,order.id).first<Row>();if(!dueEvent)throw new Response("Food delivery payment event was not recorded as due",{status:500});await event(db,String(order.id),"food_delivered",input.actorId,{method,otpConnected:false,paymentEventId,paymentStatus:"due",liveMoney:false});return remember(db,input,{orderId:order.id,status:"delivered",handoverStatus:"uat_confirmed",otpConnected:false,paymentEventId,paymentStatus:"due",amount,liveMoney:false})}
 if(input.action==="report_stock_issue"){if(["packed","dispatched","delivered","cancelled"].includes(fulfilment))throw new Response("Packed/closed Food order cannot enter stock recovery",{status:409});const reason=String(input.reason||"").trim();if(reason.length<5)throw new Response("A Food stock recovery reason is required",{status:400});const recoveryId=crypto.randomUUID();await db.batch([db.prepare("INSERT INTO food_stock_recovery_cases (id,order_id,sku,reason,status,substitution_allowed,opened_by,opened_at,resolved_at,updated_at) VALUES (?,?,?,?, 'ops_review_required',0,?,?,NULL,?)").bind(recoveryId,order.id,order.sku,reason,input.actorId,now,now),db.prepare("INSERT INTO food_order_fulfilment (order_id,status,updated_by,created_at,updated_at) VALUES (?,'stock_recovery_required',?,?,?) ON CONFLICT(order_id) DO UPDATE SET status='stock_recovery_required',updated_by=excluded.updated_by,updated_at=excluded.updated_at").bind(order.id,input.actorId,now,now),db.prepare("UPDATE food_orders SET status='stock_recovery_required',delivery_status='ops_review_required',updated_at=? WHERE id=?").bind(now,order.id)]);await event(db,String(order.id),"stock_issue_reported",input.actorId,{recoveryId,reason,substitutionAllowed:false,priceChangeAllowed:false,orderPreserved:true});return remember(db,input,{orderId:order.id,status:"stock_recovery_required",recoveryId,substitutionAllowed:false,priceChangeAllowed:false,orderPreserved:true})}
 throw new Response("Unsupported Food fulfilment action",{status:400})}
</file>

