import{authError,authorize,database,securityAudit}from"../../../lib/server-auth";
import{activateIncentiveScheme,addIncentiveAdjustment,approveIncentiveAdjustment,approveIncentiveResult,calculateIncentivePeriod,incentiveDirectory,openIncentiveDispute,resolveIncentiveDispute,reverseIncentiveResult,saveIncentiveScheme}from"../../../lib/incentive-engine";
type Row=Record<string,unknown>;
const text=(v:unknown)=>String(v??"").trim();
export async function GET(request:Request){try{await authorize(request,"incentives.view");return Response.json({data:await incentiveDirectory(await database()),productionReady:false});}catch(error){return authError(error,"Unable to load incentives");}}
export async function POST(request:Request){try{const actor=await authorize(request,"incentives.manage"),db=await database(),body=await request.json() as Row,action=text(body.action);let result:unknown;if(action==="save_scheme")result=await saveIncentiveScheme(db,{schemeCode:text(body.schemeCode),roleCode:text(body.roleCode),teamCode:text(body.teamCode),effectiveFrom:Number(body.effectiveFrom),effectiveUntil:body.effectiveUntil==null?null:Number(body.effectiveUntil),formula:body.formula as never,qualityRules:Array.isArray(body.qualityRules)?body.qualityRules as never[]:[],actorId:actor.email});else if(action==="activate_scheme")result=await activateIncentiveScheme(db,{schemeId:text(body.schemeId),approvalReference:text(body.approvalReference),actorId:actor.email});else if(action==="calculate")result=await calculateIncentivePeriod(db,{schemeId:text(body.schemeId),periodStart:Number(body.periodStart),periodEnd:Number(body.periodEnd),idempotencyKey:text(body.idempotencyKey),actorId:actor.email});else if(action==="adjust")result=await addIncentiveAdjustment(db,{resultId:text(body.resultId),amount:Number(body.amount),reason:text(body.reason),actorId:actor.email});else if(action==="approve_adjustment")result=await approveIncentiveAdjustment(db,{adjustmentId:text(body.adjustmentId),actorId:actor.email});else if(action==="dispute")result=await openIncentiveDispute(db,{resultId:text(body.resultId),reason:text(body.reason),actorId:actor.email});else if(action==="resolve_dispute")result=await resolveIncentiveDispute(db,{disputeId:text(body.disputeId),resolutionNote:text(body.resolutionNote),actorId:actor.email,release:Boolean(body.release)});else if(action==="approve_result")result=await approveIncentiveResult(db,{resultId:text(body.resultId),actorId:actor.email});else if(action==="reverse")result=await reverseIncentiveResult(db,{resultId:text(body.resultId),amount:body.amount==null?null:Number(body.amount),reason:text(body.reason),effectiveAt:Number(body.effectiveAt),actorId:actor.email});else return Response.json({error:"Unknown incentive action"},{status:400});await securityAudit(db,actor,`incentive.${action}`,action.includes("scheme")?"incentive_scheme":"incentive_result",text(body.resultId)||text(body.schemeId)||null,"completed");return Response.json({data:result,productionReady:false});}catch(error){return authError(error,"Incentive update failed");}}
