<file path="lib/taxi-lifecycle.ts">
import{ensureTaxiGovernanceTables}from"./taxi-governance";
type Row=Record<string,unknown>;
export type TaxiAction="accept"|"decline"|"assign_vehicle"|"confirm_pickup"|"start_trip"|"trip_event"|"arrive_dropoff"|"confirm_dropoff"|"complete_trip"|"driver_unavailable"|"no_show";
export type TaxiMutation={bookingId:string;action:TaxiAction;actorId:string;idempotencyKey:string;vehicleId?:string;reason?:string;handoverMethod?:"owner"|"building_staff"|"clinic_staff";tripEventType?:string;detail?:Record<string,unknown>};
const parse=<T>(value:unknown,fallback:T):T=>{try{return JSON.parse(String(value??"")) as T}catch{return fallback}};
export async function ensureTaxiLifecycleTables(db:D1Database){await ensureTaxiGovernanceTables(db);await db.batch([
 db.prepare("CREATE TABLE IF NOT EXISTS taxi_trip_action_keys (idempotency_key TEXT PRIMARY KEY,booking_id TEXT NOT NULL,action TEXT NOT NULL,result_json TEXT NOT NULL,created_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS taxi_trip_events (id TEXT PRIMARY KEY,booking_id TEXT NOT NULL,trip_id TEXT NOT NULL,provider_id TEXT NOT NULL,event_type TEXT NOT NULL,actor_id TEXT NOT NULL,detail_json TEXT NOT NULL DEFAULT '{}',created_at INTEGER NOT NULL)"),
 db.prepare("CREATE INDEX IF NOT EXISTS idx_taxi_trip_events ON taxi_trip_events(booking_id,created_at)"),
 db.prepare("CREATE TABLE IF NOT EXISTS taxi_vehicle_profiles (id TEXT PRIMARY KEY,provider_id TEXT NOT NULL,label TEXT NOT NULL,vehicle_type TEXT NOT NULL,pet_restraint TEXT NOT NULL,inspection_status TEXT NOT NULL DEFAULT 'uat_verified',active INTEGER NOT NULL DEFAULT 1,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS taxi_pickup_handover_events (trip_id TEXT PRIMARY KEY,booking_id TEXT NOT NULL,provider_id TEXT NOT NULL,method TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'confirmed',otp_status TEXT NOT NULL DEFAULT 'not_connected',confirmed_by TEXT NOT NULL,confirmed_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS taxi_dropoff_handover_events (trip_id TEXT PRIMARY KEY,booking_id TEXT NOT NULL,provider_id TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'confirmed',otp_status TEXT NOT NULL DEFAULT 'not_connected',confirmed_by TEXT NOT NULL,confirmed_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS taxi_recovery_cases (id TEXT PRIMARY KEY,booking_id TEXT NOT NULL,trip_id TEXT NOT NULL,failed_provider_id TEXT NOT NULL,reason_code TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'ops_escalation',replacement_provider_id TEXT,detail_json TEXT NOT NULL DEFAULT '{}',opened_at INTEGER NOT NULL,resolved_at INTEGER,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS taxi_customer_notifications (id TEXT PRIMARY KEY,booking_id TEXT NOT NULL,customer_id TEXT,channel TEXT NOT NULL,template_code TEXT NOT NULL,message TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'queued',event_id TEXT NOT NULL,created_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS taxi_trip_payment_events (id TEXT PRIMARY KEY,booking_id TEXT NOT NULL UNIQUE,trip_id TEXT NOT NULL UNIQUE,amount REAL NOT NULL,currency TEXT NOT NULL DEFAULT 'INR',status TEXT NOT NULL DEFAULT 'due',gateway TEXT NOT NULL DEFAULT 'uat_sandbox',reference TEXT,detail_json TEXT NOT NULL DEFAULT '{}',created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL)"),
]);const now=Date.now();for(const row of[
 ["TXV-RAHUL-01","taxi_rahul","Rahul UAT vehicle","hatchback","rear-seat harness"],
 ["TXV-MEERA-01","taxi_meera","Meera UAT vehicle","sedan","rear-seat harness"],
 ["TXV-IMRAN-01","taxi_imran","Imran UAT vehicle","hatchback","secured carrier/harness"],
])await db.prepare("INSERT OR IGNORE INTO taxi_vehicle_profiles (id,provider_id,label,vehicle_type,pet_restraint,inspection_status,active,updated_at) VALUES (?,?,?,?,?,'uat_verified',1,?)").bind(...row,now).run();}
async function context(db:D1Database,bookingId:string){await ensureTaxiLifecycleTables(db);const row=await db.prepare("SELECT b.*,w.provider_id work_order_provider_id,w.status work_order_status,p.status payment_status,t.id trip_id,t.status trip_status,t.vehicle_id,t.pickup_verification_status,t.dropoff_verification_status,t.reservation_id FROM canonical_bookings b LEFT JOIN provider_work_orders w ON w.booking_id=b.id LEFT JOIN booking_payments p ON p.booking_id=b.id JOIN taxi_trips t ON t.booking_id=b.id WHERE b.id=? AND b.service_code='pet_taxi'").bind(bookingId).first<Row>();if(!row)throw new Response("Canonical Pet Taxi booking not found",{status:404});return row}
export async function getTaxiBooking(db:D1Database,bookingId:string){return context(db,bookingId)}
async function event(db:D1Database,b:Row,eventType:string,actorId:string,detail:unknown={}){const id=crypto.randomUUID();await db.prepare("INSERT INTO taxi_trip_events (id,booking_id,trip_id,provider_id,event_type,actor_id,detail_json,created_at) VALUES (?,?,?,?,?,?,?,?)").bind(id,b.id,b.trip_id,b.provider_id,eventType,actorId,JSON.stringify(detail),Date.now()).run();return id}
async function notify(db:D1Database,b:Row,eventId:string,message:string){for(const channel of["push","whatsapp"])await db.prepare("INSERT INTO taxi_customer_notifications (id,booking_id,customer_id,channel,template_code,message,status,event_id,created_at) VALUES (?,?,?,?,?,?,'queued',?,?)").bind(crypto.randomUUID(),b.id,b.customer_id,channel,"taxi_trip_update",message,eventId,Date.now()).run()}

// An idempotency key identifies ONE mutation of ONE record. This lookup used to match on the key alone
// and ran BEFORE the record was loaded, so a second caller reusing a key - a different provider, acting
// on a different customer's booking - was answered 200, had its mutation silently discarded, and
// received the FIRST caller's identifiers in the response body. The same collision swallowed a walker's
// decline with the earlier accept, so no recovery case opened and nobody learned the job had no
// provider. The columns needed to tell a replay from a collision were already being written here and
// simply never read back. Reused for a different record or a different action, a key is a CONFLICT and
// is refused rather than answered with somebody else's record. [PTJA-P1-F23]
async function prior(db:D1Database,key:string,bookingId:string,action:string){const row=await db.prepare("SELECT booking_id,action,result_json FROM taxi_trip_action_keys WHERE idempotency_key=?").bind(key).first<Row>();if(!row)return null;if(String(row.booking_id)!==String(bookingId)||String(row.action)!==String(action))throw new Response("An idempotency key identifies one action on one record; this key was already used for a different one",{status:409});return parse<Record<string,unknown>>(row.result_json,{})}
async function remember(db:D1Database,input:TaxiMutation,result:unknown){await db.prepare("INSERT INTO taxi_trip_action_keys (idempotency_key,booking_id,action,result_json,created_at) VALUES (?,?,?,?,?)").bind(input.idempotencyKey,input.bookingId,input.action,JSON.stringify(result),Date.now()).run();return result}
export async function listTaxiBookings(db:D1Database,input:{providerId?:string;customerId?:string;bookingId?:string}){await ensureTaxiLifecycleTables(db);const where=["b.service_code='pet_taxi'"],binds:unknown[]=[];if(input.providerId){where.push("b.provider_id=?");binds.push(input.providerId)}if(input.customerId){where.push("b.customer_id=?");binds.push(input.customerId)}if(input.bookingId){where.push("b.id=?");binds.push(input.bookingId)}const rows=await db.prepare(`SELECT b.*,w.status work_order_status,w.provider_name,p.status payment_status,t.id trip_id,t.status trip_status,t.vehicle_id,t.origin_label,t.destination_label,t.route_code,t.synthetic_distance_km,t.estimated_duration_minutes,t.pickup_verification_status,t.dropoff_verification_status FROM canonical_bookings b LEFT JOIN provider_work_orders w ON w.booking_id=b.id LEFT JOIN booking_payments p ON p.booking_id=b.id JOIN taxi_trips t ON t.booking_id=b.id WHERE ${where.join(" AND ")} ORDER BY b.scheduled_start DESC`).bind(...binds).all<Row>(),out=[];for(const booking of rows.results){const[events,recovery,payment]=await Promise.all([db.prepare("SELECT * FROM taxi_trip_events WHERE booking_id=? ORDER BY created_at DESC LIMIT 50").bind(booking.id).all<Row>(),db.prepare("SELECT * FROM taxi_recovery_cases WHERE booking_id=? ORDER BY opened_at DESC LIMIT 1").bind(booking.id).first<Row>(),db.prepare("SELECT * FROM taxi_trip_payment_events WHERE booking_id=?").bind(booking.id).first<Row>()]);out.push({...booking,events:events.results.map(item=>({...item,detail:parse(item.detail_json,{})})),recovery:recovery??null,tripPayment:payment??null})}return out}
export async function mutateTaxiBooking(db:D1Database,input:TaxiMutation){if(!input.bookingId||!input.action||!input.actorId||!input.idempotencyKey)throw new Response("Booking, action, actor and idempotency key are required",{status:400});await ensureTaxiLifecycleTables(db);const old=await prior(db,input.idempotencyKey,input.bookingId,input.action);if(old)return{...old,duplicatePrevented:true};const b=await context(db,input.bookingId),now=Date.now(),bookingStatus=String(b.status),tripStatus=String(b.trip_status),groupId=String(b.schedule_group_id||"");
 if(input.action==="accept"){
  // Replacement offers (reassignment_offered) must go through acceptTaxiReplacement, which verifies
  // recovery case, trip, reservation and vehicle and marks the case replacement_accepted.
  if(bookingStatus!=="confirmed")throw new Response("Pet Taxi booking is not awaiting driver acceptance",{status:409});if(String(b.provider_id)!==String(b.work_order_provider_id))throw new Response("Taxi driver no longer matches the canonical work order",{status:409});const offer=await db.prepare("SELECT * FROM provider_assignment_offers WHERE group_id=?").bind(groupId).first<Row>();if(offer){if(String(offer.provider_id)!==String(b.provider_id)||String(offer.status)!=="pending")throw new Response("No pending Taxi driver offer is available",{status:409});if(Number(offer.expires_at)<now)throw new Response("Taxi driver acceptance offer expired; Operations recovery is required",{status:409})}const statements=[db.prepare("UPDATE canonical_bookings SET status='assigned',updated_at=? WHERE id=?").bind(now,b.id),db.prepare("UPDATE provider_work_orders SET status='accepted',updated_at=? WHERE booking_id=?").bind(now,b.id),db.prepare("UPDATE taxi_trips SET status='accepted',updated_at=? WHERE booking_id=?").bind(now,b.id)];if(offer)statements.push(db.prepare("UPDATE provider_assignment_offers SET status='accepted',responded_at=?,response_reason='Accepted in Driver workspace',updated_at=? WHERE group_id=?").bind(now,now,groupId));await db.batch(statements);const eventId=await event(db,b,"driver_accepted",input.actorId,{providerId:b.provider_id});await notify(db,b,eventId,"Your PawSpace Pet Taxi driver accepted the canonical trip. Booking ID and pickup window are unchanged.");return remember(db,input,{bookingId:b.id,tripId:b.trip_id,status:"assigned"})
 }
 if(input.action==="decline"||input.action==="driver_unavailable"||input.action==="no_show"){
  const reason=String(input.reason||"").trim();if(reason.length<3)throw new Response("A Pet Taxi recovery reason is required",{status:400});if(["in_progress","arrived_dropoff","dropoff_confirmed","completed"].includes(tripStatus))throw new Response("Active/closed Pet Taxi trips require the safety incident workflow, not reassignment",{status:409});const recoveryId=crypto.randomUUID();await db.batch([db.prepare("UPDATE canonical_bookings SET status='reassignment_needed',updated_at=? WHERE id=?").bind(now,b.id),db.prepare("UPDATE provider_work_orders SET status='recovery_pending',updated_at=? WHERE booking_id=?").bind(now,b.id),db.prepare("UPDATE taxi_trips SET status='recovery_pending',updated_at=? WHERE booking_id=?").bind(now,b.id),db.prepare("UPDATE scheduling_reservations SET status='cancelled' WHERE group_id=? AND status NOT IN ('completed','cancelled')").bind(groupId),db.prepare("UPDATE scheduling_assignment_decisions SET status='reassignment_needed',actor_id=?,reason=?,updated_at=? WHERE group_id=?").bind(input.actorId,reason,now,groupId),db.prepare("UPDATE provider_assignment_offers SET status=?,responded_at=?,response_reason=?,updated_at=? WHERE group_id=? AND status='pending'").bind(input.action==="decline"?"declined":"cancelled",now,reason,now,groupId),db.prepare("INSERT INTO taxi_recovery_cases (id,booking_id,trip_id,failed_provider_id,reason_code,status,replacement_provider_id,detail_json,opened_at,resolved_at,updated_at) VALUES (?,?,?,?,?,'ops_escalation',NULL,?,?,NULL,?)").bind(recoveryId,b.id,b.trip_id,b.provider_id,input.action,JSON.stringify({reason,bookingPreserved:true,routePreserved:true}),now,now)]);const eventId=await event(db,b,`driver_${input.action}`,input.actorId,{reason,recoveryId,bookingPreserved:true});await notify(db,b,eventId,"Your Pet Taxi trip needs driver recovery. PawSpace Operations is protecting the same booking and pickup/drop-off request while a replacement is arranged.");return remember(db,input,{bookingId:b.id,tripId:b.trip_id,status:"ops_escalation",recoveryId,bookingPreserved:true})
 }
 if(input.action==="assign_vehicle"){
  if(bookingStatus!=="assigned"||!['accepted','vehicle_assigned'].includes(tripStatus))throw new Response("Driver acceptance is required before vehicle assignment",{status:409});const vehicleId=String(input.vehicleId||"").trim(),vehicle=await db.prepare("SELECT * FROM taxi_vehicle_profiles WHERE id=? AND provider_id=? AND active=1").bind(vehicleId,b.provider_id).first<Row>();if(!vehicle||String(vehicle.inspection_status)!=="uat_verified")throw new Response("Select an active UAT-verified vehicle owned by this driver",{status:409});await db.prepare("UPDATE taxi_trips SET vehicle_id=?,status='vehicle_assigned',updated_at=? WHERE booking_id=?").bind(vehicleId,now,b.id).run();await event(db,b,"vehicle_assigned",input.actorId,{vehicleId,label:vehicle.label,vehicleType:vehicle.vehicle_type,petRestraint:vehicle.pet_restraint,productionVehicleVerification:false});return remember(db,input,{bookingId:b.id,tripId:b.trip_id,status:"vehicle_assigned",vehicleId,productionVehicleVerification:false})
 }
 if(input.action==="confirm_pickup"){
  if(tripStatus!=="vehicle_assigned"||!b.vehicle_id)throw new Response("UAT-verified vehicle assignment is required before pickup handover",{status:409});const method=input.handoverMethod;if(!method||!["owner","building_staff","clinic_staff"].includes(method))throw new Response("A governed Pet Taxi pickup handover method is required",{status:400});await db.batch([db.prepare("INSERT INTO taxi_pickup_handover_events (trip_id,booking_id,provider_id,method,status,otp_status,confirmed_by,confirmed_at) VALUES (?,?,?,?,'confirmed','not_connected',?,?) ON CONFLICT(trip_id) DO UPDATE SET provider_id=excluded.provider_id,method=excluded.method,status='confirmed',confirmed_by=excluded.confirmed_by,confirmed_at=excluded.confirmed_at").bind(b.trip_id,b.id,b.provider_id,method,input.actorId,now),db.prepare("UPDATE taxi_trips SET status='pickup_confirmed',pickup_verification_status='uat_confirmed',updated_at=? WHERE booking_id=?").bind(now,b.id)]);await event(db,b,"pickup_confirmed",input.actorId,{method,otpConnected:false,productionIdentityVerification:false});return remember(db,input,{bookingId:b.id,tripId:b.trip_id,status:"pickup_confirmed",otpConnected:false})
 }
 if(input.action==="start_trip"){
  if(tripStatus!=="pickup_confirmed")throw new Response("Confirmed pickup handover is required before Pet Taxi trip start",{status:409});await db.batch([db.prepare("UPDATE taxi_trips SET status='in_progress',updated_at=? WHERE booking_id=?").bind(now,b.id),db.prepare("UPDATE canonical_bookings SET status='in_progress',updated_at=? WHERE id=?").bind(now,b.id)]);const eventId=await event(db,b,"trip_started",input.actorId,{productionGpsConnected:false});await notify(db,b,eventId,"Your PawSpace Pet Taxi trip has started. Production live GPS is not connected in UAT yet.");return remember(db,input,{bookingId:b.id,tripId:b.trip_id,status:"in_progress",productionGpsConnected:false})
 }
 if(input.action==="trip_event"){
  if(tripStatus!=="in_progress")throw new Response("Pet Taxi trip events require an active trip",{status:409});const eventType=String(input.tripEventType||"").trim();if(!["pet_settled","water_break","customer_update"].includes(eventType))throw new Response("Route, location, photo and incident evidence must use the governed Taxi proof workflow",{status:409});const eventId=await event(db,b,`trip_${eventType}`,input.actorId,input.detail??{});return remember(db,input,{bookingId:b.id,tripId:b.trip_id,status:"logged",eventId,eventType})
 }
 if(input.action==="arrive_dropoff"){
  if(tripStatus!=="in_progress")throw new Response("Only an active Pet Taxi trip can arrive at drop-off",{status:409});await db.prepare("UPDATE taxi_trips SET status='arrived_dropoff',updated_at=? WHERE booking_id=?").bind(now,b.id).run();const eventId=await event(db,b,"arrived_dropoff",input.actorId,{productionGpsConnected:false});await notify(db,b,eventId,"Your PawSpace Pet Taxi has reached the requested drop-off. Drop-off handover confirmation is next.");return remember(db,input,{bookingId:b.id,tripId:b.trip_id,status:"arrived_dropoff"})
 }
 if(input.action==="confirm_dropoff"){
  if(tripStatus!=="arrived_dropoff")throw new Response("Drop-off arrival is required before handover confirmation",{status:409});await db.batch([db.prepare("INSERT INTO taxi_dropoff_handover_events (trip_id,booking_id,provider_id,status,otp_status,confirmed_by,confirmed_at) VALUES (?,?,?,'confirmed','not_connected',?,?) ON CONFLICT(trip_id) DO UPDATE SET provider_id=excluded.provider_id,status='confirmed',confirmed_by=excluded.confirmed_by,confirmed_at=excluded.confirmed_at").bind(b.trip_id,b.id,b.provider_id,input.actorId,now),db.prepare("UPDATE taxi_trips SET status='dropoff_confirmed',dropoff_verification_status='uat_confirmed',updated_at=? WHERE booking_id=?").bind(now,b.id)]);await event(db,b,"dropoff_confirmed",input.actorId,{otpConnected:false,productionIdentityVerification:false});return remember(db,input,{bookingId:b.id,tripId:b.trip_id,status:"dropoff_confirmed",otpConnected:false})
 }
 if(input.action==="complete_trip"){
  if(tripStatus!=="dropoff_confirmed")throw new Response("Confirmed drop-off handover is required before Pet Taxi completion",{status:409});const route=await db.prepare("SELECT COUNT(*) count FROM taxi_trip_events WHERE booking_id=? AND trip_id=? AND event_type='route_location_sample'").bind(b.id,b.trip_id).first<{count:number}>(),routeSamples=Number(route?.count||0);if(routeSamples<2)throw new Response("Pet Taxi UAT completion requires at least two canonical sandbox route samples",{status:409});const amount=Number(b.total_amount);if(!Number.isFinite(amount)||amount<=0)throw new Response("Canonical Pet Taxi amount is missing",{status:409});const paymentEventId=crypto.randomUUID();await db.batch([db.prepare("UPDATE taxi_trips SET status='completed',updated_at=? WHERE booking_id=?").bind(now,b.id),db.prepare("UPDATE canonical_bookings SET status='completed',updated_at=? WHERE id=?").bind(now,b.id),db.prepare("UPDATE provider_work_orders SET status='completed',updated_at=? WHERE booking_id=?").bind(now,b.id),db.prepare("UPDATE scheduling_reservations SET status='completed' WHERE id=?").bind(b.reservation_id),db.prepare("INSERT INTO taxi_trip_payment_events (id,booking_id,trip_id,amount,currency,status,gateway,reference,detail_json,created_at,updated_at) VALUES (?,?,?,?,'INR','due','uat_sandbox',NULL,?,?,?)").bind(paymentEventId,b.id,b.trip_id,amount,JSON.stringify({captureRequired:true,liveMoney:false,trigger:"canonical_taxi_completion",productionPaymentTimingPolicy:"pending"}),now,now)]);const dueEvent=await db.prepare("SELECT id FROM taxi_trip_payment_events WHERE id=? AND status='due'").bind(paymentEventId).first<Row>();if(!dueEvent)throw new Response("Pet Taxi completion payment event was not recorded as due",{status:500});const eventId=await event(db,b,"trip_completed",input.actorId,{paymentEventId,amount,paymentStatus:"due",liveMoney:false,routeSamples,productionPaymentTimingPolicy:"pending"});await notify(db,b,eventId,"Your PawSpace Pet Taxi trip is complete. The UAT payment ledger now shows payment due; no live charge was made.");return remember(db,input,{bookingId:b.id,tripId:b.trip_id,status:"completed",paymentEventId,paymentStatus:"due",amount,routeSamples,liveMoney:false})
 }
 throw new Response("Unsupported Pet Taxi lifecycle action",{status:400})}
</file>

