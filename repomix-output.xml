import{authError,database,requireCustomerOwnership,requirePermission,requireProviderOwnership,resolveActor,securityAudit}from"../../../lib/server-auth";
import{hasPermission}from"../../../lib/platform-security";
import{getBoardingStay}from"../../../lib/boarding-stay-lifecycle";
import{getBoardingProofSnapshot,mutateBoardingProof,type BoardingProofAction,type BoardingProofInput}from"../../../lib/boarding-proof-governance";

type Body=Omit<BoardingProofInput,"actorId">;
const json=(value:unknown,status=200)=>Response.json(value,{status});
const providerActions=new Set<BoardingProofAction>(["prepare_media","record_daily_update","record_medication","report_incident"]);
const staffActions=new Set<BoardingProofAction>(["sandbox_finalize_media","record_media_scan","revoke_media","resolve_incident"]);
const customerActions=new Set<BoardingProofAction>(["acknowledge_incident"]);

export async function GET(request:Request){try{const url=new URL(request.url),stayId=String(url.searchParams.get("stayId")||"").trim(),scope=String(url.searchParams.get("scope")||"provider");if(!stayId)return json({error:"Stay ID is required"},400);const db=await database(),actor=await resolveActor(request),stay=await getBoardingStay(db,stayId);if(!stay)return json({error:"Boarding stay not found"},404);if(scope==="customer"){requirePermission(actor,"scheduling.book");await requireCustomerOwnership(db,actor,String(stay.customer_id));}else if(hasPermission(actor.permissions,"bookings.manage")){requirePermission(actor,"bookings.view");}else{requirePermission(actor,"bookings.view");await requireProviderOwnership(db,actor,String(stay.host_provider_id));}const data=await getBoardingProofSnapshot(db,stayId);return json({data,scope,sandboxOnly:true});}catch(error){return authError(error,"Unable to load Boarding proof records");}}

export async function POST(request:Request){try{const body=await request.json() as Body,stayId=String(body.stayId||"").trim(),action=body.action,idempotencyKey=String(body.idempotencyKey||"").trim();if(!stayId||!action||!idempotencyKey)return json({error:"Stay, action and idempotency key are required"},400);const db=await database(),actor=await resolveActor(request),stay=await getBoardingStay(db,stayId);if(!stay)return json({error:"Boarding stay not found"},404);if(providerActions.has(action)){requirePermission(actor,"bookings.view");if(!hasPermission(actor.permissions,"bookings.manage"))await requireProviderOwnership(db,actor,String(stay.host_provider_id));}else if(customerActions.has(action)){requirePermission(actor,"scheduling.book");await requireCustomerOwnership(db,actor,String(stay.customer_id));}else if(staffActions.has(action)){requirePermission(actor,"bookings.manage");}else return json({error:"Unsupported Boarding proof action"},400);const result=await mutateBoardingProof(db,{...body,stayId,action,idempotencyKey,actorId:actor.email});await securityAudit(db,actor,`boarding.proof.${action}`,"boarding_stay",stayId,"completed",{bookingId:stay.booking_id,providerId:stay.host_provider_id,customerId:stay.customer_id,sandboxOnly:true,duplicatePrevented:Boolean((result as Record<string,unknown>).duplicatePrevented)});return json({data:result,sandboxOnly:true},action==="report_incident"?202:200);}catch(error){return authError(error,"Unable to update Boarding proof records");}}
</file>

