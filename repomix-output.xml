import{authError,authorize,database,securityAudit}from"../../../lib/server-auth";
import{addSettlementAdjustment,approveSettlement,approveSettlementPolicy,createSandboxPayoutInstruction,ensurePartnerSettlementTables,refreshPartnerSettlementStatements}from"../../../lib/partner-settlement-governance";
import{approveOrderCommission,confirmOrderCommission,getProviderCommissionDashboard,overrideOrderCommission,saveProviderCompensationProfile,type CommissionMode,type EngagementModel}from"../../../lib/provider-commission-governance";
type Body={action?:string;statementId?:string;type?:"incentive"|"deduction"|"reversal"|"manual_correction";amount?:number;reason?:string;idempotencyKey?:string;providerId?:string;engagementModel?:EngagementModel;commissionMode?:CommissionMode;commissionValue?:number;razorpayxContactId?:string;razorpayxFundAccountId?:string;bookingId?:string};
const json=(value:unknown,status=200)=>Response.json(value,{status,headers:{"cache-control":"no-store"}});function sameOrigin(r:Request){const o=r.headers.get("origin");if(o&&o!==new URL(r.url).origin)throw new Response("Cross-origin partner finance write blocked",{status:403});}
export async function GET(request:Request){try{await authorize(request,"finance.view");const db=await database();await ensurePartnerSettlementTables(db);const period=new URL(request.url).searchParams.get("period")||new Date().toISOString().slice(0,7);await refreshPartnerSettlementStatements(db,period);const [statements,payouts,commission]=await Promise.all([db.prepare("SELECT * FROM partner_settlement_statements WHERE period_code=? ORDER BY provider_id").bind(period).all(),db.prepare("SELECT * FROM partner_payout_instructions ORDER BY updated_at DESC LIMIT 100").all(),getProviderCommissionDashboard(db)]);return json({data:{period,statements:statements.results,payouts:payouts.results,commission,source:"canonical_partner_settlement",livePayouts:false}});}catch(error){return authError(error,"Unable to load partner finance");}}
export async function POST(request:Request){try{sameOrigin(request);const actor=await authorize(request,"finance.manage"),body=await request.json() as Body,db=await database();await ensurePartnerSettlementTables(db);
 if(body.action==="save_provider_profile"){if(!body.providerId||!body.engagementModel||!body.reason)return json({error:"Provider, engagement model and reason are required"},400);const data=await saveProviderCompensationProfile(db,{providerId:body.providerId,engagementModel:body.engagementModel,commissionMode:body.commissionMode,commissionValue:body.commissionValue,razorpayxContactId:body.razorpayxContactId,razorpayxFundAccountId:body.razorpayxFundAccountId,reason:body.reason,actor:actor.email});await securityAudit(db,actor,"partner.compensation.profile","provider",body.providerId,"completed",{engagementModel:body.engagementModel,commissionMode:body.commissionMode,commissionValue:body.commissionValue,liveMoney:false});return json({data});}
 if(body.action==="override_order_commission"){if(!body.bookingId||!body.commissionMode||!Number.isFinite(body.commissionValue)||!body.reason)return json({error:"Booking, commission mode/value and reason are required"},400);const data=await overrideOrderCommission(db,{bookingId:body.bookingId,mode:body.commissionMode,value:Number(body.commissionValue),reason:body.reason,actor:actor.email});await securityAudit(db,actor,"partner.commission.override","booking",body.bookingId,"completed",{mode:body.commissionMode,value:body.commissionValue});return json({data});}
 if(body.action==="confirm_order_commission"){if(!body.bookingId)return json({error:"Booking ID is required"},400);const data=await confirmOrderCommission(db,{bookingId:body.bookingId,actor:actor.email});await securityAudit(db,actor,"partner.commission.confirm","booking",body.bookingId,"completed",{dueAt:data.dueAt});return json({data});}
 if(body.action==="approve_order_commission_level_1"){if(!body.bookingId)return json({error:"Booking ID is required"},400);const data=await approveOrderCommission(db,{bookingId:body.bookingId,level:1,actor:actor.email});await securityAudit(db,actor,"partner.commission.approve.level1","booking",body.bookingId,"completed",{});return json({data});}
 if(body.action==="approve_order_commission_level_2"){if(!body.bookingId)return json({error:"Booking ID is required"},400);const data=await approveOrderCommission(db,{bookingId:body.bookingId,level:2,actor:actor.email,idempotencyKey:body.idempotencyKey});await securityAudit(db,actor,"partner.commission.approve.level2","booking",body.bookingId,"completed",{payoutId:data.payoutId,rail:"razorpayx",environment:"sandbox",liveMoney:false});return json({data});}
 if(body.action==="adjust"){if(!body.statementId||!body.type||!Number.isFinite(body.amount)||!body.reason)return json({error:"Complete adjustment details are required"},400);const data=await addSettlementAdjustment(db,{statementId:body.statementId,type:body.type,amount:Number(body.amount),reason:body.reason,actor:actor.email});await securityAudit(db,actor,"partner.settlement.adjust","partner_settlement",body.statementId,"completed",{adjustmentId:data.id,type:body.type,amount:body.amount});return json({data},201);}if(body.action==="approve_policy"){if(!body.statementId||!body.reason)return json({error:"Statement ID and reason are required"},400);const data=await approveSettlementPolicy(db,{statementId:body.statementId,reason:body.reason,actor:actor.email});await securityAudit(db,actor,"partner.settlement.policy_approve","partner_settlement",body.statementId,"completed",{reason:body.reason});return json({data},data.duplicatePrevented?200:201);}if(body.action==="approve"){if(!body.statementId)return json({error:"Statement ID is required"},400);const data=await approveSettlement(db,{statementId:body.statementId,actor:actor.email});await securityAudit(db,actor,"partner.settlement.approve","partner_settlement",body.statementId,"completed",{});return json({data});}if(body.action==="sandbox_payout"){if(!body.statementId||!body.idempotencyKey)return json({error:"Statement and idempotency key are required"},400);const data=await createSandboxPayoutInstruction(db,{statementId:body.statementId,idempotencyKey:body.idempotencyKey,actor:actor.email});await securityAudit(db,actor,"partner.payout.prepare","partner_settlement",body.statementId,"completed",{environment:"sandbox",liveMoney:false});return json({data},data.duplicatePrevented?200:201);}return json({error:"Unsupported partner finance action"},400);}catch(error){if(error instanceof Response)return json({error:await error.text()},error.status);return authError(error,"Unable to update partner finance");}}
