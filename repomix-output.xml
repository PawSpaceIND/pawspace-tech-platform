type Db=D1Database;
type Row=Record<string,unknown>;
export type OpportunityStatus="ready"|"suppressed"|"review_required"|"converted"|"closed";
export type SuppressionReason="marketing_consent_missing"|"channel_consent_missing"|"customer_opted_out"|"open_complaint_or_safety_issue"|"unresolved_refund_or_payment_issue"|"duplicate_review_required"|"customer_data_quality_low"|"frequency_cap_reached"|"quiet_hours"|"identity_unavailable";

const text=(value:unknown)=>String(value??"").trim();
const uid=(prefix:string)=>`${prefix}-${crypto.randomUUID().slice(0,12).toUpperCase()}`;
const phone=(value:unknown)=>text(value).replace(/\D/g,"").slice(-10);
const email=(value:unknown)=>text(value).toLowerCase();
const json=(value:unknown)=>{try{return JSON.parse(String(value||"{}")) as Record<string,unknown>}catch{return{} as Record<string,unknown>}};

export async function ensureRevenueOpportunityTables(db:Db){await db.batch([
 db.prepare("CREATE TABLE IF NOT EXISTS customer_contact_preferences (customer_id TEXT PRIMARY KEY,marketing_consent INTEGER NOT NULL DEFAULT 0,service_consent INTEGER NOT NULL DEFAULT 1,whatsapp_consent INTEGER NOT NULL DEFAULT 0,sms_consent INTEGER NOT NULL DEFAULT 0,email_consent INTEGER NOT NULL DEFAULT 0,opt_out INTEGER NOT NULL DEFAULT 0,source TEXT NOT NULL DEFAULT 'customer',updated_by TEXT NOT NULL,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS customer_merge_reviews (id TEXT PRIMARY KEY,primary_customer_id TEXT NOT NULL,duplicate_customer_id TEXT NOT NULL,match_reason TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'open',reviewed_by TEXT,reviewed_at INTEGER,created_at INTEGER NOT NULL)"),
 db.prepare("CREATE UNIQUE INDEX IF NOT EXISTS customer_merge_pair_idx ON customer_merge_reviews(primary_customer_id,duplicate_customer_id)"),
 db.prepare("CREATE TABLE IF NOT EXISTS revenue_opportunity_policies (id TEXT PRIMARY KEY,name TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'draft',version INTEGER NOT NULL DEFAULT 1,timezone TEXT NOT NULL,quiet_start_minute INTEGER,quiet_end_minute INTEGER,max_outreach_per_customer_window INTEGER NOT NULL,frequency_window_hours INTEGER NOT NULL,data_quality_min_score INTEGER NOT NULL,require_marketing_consent INTEGER NOT NULL DEFAULT 1,effective_from INTEGER NOT NULL,effective_until INTEGER,approval_reference TEXT,created_by TEXT NOT NULL,created_at INTEGER NOT NULL,updated_by TEXT NOT NULL,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS revenue_opportunity_policy_versions (id TEXT PRIMARY KEY,policy_id TEXT NOT NULL,version INTEGER NOT NULL,snapshot_json TEXT NOT NULL,reason TEXT NOT NULL,actor_id TEXT NOT NULL,created_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS canonical_revenue_opportunities (id TEXT PRIMARY KEY,idempotency_key TEXT NOT NULL UNIQUE,customer_id TEXT NOT NULL,opportunity_type TEXT NOT NULL,service_code TEXT,reason TEXT NOT NULL,status TEXT NOT NULL,preferred_channel TEXT NOT NULL,estimated_value REAL NOT NULL DEFAULT 0,confidence REAL NOT NULL DEFAULT 0,signal_snapshot_json TEXT NOT NULL,suppression_reasons_json TEXT NOT NULL DEFAULT '[]',policy_id TEXT NOT NULL,policy_version INTEGER NOT NULL,source_key TEXT NOT NULL,converted_booking_id TEXT,created_by TEXT NOT NULL,created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL,UNIQUE(customer_id,source_key,policy_id,policy_version))"),
 db.prepare("CREATE TABLE IF NOT EXISTS revenue_opportunity_events (id TEXT PRIMARY KEY,opportunity_id TEXT NOT NULL,event_type TEXT NOT NULL,actor_id TEXT NOT NULL,detail_json TEXT NOT NULL DEFAULT '{}',created_at INTEGER NOT NULL)"),
 db.prepare("CREATE INDEX IF NOT EXISTS revenue_opportunity_customer_status_idx ON canonical_revenue_opportunities(customer_id,status,created_at)"),
]);}

function policySnapshot(row:Row){return{id:text(row.id),name:text(row.name),status:text(row.status),version:Number(row.version||1),timezone:text(row.timezone),quietStartMinute:row.quiet_start_minute==null?null:Number(row.quiet_start_minute),quietEndMinute:row.quiet_end_minute==null?null:Number(row.quiet_end_minute),maxOutreachPerCustomerWindow:Number(row.max_outreach_per_customer_window),frequencyWindowHours:Number(row.frequency_window_hours),dataQualityMinScore:Number(row.data_quality_min_score),requireMarketingConsent:Number(row.require_marketing_consent)===1,effectiveFrom:Number(row.effective_from),effectiveUntil:row.effective_until==null?null:Number(row.effective_until),approvalReference:row.approval_reference?text(row.approval_reference):null};}
function validMinute(value:number|null){return value==null||(Number.isInteger(value)&&value>=0&&value<1440);}
function validatePolicy(input:{name:string;timezone:string;quietStartMinute:number|null;quietEndMinute:number|null;maxOutreachPerCustomerWindow:number;frequencyWindowHours:number;dataQualityMinScore:number;effectiveFrom:number;effectiveUntil:number|null}){if(input.name.trim().length<3||!input.timezone.trim())throw new Error("Opportunity policy name and timezone are required");if(!validMinute(input.quietStartMinute)||!validMinute(input.quietEndMinute))throw new Error("Quiet-hour minute values must be between 0 and 1439");if((input.quietStartMinute==null)!==(input.quietEndMinute==null))throw new Error("Quiet hours require both start and end");if(!Number.isInteger(input.maxOutreachPerCustomerWindow)||input.maxOutreachPerCustomerWindow<1)throw new Error("Frequency cap must be a positive integer");if(!Number.isInteger(input.frequencyWindowHours)||input.frequencyWindowHours<1)throw new Error("Frequency window hours must be positive");if(!Number.isInteger(input.dataQualityMinScore)||input.dataQualityMinScore<0||input.dataQualityMinScore>100)throw new Error("Data quality threshold must be 0-100");if(!Number.isFinite(input.effectiveFrom)||input.effectiveFrom<=0)throw new Error("Opportunity policy effective-from is required");if(input.effectiveUntil!=null&&input.effectiveUntil<=input.effectiveFrom)throw new Error("Opportunity policy effective-until must be after effective-from");}
async function versionPolicy(db:Db,row:Row,reason:string,actorId:string){await db.prepare("INSERT INTO revenue_opportunity_policy_versions (id,policy_id,version,snapshot_json,reason,actor_id,created_at) VALUES (?,?,?,?,?,?,?)").bind(uid("ROPV"),row.id,row.version,JSON.stringify(policySnapshot(row)),reason,actorId,Date.now()).run();}

export async function saveRevenueOpportunityPolicy(db:Db,input:{id?:string;name:string;timezone:string;quietStartMinute?:number|null;quietEndMinute?:number|null;maxOutreachPerCustomerWindow:number;frequencyWindowHours:number;dataQualityMinScore:number;requireMarketingConsent:boolean;effectiveFrom:number;effectiveUntil?:number|null;reason:string;actorId:string}){await ensureRevenueOpportunityTables(db);const normalized={name:input.name.trim(),timezone:input.timezone.trim(),quietStartMinute:input.quietStartMinute==null?null:Number(input.quietStartMinute),quietEndMinute:input.quietEndMinute==null?null:Number(input.quietEndMinute),maxOutreachPerCustomerWindow:Number(input.maxOutreachPerCustomerWindow),frequencyWindowHours:Number(input.frequencyWindowHours),dataQualityMinScore:Number(input.dataQualityMinScore),requireMarketingConsent:Boolean(input.requireMarketingConsent),effectiveFrom:Number(input.effectiveFrom),effectiveUntil:input.effectiveUntil==null?null:Number(input.effectiveUntil)};validatePolicy(normalized);if(input.reason.trim().length<8)throw new Error("A clear opportunity-policy change reason is required");const now=Date.now(),id=input.id?.trim()||uid("ROP"),prior=await db.prepare("SELECT * FROM revenue_opportunity_policies WHERE id=?").bind(id).first<Row>();if(prior&&text(prior.status)!=="draft")throw new Error("Active/retired opportunity policy is immutable; create a new policy instead");const version=prior?Number(prior.version||1)+1:1;if(prior)await db.prepare("UPDATE revenue_opportunity_policies SET name=?,version=?,timezone=?,quiet_start_minute=?,quiet_end_minute=?,max_outreach_per_customer_window=?,frequency_window_hours=?,data_quality_min_score=?,require_marketing_consent=?,effective_from=?,effective_until=?,updated_by=?,updated_at=? WHERE id=?").bind(normalized.name,version,normalized.timezone,normalized.quietStartMinute,normalized.quietEndMinute,normalized.maxOutreachPerCustomerWindow,normalized.frequencyWindowHours,normalized.dataQualityMinScore,normalized.requireMarketingConsent?1:0,normalized.effectiveFrom,normalized.effectiveUntil,input.actorId,now,id).run();else await db.prepare("INSERT INTO revenue_opportunity_policies (id,name,status,version,timezone,quiet_start_minute,quiet_end_minute,max_outreach_per_customer_window,frequency_window_hours,data_quality_min_score,require_marketing_consent,effective_from,effective_until,approval_reference,created_by,created_at,updated_by,updated_at) VALUES (?,?,'draft',1,?,?,?,?,?,?,?,?,?,NULL,?,?,?,?)").bind(id,normalized.name,normalized.timezone,normalized.quietStartMinute,normalized.quietEndMinute,normalized.maxOutreachPerCustomerWindow,normalized.frequencyWindowHours,normalized.dataQualityMinScore,normalized.requireMarketingConsent?1:0,normalized.effectiveFrom,normalized.effectiveUntil,input.actorId,now,input.actorId,now).run();const row=await db.prepare("SELECT * FROM revenue_opportunity_policies WHERE id=?").bind(id).first<Row>();if(!row)throw new Error("Opportunity policy could not be saved");await versionPolicy(db,row,input.reason,input.actorId);return policySnapshot(row);}

export async function activateRevenueOpportunityPolicy(db:Db,input:{policyId:string;approvalReference:string;reason:string;actorId:string}){await ensureRevenueOpportunityTables(db);const row=await db.prepare("SELECT * FROM revenue_opportunity_policies WHERE id=?").bind(input.policyId).first<Row>();if(!row)throw new Error("Opportunity policy not found");if(text(row.status)!=="draft")throw new Error("Only draft opportunity policy can be activated");if(input.approvalReference.trim().length<4||input.reason.trim().length<8)throw new Error("Policy approval reference and reason are required");const p=policySnapshot(row);validatePolicy({...p,effectiveUntil:p.effectiveUntil});const now=Date.now();await db.prepare("UPDATE revenue_opportunity_policies SET status='active_uat',approval_reference=?,updated_by=?,updated_at=? WHERE id=?").bind(input.approvalReference.trim(),input.actorId,now,input.policyId).run();const after=await db.prepare("SELECT * FROM revenue_opportunity_policies WHERE id=?").bind(input.policyId).first<Row>();await versionPolicy(db,after!,input.reason,input.actorId);return policySnapshot(after!);}

async function activePolicy(db:Db,asOf:number){return db.prepare("SELECT * FROM revenue_opportunity_policies WHERE status='active_uat' AND effective_from<=? AND (effective_until IS NULL OR effective_until>=?) ORDER BY updated_at DESC LIMIT 1").bind(asOf,asOf).first<Row>();}
function localMinute(value:number,timezone:string){const parts=new Intl.DateTimeFormat("en-GB",{timeZone:timezone,hour:"2-digit",minute:"2-digit",hour12:false}).formatToParts(new Date(value));const hour=Number(parts.find(p=>p.type==="hour")?.value||0)%24,minute=Number(parts.find(p=>p.type==="minute")?.value||0);return hour*60+minute;}
function inQuietHours(value:number,timezone:string,start:number|null,end:number|null){if(start==null||end==null)return false;const minute=localMinute(value,timezone);return start<end?minute>=start&&minute<end:minute>=start||minute<end;}

async function customerFacts(db:Db,customerId:string){const customer=await db.prepare("SELECT id,name,primary_phone,email,city_id FROM canonical_customers WHERE id=?").bind(customerId).first<Row>()||await db.prepare("SELECT id,name,primary_phone,email,area city_id FROM crm_contacts WHERE id=?").bind(customerId).first<Row>();if(!customer)return null;const[prefs,bookings,tickets,pets]=await Promise.all([db.prepare("SELECT * FROM customer_contact_preferences WHERE customer_id=?").bind(customerId).first<Row>(),db.prepare("SELECT id,service_code,status,total_amount,scheduled_end,created_at FROM canonical_bookings WHERE customer_id=? ORDER BY created_at DESC LIMIT 100").bind(customerId).all<Row>(),db.prepare("SELECT id,category,priority,status,subject,updated_at FROM customer_experience_tickets WHERE customer_id=? ORDER BY updated_at DESC LIMIT 50").bind(customerId).all<Row>(),db.prepare("SELECT id FROM canonical_pets WHERE customer_id=? LIMIT 20").bind(customerId).all<Row>()]);const p=phone(customer.primary_phone),e=email(customer.email),duplicates=await db.prepare("SELECT id FROM canonical_customers WHERE id!=? AND ((?!='' AND substr(replace(replace(replace(primary_phone,'+',''),' ',''),'-',''),-10)=?) OR (?!='' AND lower(email)=?)) LIMIT 10").bind(customerId,p,p,e,e).all<Row>();const issues:string[]=[];if(!p)issues.push("missing_primary_phone");if(!text(customer.name))issues.push("missing_name");if(!pets.results.length)issues.push("no_canonical_pet");if(duplicates.results.length)issues.push("possible_duplicate");const quality=Math.max(0,100-issues.length*20);return{customer,prefs:prefs||{},bookings:bookings.results,tickets:tickets.results,issues,quality,duplicateIds:duplicates.results.map(row=>text(row.id))};}
function channelConsent(prefs:Row,channel:string){if(channel==="whatsapp")return Number(prefs.whatsapp_consent)===1;if(channel==="sms")return Number(prefs.sms_consent)===1;if(channel==="email")return Number(prefs.email_consent)===1;return Number(prefs.service_consent)===1;}
function preferredChannel(prefs:Row,emailValue:string){if(Number(prefs.whatsapp_consent)===1)return"whatsapp";if(Number(prefs.sms_consent)===1)return"sms";if(Number(prefs.email_consent)===1&&emailValue)return"email";return"call";}

export async function createCanonicalRevenueOpportunity(db:Db,input:{customerId:string;opportunityType:string;serviceCode?:string|null;reason:string;estimatedValue:number;confidence:number;sourceKey:string;idempotencyKey:string;actorId:string;asOf?:number}){await ensureRevenueOpportunityTables(db);if(!input.customerId||!input.opportunityType||input.reason.trim().length<4||!input.sourceKey||!input.idempotencyKey)throw new Error("Complete canonical opportunity context is required");if(!Number.isFinite(input.estimatedValue)||input.estimatedValue<0||!Number.isFinite(input.confidence)||input.confidence<0||input.confidence>1)throw new Error("Opportunity estimate/confidence are invalid");const prior=await db.prepare("SELECT * FROM canonical_revenue_opportunities WHERE idempotency_key=?").bind(input.idempotencyKey).first<Row>();if(prior)return{opportunity:prior,duplicatePrevented:true};const now=input.asOf??Date.now(),policyRow=await activePolicy(db,now);if(!policyRow)throw new Error("No active opportunity policy is configured");const policy=policySnapshot(policyRow),facts=await customerFacts(db,input.customerId);if(!facts)throw new Error("Canonical customer identity is unavailable");const prefs=facts.prefs,channel=preferredChannel(prefs,text(facts.customer.email));const suppression:SuppressionReason[]=[];if(policy.requireMarketingConsent&&Number(prefs.marketing_consent)!==1)suppression.push("marketing_consent_missing");if(!channelConsent(prefs,channel))suppression.push("channel_consent_missing");if(Number(prefs.opt_out)===1)suppression.push("customer_opted_out");if(facts.tickets.some(t=>text(t.status)!=="resolved"&&/quality|complaint|safety|incident/i.test(`${text(t.category)} ${text(t.subject)}`)))suppression.push("open_complaint_or_safety_issue");if(facts.tickets.some(t=>text(t.status)!=="resolved"&&/refund|payment|charge|billing/i.test(`${text(t.category)} ${text(t.subject)}`)))suppression.push("unresolved_refund_or_payment_issue");if(facts.issues.includes("possible_duplicate"))suppression.push("duplicate_review_required");if(facts.quality<policy.dataQualityMinScore)suppression.push("customer_data_quality_low");if(inQuietHours(now,policy.timezone,policy.quietStartMinute,policy.quietEndMinute))suppression.push("quiet_hours");const since=now-policy.frequencyWindowHours*60*60*1000,count=await db.prepare("SELECT COUNT(*) count FROM revenue_opportunity_events e JOIN canonical_revenue_opportunities o ON o.id=e.opportunity_id WHERE o.customer_id=? AND e.event_type='outreach_authorized' AND e.created_at>=?").bind(input.customerId,since).first<Row>();if(Number(count?.count||0)>=policy.maxOutreachPerCustomerWindow)suppression.push("frequency_cap_reached");const status:OpportunityStatus=suppression.some(r=>["duplicate_review_required","customer_data_quality_low"].includes(r))?"review_required":suppression.length?"suppressed":"ready";const recency=facts.bookings[0]?Number(facts.bookings[0].created_at||0):null,frequency=facts.bookings.filter(b=>!["cancelled","refunded"].includes(text(b.status))).length,lifetimeValue=facts.bookings.filter(b=>!["cancelled","refunded"].includes(text(b.status))).reduce((sum,b)=>sum+Number(b.total_amount||0),0),signalSnapshot={sourceKey:input.sourceKey,customerId:input.customerId,canonicalBookingCount:facts.bookings.length,eligibleBookingFrequency:frequency,lifetimeValue,lastBookingAt:recency,openTicketCount:facts.tickets.filter(t=>text(t.status)!=="resolved").length,dataQualityScore:facts.quality,dataQualityIssues:facts.issues,duplicateCandidateIds:facts.duplicateIds,consent:{marketing:Number(prefs.marketing_consent)===1,service:Number(prefs.service_consent)===1,whatsapp:Number(prefs.whatsapp_consent)===1,sms:Number(prefs.sms_consent)===1,email:Number(prefs.email_consent)===1,optOut:Number(prefs.opt_out)===1},estimateOnly:true};const id=uid("CRO"),eventTime=Date.now();await db.batch([db.prepare("INSERT INTO canonical_revenue_opportunities (id,idempotency_key,customer_id,opportunity_type,service_code,reason,status,preferred_channel,estimated_value,confidence,signal_snapshot_json,suppression_reasons_json,policy_id,policy_version,source_key,created_by,created_at,updated_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)").bind(id,input.idempotencyKey,input.customerId,input.opportunityType,input.serviceCode||null,input.reason.trim(),status,channel,input.estimatedValue,input.confidence,JSON.stringify(signalSnapshot),JSON.stringify(suppression),policy.id,policy.version,input.sourceKey,input.actorId,eventTime,eventTime),db.prepare("INSERT INTO revenue_opportunity_events (id,opportunity_id,event_type,actor_id,detail_json,created_at) VALUES (?,?,?,?,?,?)").bind(uid("CROE"),id,status==="ready"?"created_ready":"created_suppressed",input.actorId,JSON.stringify({status,suppression}),eventTime)]);const opportunity=await db.prepare("SELECT * FROM canonical_revenue_opportunities WHERE id=?").bind(id).first<Row>();return{opportunity,duplicatePrevented:false,status,suppressionReasons:suppression,automaticOutreach:false};}

export async function recheckRevenueOpportunity(db:Db,input:{opportunityId:string;actorId:string;asOf?:number}){await ensureRevenueOpportunityTables(db);const row=await db.prepare("SELECT * FROM canonical_revenue_opportunities WHERE id=?").bind(input.opportunityId).first<Row>();if(!row)throw new Error("Canonical opportunity not found");const recreated=await createCanonicalRevenueOpportunity(db,{customerId:text(row.customer_id),opportunityType:text(row.opportunity_type),serviceCode:row.service_code?text(row.service_code):null,reason:text(row.reason),estimatedValue:Number(row.estimated_value),confidence:Number(row.confidence),sourceKey:`${text(row.source_key)}:recheck:${input.asOf??Date.now()}`,idempotencyKey:`recheck:${input.opportunityId}:${input.asOf??Date.now()}`,actorId:input.actorId,asOf:input.asOf});return recreated;}

export async function authorizeOpportunityOutreach(db:Db,input:{opportunityId:string;actorId:string;reason:string}){await ensureRevenueOpportunityTables(db);if(input.reason.trim().length<8)throw new Error("Outreach authorization requires a clear reason");const row=await db.prepare("SELECT * FROM canonical_revenue_opportunities WHERE id=?").bind(input.opportunityId).first<Row>();if(!row)throw new Error("Canonical opportunity not found");if(text(row.status)!=="ready")throw new Error("Suppressed/review opportunity cannot authorize outreach");const now=Date.now();await db.prepare("INSERT INTO revenue_opportunity_events (id,opportunity_id,event_type,actor_id,detail_json,created_at) VALUES (?,?,?,?,?,?)").bind(uid("CROE"),input.opportunityId,"outreach_authorized",input.actorId,JSON.stringify({reason:input.reason.trim(),channel:text(row.preferred_channel),automatic:false}),now).run();return{opportunityId:input.opportunityId,channel:text(row.preferred_channel),authorized:true,automatic:false};}

export async function markOpportunityConverted(db:Db,input:{opportunityId:string;bookingId:string;actorId:string}){await ensureRevenueOpportunityTables(db);const row=await db.prepare("SELECT * FROM canonical_revenue_opportunities WHERE id=?").bind(input.opportunityId).first<Row>();if(!row)throw new Error("Canonical opportunity not found");const booking=await db.prepare("SELECT id,customer_id FROM canonical_bookings WHERE id=?").bind(input.bookingId).first<Row>();if(!booking||text(booking.customer_id)!==text(row.customer_id))throw new Error("Converted booking must belong to the opportunity customer");const now=Date.now();await db.batch([db.prepare("UPDATE canonical_revenue_opportunities SET status='converted',converted_booking_id=?,updated_at=? WHERE id=?").bind(input.bookingId,now,input.opportunityId),db.prepare("INSERT INTO revenue_opportunity_events (id,opportunity_id,event_type,actor_id,detail_json,created_at) VALUES (?,?,?,?,?,?)").bind(uid("CROE"),input.opportunityId,"converted",input.actorId,JSON.stringify({bookingId:input.bookingId}),now)]);return{opportunityId:input.opportunityId,status:"converted",bookingId:input.bookingId};}

export async function revenueOpportunityDirectory(db:Db){await ensureRevenueOpportunityTables(db);const[policies,opportunities,events]=await Promise.all([db.prepare("SELECT * FROM revenue_opportunity_policies ORDER BY updated_at DESC").all<Row>(),db.prepare("SELECT * FROM canonical_revenue_opportunities ORDER BY created_at DESC LIMIT 300").all<Row>(),db.prepare("SELECT * FROM revenue_opportunity_events ORDER BY created_at DESC LIMIT 300").all<Row>()]);return{policies:policies.results.map(policySnapshot),opportunities:opportunities.results.map(row=>({...row,signals:json(row.signal_snapshot_json),suppressionReasons:JSON.parse(String(row.suppression_reasons_json||"[]"))})),events:events.results,truth:{canonicalOpportunitySource:"canonical_revenue_opportunities",legacySyntheticRevenueOpportunitiesAuthoritative:false,automaticOutreach:false,estimatedValueIsAchievedRevenue:false,productionReady:false}};}
