import{ensureFoodFinanceTables}from"./food-finance-governance";
import{ensureFoodProofTables}from"./food-proof-governance";
type Row=Record<string,unknown>;
export type FoodOpsAction="resume_same_sku_stock"|"add_note";
export type FoodOpsInput={orderId:string;action:FoodOpsAction;actorId:string;idempotencyKey:string;reason?:string;note?:string};
const parse=<T>(value:unknown,fallback:T):T=>{try{return JSON.parse(String(value??"")) as T}catch{return fallback}};
export async function ensureFoodOpsTables(db:D1Database){await ensureFoodFinanceTables(db);await ensureFoodProofTables(db);await db.batch([db.prepare("CREATE TABLE IF NOT EXISTS food_ops_action_keys (idempotency_key TEXT PRIMARY KEY,order_id TEXT NOT NULL,action TEXT NOT NULL,result_json TEXT NOT NULL,created_at INTEGER NOT NULL)"),db.prepare("CREATE TABLE IF NOT EXISTS food_ops_notes (id TEXT PRIMARY KEY,order_id TEXT NOT NULL,note TEXT NOT NULL,actor_id TEXT NOT NULL,created_at INTEGER NOT NULL)"),db.prepare("CREATE INDEX IF NOT EXISTS idx_food_ops_notes_order ON food_ops_notes(order_id,created_at)")])}
async function prior(db:D1Database,key:string){const row=await db.prepare("SELECT result_json FROM food_ops_action_keys WHERE idempotency_key=?").bind(key).first<Row>();return row?parse<Record<string,unknown>>(row.result_json,{}):null}
async function remember(db:D1Database,input:FoodOpsInput,result:unknown){await db.prepare("INSERT INTO food_ops_action_keys (idempotency_key,order_id,action,result_json,created_at) VALUES (?,?,?,?,?)").bind(input.idempotencyKey,input.orderId,input.action,JSON.stringify(result),Date.now()).run();return result}
async function event(db:D1Database,orderId:string,eventType:string,actorId:string,detail:unknown){await db.prepare("INSERT INTO food_fulfilment_events (id,order_id,event_type,actor_id,detail_json,created_at) VALUES (?,?,?,?,?,?)").bind(crypto.randomUUID(),orderId,eventType,actorId,JSON.stringify(detail),Date.now()).run()}
function priority(flags:string[],incidents:Row[]){if(incidents.some(item=>String(item.severity)==="critical"&&String(item.status)!=="resolved"))return"critical";if(flags.some(flag=>["stock_recovery_required","fulfilment_overdue","quality_incident"].includes(flag)))return"high";return flags.length?"attention":"clear"}
export async function getFoodOpsSnapshot(db:D1Database){await ensureFoodOpsTables(db);const now=Date.now(),rows=await db.prepare("SELECT o.*,c.name customer_name,l.sku,l.item_name,l.quantity,l.unit_price,l.line_total,r.status reservation_status,f.status fulfilment_status,f.lot_id,f.dispatch_reference,f.delivery_adapter_status,f.handover_status,p.status payment_intent_status FROM food_orders o LEFT JOIN canonical_customers c ON c.id=o.customer_id JOIN food_order_lines l ON l.order_id=o.id JOIN food_inventory_reservations r ON r.order_id=o.id LEFT JOIN food_order_fulfilment f ON f.order_id=o.id LEFT JOIN food_order_payments p ON p.order_id=o.id ORDER BY o.created_at DESC").all<Row>(),orders:Array<Record<string,unknown>>=[];for(const order of rows.results){const[stock,incidents,cancellation,refunds,settlement,reconciliation,media,notes,payment]=await Promise.all([db.prepare("SELECT * FROM food_stock_recovery_cases WHERE order_id=? ORDER BY opened_at DESC LIMIT 1").bind(order.id).first<Row>(),db.prepare("SELECT * FROM food_quality_incidents WHERE order_id=? ORDER BY reported_at DESC").bind(order.id).all<Row>(),db.prepare("SELECT * FROM food_cancellation_requests WHERE order_id=? ORDER BY created_at DESC LIMIT 1").bind(order.id).first<Row>(),db.prepare("SELECT * FROM food_refund_ledger WHERE order_id=? ORDER BY created_at DESC").bind(order.id).all<Row>(),db.prepare("SELECT * FROM food_supplier_settlement_ledger WHERE order_id=?").bind(order.id).first<Row>(),db.prepare("SELECT * FROM food_finance_reconciliation WHERE order_id=? ORDER BY created_at DESC LIMIT 1").bind(order.id).first<Row>(),db.prepare("SELECT a.id,a.purpose,a.scan_status,a.access_status,a.retention_status,m.sku,m.lot_id FROM service_media_assets a JOIN food_media_order_bindings m ON m.media_id=a.id WHERE a.booking_id=? ORDER BY a.created_at DESC").bind(order.id).all<Row>(),db.prepare("SELECT * FROM food_ops_notes WHERE order_id=? ORDER BY created_at DESC LIMIT 20").bind(order.id).all<Row>(),db.prepare("SELECT * FROM food_order_payment_events WHERE order_id=?").bind(order.id).first<Row>()]);const flags:string[]=[],openIncidents=incidents.results.filter(item=>String(item.status)!=="resolved"),fulfilment=String(order.fulfilment_status||"");if(String(order.status)==="stock_recovery_required"||stock&&String(stock.status)==="ops_review_required")flags.push("stock_recovery_required");if(openIncidents.some(item=>String(item.severity)==="critical"))flags.push("critical_quality_incident");else if(openIncidents.some(item=>String(item.severity)==="urgent"))flags.push("urgent_quality_incident");else if(openIncidents.length)flags.push("quality_incident");if(cancellation&&String(cancellation.status)==="policy_review_required")flags.push("cancellation_policy_review");if(refunds.results.some(item=>String(item.status)==="sandbox_pending"))flags.push("refund_pending");if(media.results.some(item=>String(item.scan_status)!=="clean"||String(item.access_status)!=="ready"||String(item.retention_status)!=="active"))flags.push("media_blocked");if(payment&&String(payment.status)==="due")flags.push("payment_due");const age=now-Number(order.created_at||now);if(age>4*60*60_000&&!["delivered","cancelled"].includes(fulfilment||String(order.status)))flags.push("fulfilment_overdue");if(String(order.status)==="delivered"&&(!settlement||String(settlement.approval_status)!=="ready"))flags.push("supplier_settlement_not_ready");if(!settlement||String(settlement.tax_status)!=="configured")flags.push("tax_pending");const inventory=flags.includes("stock_recovery_required")?await db.prepare("SELECT available_units,reserved_units,status FROM food_inventory_uat WHERE sku=? AND zone_id=?").bind(order.sku,order.zone_id).first<Row>():null,available=inventory?Math.max(0,Number(inventory.available_units||0)-Number(inventory.reserved_units||0)):0;orders.push({...order,stockRecovery:stock??null,incidents:incidents.results,cancellation:cancellation??null,refunds:refunds.results,settlement:settlement??null,reconciliation:reconciliation??null,media:media.results,notes:notes.results,deliveryPayment:payment??null,sameSkuAvailableUnits:available,exceptionFlags:[...new Set(flags)],priority:priority(flags,openIncidents)})}const metrics={total:orders.length,clear:orders.filter(item=>(item.exceptionFlags as string[]).length===0).length,needsAttention:orders.filter(item=>(item.exceptionFlags as string[]).length>0).length,stockRecovery:orders.filter(item=>(item.exceptionFlags as string[]).includes("stock_recovery_required")).length,openIncidents:orders.reduce((sum,item)=>sum+(item.incidents as Row[]).filter(row=>String(row.status)!=="resolved").length,0),financeReview:orders.filter(item=>(item.exceptionFlags as string[]).some(flag=>["cancellation_policy_review","refund_pending","payment_due","supplier_settlement_not_ready","tax_pending"].includes(flag))).length};return{source:"canonical Food UAT database",generatedAt:now,metrics,orders,readiness:{engineeringGate:"gate_5_closed_uat_contract",productionReady:false,customerJourney:"canonical",fulfilmentJourney:"canonical_uat",opsExceptionQueue:"canonical",finance:"sandbox_governed",proof:"private_scan_gated_contract",externalDependencies:{productionCatalogue:"disconnected",productionInventory:"disconnected",productionLotTraceability:"disconnected",deliveryPartner:"disconnected",otp:"disconnected",objectStorage:"disconnected",malwareScanner:"disconnected",payments:"sandbox_only",refunds:"sandbox_only",cogs:"configuration_required",supplierSettlement:"rule_pending",tax:"configuration_required"}}}}
