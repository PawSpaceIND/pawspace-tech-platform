type Row=Record<string,unknown>;

export async function ensureTrainingProgrammeTables(db:D1Database){await db.batch([
  db.prepare("CREATE TABLE IF NOT EXISTS training_programmes (id TEXT PRIMARY KEY,booking_id TEXT NOT NULL UNIQUE,customer_id TEXT NOT NULL,provider_id TEXT NOT NULL,city_id TEXT NOT NULL,zone_id TEXT NOT NULL,plan_code TEXT NOT NULL,plan_name TEXT NOT NULL,pet_ids_json TEXT NOT NULL,requirements_json TEXT NOT NULL DEFAULT '[]',meet_booking_id TEXT,status TEXT NOT NULL DEFAULT 'scheduled',total_sessions INTEGER NOT NULL,completed_sessions INTEGER NOT NULL DEFAULT 0,no_show_sessions INTEGER NOT NULL DEFAULT 0,cancelled_sessions INTEGER NOT NULL DEFAULT 0,pricing_snapshot_json TEXT NOT NULL DEFAULT '{}',created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL)"),
  db.prepare("CREATE INDEX IF NOT EXISTS idx_training_programmes_provider ON training_programmes(provider_id,status,updated_at)"),
  db.prepare("CREATE INDEX IF NOT EXISTS idx_training_programmes_customer ON training_programmes(customer_id,status,updated_at)"),
  db.prepare("CREATE TABLE IF NOT EXISTS training_sessions (id TEXT PRIMARY KEY,programme_id TEXT NOT NULL,booking_id TEXT NOT NULL,schedule_reservation_id TEXT NOT NULL UNIQUE,sequence_no INTEGER NOT NULL,provider_id TEXT NOT NULL,scheduled_start TEXT NOT NULL,scheduled_end TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'scheduled',attendance_json TEXT NOT NULL DEFAULT '{}',homework_json TEXT NOT NULL DEFAULT '{}',progress_json TEXT NOT NULL DEFAULT '{}',evidence_json TEXT NOT NULL DEFAULT '[]',started_at INTEGER,completed_at INTEGER,created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL,UNIQUE(programme_id,sequence_no))"),
  db.prepare("CREATE INDEX IF NOT EXISTS idx_training_sessions_programme ON training_sessions(programme_id,sequence_no)"),
  db.prepare("CREATE INDEX IF NOT EXISTS idx_training_sessions_provider ON training_sessions(provider_id,scheduled_start,status)"),
  db.prepare("CREATE TABLE IF NOT EXISTS training_programme_events (id TEXT PRIMARY KEY,programme_id TEXT NOT NULL,booking_id TEXT NOT NULL,event_type TEXT NOT NULL,actor_id TEXT NOT NULL,detail_json TEXT NOT NULL DEFAULT '{}',created_at INTEGER NOT NULL)"),
]);}

function parse<T>(value:unknown,fallback:T):T{try{return JSON.parse(String(value??"")) as T}catch{return fallback}}

export async function readTrainingProgramme(db:D1Database,bookingId:string){await ensureTrainingProgrammeTables(db);const programme=await db.prepare("SELECT * FROM training_programmes WHERE booking_id=?").bind(bookingId).first<Row>();if(!programme)return null;const[sessions,events]=await Promise.all([db.prepare("SELECT * FROM training_sessions WHERE programme_id=? ORDER BY sequence_no").bind(programme.id).all<Row>(),db.prepare("SELECT * FROM training_programme_events WHERE programme_id=? ORDER BY created_at DESC LIMIT 100").bind(programme.id).all<Row>()]);return{programme,sessions:sessions.results,events:events.results};}

export async function materializeTrainingProgramme(db:D1Database,input:{bookingId:string;meetBookingId?:string;actorId:string}){await ensureTrainingProgrammeTables(db);const prior=await readTrainingProgramme(db,input.bookingId);if(prior)return{...prior,duplicatePrevented:true};const booking=await db.prepare("SELECT * FROM canonical_bookings WHERE id=? AND service_code='dog_training'").bind(input.bookingId).first<Row>();if(!booking)throw new Response("Canonical Training booking not found",{status:404});if(String(booking.package_code)==="trainer-meet-greet")throw new Response("Meet & Greet is an assessment booking, not a Training programme",{status:409});const reservations=await db.prepare("SELECT * FROM scheduling_reservations WHERE group_id=? AND status!='cancelled' ORDER BY occurrence_number,scheduled_start").bind(booking.schedule_group_id).all<Row>();if(!reservations.results.length)throw new Response("Training programme requires scheduled session reservations",{status:409});if(reservations.results.some(row=>String(row.provider_id)!==String(booking.provider_id)))throw new Response("Training session provider does not match the canonical booking",{status:409});const numbers=reservations.results.map(row=>Number(row.occurrence_number));if(new Set(numbers).size!==numbers.length)throw new Response("Training session occurrence numbers must be unique",{status:409});if(input.meetBookingId){const meet=await db.prepare("SELECT id,customer_id,service_code,package_code,status FROM canonical_bookings WHERE id=?").bind(input.meetBookingId).first<Row>();if(!meet||String(meet.customer_id)!==String(booking.customer_id)||String(meet.service_code)!=="dog_training"||String(meet.package_code)!=="trainer-meet-greet"||String(meet.status)==="cancelled")throw new Response("Meet & Greet does not belong to this Training customer/programme",{status:409});}
  const pricing=parse<Record<string,unknown>>(booking.pricing_json,{}),requirements=Array.isArray(pricing.requirements)?pricing.requirements:[],petIds=parse<string[]>(booking.pet_ids_json,[]),now=Date.now(),programmeId=`TP-${crypto.randomUUID().slice(0,12).toUpperCase()}`;const statements=[db.prepare("INSERT INTO training_programmes (id,booking_id,customer_id,provider_id,city_id,zone_id,plan_code,plan_name,pet_ids_json,requirements_json,meet_booking_id,status,total_sessions,completed_sessions,no_show_sessions,cancelled_sessions,pricing_snapshot_json,created_at,updated_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,'scheduled',?,0,0,0,?,?,?)").bind(programmeId,input.bookingId,booking.customer_id,booking.provider_id,booking.city_id,booking.zone_id,booking.package_code,booking.package_name,JSON.stringify(petIds),JSON.stringify(requirements),input.meetBookingId??null,reservations.results.length,booking.pricing_json,now,now),...reservations.results.map((row,index)=>db.prepare("INSERT INTO training_sessions (id,programme_id,booking_id,schedule_reservation_id,sequence_no,provider_id,scheduled_start,scheduled_end,status,attendance_json,homework_json,progress_json,evidence_json,created_at,updated_at) VALUES (?,?,?,?,?,?,?,?,'scheduled','{}','{}','{}','[]',?,?)").bind(`TS-${crypto.randomUUID().slice(0,12).toUpperCase()}`,programmeId,input.bookingId,row.id,Number(row.occurrence_number||index+1),row.provider_id,row.scheduled_start,row.scheduled_end,now,now)),db.prepare("INSERT INTO training_programme_events (id,programme_id,booking_id,event_type,actor_id,detail_json,created_at) VALUES (?,?,?,?,?,?,?)").bind(crypto.randomUUID(),programmeId,input.bookingId,"programme_materialized",input.actorId,JSON.stringify({sessionCount:reservations.results.length,meetBookingId:input.meetBookingId??null,requirements,providerId:booking.provider_id}),now)];await db.batch(statements);const result=await readTrainingProgramme(db,input.bookingId);return{...result,duplicatePrevented:false};}
</file>

