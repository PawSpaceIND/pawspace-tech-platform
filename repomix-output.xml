import{ensureBoardingFinanceTables}from"./boarding-finance-governance";
import{ensureBoardingProofTables}from"./boarding-proof-governance";
import{createAssignmentOffer}from"./provider-capacity-governance";

type Row=Record<string,unknown>;
export type BoardingOpsAction="assign_replacement"|"close_recovery"|"add_note";
export type BoardingOpsInput={stayId:string;action:BoardingOpsAction;actorId:string;idempotencyKey:string;reason?:string;note?:string;providerId?:string};
const parse=<T>(value:unknown,fallback:T):T=>{try{return JSON.parse(String(value??"")) as T;}catch{return fallback;}};

export async function ensureBoardingOpsTables(db:D1Database){await ensureBoardingFinanceTables(db);await ensureBoardingProofTables(db);await db.batch([
 db.prepare("CREATE TABLE IF NOT EXISTS boarding_ops_action_keys (idempotency_key TEXT PRIMARY KEY,stay_id TEXT NOT NULL,action TEXT NOT NULL,result_json TEXT NOT NULL,created_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS boarding_ops_notes (id TEXT PRIMARY KEY,stay_id TEXT NOT NULL,booking_id TEXT NOT NULL,note TEXT NOT NULL,actor_id TEXT NOT NULL,created_at INTEGER NOT NULL)"),
 db.prepare("CREATE INDEX IF NOT EXISTS idx_boarding_ops_notes_stay ON boarding_ops_notes(stay_id,created_at)"),
]);}

async function prior(db:D1Database,key:string){const row=await db.prepare("SELECT result_json FROM boarding_ops_action_keys WHERE idempotency_key=?").bind(key).first<Row>();return row?parse<Record<string,unknown>>(row.result_json,{}):null;}
async function remember(db:D1Database,input:BoardingOpsInput,result:unknown){await db.prepare("INSERT INTO boarding_ops_action_keys (idempotency_key,stay_id,action,result_json,created_at) VALUES (?,?,?,?,?)").bind(input.idempotencyKey,input.stayId,input.action,JSON.stringify(result),Date.now()).run();return result;}
async function event(db:D1Database,stay:Row,eventType:string,actorId:string,detail:unknown){await db.prepare("INSERT INTO boarding_stay_events (id,stay_id,booking_id,event_type,actor_id,detail_json,created_at) VALUES (?,?,?,?,?,?,?)").bind(crypto.randomUUID(),stay.id,stay.booking_id,eventType,actorId,JSON.stringify(detail),Date.now()).run();}
async function notify(db:D1Database,stay:Row,eventId:string,message:string){for(const channel of["push","whatsapp"])await db.prepare("INSERT INTO booking_customer_notifications (id,booking_id,customer_id,channel,template_code,message,status,event_id,created_at) VALUES (?,?,?,?,?,?, 'queued',?,?)").bind(crypto.randomUUID(),stay.booking_id,stay.customer_id,channel,"boarding_recovery_update",message,eventId,Date.now()).run();}

function exceptionPriority(flags:string[],incidents:Row[]){if(incidents.some(item=>String(item.severity)==="emergency"&&String(item.status)!=="resolved"))return"emergency";if(flags.some(flag=>["host_recovery","urgent_incident","checkin_due","checkout_due"].includes(flag)))return"high";return flags.length?"attention":"clear";}

async function replacementCandidates(db:D1Database,stay:Row){const petIds=parse<string[]>(stay.pet_ids_json,[]),pets=petIds.length?await db.prepare(`SELECT species,vaccination_status FROM canonical_pets WHERE id IN (${petIds.map(()=>"?").join(",")})`).bind(...petIds).all<Row>():{results:[] as Row[]};const species=[...new Set(pets.results.map(row=>String(row.species)))],allVaccinated=pets.results.length===petIds.length&&pets.results.every(row=>String(row.vaccination_status)==="verified");if(!allVaccinated)return[];const rows=await db.prepare("SELECT h.provider_id,h.area,h.species_json,h.max_guest_pets,h.one_family_only,h.medication_support,h.home_verified,h.kyc_status,h.background_check_status,p.name,p.provider_model,p.rating,p.quality_score,p.live,p.status,p.services_json,p.zones_json FROM boarding_host_profiles h JOIN provider_capacity_profiles p ON p.id=h.provider_id WHERE h.city_id=? AND h.zone_id=? AND h.active=1 AND p.live=1 AND p.status='active' AND h.provider_id!=? ORDER BY p.quality_score DESC,p.rating DESC").bind(stay.city_id,stay.zone_id,stay.host_provider_id).all<Row>(),out=[] as Array<Record<string,unknown>>;for(const row of rows.results){if(Number(row.home_verified)!==1||String(row.kyc_status)!=="verified"||String(row.background_check_status)!=="verified")continue;if(!parse<string[]>(row.services_json,[]).includes("boarding")||!parse<string[]>(row.zones_json,[]).includes(String(stay.zone_id)))continue;const supported=parse<string[]>(row.species_json,[]);if(species.some(item=>!supported.includes(item)))continue;if(Number(stay.pet_count)>Number(row.max_guest_pets||0))continue;const blocked=await db.prepare("SELECT id FROM provider_unavailability WHERE provider_id=? AND status='active' AND starts_at<? AND ends_at>? LIMIT 1").bind(row.provider_id,stay.check_out_at,stay.check_in_at).first<Row>();if(blocked)continue;const locks=await db.prepare("SELECT capacity_units,family_key FROM boarding_capacity_locks WHERE provider_id=? AND status='active' AND stay_id!=? AND starts_at<? AND ends_at>?").bind(row.provider_id,stay.id,stay.check_out_at,stay.check_in_at).all<Row>();if(Number(row.one_family_only)===1&&locks.results.length)continue;const used=locks.results.reduce((sum,item)=>sum+Number(item.capacity_units||0),0);if(used+Number(stay.pet_count)>Number(row.max_guest_pets||0))continue;out.push({providerId:String(row.provider_id),name:String(row.name),area:String(row.area),model:String(row.provider_model),rating:Number(row.rating||0),qualityScore:Number(row.quality_score||0),maxGuestPets:Number(row.max_guest_pets||0),availableGuestPets:Number(row.max_guest_pets||0)-used,oneFamilyOnly:Boolean(row.one_family_only),medicationSupport:Boolean(row.medication_support)});}return out;}

export async function getBoardingOpsSnapshot(db:D1Database){await ensureBoardingOpsTables(db);const now=Date.now(),rows=await db.prepare("SELECT s.*,b.schedule_group_id,b.status booking_status,b.total_amount,pay.amount_due_now,pay.status payment_status,b.provider_id booking_provider_id,b.package_name,b.pet_ids_json,c.name customer_name,p.name provider_name FROM boarding_stays s JOIN canonical_bookings b ON b.id=s.booking_id LEFT JOIN booking_payments pay ON pay.booking_id=b.id LEFT JOIN canonical_customers c ON c.id=s.customer_id LEFT JOIN provider_capacity_profiles p ON p.id=s.host_provider_id WHERE b.service_code='boarding' ORDER BY s.check_in_at ASC").all<Row>(),stays=[] as Array<Record<string,unknown>>;for(const stay of rows.results){const [recovery,incidents,cancellation,dateChange,refunds,settlement,media,notes,reconciliation]=await Promise.all([
 db.prepare("SELECT * FROM boarding_recovery_cases WHERE stay_id=? ORDER BY opened_at DESC LIMIT 1").bind(stay.id).first<Row>(),
 db.prepare("SELECT id,severity,summary,action_taken,status,ops_status,notification_status,customer_acknowledged_at,resolution,reported_at,updated_at FROM boarding_incidents WHERE stay_id=? ORDER BY reported_at DESC").bind(stay.id).all<Row>(),
 db.prepare("SELECT * FROM boarding_cancellation_requests WHERE stay_id=? ORDER BY created_at DESC LIMIT 1").bind(stay.id).first<Row>(),
 db.prepare("SELECT * FROM boarding_date_change_requests WHERE stay_id=? ORDER BY created_at DESC LIMIT 1").bind(stay.id).first<Row>(),
 db.prepare("SELECT id,amount,status,reference,policy_source,created_at,updated_at FROM boarding_refund_ledger WHERE booking_id=? ORDER BY created_at DESC").bind(stay.booking_id).all<Row>(),
 db.prepare("SELECT * FROM boarding_host_settlement_ledger WHERE booking_id=?").bind(stay.booking_id).first<Row>(),
 db.prepare("SELECT id,purpose,scan_status,access_status,retention_status,synthetic,created_at,updated_at FROM service_media_assets WHERE booking_id=? AND purpose IN ('boarding_checkin','stay_update','boarding_medication','boarding_incident','boarding_checkout') ORDER BY created_at DESC").bind(stay.booking_id).all<Row>(),
 db.prepare("SELECT id,note,actor_id,created_at FROM boarding_ops_notes WHERE stay_id=? ORDER BY created_at DESC LIMIT 20").bind(stay.id).all<Row>(),
 db.prepare("SELECT * FROM boarding_finance_reconciliation WHERE booking_id=? ORDER BY created_at DESC LIMIT 1").bind(stay.booking_id).first<Row>(),
