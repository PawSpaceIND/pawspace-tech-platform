async function candidates(db:D1Database,booking:Row){const start=String(booking.scheduled_start),end=String(booking.scheduled_end),rows=await db.prepare("SELECT p.*,v.id vehicle_id,v.label vehicle_label FROM provider_capacity_profiles p JOIN taxi_vehicle_profiles v ON v.provider_id=p.id AND v.active=1 AND v.inspection_status='uat_verified' WHERE p.city_id=? AND p.live=1 AND p.status='active' AND p.id!=? ORDER BY p.quality_score DESC,p.rating DESC").bind(booking.city_id,booking.provider_id).all<Row>(),out:Array<Record<string,unknown>>=[];for(const row of rows.results){if(!parse<string[]>(row.services_json,[]).includes("pet_taxi")||!parse<string[]>(row.zones_json,[]).includes(String(booking.zone_id)))continue;const blocked=await db.prepare("SELECT id FROM provider_unavailability WHERE provider_id=? AND status='active' AND starts_at<? AND ends_at>? LIMIT 1").bind(row.id,end,start).first<Row>();if(blocked)continue;const bufferMs=Math.max(0,Number(row.travel_buffer_minutes||20))*60_000,bufferedStart=new Date(new Date(start).getTime()-bufferMs).toISOString(),bufferedEnd=new Date(new Date(end).getTime()+bufferMs).toISOString(),conflict=await db.prepare("SELECT id FROM scheduling_reservations WHERE provider_id=? AND group_id!=? AND status NOT IN ('cancelled','completed') AND scheduled_start<? AND scheduled_end>? LIMIT 1").bind(row.id,booking.schedule_group_id,bufferedEnd,bufferedStart).first<Row>();if(conflict)continue;out.push({providerId:String(row.id),name:String(row.name),model:String(row.provider_model),rating:Number(row.rating||0),qualityScore:Number(row.quality_score||0),travelBufferMinutes:Number(row.travel_buffer_minutes||20),vehicleId:String(row.vehicle_id),vehicleLabel:String(row.vehicle_label)})}return out}
function priority(flags:string[],incidents:Row[]){if(incidents.some(item=>String(item.severity)==="emergency"&&String(item.status)!=="resolved"))return"emergency";if(flags.some(flag=>["driver_recovery","driver_acceptance_due","route_missing","trip_overdue"].includes(flag)))return"high";return flags.length?"attention":"clear"}
export async function getTaxiOpsSnapshot(db:D1Database){await ensureTaxiOpsTables(db);const now=Date.now();
 // Cold-DB safe: canonical booking tables are created by the booking routes. Before any booking
 // module has run (fresh staging D1), the queue is honestly empty instead of a 500.
 const rows=await db.prepare("SELECT name FROM sqlite_master WHERE type='table' AND name='canonical_bookings'").first<Row>()?await db.prepare("SELECT b.*,c.name customer_name,p.name provider_name,w.status work_order_status,pay.status payment_status,t.id trip_id,t.status trip_status,t.vehicle_id,t.origin_label,t.destination_label,t.route_code,t.synthetic_distance_km,t.estimated_duration_minutes FROM canonical_bookings b LEFT JOIN canonical_customers c ON c.id=b.customer_id LEFT JOIN provider_capacity_profiles p ON p.id=b.provider_id LEFT JOIN provider_work_orders w ON w.booking_id=b.id LEFT JOIN booking_payments pay ON pay.booking_id=b.id JOIN taxi_trips t ON t.booking_id=b.id WHERE b.service_code='pet_taxi' ORDER BY b.scheduled_start ASC").all<Row>():{results:[] as Row[]};const bookings:Array<Record<string,unknown>>=[];for(const booking of rows.results){const[recovery,incidents,cancellation,refunds,settlement,reconciliation,media,notes,offer,payment]=await Promise.all([db.prepare("SELECT * FROM taxi_recovery_cases WHERE booking_id=? ORDER BY opened_at DESC LIMIT 1").bind(booking.id).first<Row>(),db.prepare("SELECT * FROM taxi_incidents WHERE booking_id=? ORDER BY reported_at DESC").bind(booking.id).all<Row>(),db.prepare("SELECT * FROM taxi_cancellation_requests WHERE booking_id=? ORDER BY created_at DESC LIMIT 1").bind(booking.id).first<Row>(),db.prepare("SELECT * FROM taxi_refund_ledger WHERE booking_id=? ORDER BY created_at DESC").bind(booking.id).all<Row>(),db.prepare("SELECT * FROM taxi_driver_settlement_ledger WHERE booking_id=?").bind(booking.id).first<Row>(),db.prepare("SELECT * FROM taxi_finance_reconciliation WHERE booking_id=? ORDER BY created_at DESC LIMIT 1").bind(booking.id).first<Row>(),db.prepare("SELECT a.id,a.purpose,a.scan_status,a.access_status,a.retention_status FROM service_media_assets a JOIN taxi_media_trip_bindings m ON m.media_id=a.id WHERE a.booking_id=? ORDER BY a.created_at DESC").bind(booking.id).all<Row>(),db.prepare("SELECT * FROM taxi_ops_notes WHERE booking_id=? ORDER BY created_at DESC LIMIT 20").bind(booking.id).all<Row>(),db.prepare("SELECT status,provider_id,expires_at,attempt_no FROM provider_assignment_offers WHERE group_id=?").bind(booking.schedule_group_id).first<Row>(),db.prepare("SELECT * FROM taxi_trip_payment_events WHERE booking_id=?").bind(booking.id).first<Row>()]);const flags:string[]=[],openIncidents=incidents.results.filter(item=>String(item.status)!=="resolved");if(["reassignment_needed","reassignment_offered"].includes(String(booking.status))||recovery&&!["resolved","closed"].includes(String(recovery.status)))flags.push("driver_recovery");if(offer&&String(offer.status)==="pending"&&Number(offer.expires_at)<now)flags.push("driver_acceptance_due");if(openIncidents.some(item=>String(item.severity)==="emergency"))flags.push("emergency_incident");else if(openIncidents.some(item=>String(item.severity)==="urgent"))flags.push("urgent_incident");else if(openIncidents.length)flags.push("care_incident");if(cancellation&&String(cancellation.status)==="policy_review_required")flags.push("cancellation_policy_review");if(refunds.results.some(item=>String(item.status)==="sandbox_pending"))flags.push("refund_pending");if(media.results.some(item=>String(item.scan_status)!=="clean"||String(item.access_status)!=="ready"||String(item.retention_status)!=="active"))flags.push("media_blocked");if(String(booking.trip_status)==="in_progress"){const route=await db.prepare("SELECT COUNT(*) count FROM taxi_trip_events WHERE booking_id=? AND event_type='route_location_sample'").bind(booking.id).first<{count:number}>();if(Number(route?.count||0)<2)flags.push("route_missing")}if(!["completed","cancelled"].includes(String(booking.trip_status))&&new Date(String(booking.scheduled_end)).getTime()<now)flags.push("trip_overdue");if(payment&&String(payment.status)==="due")flags.push("trip_payment_due");if(String(booking.status)==="completed"&&(!settlement||String(settlement.approval_status)!=="ready"||String(settlement.payout_status)==="not_instructed"))flags.push("settlement_not_ready");const replacementCandidates=flags.includes("driver_recovery")&&!["in_progress","arrived_dropoff","dropoff_confirmed","completed"].includes(String(booking.trip_status))?await candidates(db,booking):[];bookings.push({...booking,recovery:recovery??null,incidents:incidents.results,cancellation:cancellation??null,refunds:refunds.results,settlement:settlement??null,reconciliation:reconciliation??null,media:media.results,notes:notes.results,offer:offer??null,tripPayment:payment??null,replacementCandidates,exceptionFlags:[...new Set(flags)],priority:priority(flags,openIncidents)})}const metrics={total:bookings.length,clear:bookings.filter(item=>(item.exceptionFlags as string[]).length===0).length,needsAttention:bookings.filter(item=>(item.exceptionFlags as string[]).length>0).length,recovery:bookings.filter(item=>(item.exceptionFlags as string[]).includes("driver_recovery")).length,openIncidents:bookings.reduce((sum,item)=>sum+(item.incidents as Row[]).filter(row=>String(row.status)!=="resolved").length,0),financeReview:bookings.filter(item=>(item.exceptionFlags as string[]).some(flag=>["cancellation_policy_review","refund_pending","trip_payment_due","settlement_not_ready"].includes(flag))).length,routeMissing:bookings.filter(item=>(item.exceptionFlags as string[]).includes("route_missing")).length};return{source:"canonical Pet Taxi UAT database",generatedAt:now,metrics,bookings,readiness:{engineeringGate:"gate_5_closed_uat_contract",productionReady:false,customerJourney:"canonical",driverJourney:"canonical",opsExceptionQueue:"canonical",finance:"sandbox_governed",proof:"private_scan_gated_contract",routeEvidence:"sandbox_unverified",externalDependencies:{productionMaps:"disconnected",productionGps:"disconnected",objectStorage:"disconnected",malwareScanner:"disconnected",whatsappPush:"queued_only",payments:"sandbox_only",refunds:"sandbox_only",tax:"configuration_required",driverPayout:"rule_pending",vehicleCompliance:"uat_only"}}}}
export async function mutateTaxiOps(db:D1Database,input:TaxiOpsInput){if(!input.bookingId||!input.action||!input.actorId||!input.idempotencyKey)throw new Response("Booking, action, actor and idempotency key are required",{status:400});await ensureTaxiOpsTables(db);const old=await prior(db,input.idempotencyKey);if(old)return{...old,duplicatePrevented:true};const booking=await db.prepare("SELECT b.*,t.id trip_id,t.status trip_status,t.reservation_id,w.provider_id work_order_provider_id FROM canonical_bookings b JOIN taxi_trips t ON t.booking_id=b.id LEFT JOIN provider_work_orders w ON w.booking_id=b.id WHERE b.id=? AND b.service_code='pet_taxi'").bind(input.bookingId).first<Row>();if(!booking)throw new Response("Canonical Pet Taxi booking not found",{status:404});const now=Date.now();if(input.action==="add_note"){const note=String(input.note||"").trim();if(note.length<5)throw new Response("A meaningful Operations note is required",{status:400});const id=crypto.randomUUID();await db.prepare("INSERT INTO taxi_ops_notes (id,booking_id,note,actor_id,created_at) VALUES (?,?,?,?,?)").bind(id,booking.id,note,input.actorId,now).run();await event(db,booking,"ops_note_added",input.actorId,{noteId:id});return remember(db,input,{bookingId:booking.id,status:"noted",noteId:id})}if(input.action==="assign_replacement"){if(String(booking.status)!=="reassignment_needed"||String(booking.trip_status)!=="recovery_pending")throw new Response("Replacement assignment requires a pre-trip recovery-pending Pet Taxi booking",{status:409});const recovery=await db.prepare("SELECT * FROM taxi_recovery_cases WHERE booking_id=? AND status!='resolved' ORDER BY opened_at DESC LIMIT 1").bind(booking.id).first<Row>();if(!recovery)throw new Response("No open Pet Taxi recovery case exists",{status:409});const providerId=String(input.providerId||"").trim(),reason=String(input.reason||"").trim();if(!providerId||reason.length<5)throw new Response("Replacement driver and assignment reason are required",{status:400});const candidate=(await candidates(db,booking)).find(item=>String(item.providerId)===providerId);if(!candidate)throw new Response("Selected replacement driver is not eligible for the canonical trip window with an active UAT-verified vehicle",{status:409});const groupId=String(booking.schedule_group_id),offer=await createAssignmentOffer(db,{groupId,bookingId:String(booking.id),providerId,attemptNo:Number((await db.prepare("SELECT attempt_no FROM provider_assignment_offers WHERE group_id=?").bind(groupId).first<{attempt_no:number}>())?.attempt_no||0)+1});await db.batch([db.prepare("UPDATE taxi_recovery_cases SET status='replacement_offered',replacement_provider_id=?,detail_json=?,updated_at=? WHERE id=?").bind(providerId,JSON.stringify({...parse<Record<string,unknown>>(recovery.detail_json,{}),replacementReason:reason,bookingPreserved:true,routePreserved:true}),now,recovery.id),db.prepare("UPDATE canonical_bookings SET provider_id=?,status='reassignment_offered',updated_at=? WHERE id=?").bind(providerId,now,booking.id),db.prepare("UPDATE provider_work_orders SET provider_id=?,provider_name=?,provider_model=?,status='reassignment_offered',updated_at=? WHERE booking_id=?").bind(providerId,candidate.name,candidate.model,now,booking.id),db.prepare("UPDATE taxi_trips SET provider_id=?,vehicle_id=NULL,status='scheduled',pickup_verification_status='pending',dropoff_verification_status='pending',updated_at=? WHERE booking_id=?").bind(providerId,now,booking.id),db.prepare("UPDATE scheduling_reservations SET provider_id=?,status='assigned' WHERE id=? AND status='cancelled'").bind(providerId,booking.reservation_id),db.prepare("UPDATE scheduling_assignment_decisions SET selected_provider_id=?,status='reassignment_offered',actor_id=?,reason=?,updated_at=? WHERE group_id=?").bind(providerId,input.actorId,reason,now,groupId)]);const eventId=crypto.randomUUID();await db.prepare("INSERT INTO taxi_trip_events (id,booking_id,trip_id,provider_id,event_type,actor_id,detail_json,created_at) VALUES (?,?,?,?,?,?,?,?)").bind(eventId,booking.id,booking.trip_id,providerId,"replacement_driver_offered",input.actorId,JSON.stringify({recoveryId:recovery.id,failedProviderId:recovery.failed_provider_id,replacementProviderId:providerId,vehicleId:candidate.vehicleId,offerExpiresAt:offer.expiresAt,bookingPreserved:true,routePreserved:true}),now).run();await notify(db,booking,eventId,"PawSpace Operations offered your existing Pet Taxi trip to an eligible replacement driver. Booking ID, pickup/drop-off labels and quoted route class are unchanged.");return remember(db,input,{bookingId:booking.id,tripId:booking.trip_id,status:"replacement_offered",replacementProviderId:providerId,recoveryId:recovery.id,offer,bookingPreserved:true,routePreserved:true})}if(input.action==="close_recovery"){if(String(booking.status)!=="assigned")throw new Response("Replacement driver must accept before Operations can close recovery",{status:409});const recovery=await db.prepare("SELECT * FROM taxi_recovery_cases WHERE booking_id=? AND status='replacement_accepted' ORDER BY opened_at DESC LIMIT 1").bind(booking.id).first<Row>();if(!recovery)throw new Response("No accepted Pet Taxi recovery case exists",{status:409});const reason=String(input.reason||"").trim();if(reason.length<5)throw new Response("A recovery closure reason is required",{status:400});await db.prepare("UPDATE taxi_recovery_cases SET status='resolved',resolved_at=?,updated_at=?,detail_json=? WHERE id=?").bind(now,now,JSON.stringify({...parse<Record<string,unknown>>(recovery.detail_json,{}),closureReason:reason,closedBy:input.actorId,bookingPreserved:true,routePreserved:true}),recovery.id).run();await event(db,booking,"recovery_closed",input.actorId,{recoveryId:recovery.id,replacementProviderId:booking.provider_id,bookingPreserved:true,routePreserved:true});return remember(db,input,{bookingId:booking.id,tripId:booking.trip_id,status:"resolved",recoveryId:recovery.id,replacementProviderId:booking.provider_id,bookingPreserved:true,routePreserved:true})}throw new Response("Unsupported Pet Taxi Operations action",{status:400})}
