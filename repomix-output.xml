  if(action==="update_ticket"){const ticketId=String(body.id||""),status=String(body.status||""),resolution=String(body.resolution||"").trim(),rootCause=String(body.rootCause||"").trim(),evidence=String(body.evidence||"").trim();if(!["open","in_progress","waiting_customer","resolved","reopened"].includes(status))return Response.json({error:"Invalid ticket status"},{status:400});if(status==="resolved"&&(resolution.length<8||rootCause.length<4||evidence.length<4))return Response.json({error:"Resolution, root cause and evidence are mandatory"},{status:409});await db.prepare("UPDATE customer_experience_tickets SET status=?,customer_status=?,resolution=?,root_cause=?,resolution_evidence=?,reopened_count=reopened_count+?,resolved_at=?,updated_at=? WHERE id=?").bind(status,status==="resolved"?"Resolved":status==="waiting_customer"?"Waiting for your response":"Our team is working on it",resolution||null,rootCause||null,evidence||null,status==="reopened"?1:0,status==="resolved"?now:null,now,ticketId).run();await queueDelivery(db,{entityType:"ticket",entityId:ticketId,channel:"whatsapp",template:`ticket_${status}`});return Response.json({ok:true,status})}
  if(action==="toggle_close_item"){const key=String(body.key||"");if(!closeKeys.includes(key))return Response.json({error:"Invalid Accounts closure item"},{status:400});const closure=await db.prepare("SELECT * FROM finance_day_closures WHERE closure_date=?").bind(dayKey()).first<Row>();const checklist=JSON.parse(String(closure?.checklist_json||"{}")) as Record<string,{done:boolean;note:string}>;checklist[key]={done:!checklist[key]?.done,note:!checklist[key]?.done?"Checked in UAT":"Pending validation"};await db.prepare("UPDATE finance_day_closures SET checklist_json=?,status='open',updated_at=? WHERE closure_date=?").bind(JSON.stringify(checklist),now,dayKey()).run();return Response.json({ok:true,checklist})}
  if(action==="submit_accounts_close"){const closure=await db.prepare("SELECT * FROM finance_day_closures WHERE closure_date=?").bind(dayKey()).first<Row>(),checklist=JSON.parse(String(closure?.checklist_json||"{}")) as Record<string,{done:boolean}>;if(closeKeys.some(key=>!checklist[key]?.done))return Response.json({error:"All six Accounts checks are mandatory before day closure"},{status:409});if(Math.abs(Number(body.varianceAmount||0))>0&&!String(body.note||"").trim())return Response.json({error:"Variance requires a note"},{status:409});await db.prepare("UPDATE finance_day_closures SET status='submitted',variance_amount=?,note=?,submitted_by=?,submitted_at=?,updated_at=? WHERE closure_date=?").bind(Number(body.varianceAmount||0),String(body.note||"")||null,actor.email,now,now,dayKey()).run();await queueDelivery(db,{entityType:"accounts_close",entityId:dayKey(),channel:"whatsapp",template:"accounts_day_close_submitted"});return Response.json({ok:true,status:"submitted"})}
  if(action==="complete_ops"){const opsId=String(body.id||""),item=await db.prepare("SELECT * FROM ops_completion_controls WHERE id=?").bind(opsId).first<Row>();if(!item)return Response.json({error:"Operations record not found"},{status:404});const evidence=String(body.evidence||"").trim();if(evidence.length<6||!body.customerUpdated||!body.paymentConfirmed||!body.settlementReady)return Response.json({error:"Evidence, customer update, payment confirmation and settlement readiness are mandatory"},{status:409});await db.prepare("UPDATE ops_completion_controls SET status='completed',service_evidence=?,customer_update_at=?,payment_confirmed=1,provider_settlement_ready=1,exception_reason=NULL,completed_at=?,updated_at=? WHERE id=?").bind(evidence,now,now,now,opsId).run();await queueDelivery(db,{entityType:"booking",entityId:String(item.booking_id),channel:"whatsapp",template:"service_completed"});return Response.json({ok:true,status:"completed"})}
