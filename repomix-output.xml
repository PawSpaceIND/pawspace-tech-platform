<file path="lib/referral-governance.ts">
export type ReferralService="grooming"|"dog_training"|"boarding"|"pet_sitting"|"dog_walking";
export type ReferralProgrammeStatus="active"|"paused";
export type ReferralProgramme={
  id:string;name:string;status:ReferralProgrammeStatus;testOnly:boolean;eligibleServices:ReferralService[];cityIds:string[];rewardUseServices:ReferralService[];
  friendDiscount:number|null;referrerReward:number|null;perReferrerMonthlyLimit:number|null;rewardValidityDays:number|null;oneRewardPerFriend:boolean;
  reversalOnRefund:boolean|null;qualificationRule:"completed_paid_first_booking";validFrom:number;validUntil:number;createdAt:number;updatedAt:number;
};
export type ReferralClaimInput={code:string;referredCustomerId:string;serviceCode:ReferralService;cityId:string;idempotencyKey:string};

type Db=D1Database;
type Row=Record<string,unknown>;
const DAY=86_400_000;
const jsonList=(value:unknown)=>{try{return JSON.parse(String(value||"[]")) as string[]}catch{return [] as string[]}};
const normalizeCode=(value:string)=>value.trim().toUpperCase().replace(/\s+/g,"");
const normalizeIdentity=(value:unknown)=>String(value||"").trim().toLowerCase().replace(/\s+/g,"");
const monthStart=(value=Date.now())=>{const d=new Date(value);return Date.UTC(d.getUTCFullYear(),d.getUTCMonth(),1)};
const id=(prefix:string)=>`${prefix}-${crypto.randomUUID().slice(0,12).toUpperCase()}`;

export async function ensureReferralTables(db:Db){await db.batch([
  db.prepare("CREATE TABLE IF NOT EXISTS referral_programmes (id TEXT PRIMARY KEY,name TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'paused',test_only INTEGER NOT NULL DEFAULT 1,eligible_services_json TEXT NOT NULL,city_ids_json TEXT NOT NULL,reward_use_services_json TEXT NOT NULL,friend_discount REAL,referrer_reward REAL,per_referrer_monthly_limit INTEGER,reward_validity_days INTEGER,one_reward_per_friend INTEGER NOT NULL DEFAULT 1,reversal_on_refund INTEGER,qualification_rule TEXT NOT NULL DEFAULT 'completed_paid_first_booking',valid_from INTEGER NOT NULL,valid_until INTEGER NOT NULL,created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL)"),
  db.prepare("CREATE TABLE IF NOT EXISTS referral_codes (id TEXT PRIMARY KEY,programme_id TEXT NOT NULL,customer_id TEXT NOT NULL,code TEXT NOT NULL UNIQUE,status TEXT NOT NULL DEFAULT 'active',created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL)"),
  db.prepare("CREATE UNIQUE INDEX IF NOT EXISTS referral_code_customer_programme_idx ON referral_codes(programme_id,customer_id)"),
  db.prepare("CREATE TABLE IF NOT EXISTS referral_claims (id TEXT PRIMARY KEY,idempotency_key TEXT NOT NULL UNIQUE,programme_id TEXT NOT NULL,referral_code_id TEXT NOT NULL,code TEXT NOT NULL,referrer_customer_id TEXT NOT NULL,referred_customer_id TEXT NOT NULL,service_code TEXT NOT NULL,city_id TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'pending_booking',fraud_state TEXT NOT NULL DEFAULT 'pending_identity',first_booking_id TEXT UNIQUE,policy_snapshot_json TEXT NOT NULL,review_reason TEXT,created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL)"),
  db.prepare("CREATE UNIQUE INDEX IF NOT EXISTS referral_claim_friend_programme_idx ON referral_claims(programme_id,referred_customer_id)"),
  db.prepare("CREATE TABLE IF NOT EXISTS referral_rewards (id TEXT PRIMARY KEY,claim_id TEXT NOT NULL UNIQUE,programme_id TEXT NOT NULL,referrer_customer_id TEXT NOT NULL,referred_customer_id TEXT NOT NULL,source_booking_id TEXT NOT NULL UNIQUE,amount REAL NOT NULL,status TEXT NOT NULL DEFAULT 'pending',valid_until INTEGER NOT NULL,policy_snapshot_json TEXT NOT NULL,released_at INTEGER,reversed_at INTEGER,created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL)"),
  db.prepare("CREATE TABLE IF NOT EXISTS referral_reward_events (id TEXT PRIMARY KEY,reward_id TEXT NOT NULL,event_type TEXT NOT NULL,amount REAL NOT NULL,reason TEXT,actor_id TEXT NOT NULL,created_at INTEGER NOT NULL)"),
  db.prepare("CREATE TABLE IF NOT EXISTS referral_reward_reservations (id TEXT PRIMARY KEY,idempotency_key TEXT NOT NULL UNIQUE,reward_id TEXT NOT NULL UNIQUE,customer_id TEXT NOT NULL,booking_id TEXT NOT NULL UNIQUE,amount REAL NOT NULL,status TEXT NOT NULL DEFAULT 'uat_reserved',created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL)"),
]);}

function rowToProgramme(row:Row):ReferralProgramme{return{
  id:String(row.id),name:String(row.name),status:String(row.status) as ReferralProgrammeStatus,testOnly:Number(row.test_only)===1,
  eligibleServices:jsonList(row.eligible_services_json) as ReferralService[],cityIds:jsonList(row.city_ids_json),rewardUseServices:jsonList(row.reward_use_services_json) as ReferralService[],
  friendDiscount:row.friend_discount==null?null:Number(row.friend_discount),referrerReward:row.referrer_reward==null?null:Number(row.referrer_reward),
  perReferrerMonthlyLimit:row.per_referrer_monthly_limit==null?null:Number(row.per_referrer_monthly_limit),rewardValidityDays:row.reward_validity_days==null?null:Number(row.reward_validity_days),
  oneRewardPerFriend:Number(row.one_reward_per_friend)===1,reversalOnRefund:row.reversal_on_refund==null?null:Number(row.reversal_on_refund)===1,
  qualificationRule:"completed_paid_first_booking",validFrom:Number(row.valid_from),validUntil:Number(row.valid_until),createdAt:Number(row.created_at),updatedAt:Number(row.updated_at)
};}

export async function seedReferralProgramme(db:Db){await ensureReferralTables(db);const now=Date.now();await db.prepare("INSERT OR IGNORE INTO referral_programmes (id,name,status,test_only,eligible_services_json,city_ids_json,reward_use_services_json,friend_discount,referrer_reward,per_referrer_monthly_limit,reward_validity_days,one_reward_per_friend,reversal_on_refund,qualification_rule,valid_from,valid_until,created_at,updated_at) VALUES ('uat-referral-programme','UAT Referral Programme','paused',1,?,?,?,NULL,NULL,NULL,NULL,1,NULL,'completed_paid_first_booking',?,?,?,?)").bind(JSON.stringify(["grooming","dog_training","boarding","pet_sitting"]),JSON.stringify(["blr"]),JSON.stringify(["grooming","dog_training","boarding","pet_sitting"]),now-DAY,now+365*DAY,now,now).run();}

function requireActiveConfiguration(programme:ReferralProgramme){if(programme.status!=="active")throw new Error("Referral programme is paused");if(!programme.testOnly)throw new Error("Only UAT referral programmes are enabled in this gate");if(programme.friendDiscount==null||programme.friendDiscount<0)throw new Error("Referral friend discount is configuration_required");if(programme.referrerReward==null||programme.referrerReward<=0)throw new Error("Referral reward amount is configuration_required");if(programme.perReferrerMonthlyLimit==null||programme.perReferrerMonthlyLimit<1)throw new Error("Referral monthly limit is configuration_required");if(programme.rewardValidityDays==null||programme.rewardValidityDays<1)throw new Error("Referral reward validity is configuration_required");if(programme.reversalOnRefund==null)throw new Error("Referral refund/reversal policy is configuration_required");}

export async function listReferralDirectory(db:Db){await seedReferralProgramme(db);const [programmes,codes,claims,rewards,reservations]=await Promise.all([
  db.prepare("SELECT * FROM referral_programmes ORDER BY created_at DESC").all<Row>(),
  db.prepare("SELECT c.*,p.name programme_name FROM referral_codes c JOIN referral_programmes p ON p.id=c.programme_id ORDER BY c.created_at DESC LIMIT 200").all<Row>(),
  db.prepare("SELECT * FROM referral_claims ORDER BY created_at DESC LIMIT 200").all<Row>(),
  db.prepare("SELECT * FROM referral_rewards ORDER BY created_at DESC LIMIT 200").all<Row>(),
  db.prepare("SELECT * FROM referral_reward_reservations ORDER BY created_at DESC LIMIT 200").all<Row>(),
]);return{programmes:programmes.results.map(rowToProgramme),codes:codes.results,claims:claims.results,rewards:rewards.results,reservations:reservations.results,testOnly:true,productionReady:false};}

export async function saveReferralProgramme(db:Db,input:Omit<ReferralProgramme,"createdAt"|"updatedAt"|"testOnly"|"qualificationRule">){await seedReferralProgramme(db);const now=Date.now();if(!input.name.trim())throw new Error("Programme name is required");if(!input.eligibleServices.length||!input.cityIds.length||!input.rewardUseServices.length)throw new Error("Referral service and city scope are required");if(input.validUntil<=input.validFrom)throw new Error("Referral validity window is invalid");if(input.friendDiscount!=null&&input.friendDiscount<0)throw new Error("Friend discount cannot be negative");if(input.referrerReward!=null&&input.referrerReward<=0)throw new Error("Referrer reward must be positive when configured");if(input.perReferrerMonthlyLimit!=null&&input.perReferrerMonthlyLimit<1)throw new Error("Monthly reward limit must be positive when configured");if(input.rewardValidityDays!=null&&input.rewardValidityDays<1)throw new Error("Reward validity must be positive when configured");const programme={...input,testOnly:true,qualificationRule:"completed_paid_first_booking" as const,createdAt:now,updatedAt:now};if(programme.status==="active")requireActiveConfiguration(programme);await db.prepare("INSERT INTO referral_programmes (id,name,status,test_only,eligible_services_json,city_ids_json,reward_use_services_json,friend_discount,referrer_reward,per_referrer_monthly_limit,reward_validity_days,one_reward_per_friend,reversal_on_refund,qualification_rule,valid_from,valid_until,created_at,updated_at) VALUES (?,?,?,1,?,?,?,?,?,?,?,?,?,'completed_paid_first_booking',?,?,?,?) ON CONFLICT(id) DO UPDATE SET name=excluded.name,status=excluded.status,test_only=1,eligible_services_json=excluded.eligible_services_json,city_ids_json=excluded.city_ids_json,reward_use_services_json=excluded.reward_use_services_json,friend_discount=excluded.friend_discount,referrer_reward=excluded.referrer_reward,per_referrer_monthly_limit=excluded.per_referrer_monthly_limit,reward_validity_days=excluded.reward_validity_days,one_reward_per_friend=excluded.one_reward_per_friend,reversal_on_refund=excluded.reversal_on_refund,valid_from=excluded.valid_from,valid_until=excluded.valid_until,updated_at=excluded.updated_at").bind(input.id,input.name.trim(),input.status,JSON.stringify(input.eligibleServices),JSON.stringify(input.cityIds),JSON.stringify(input.rewardUseServices),input.friendDiscount,input.referrerReward,input.perReferrerMonthlyLimit,input.rewardValidityDays,input.oneRewardPerFriend?1:0,input.reversalOnRefund==null?null:input.reversalOnRefund?1:0,input.validFrom,input.validUntil,now,now).run();const row=await db.prepare("SELECT * FROM referral_programmes WHERE id=?").bind(input.id).first<Row>();if(!row)throw new Error("Referral programme could not be saved");return rowToProgramme(row);}

export async function ensureReferralCode(db:Db,input:{programmeId:string;customerId:string}){await seedReferralProgramme(db);if(!input.customerId.trim())throw new Error("Referrer customer is required");const customer=await db.prepare("SELECT id FROM canonical_customers WHERE id=?").bind(input.customerId).first<Row>();if(!customer)throw new Error("Referrer must be a canonical customer");const programmeRow=await db.prepare("SELECT * FROM referral_programmes WHERE id=?").bind(input.programmeId).first<Row>();if(!programmeRow)throw new Error("Referral programme not found");const prior=await db.prepare("SELECT * FROM referral_codes WHERE programme_id=? AND customer_id=?").bind(input.programmeId,input.customerId).first<Row>();if(prior)return{code:String(prior.code),codeId:String(prior.id),duplicatePrevented:true};const now=Date.now(),codeId=id("RFC"),code=`REF-${crypto.randomUUID().replaceAll("-","").slice(0,8).toUpperCase()}`;await db.prepare("INSERT INTO referral_codes (id,programme_id,customer_id,code,status,created_at,updated_at) VALUES (?,?,?,?, 'active',?,?)").bind(codeId,input.programmeId,input.customerId,code,now,now).run();return{code,codeId,duplicatePrevented:false};}

async function identityRisk(db:Db,referrerCustomerId:string,referredCustomerId:string){const [a,b]=await Promise.all([db.prepare("SELECT id,primary_phone,email FROM canonical_customers WHERE id=?").bind(referrerCustomerId).first<Row>(),db.prepare("SELECT id,primary_phone,email FROM canonical_customers WHERE id=?").bind(referredCustomerId).first<Row>()]);if(!a||!b)return{state:"pending_identity",reason:"Referred identity will be rechecked at qualification"};const phoneA=normalizeIdentity(a.primary_phone),phoneB=normalizeIdentity(b.primary_phone),emailA=normalizeIdentity(a.email),emailB=normalizeIdentity(b.email);if(phoneA&&phoneB&&phoneA===phoneB)return{state:"hold",reason:"Referrer and referred customer share the same canonical phone"};if(emailA&&emailB&&emailA===emailB)return{state:"hold",reason:"Referrer and referred customer share the same canonical email"};return{state:"clear",reason:null};}

export async function claimReferral(db:Db,input:ReferralClaimInput){await seedReferralProgramme(db);const code=normalizeCode(input.code);if(!code||!input.referredCustomerId||!input.serviceCode||!input.cityId||!input.idempotencyKey)return{matched:false,error:"Complete referral context is required"};const priorByKey=await db.prepare("SELECT * FROM referral_claims WHERE idempotency_key=?").bind(input.idempotencyKey).first<Row>();if(priorByKey){if(String(priorByKey.code)!==code||String(priorByKey.referred_customer_id)!==input.referredCustomerId||String(priorByKey.service_code)!==input.serviceCode||String(priorByKey.city_id)!==input.cityId)return{matched:true,error:"Referral idempotency key was already used for different claim context"};return{matched:true,claimId:String(priorByKey.id),status:String(priorByKey.status),friendDiscount:JSON.parse(String(priorByKey.policy_snapshot_json||"{}")).friendDiscount??0,duplicatePrevented:true,bookingPricingAuthoritative:false};}const codeRow=await db.prepare("SELECT * FROM referral_codes WHERE code=? AND status='active'").bind(code).first<Row>();if(!codeRow)return{matched:false,error:"Referral code not found"};const programmeRow=await db.prepare("SELECT * FROM referral_programmes WHERE id=?").bind(codeRow.programme_id).first<Row>();if(!programmeRow)return{matched:true,error:"Referral programme not found"};const programme=rowToProgramme(programmeRow);try{requireActiveConfiguration(programme)}catch(error){return{matched:true,error:error instanceof Error?error.message:"Referral programme is unavailable"}}const now=Date.now();if(now<programme.validFrom||now>programme.validUntil)return{matched:true,error:"Referral programme is outside its validity window"};if(!programme.eligibleServices.includes(input.serviceCode))return{matched:true,error:"Referral is not eligible for this service"};if(!programme.cityIds.includes(input.cityId))return{matched:true,error:"Referral is not eligible in this city"};const referrerCustomerId=String(codeRow.cust