import{seedProviderCapacityDefaults}from"./provider-capacity-governance";
import{splitPaymentPlan}from"./stay-split-payments";
import{sameInstant}from"./booking-window-instant";

type Row=Record<string,unknown>;
export type BoardingPaymentMode="prepaid"|"split_50_50";
export type BoardingQuote={quoteId:string;packageCode:string;packageName:string;packageVersion:number;petCount:number;cityId:string;zoneId:string;scheduledStart:string;scheduledEnd:string;durationHours:number;stayUnits:number;basePricePerPet:number;totalAmount:number;amountDueNow:number;paymentMode:BoardingPaymentMode;expiresAt:number};

const packages=[
 {code:"boarding-4h",name:"Standard Stay",kind:"daycare",maxHours:4,basePrice:499,maxPets:4},
 {code:"boarding-10h",name:"Premium Stay",kind:"daycare",maxHours:10,basePrice:599,maxPets:4},
 {code:"boarding-24h",name:"Luxury Stay",kind:"overnight",maxHours:24,basePrice:699,maxPets:4},
] as const;
const hosts=[
 {providerId:"host_maya_rohan",cityId:"blr",zoneId:"blr-east",area:"Indiranagar",species:["dog"],maxGuestPets:2,oneFamilyOnly:1,medicationSupport:1,residentPets:"none",homeVerified:1,kyc:"verified",background:"verified"},
 {providerId:"host_sana",cityId:"blr",zoneId:"blr-east",area:"HSR Layout",species:["dog","cat"],maxGuestPets:2,oneFamilyOnly:1,medicationSupport:1,residentPets:"none",homeVerified:1,kyc:"verified",background:"verified"},
 {providerId:"host_arjun_tara",cityId:"blr",zoneId:"blr-east",area:"Koramangala",species:["dog"],maxGuestPets:3,oneFamilyOnly:0,medicationSupport:0,residentPets:"beagle",homeVerified:1,kyc:"verified",background:"verified"},
 // Second cat-accepting host: host_sana is one_family_only, so without this any single overlapping
 // commitment made dog+cat boarding (the app's default pet selection) fully unavailable.
 {providerId:"host_priya_dev",cityId:"blr",zoneId:"blr-east",area:"Whitefield",species:["dog","cat"],maxGuestPets:4,oneFamilyOnly:0,medicationSupport:1,residentPets:"none",homeVerified:1,kyc:"verified",background:"verified"},
] as const;

async function ensureQuoteColumn(db:D1Database,column:string,definition:string){
 const columns=await db.prepare("PRAGMA table_info(boarding_commercial_quotes)").all<Row>();
 if(columns.results.some(row=>String(row.name)===column))return;
 try{await db.prepare(`ALTER TABLE boarding_commercial_quotes ADD COLUMN ${column} ${definition}`).run();}
 catch(error){const after=await db.prepare("PRAGMA table_info(boarding_commercial_quotes)").all<Row>();if(!after.results.some(row=>String(row.name)===column))throw error;}
}

export async function ensureBoardingGovernanceTables(db:D1Database){await seedProviderCapacityDefaults(db);await db.batch([
 db.prepare("CREATE TABLE IF NOT EXISTS boarding_commercial_packages (package_code TEXT PRIMARY KEY,name TEXT NOT NULL,care_kind TEXT NOT NULL,max_hours INTEGER NOT NULL,base_price_per_pet REAL NOT NULL,currency TEXT NOT NULL DEFAULT 'INR',max_pets INTEGER NOT NULL DEFAULT 4,active INTEGER NOT NULL DEFAULT 1,version INTEGER NOT NULL DEFAULT 1,effective_from TEXT NOT NULL,effective_to TEXT,updated_by TEXT NOT NULL,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS boarding_commercial_quotes (id TEXT PRIMARY KEY,package_code TEXT NOT NULL,package_version INTEGER NOT NULL,pet_count INTEGER NOT NULL,city_id TEXT NOT NULL DEFAULT 'blr',zone_id TEXT NOT NULL DEFAULT 'blr-east',scheduled_start TEXT NOT NULL,scheduled_end TEXT NOT NULL,duration_hours REAL NOT NULL,stay_units INTEGER NOT NULL,payment_mode TEXT NOT NULL,total_amount REAL NOT NULL,amount_due_now REAL NOT NULL,expires_at INTEGER NOT NULL,status TEXT NOT NULL DEFAULT 'open',created_at INTEGER NOT NULL,used_at INTEGER,used_booking_id TEXT)"),
 db.prepare("CREATE INDEX IF NOT EXISTS idx_boarding_quote_expiry ON boarding_commercial_quotes(status,expires_at)"),
 db.prepare("CREATE TABLE IF NOT EXISTS boarding_booking_quote_links (quote_id TEXT PRIMARY KEY,booking_id TEXT NOT NULL UNIQUE,created_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS boarding_host_profiles (provider_id TEXT PRIMARY KEY,city_id TEXT NOT NULL,zone_id TEXT NOT NULL,area TEXT NOT NULL,species_json TEXT NOT NULL,max_guest_pets INTEGER NOT NULL,one_family_only INTEGER NOT NULL DEFAULT 0,medication_support INTEGER NOT NULL DEFAULT 0,resident_pets TEXT NOT NULL DEFAULT 'none',home_verified INTEGER NOT NULL DEFAULT 0,kyc_status TEXT NOT NULL DEFAULT 'pending',background_check_status TEXT NOT NULL DEFAULT 'pending',active INTEGER NOT NULL DEFAULT 1,version INTEGER NOT NULL DEFAULT 1,updated_by TEXT NOT NULL,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS boarding_stays (id TEXT PRIMARY KEY,booking_id TEXT NOT NULL UNIQUE,customer_id TEXT NOT NULL,host_provider_id TEXT NOT NULL,city_id TEXT NOT NULL,zone_id TEXT NOT NULL,package_code TEXT NOT NULL,check_in_at TEXT NOT NULL,check_out_at TEXT NOT NULL,billed_units INTEGER NOT NULL,pet_count INTEGER NOT NULL,status TEXT NOT NULL DEFAULT 'awaiting_host_acceptance',care_plan_status TEXT NOT NULL DEFAULT 'required',check_in_status TEXT NOT NULL DEFAULT 'pending',check_out_status TEXT NOT NULL DEFAULT 'pending',extension_status TEXT NOT NULL DEFAULT 'none',created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS boarding_stay_events (id TEXT PRIMARY KEY,stay_id TEXT NOT NULL,booking_id TEXT NOT NULL,event_type TEXT NOT NULL,actor_id TEXT NOT NULL,detail_json TEXT NOT NULL DEFAULT '{}',created_at INTEGER NOT NULL)"),
 ]);await ensureQuoteColumn(db,"city_id","TEXT NOT NULL DEFAULT 'blr'");await ensureQuoteColumn(db,"zone_id","TEXT NOT NULL DEFAULT 'blr-east'");
  // Same defect and same shape as Pet Sitting: a stay priced at 2500/unit by Pricing Control was
  // governed as {basePricePerPet:699, stayUnits:2, totalAmount:5000} - 699 x 2 = 1398 against 5000
  // actually charged - because the priced unit was never written back to the quote row. Nullable and
  // additive; a quote that was never repriced falls back to the package column. [PTJA-W1-F15]
  await ensureQuoteColumn(db,"priced_base_price_per_pet","REAL");const now=Date.now();for(const item of packages)await db.prepare("INSERT OR IGNORE INTO boarding_commercial_packages (package_code,name,care_kind,max_hours,base_price_per_pet,currency,max_pets,active,version,effective_from,effective_to,updated_by,updated_at) VALUES (?,?,?,?,?,'INR',?,1,1,'2026-08-01',NULL,'founder_seed',?)").bind(item.code,item.name,item.kind,item.maxHours,item.basePrice,item.maxPets,now).run();for(const host of hosts)await db.prepare("INSERT OR IGNORE INTO boarding_host_profiles (provider_id,city_id,zone_id,area,species_json,max_guest_pets,one_family_only,medication_support,resident_pets,home_verified,kyc_status,background_check_status,active,version,updated_by,updated_at) VALUES (?,?,?,?,?,?,?,?,?,?,?, ?,1,1,'founder_seed',?)").bind(host.providerId,host.cityId,host.zoneId,host.area,JSON.stringify(host.species),host.maxGuestPets,host.oneFamilyOnly,host.medicationSupport,host.residentPets,host.homeVerified,host.kyc,host.background,now).run();for(const host of hosts)await db.prepare("UPDATE provider_capacity_profiles SET capacity=?,updated_at=? WHERE id=? AND updated_by='founder_seed' AND version=1").bind(host.maxGuestPets,now,host.providerId).run();}

function activePackage(row:Row,at:string){const date=at.slice(0,10);return Number(row.active)===1&&date>=String(row.effective_from)&&(!row.effective_to||date<=String(row.effective_to));}
function durationHours(start:string,end:string){return(new Date(end).getTime()-new Date(start).getTime())/3_600_000;}
function unitsFor(row:Row,hours:number){if(String(row.care_kind)==="daycare"){if(hours<=0||hours>Number(row.max_hours))throw new Response(`${String(row.name)} supports up to ${Number(row.max_hours)} hours`,{status:409});return 1;}if(hours<=10)throw new Response("Overnight Boarding requires more than 10 hours",{status:409});return Math.max(1,Math.ceil(hours/24));}

export async function listBoardingPackages(db:D1Database,at=new Date().toISOString()){await ensureBoardingGovernanceTables(db);const date=at.slice(0,10);const rows=await db.prepare("SELECT package_code,name,care_kind,max_hours,base_price_per_pet,currency,max_pets,version FROM boarding_commercial_packages WHERE active=1 AND effective_from<=? AND (effective_to IS NULL OR effective_to>=?) ORDER BY max_hours").bind(date,date).all<Row>();return rows.results;}

export async function listBoardingHosts(db:D1Database,input:{cityId:string;zoneId:string;at?:string}){await ensureBoardingGovernanceTables(db);const date=(input.at||new Date().toISOString()).slice(0,10);const rows=await db.prepare("SELECT h.provider_id,h.area,h.species_json,h.max_guest_pets,h.one_family_only,h.medication_support,h.resident_pets,h.home_verified,h.kyc_status,h.background_check_status,h.version,p.name,p.provider_model,p.rating,p.quality_score,p.capacity,p.status,p.live FROM boarding_host_profiles h JOIN provider_capacity_profiles p ON p.id=h.provider_id WHERE h.city_id=? AND h.zone_id=? AND h.active=1 AND p.live=1 AND p.status='active' AND p.effective_from<=? AND (p.effective_to IS NULL OR p.effective_to>=?) ORDER BY p.quality_score DESC,p.rating DESC").bind(input.cityId,input.zoneId,date,date).all<Row>();return rows.results.map(row=>({providerId:String(row.provider_id),name:String(row.name),model:String(row.provider_model),area:String(row.area),rating:Number(row.rating||0),qualityScore:Number(row.quality_score||0),capacity:Number(row.capacity||row.max_guest_pets||1),species:JSON.parse(String(row.species_json||"[]")) as string[],oneFamilyOnly:Boolean(row.one_family_only),medicationSupport:Boolean(row.medication_support),residentPets:String(row.resident_pets),homeVerified:Boolean(row.home_verified),kycStatus:String(row.kyc_status),backgroundCheckStatus:String(row.background_check_status),profileVersion:Number(row.version||1)}));}

export async function createBoardingQuote(db:D1Database,input:{packageCode:string;petCount:number;scheduledStart:string;scheduledEnd:string;paymentMode:BoardingPaymentMode;couponCode?:string;cityId?:string;zoneId?:string}){await ensureBoardingGovernanceTables(db);const startMs=new Date(input.scheduledStart).getTime(),endMs=new Date(input.scheduledEnd).getTime();if(!Number.isFinite(startMs)||!Number.isFinite(endMs)||endMs<=startMs)throw new Response("Boarding quote requires a valid future stay window",{status:400});if(startMs<=Date.now())throw new Response("Boarding quote requires a future check-in",{status:400});if(input.paymentMode!=="prepaid"&&input.paymentMode!=="split_50_50")throw new Response("Boarding supports full prepaid or the approved 50/50 split payment",{status:409});if(String(input.couponCode||"").trim())throw new Response("Boarding coupon policy is not enabled in the canonical catalogue",{status:409});const row=await db.prepare("SELECT * FROM boarding_commercial_packages WHERE package_code=?").bind(input.packageCode).first<Row>();if(!row||!activePackage(row,input.scheduledStart))throw new Response("Active Boarding package not found for this date",{status:404});const petCount=Math.floor(Number(input.petCount));if(petCount<1||petCount>Number(row.max_pets))throw new Response(`Boarding supports 1-${Number(row.max_pets)} pets per booking`,{status:409});const cityId=String(input.cityId||"blr"),zoneId=String(input.zoneId||"blr-east"),hours=durationHours(input.scheduledStart,input.scheduledEnd),stayUnits=unitsFor(row,hours),basePricePerPet=Number(row.base_price_per_pet),totalAmount=basePricePerPet*petCount*stayUnits,amountDueNow=input.paymentMode==="split_50_50"?splitPaymentPlan({totalAmount,scheduledStart:input.scheduledStart}).dueNow:totalAmount,now=Date.now(),expiresAt=now+15*60_000,id=`BQ-${crypto.randomUUID().slice(0,12).toUpperCase()}`;await db.prepare("INSERT INTO boarding_commercial_quotes (id,package_code,package_version,pet_count,city_id,zone_id,scheduled_start,scheduled_end,duration_hours,stay_units,payment_mode,total_amount,amount_due_now,expires_at,status,created_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,'open',?)").bind(id,row.package_code,row.version,petCount,cityId,zoneId,input.scheduledStart,input.scheduledEnd,hours,stayUnits,input.paymentMode,totalAmount,amountDueNow,expiresAt,now).run();return{quoteId:id,packageCode:String(row.package_code),packageName:String(row.name),packageVersion:Number(row.version),petCount,cityId,zoneId,scheduledStart:input.scheduledStart,scheduledEnd:input.scheduledEnd,durationHours:hours,stayUnits,basePricePerPet,totalAmount,amountDueNow,paymentMode:input.paymentMode,expiresAt} satisfies BoardingQuote;}

/*
 * The five host capability answers are matched in lib/boarding-host-capability.ts. [PTJA-W3-BH]
 *
 * This function already checked zone, species and declared capacity. It never checked medication
 * handling - the column was read by nothing at all, so a host who cannot give medication was matched
 * to a pet that needs it every time - and it never checked one-family-at-a-time at BOOKING time, only
 * later at stay acceptance, which turns a matching decision into a failed handover.
 *
 * The verification checks below are UNCHANGED. Boarding's home/KYC/background requirements predate this
 * work and are not extended by it: the police floor remains Dog Walking and Pet Taxi.
 */
async function assertHostEligible(db:D1Database,input:{providerId:string;cityId:string;zoneId:string;petCount:number;species:string[];vaccinationStatuses:string[];medicationRequired?:boolean;customerId?:string|null}){
  const{assertBoardingHostMatches}=await import("./boarding-host-capability");
  await assertBoardingHostMatches(db,{providerId:input.providerId,cityId:input.cityId,zoneId:input.zoneId,
    species:input.species,petCount:input.petCount,medicationRequired:Boolean(input.medicationRequired),customerId:input.customerId??null});const row=await db.prepare("SELECT h.*,p.services_json,p.zones_json,p.live,p.status provider_status FROM boarding_host_profiles h JOIN provider_capacity_profiles p ON p.id=h.provider_id WHERE h.provider_id=?").bind(input.providerId).first<Row>();if(!row||Number(row.active)!==1||!Boolean(row.live)||String(row.provider_status)!=="active")throw new Response("Selected Boarding host is not active",{status:409});if(String(row.city_id)!==input.cityId||String(row.zone_id)!==input.zoneId)throw new Response("Selected Boarding host is outside the booking zone",{status:409});if(Number(row.home_verified)!==1||String(row.kyc_status)!=="verified"||String(row.background_check_status)!=="verified")throw new Response("Selected Boarding host has not completed required verification",{status:409});const supported=JSON.parse(String(row.species_json||"[]")) as string[];if(input.species.some(species=>!supported.includes(species)))throw new Response("Selected Boarding host is not eligible for every pet species",{status:409});if(input.petCount>Number(row.max_guest_pets))throw new Response("Selected Boarding host capacity is lower than the pet count",{status:409});if(input.vaccinationStatuses.some(status=>status!=="verified"))throw new Response("Boarding requires verified vaccination for every pet",{status:409});return{providerId:String(row.provider_id),profileVersion:Number(row.version||1),maxGuestPets:Number(row.max_guest_pets),oneFamilyOnly:Boolean(row.one_family_only),medicationSupport:Boolean(row.medication_support)};}

export async function governBoardingBooking(db:D1Database,input:{quoteId:string;packageCode:string;packageName:string;petCount:number;scheduledStart:string;scheduledEnd:string;submittedTotal:number;submittedAmountDueNow:number;paymentMode:string;paymentStatus:string;reservationCount:number;providerId:string;cityId:string;zoneId:string;species:string[];vaccinationStatuses:string[];medicationRequired?:boolean;customerId?:string|null}){await ensureBoardingGovernanceTables(db);const linked=await db.prepare("SELECT booking_id FROM boarding_booking_quote_links WHERE quote_id=?").bind(input.quoteId).first<Row>();if(linked)throw new Response("Boarding quote is already linked to a booking",{status:409});const quote=await db.prepare("SELECT q.*,p.name,p.base_price_per_pet FROM boarding_commercial_quotes q JOIN boarding_commercial_packages p ON p.package_code=q.package_code AND p.version=q.package_version WHERE q.id=?").bind(input.quoteId).first<Row>();if(!quote)throw new Response("A valid server Boarding quote is required",{status:409});if(String(quote.status)!=="open")throw new Response("Boarding quote has already been used",{status:409});if(Number(quote.expires_at)<Date.now())throw new Response("Boarding quote expired; refresh price and availability",{status:409});if(String(quote.package_code)!==input.packageCode||String(quote.name)!==input.packageName)throw new Response("Boarding package does not match the server quote",{status:409});if(Number(quote.pet_count)!==input.petCount)throw new Response("Boarding pet count changed after quote",{status:409});if(String(quote.city_id)!==input.cityId||String(quote.zone_id)!==input.zoneId)throw new Response("Boarding quote city/zone does not match the scheduling reservation",{status:409});if(!sameInstant(quote.scheduled_start,input.scheduledStart)||!sameInstant(quote.scheduled_end,input.scheduledEnd))throw new Response("Boarding stay window changed after quote",{status:409});if(Number(quote.total_amount)!==input.submittedTotal||Number(quote.amount_due_now)!==input.submittedAmountDueNow)throw new Response("Boarding amount does not match the server quote",{status:409});if(String(quote.payment_mode)!==input.paymentMode)throw new Response("Boarding payment mode does not match the server quote",{status:409});if(input.paymentStatus!=="captured")throw new Response("Boarding payment must be captured in sandbox before confirmation",{status:409});if(input.reservationCount!==1)throw new Response("Boarding requires exactly one continuous stay reservation",{status:409});const host=await assertHostEligible(db,input);return{quoteId:String(quote.id),packageCode:String(quote.package_code),packageName:String(quote.name),catalogueVersion:`boarding-v${Number(quote.package_version)}`,petCount:Number(quote.pet_count),scheduledStart:String(quote.scheduled_start),scheduledEnd:String(quote.scheduled_end),durationHours:Number(quote.duration_hours),stayUnits:Number(quote.stay_units),basePricePerPet:Number(quote.priced_base_price_per_pet??quote.base_price_per_pet),totalAmount:Number(quote.total_amount),amountDueNow:Number(quote.amount_due_now),paymentMode:String(quote.payment_mode),host};}

export function boardingQuoteLinkStatement(db:D1Database,quoteId:string,bookingId:string){return db.prepare("INSERT INTO boarding_booking_quote_links (quote_id,booking_id,created_at) VALUES (?,?,?)").bind(quoteId,bookingId,Date.now());}
export function boardingStayStatement(db:D1Database,input:{bookingId:string;customerId:string;providerId:string;cityId:string;zoneId:string;packageCode:string;scheduledStart:string;scheduledEnd:string;stayUnits:number;petCount:number}){const now=Date.now();return db.prepare("INSERT INTO boarding_stays (id,booking_id,customer_id,host_provider_id,city_id,zone_id,package_code,check_in_at,check_out_at,billed_units,pet_count,status,care_plan_status,check_in_status,check_out_status,extension_status,created_at,updated_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,'awaiting_host_acceptance','required','pending','pending','none',?,?)").bind(`BSTAY-${crypto.randomUUID().slice(0,10).toUpperCase()}`,input.bookingId,input.customerId,input.providerId,input.cityId,input.zoneId,input.packageCode,input.scheduledStart,input.scheduledEnd,input.stayUnits,input.petCount,now,now);}
export async function consumeBoardingQuote(db:D1Database,quoteId:string,bookingId:string){const result=await db.prepare("UPDATE boarding_commercial_quotes SET status='used',used_at=?,used_booking_id=? WHERE id=? AND status='open'").bind(Date.now(),bookingId,quoteId).run();if(Number(result.meta.changes||0)!==1)throw new Response("Boarding quote could not be consumed exactly once",{status:409});}
