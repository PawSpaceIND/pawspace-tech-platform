type Row=Record<string,unknown>;
export type TaxiMediaPurpose="taxi_update"|"taxi_incident"|"taxi_dropoff";
export type TaxiProofAction="prepare_media"|"sandbox_finalize_media"|"record_media_scan"|"revoke_media"|"record_location_sample"|"record_photo_update"|"report_incident"|"acknowledge_incident"|"resolve_incident";
export type TaxiProofInput={bookingId:string;action:TaxiProofAction;actorId:string;idempotencyKey:string;purpose?:TaxiMediaPurpose;mimeType?:string;sizeBytes?:number;sha256?:string;uploadToken?:string;storageObjectId?:string;mediaRef?:string;scanResult?:"clean"|"rejected";reason?:string;note?:string;latitude?:number;longitude?:number;accuracyMeters?:number;incidentId?:string;severity?:"attention"|"urgent"|"emergency";summary?:string;actionTaken?:string;resolution?:string};
const allowedMime=new Set(["image/jpeg","image/png","image/webp"]),allowedPurpose=new Set<TaxiMediaPurpose>(["taxi_update","taxi_incident","taxi_dropoff"]),parse=<T>(value:unknown,fallback:T):T=>{try{return JSON.parse(String(value??"")) as T}catch{return fallback}},mediaIdFromRef=(ref:string)=>{const prefix="media://asset/";if(!ref.startsWith(prefix))throw new Response("Pet Taxi proof must use a PawSpace media reference",{status:400});const id=ref.slice(prefix.length).trim();if(!id||id.includes("/")||id.includes("?")||id.includes("#"))throw new Response("Invalid PawSpace media asset reference",{status:400});return id};
async function digest(value:string){const hash=await crypto.subtle.digest("SHA-256",new TextEncoder().encode(value));return Array.from(new Uint8Array(hash)).map(byte=>byte.toString(16).padStart(2,"0")).join("")}
export async function ensureTaxiProofTables(db:D1Database){await ensureTaxiLifecycleTables(db);await ensureServiceMediaTable(db);await db.batch([
