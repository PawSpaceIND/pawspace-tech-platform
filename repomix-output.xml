export async function loadCustomerBoardingStay(bookingId:string){const response=await fetch(`/api/boarding-stays?scope=customer&bookingId=${encodeURIComponent(bookingId)}`,{cache:"no-store"}),payload=await body<BoardingStay[]>(response);return(payload.data??[])[0]??null;}
