  const incidentId=String(input.incidentId||"").trim(),resolution=String(input.resolution||"").trim();if(resolution.length<5)throw new Response("Incident resolution is required",{status:400});const incident=await db.prepare("SELECT * FROM sitting_incidents WHERE id=? AND booking_id=?").bind(incidentId,b.id).first<Row>();if(!incident)throw new Response("Sitting incident not found",{status:404});if(String(incident.reported_by)===input.actorId)throw new Response("A Sitting incident cannot be resolved by the actor who reported it",{status:403});if(String(incident.status)==="resolved")return remember(db,input,{bookingId:b.id,incidentId,status:"resolved",duplicateResolution:true});await db.prepare("UPDATE sitting_incidents SET status='resolved',ops_status='resolved',resolution=?,resolved_by=?,resolved_at=?,updated_at=? WHERE id=?").bind(resolution,input.actorId,now,now,incidentId).run();await incidentEvent(db,incidentId,String(b.id),"resolved",input.actorId,{resolution,automaticRefund:false,automaticPayoutChange:false});return remember(db,input,{bookingId:b.id,incidentId,status:"resolved",automaticRefund:false,automaticPayoutChange:false});
 }
 throw new Response("Unsupported Sitting proof action",{status:400});
}

