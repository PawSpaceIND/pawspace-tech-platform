<file path="lib/taxi-ops-governance.ts">
import{ensureTaxiFinanceTables}from"./taxi-finance-governance";
import{ensureTaxiProofTables}from"./taxi-proof-governance";
import{createAssignmentOffer,ensureProviderCapacityTables}from"./provider-capacity-governance";
type Row=Record<string,unknown>;
export type TaxiOpsAction="assign_replacement"|"close_recovery"|"add_note";
export type TaxiOpsInput={bookingId:string;action:TaxiOpsAction;actorId:string;idempotencyKey:string;providerId?:string;reason?:string;note?:string};
const parse=<T>(value:unknown,fallback:T):T=>{try{return JSON.parse(String(value??"")) as T}catch{return fallback}};
export async function ensureTaxiOpsTables(db:D1Database){await ensureTaxiFinanceTables(db);await ensureTaxiProofTables(db);await ensureProviderCapacityTables(db);await db.batch([db.prepare("CREATE TABLE IF NOT EXISTS taxi_trips (id TEXT PRIMARY KEY,booking_id TEXT NOT NULL UNIQUE,schedule_group_id TEXT NOT NULL,reservation_id TEXT NOT NULL UNIQUE,provider_id TEXT NOT NULL,origin_label TEXT NOT NULL,destination_label TEXT NOT NULL,route_code TEXT NOT NULL,synthetic_distance_km REAL NOT NULL,estimated_duration_minutes INTEGER NOT NULL,scheduled_start TEXT NOT NULL,scheduled_end TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'scheduled',vehicle_id TEXT,pickup_verification_status TEXT NOT NULL DEFAULT 'pending',dropoff_verification_status TEXT NOT NULL DEFAULT 'pending',created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL)"),db.prepare("CREATE TABLE IF NOT EXISTS taxi_ops_action_keys (idempotency_key TEXT PRIMARY KEY,booking_id TEXT NOT NULL,action TEXT NOT NULL,result_json TEXT NOT NULL,created_at INTEGER NOT NULL)"),db.prepare("CREATE TABLE IF NOT EXISTS taxi_ops_notes (id TEXT PRIMARY KEY,booking_id TEXT NOT NULL,note TEXT NOT NULL,actor_id TEXT NOT NULL,created_at INTEGER NOT NULL)"),db.prepare("CREATE INDEX IF NOT EXISTS idx_taxi_ops_notes_booking ON taxi_ops_notes(booking_id,created_at)")])}
async function prior(db:D1Database,key:string){const row=await db.prepare("SELECT result_json FROM taxi_ops_action_keys WHERE idempotency_key=?").bind(key).first<Row>();return row?parse<Record<string,unknown>>(row.result_json,{}):null}
async function remember(db:D1Database,input:TaxiOpsInput,result:unknown){await db.prepare("INSERT INTO taxi_ops_action_keys (idempotency_key,booking_id,action,result_json,created_at) VALUES (?,?,?,?,?)").bind(input.idempotencyKey,input.bookingId,input.action,JSON.stringify(result),Date.now()).run();return result}
async function event(db:D1Database,booking:Row,eventType:string,actorId:string,detail:unknown){await db.prepare("INSERT INTO taxi_trip_events (id,booking_id,trip_id,provider_id,event_type,actor_id,detail_json,created_at) VALUES (?,?,?,?,?,?,?,?)").bind(crypto.randomUUID(),booking.id,booking.trip_id,booking.provider_id,eventType,actorId,JSON.stringify(detail),Date.now()).run()}
