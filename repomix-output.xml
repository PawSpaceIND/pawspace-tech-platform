<file path="app/api/training-reconciliation/route.ts">
import{authError,database,requirePermission,resolveActor}from"../../../lib/server-auth";
import{ensureTrainingCommercialTables}from"../../../lib/training-commercial-governance";
import{refreshTrainingFinanceReadModel}from"../../../lib/training-finance";
type Row=Record<string,unknown>;
const json=(value:unknown,status=200)=>Response.json(value,{status,headers:{"cache-control":"no-store"}});
export async function GET(request:Request){try{const db=await database(),actor=await resolveActor(request);requirePermission(actor,"reports.view");await ensureTrainingCommercialTables(db);await refreshTrainingFinanceReadModel(db);const rows=await db.prepare("SELECT p.*,b.service_code,b.schedule_group_id,b.total_amount,b.pricing_json,b.status booking_status,pay.amount payment_amount,pay.amount_due_now,pay.status payment_status,pay.gateway,inv.status invoice_status,inv.commercial_total invoice_commercial_total,inv.invoice_number,inv.tax_amount,inv.invoice_total FROM training_programmes p JOIN canonical_bookings b ON b.id=p.booking_id LEFT JOIN booking_payments pay ON pay.booking_id=p.booking_id LEFT JOIN training_finance_invoices inv ON inv.booking_id=p.booking_id ORDER BY p.updated_at DESC LIMIT 200").all<Row>();const records=[];for(const row of rows.results){const[sessions,reservations,consumptions,earnings,quoteLink]=await Promise.all([db.prepare("SELECT id,status,provider_id FROM training_sessions WHERE programme_id=?").bind(row.id).all<Row>(),db.prepare("SELECT id,status,provider_id FROM scheduling_reservations WHERE group_id=? AND status!='cancelled'").bind(row.schedule_group_id).all<Row>(),db.prepare("SELECT session_id FROM training_session_consumptions WHERE programme_id=?").bind(row.id).all<Row>(),db.prepare("SELECT session_id,status,gross_earning FROM training_session_earnings WHERE programme_id=?").bind(row.id).all<Row>(),db.prepare("SELECT l.quote_id,q.status quote_status,q.used_booking_id,q.sessions quote_sessions,q.total_amount quote_total,q.amount_due_now quote_due_now FROM training_booking_quote_links l LEFT JOIN training_commercial_quotes q ON q.id=l.quote_id WHERE l.booking_id=?").bind(row.booking_id).first<Row>()]);const issues:string[]=[],expected=Number(row.total_sessions||0),completed=sessions.results.filter(item=>String(item.status)==="completed").length;if(String(row.service_code)!=="dog_training")issues.push("Programme booking is not dog_training");if(sessions.results.length!==expected)issues.push(`Programme has ${sessions.results.length} session rows; expected ${expected}`);if(reservations.results.length!==expected)issues.push(`Scheduling has ${reservations.results.length} active reservations; expected ${expected}`);if(Number(row.completed_sessions||0)!==completed)issues.push(`Programme completed counter ${Number(row.completed_sessions||0)} does not match ${completed} completed session rows`);if(consumptions.results.length!==completed)issues.push(`Completed-session consumption count ${consumptions.results.length} does not match ${completed}`);if(earnings.results.length!==completed)issues.push(`Finance earnings rows ${earnings.results.length} do not match ${completed} completed sessions`);if(Number(row.payment_amount||0)!==Number(row.total_amount||0))issues.push("Payment commercial amount does not match canonical booking total");if(Number(row.invoice_commercial_total||0)!==Number(row.total_amount||0))issues.push("Training invoice commercial total does not match booking total");if(!quoteLink)issues.push("Training booking has no canonical server quote link (legacy/pre-Gate-3 record)");else{if(String(quoteLink.quote_status)!=="used")issues.push(`Training quote status is ${String(quoteLink.quote_status||"missing")}, expected used`);if(String(quoteLink.used_booking_id)!==String(row.booking_id))issues.push("Training quote used_booking_id does not match booking");if(Number(quoteLink.quote_sessions)!==expected)issues.push("Training quote session count does not match programme");if(Number(quoteLink.quote_total)!==Number(row.total_amount||0))issues.push("Training quote total does not match booking");if(Number(quoteLink.quote_due_now)!==Number(row.amount_due_now||0))issues.push("Training quote upfront amount does not match payment ledger");}const completedIds=new Set(sessions.results.filter(item=>String(item.status)==="completed").map(item=>String(item.id)));for(const earning of earnings.results)if(!completedIds.has(String(earning.session_id)))issues.push(`Earning exists for non-completed session ${String(earning.session_id)}`);records.push({programmeId:String(row.id),bookingId:String(row.booking_id),status:issues.length?"exception":"reconciled",issues,programmeStatus:String(row.status),bookingStatus:String(row.booking_status),paymentStatus:String(row.payment_status||"missing"),invoiceStatus:String(row.invoice_status||"missing"),sessions:{expected,actual:sessions.results.length,completed,consumed:consumptions.results.length,earnings:earnings.results.length},commercial:{bookingTotal:Number(row.total_amount||0),paymentAmount:Number(row.payment_amount||0),amountDueNow:Number(row.amount_due_now||0),invoiceCommercialTotal:Number(row.invoice_commercial_total||0),taxAmount:row.tax_amount===null||row.tax_amount===undefined?null:Number(row.tax_amount),invoiceTotal:row.invoice_total===null||row.invoice_total===undefined?null:Number(row.invoice_total)},quote:quoteLink||null});}return json({data:{summary:{programmes:records.length,reconciled:records.filter(item=>item.status==="reconciled").length,exceptions:records.filter(item=>item.status==="exception").length},records,source:"canonical_training_reconciliation",liveMoney:false}});}catch(error){return authError(error,"Unable to reconcile Training records");}}
</file>

<file path="app/api/training-requirements/route.ts">
import{authError,database,requirePermission,resolveActor,securityAudit}from"../../../lib/server-auth";

type Db=Awaited<ReturnType<typeof database>>;
const defaults=["Toilet routine","Biting & chewing","Leash walking","Recall","Basic obedience","Socialisation","Excess barking","Separation anxiety"];

async function ensureRequirements(db:Db){await db.prepare("CREATE TABLE IF NOT EXISTS training_requirements (id TEXT PRIMARY KEY NOT NULL,label TEXT NOT NULL UNIQUE,sort_order INTEGER NOT NULL,active INTEGER DEFAULT 1 NOT NULL,version INTEGER DEFAULT 1 NOT NULL,updated_by TEXT NOT NULL,updated_at INTEGER NOT NULL)").run();const now=Date.now();for(const[index,label]of defaults.entries())await db.prepare("INSERT OR IGNORE INTO training_requirements (id,label,sort_order,active,version,updated_by,updated_at) VALUES (?,?,?,1,1,'founder_seed',?)").bind(`training_requirement_${index+1}`,label,index+1,now).run();}
function sameOrigin(request:Request){const origin=request.headers.get("origin");if(origin&&origin!==new URL(request.url).origin)throw new Response("Cross-origin write blocked",{status:403});}

export async function GET(){try{const db=await database();await ensureRequirements(db);const rows=await db.prepare("SELECT id,label,sort_order,active,version FROM training_requirements ORDER BY sort_order,label").all();return Response.json({data:rows.results});}catch(error){return Response.json({error:error instanceof Error?error.message:"Training requirements could not load"},{status:500});}}

export async function POST(request:Request){try{sameOrigin(request);const actor=await resolveActor(request);requirePermission(actor,"settings.manage");const db=await database();await ensureRequirements(db);const body=await request.json() as{label?:string};const label=body.label?.trim();if(!label||label.length<3||label.length>80)return Response.json({error:"Enter a requirement between 3 and 80 characters"},{status:400});const order=await db.prepare("SELECT COALESCE(MAX(sort_order),0)+1 AS next_order FROM training_requirements").first<{next_order:number}>();const id=`training_requirement_${crypto.randomUUID().slice(0,12)}`,now=Date.now();await db.prepare("INSERT INTO training_requirements (id,label,sort_order,active,version,updated_by,updated_at) VALUES (?,?,?,1,1,?,?)").bind(id,label,Number(order?.next_order??1),actor.email,now).run();await securityAudit(db,actor,"training_requirement.create","training_requirement",id,"completed",{label});return Response.json({data:{id,label,active:1}},{status:201});}catch(error){return authError(error,"Requirement was not added");}}

export async function PATCH(request:Request){try{sameOrigin(request);const actor=await resolveActor(request);requirePermission(actor,"settings.manage");const db=await database();await ensureRequirements(db);const body=await request.json() as{id?:unknown;label?:unknown;active?:unknown;sortOrder?:unknown};if(typeof body.id!=="string"||!body.id.trim())return Response.json({error:"Requirement id is required"},{status:400});if(body.active!==undefined&&typeof body.active!=="boolean")return Response.json({error:"Requirement active must be a boolean"},{status:400});if(body.sortOrder!==undefined&&(!Number.isInteger(body.sortOrder)||Number(body.sortOrder)<1))return Response.json({error:"Requirement sortOrder must be a positive integer"},{status:400});if(body.label!==undefined&&typeof body.label!=="string")return Response.json({error:"Requirement label must be text"},{status:400});const id=body.id.trim(),current=await db.prepare("SELECT * FROM training_requirements WHERE id=?").bind(id).first<Record<string,unknown>>();if(!current)return Response.json({error:"Requirement not found"},{status:404});const label=typeof body.label==="string"?body.label.trim():String(current.label);if(label.length<3||label.length>80)return Response.json({error:"Invalid requirement label"},{status:400});await db.prepare("UPDATE training_requirements SET label=?,active=?,sort_order=?,version=version+1,updated_by=?,updated_at=? WHERE id=?").bind(label,body.active===undefined?Number(current.active):body.active?1:0,body.sortOrder===undefined?Number(current.sort_order):Number(body.sortOrder),actor.email,Date.now(),id).run();await securityAudit(db,actor,"training_requirement.update","training_requirement",id,"completed",{label,active:body.active,sortOrder:body.sortOrder});return Response.json({data:{id,label}});}catch(error){return authError(error,"Requirement was not updated");}}
</file>

<file path="app/api/training-session-media/route.ts">
import{authError,database,requirePermission,requireProviderOwnership,resolveActor,securityAudit}from"../../../lib/server-auth";
import{ensureTrainingSessionLifecycleTables,getTrainingSession}from"../../../lib/training-session-lifecycle";
import{ensureMediaBoundaryTables,issueMediaUploadGrant,redeemMediaUploadGrant,reviewMedia}from"../../../lib/media-upload-boundary";
type Row=Record<string,unknown>;
type RegisterInput={sessionId:string;mimeType:string;sizeBytes:number;sha256:string;fileName?:string};
type MediaActionInput={id:string;action:"confirm_upload"|"record_review";uploadToken?:string;storageReference?:string;observedSizeBytes?:number;observedSha256?:string;observedMimeType?:string;decision?:"approved"|"rejected";reason?:string};
const json=(value:unknown,status=200)=>Response.json(value,{status});

async function ensureMediaTables(db:D1Database){await ensureTrainingSessionLifecycleTables(db);await ensureMediaBoundaryTables(db);await db.batch([
 db.prepare("CREATE TABLE IF NOT EXISTS service_media_assets (id TEXT PRIMARY KEY,booking_id TEXT NOT NULL,provider_id TEXT NOT NULL,purpose TEXT NOT NULL,storage_key TEXT NOT NULL,mime_type TEXT NOT NULL,size_bytes INTEGER NOT NULL,sha256 TEXT NOT NULL,scan_status TEXT NOT NULL DEFAULT 'pending',access_status TEXT NOT NULL DEFAULT 'pending_upload',retention_status TEXT NOT NULL DEFAULT 'active',synthetic INTEGER NOT NULL DEFAULT 1,created_by TEXT NOT NULL,created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS service_media_events (id TEXT PRIMARY KEY,media_id TEXT NOT NULL,booking_id TEXT NOT NULL,event_type TEXT NOT NULL,actor_id TEXT NOT NULL,detail_json TEXT NOT NULL DEFAULT '{}',created_at INTEGER NOT NULL)"),
]);}
async function mediaEvent(db:D1Database,mediaId:string,bookingId:string,eventType:string,actorId:string,detail:unknown){await db.prepare("INSERT INTO service_media_events (id,media_id,booking_id,event_type,actor_id,detail_json,created_at) VALUES (?,?,?,?,?,?,?)").bind(crypto.randomUUID(),mediaId,bookingId,eventType,actorId,JSON.stringify(detail),Date.now()).run();}

export async function GET(request:Request){try{const sessionId=String(new URL(request.url).searchParams.get("sessionId")||"").trim();if(!sessionId)return json({error:"Training session ID is required"},400);const db=await database();await ensureMediaTables(db);const actor=await resolveActor(request);requirePermission(actor,"bookings.view");const session=await getTrainingSession(db,sessionId);if(!session)return json({error:"Training session not found"},404);await requireProviderOwnership(db,actor,String(session.provider_id));const assets=await db.prepare("SELECT a.id,a.booking_id,a.provider_id,a.purpose,a.mime_type,a.size_bytes,a.sha256,a.scan_status,a.access_status,a.retention_status,a.synthetic,a.created_at,a.updated_at FROM training_session_media_links l JOIN service_media_assets a ON a.id=l.media_id WHERE l.session_id=? ORDER BY a.created_at").bind(sessionId).all<Row>();return json({data:{sessionId,assets:assets.results.map(row=>({...row,ref:`media://asset/${String(row.id)}`,proofReady:String(row.scan_status)==="clean"&&String(row.access_status)==="ready"&&String(row.retention_status)==="active"&&Number(row.synthetic||0)===0}))}});}catch(error){return authError(error,"Unable to load Training session media");}}

/**
 * Training evidence goes through the same signed-upload boundary as every other service media surface.
 * This route previously answered storage:{mode:"not_connected"} and offered no confirmation path at
 * all, so an asset could sit at pending_upload forever or be advanced by whatever wrote to it directly.
 * [PTJA-W2-B4-M04]
 */
export async function POST(request:Request){try{const input=await request.json() as RegisterInput;if(!input.sessionId||!input.mimeType||!Number.isFinite(input.sizeBytes)||!input.sha256)return json({error:"Session, MIME type, size and checksum are required"},400);const db=await database();await ensureMediaTables(db);const actor=await resolveActor(request);requirePermission(actor,"bookings.view");const session=await getTrainingSession(db,input.sessionId);if(!session)return json({error:"Training session not found"},404);if(["completed","cancelled","no_show"].includes(String(session.status)))return json({error:`Training evidence cannot be added after session status ${String(session.status)}`},409);await requireProviderOwnership(db,actor,String(session.provider_id));const prior=await db.prepare("SELECT a.id,a.scan_status,a.access_status,a.retention_status,a.synthetic FROM training_session_media_links l JOIN service_media_assets a ON a.id=l.media_id WHERE l.session_id=? AND a.sha256=? AND a.retention_status='active' ORDER BY a.created_at DESC LIMIT 1").bind(input.sessionId,input.sha256.toLowerCase()).first<Row>();if(prior)return json({data:{id:String(prior.id),ref:`media://asset/${String(prior.id)}`,duplicatePrevented:true,proofReady:String(prior.scan_status)==="clean"&&String(prior.access_status)==="ready"&&Number(prior.synthetic||0)===0}});
 const grant=await issueMediaUploadGrant(db,{bookingId:String(session.booking_id),scopeType:"training_session",scopeId:input.sessionId,providerId:String(session.provider_id),serviceCode:"dog_training",cityId:session.city_id?String(session.city_id):null,category:"training_homework",mimeType:input.mimeType,sizeBytes:input.sizeBytes,sha256:input.sha256,fileName:input.fileName,actorId:actor.email});
 await db.prepare("INSERT INTO training_session_media_links (media_id,session_id,programme_id,booking_id,provider_id,created_at) VALUES (?,?,?,?,?,?)").bind(grant.mediaId,input.sessionId,session.programme_id,session.booking_id,session.provider_id,Date.now()).run();
 await mediaEvent(db,grant.mediaId,String(session.booking_id),"training_session_upload_grant_issued",actor.email,{sessionId:input.sessionId,providerId:session.provider_id,mimeType:input.mimeType,sizeBytes:input.sizeBytes,grantId:grant.grantId,expiresAt:grant.expiresAt,adapterConnected:false});
 await securityAudit(db,actor,"training.media.prepare","training_session",input.sessionId,"completed",{mediaId:grant.mediaId,bookingId:session.booking_id,providerId:session.provider_id,synthetic:false,grantId:grant.grantId,policyVersion:grant.policyVersion});
 return json({data:{id:grant.mediaId,ref:grant.mediaRef,sessionId:input.sessionId,bookingId:String(session.booking_id),providerId:String(session.provider_id),scanStatus:"pending",accessStatus:"pending_upload",reviewStatus:grant.reviewStatus,proofReady:false,synthetic:false,policyVersion:grant.policyVersion,upload:{token:grant.token,objectKey:grant.objectKey,expiresAt:grant.expiresAt,singleUse:true,adapterConnected:false,rawPublicUrl:false}}},201);}catch(error){return authError(error,"Unable to prepare Training session media");}}

/** Steps 5-7 for Training evidence: redeem the grant, then let a SECOND person decide. */
export async function PATCH(request:Request){try{const db=await database();await ensureMediaTables(db);const actor=await resolveActor(request);requirePermission(actor,"bookings.view");const input=await request.json() as MediaActionInput;if(!input.id||!input.action)return json({error:"Media ID and action are required"},400);const link=await db.prepare("SELECT l.session_id,l.booking_id,l.provider_id FROM training_session_media_links l WHERE l.media_id=?").bind(input.id).first<Row>();if(!link)return json({error:"Training session media not found"},404);await requireProviderOwnership(db,actor,String(link.provider_id));
 if(input.action==="confirm_upload"){requirePermission(actor,"bookings.view");const result=await redeemMediaUploadGrant(db,{token:String(input.uploadToken||""),objectKey:String(input.storageReference||""),observed:{sizeBytes:Number(input.observedSizeBytes),sha256:String(input.observedSha256||""),mimeType:String(input.observedMimeType||"")},actorId:actor.email});if(result.mediaId!==input.id)return json({error:"This upload token belongs to another media asset"},403);await securityAudit(db,actor,"training.media.confirm_upload","training_session",String(link.session_id),"completed",{mediaId:input.id});return json({data:{id:input.id,accessStatus:result.accessStatus,reviewStatus:result.reviewStatus,proofReady:false}});}
 if(input.action==="record_review"){requirePermission(actor,"bookings.manage");const decision=String(input.decision||"");if(!["approved","rejected"].includes(decision))return json({error:"A review decision must be approved or rejected"},400);const result=await reviewMedia(db,{mediaId:input.id,decision:decision as "approved"|"rejected",actorId:actor.email,reason:String(input.reason||"")});await securityAudit(db,actor,"training.media.review","training_session",String(link.session_id),"completed",{mediaId:input.id,decision,reviewStatus:result.reviewStatus});return json({data:{id:input.id,accessStatus:result.accessStatus,reviewStatus:result.reviewStatus,proofReady:result.proofReady}});}
 return json({error:"Unsupported Training session media action"},400);}catch(error){return authError(error,"Unable to update Training session media");}}
</file>

<file path="app/api/training-sessions/route.ts">
import{authError,authFailure,database,requirePermission,requireProviderOwnership,resolveActor,securityAudit}from"../../../lib/server-auth";
import{hasPermission,maskName}from"../../../lib/platform-security";
import{getTrainingSession,listTrainerSessions,mutateTrainingSession,type TrainingSessionAction,type TrainingReport}from"../../../lib/training-session-lifecycle";
import{tryQualifyLinkedReferral}from"../../../lib/referral-booking-governance";
type Body={sessionId?:string;providerId?:string;action?:TrainingSessionAction;idempotencyKey?:string;reason?:string;report?:TrainingReport;newStart?:string;newEnd?:string;newProviderId?:string};
const json=(value:unknown,status=200)=>Response.json(value,{status});
const staffActions=new Set<TrainingSessionAction>(["reschedule","replace_provider","cancel_session"]);
async function trainingSessionError(error:unknown){if(error instanceof Response&&error.status===409){let message="";try{message=await error.clone().text();}catch{}if(message==="Trainer roster availability is not configured; cannot verify the trainer works this window"||/^Trainer has no roster availability covering \d{4}-\d{2}-\d{2} in this zone for the requested window$/.test(message))return authFailure("Trainer roster unavailable",409);if(/^Provider schedule conflicts with reservation .+ including travel buffer$/.test(message))return authFailure("Trainer schedule conflicts with travel buffer",409);}return authError(error,"Unable to update Training session");}

export async function GET(request:Request){try{const providerId=String(new URL(request.url).searchParams.get("providerId")||"").trim();if(!providerId)return json({error:"Trainer provider ID is required"},400);const db=await database();const actor=await resolveActor(request);requirePermission(actor,"bookings.view");await requireProviderOwnership(db,actor,providerId);const sessions=await listTrainerSessions(db,providerId);return json({data:sessions.map((item:Record<string,unknown>)=>({...item,customer_name:maskName(String(item.customer_name||"Customer"))}))});}catch(error){return authError(error,"Unable to load Training sessions");}}

export async function POST(request:Request){try{const body=await request.json() as Body,sessionId=String(body.sessionId||"").trim(),action=body.action,idempotencyKey=String(body.idempotencyKey||"").trim();if(!sessionId||!action||!idempotencyKey)return json({error:"Session, action and idempotency key are required"},400);const db=await database(),actor=await resolveActor(request);const session=await getTrainingSession(db,sessionId);if(!session)return json({error:"Training session not found"},404);const staff=hasPermission(actor.permissions,"bookings.manage");if(staffActions.has(action)){requirePermission(actor,"bookings.manage");}else{requirePermission(actor,"bookings.view");if(!staff)await requireProviderOwnership(db,actor,String(session.provider_id));}
 const result=await mutateTrainingSession(db,{sessionId,action,actorId:actor.email,idempotencyKey,reason:body.reason,report:body.report,newStart:body.newStart,newEnd:body.newEnd,newProviderId:body.newProviderId,staffOverride:staff});let referral:unknown={applicable:false,status:"not_applicable"};if(action==="complete"&&String(((result as Record<string,unknown>).programme as Record<string,unknown>|undefined)?.status||"")==="completed"){await db.prepare("UPDATE canonical_bookings SET status='completed',updated_at=? WHERE id=? AND status!='cancelled'").bind(Date.now(),session.booking_id).run();try{referral=await tryQualifyLinkedReferral(db,{bookingId:String(session.booking_id),actorId:actor.email});}catch(error){referral={applicable:true,status:"review_required",reason:error instanceof Error?error.message:"Referral qualification requires review"};}}
 await securityAudit(db,actor,`training.session.${action}`,"training_session",sessionId,"completed",{bookingId:session.booking_id,programmeId:session.programme_id,providerId:session.provider_id,staffOverride:staff,duplicatePrevented:Boolean((result as Record<string,unknown>).duplicatePrevented),referral});return json({data:result,referral});}catch(error){return trainingSessionError(error);}}
</file>

