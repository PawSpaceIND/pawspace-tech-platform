 db.prepare("SELECT id,media_type,classification,status,publish_approved,created_at FROM provider_onboarding_profile_media WHERE application_id=? ORDER BY created_at DESC").bind(applicationId).all<Row>(),
 db.prepare("SELECT id,event_type,from_status,to_status,created_at FROM provider_onboarding_events WHERE application_id=? ORDER BY created_at DESC LIMIT 50").bind(applicationId).all<Row>(),
 ]);let quiz:null|Record<string,unknown>=null;const quizRef=text(application.quiz_version_ref);if(quizRef){const row=await db.prepare("SELECT id,locale_code,status,question_count,pass_threshold,questions_json FROM provider_quiz_versions WHERE id=? AND status='approved'").bind(quizRef).first<Row>();if(row)quiz={id:row.id,localeCode:row.locale_code,status:row.status,questionCount:row.question_count,passThreshold:row.pass_threshold,questions:sanitizeQuestions(row.questions_json)};}let agreementContent:null|Record<string,unknown>=null;if(agreement?.content_id){const row=await db.prepare("SELECT content_key,locale_code,content_type,content_text,version FROM provider_onboarding_content_versions WHERE id=? AND status='active'").bind(agreement.content_id).first<Row>();if(row&&text(row.content_type)==="legal")agreementContent={contentKey:row.content_key,localeCode:row.locale_code,contentText:row.content_text,version:row.version};}result.push({application,documents:documents.results,verification,attempt,quiz,interview,agreement,agreementContent,profile:profile?{status:profile.status,displayName:profile.display_name,bio:profile.bio,businessName:profile.business_name,businessDetails:parse(profile.business_details_json,{}),services:parse(profile.services_json,[]),serviceAreas:parse(profile.service_areas_json,[]),languages:parse(profile.languages_json,[]),packageDetails:parse(profile.package_details_json,[]),facilityDetails:parse(profile.facility_details_json,{}),references:parse(profile.references_json,[]),updatedAt:profile.updated_at}:null,media:media.results,events:events.results});}return{providerId,applications:result,productionReady:false,externalKycConnected:false,externalEsignConnected:false,marketplaceLive:false,orderEligible:false,autonomousProviderDecision:false};}
