export type BoardingOpsCandidate={providerId:string;name:string;area:string;model:string;rating:number;qualityScore:number;maxGuestPets:number;availableGuestPets:number;oneFamilyOnly:boolean;medicationSupport:boolean};
export type BoardingOpsStay={id:string;booking_id:string;customer_id:string;customer_name?:string;host_provider_id:string;provider_name?:string;status:string;booking_status:string;payment_status:string;package_name:string;check_in_at:string;check_out_at:string;care_plan_status:string;check_in_status:string;check_out_status:string;priority:"emergency"|"high"|"attention"|"clear";exceptionFlags:string[];replacementCandidates:BoardingOpsCandidate[];recovery?:Record<string,unknown>|null;incidents:Array<Record<string,unknown>>;cancellation?:Record<string,unknown>|null;dateChange?:Record<string,unknown>|null;refunds:Array<Record<string,unknown>>;settlement?:Record<string,unknown>|null;media:Array<Record<string,unknown>>;notes:Array<Record<string,unknown>>;reconciliation?:Record<string,unknown>|null};
export type BoardingOpsSnapshot={source:string;generatedAt:number;metrics:{total:number;clear:number;needsAttention:number;recovery:number;openIncidents:number;financeReview:number;mediaBlocked:number};stays:BoardingOpsStay[];readiness:{engineeringGate:string;productionReady:boolean;customerJourney:string;hostJourney:string;opsExceptionQueue:string;finance:string;media:string;identity:string;externalDependencies:Record<string,string>}};
type Payload<T>={data?:T;error?:string};
async function read<T>(response:Response){const payload=await response.json() as Payload<T>;if(!response.ok)throw new Error(payload.error||"Boarding Operations request failed");return payload.data as T;}
export async function loadBoardingOps(){return read<BoardingOpsSnapshot>(await fetch("/api/boarding-ops",{cache:"no-store"}));}
export async function updateBoardingOps(input:{stayId:string;action:"assign_replacement"|"close_recovery"|"add_note";idempotencyKey:string;reason?:string;note?:string;providerId?:string}){return read<Record<string,unknown>>(await fetch("/api/boarding-ops",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(input)}));}
