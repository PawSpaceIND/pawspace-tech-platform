 db.prepare("CREATE TABLE IF NOT EXISTS tax_policy_versions (id TEXT PRIMARY KEY,entity_id TEXT NOT NULL,version INTEGER NOT NULL,status TEXT NOT NULL DEFAULT 'draft',effective_from TEXT NOT NULL,effective_to TEXT,policy_json TEXT NOT NULL,approval_reference TEXT,approved_by TEXT,approved_at INTEGER,created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL,UNIQUE(entity_id,version))"),
