  // accepted, stored as TEXT, read back as NaN, and the host became permanently unbookable behind a
  // "another reservation took this provider/slot" message with no competing reservation in the table.
  // A capacity column is a number before it is anything else. [PTJA-P1-F35]
  if(typeof value==="boolean"||value===null||value===""||!Number.isFinite(Number(value)))return json({error:`${key} must be a number`},400);
  if(Number(value)<0)return json({error:`${key} cannot be negative`},400);}if(key==="provider_model"&&!['full_time','commission'].includes(String(value)))return json({error:"Provider model must be full_time or commission"},400);}const now=Date.now(),set=entries.map(([key])=>`${key}=?`).join(",");await db.prepare(`UPDATE provider_capacity_profiles SET ${set},version=version+1,updated_by=?,updated_at=? WHERE id=?`).bind(...entries.map(([,value])=>value),actor.email,now,body.providerId).run();const after=await db.prepare("SELECT * FROM provider_capacity_profiles WHERE id=?").bind(body.providerId).first<Row>();await db.prepare("INSERT INTO provider_capacity_audit (id,provider_id,action,before_json,after_json,actor_id,reason,created_at) VALUES (?,?,?,?,?,?,?,?)").bind(crypto.randomUUID(),body.providerId,"updated",JSON.stringify(before),JSON.stringify(after),actor.email,body.reason.trim(),now).run();await securityAudit(db,actor,"provider.capacity.update","provider",body.providerId,"completed",{reason:body.reason,changes:entries.map(([key])=>key)});return json({data:after});}catch(error){return authError(error,"Unable to update provider capacity");}}

export async function POST(request:Request){try{const actor=await authorize(request,"scheduling.manage");const db=await database();await seedProviderCapacityDefaults(db);await ensureSchedulingTables(db);const body=await request.json() as {action?:"set_availability"|"block_time"|"unblock_time";providerId?:string;cityId?:string;zoneId?:string;date?:string;windows?:string[];startsAt?:string;endsAt?:string;reason?:string;blockId?:string};if(!body.providerId||!body.action)return json({error:"Provider and action are required"},400);const now=Date.now();
