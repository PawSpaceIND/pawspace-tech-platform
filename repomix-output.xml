import{authError,database,requireCustomerOwnership,requirePermission,resolveActor,securityAudit}from"../../../lib/server-auth";
import{hasPermission}from"../../../lib/platform-security";
import{listCustomerSubscriptionWallets,mutateSubscriptionWallet,readSubscriptionWallet,type SubscriptionWalletAction}from"../../../lib/subscription-wallet";

type Row=Record<string,unknown>;
const json=(value:unknown,status=200)=>Response.json(value,{status});

async function subscriptionCustomer(db:Awaited<ReturnType<typeof database>>,subscriptionId:string){const row=await db.prepare("SELECT customer_id FROM customer_grooming_subscriptions WHERE id=?").bind(subscriptionId).first<Row>();return row?String(row.customer_id):null;}

export async function GET(request:Request){try{const actor=await resolveActor(request);const db=await database(),url=new URL(request.url),subscriptionId=String(url.searchParams.get("subscriptionId")||"").trim(),customerId=String(url.searchParams.get("customerId")||"").trim();if(!subscriptionId&&!customerId)return json({error:"Subscription or customer is required"},400);if(subscriptionId){const owner=await subscriptionCustomer(db,subscriptionId);if(!owner)return json({error:"Subscription not found"},404);if(!hasPermission(actor.permissions,"customers.view"))requirePermission(actor,"scheduling.book");await requireCustomerOwnership(db,actor,owner);const wallet=await readSubscriptionWallet(db,subscriptionId);return json({data:wallet,testOnly:true,liveMoney:false});}requirePermission(actor,"customers.view");const wallets=await listCustomerSubscriptionWallets(db,customerId);return json({data:wallets,testOnly:true,liveMoney:false});}catch(error){return authError(error,"Unable to load subscription wallet");}}

export async function POST(request:Request){try{const actor=await resolveActor(request),db=await database(),body=await request.json() as Record<string,unknown>,subscriptionId=String(body.subscriptionId||"").trim(),action=String(body.action||"") as SubscriptionWalletAction,idempotencyKey=String(body.idempotencyKey||"").trim();if(!subscriptionId||!action||!idempotencyKey)return json({error:"Subscription, action and idempotency key are required"},400);const credits=body.credits==null?undefined:Number(body.credits),pauseDays=body.pauseDays==null?undefined:Number(body.pauseDays);if(credits!==undefined&&(!Number.isFinite(credits)||!Number.isInteger(credits)||credits<1))return json({error:"Credits must be a positive integer"},400);if(pauseDays!==undefined&&(!Number.isFinite(pauseDays)||!Number.isInteger(pauseDays)||pauseDays<1))return json({error:"Pause days must be a positive integer"},400);const owner=await subscriptionCustomer(db,subscriptionId);if(!owner)return json({error:"Subscription not found"},404);const customerActions=new Set<SubscriptionWalletAction>(["reserve","pause","resume"]);if(customerActions.has(action)){requirePermission(actor,"scheduling.book");await requireCustomerOwnership(db,actor,owner);}else requirePermission(actor,"bookings.manage");const result=await mutateSubscriptionWallet(db,{subscriptionId,action,idempotencyKey,bookingId:body.bookingId?String(body.bookingId):undefined,credits,reason:body.reason?String(body.reason):undefined,pauseDays,actorId:actor.email});await securityAudit(db,actor,`subscription_wallet.${action}`,"subscription",subscriptionId,"completed",{bookingId:body.bookingId||null,credits:body.credits||null,testOnly:true,liveMoney:false,duplicatePrevented:Boolean((result as Record<string,unknown>).duplicatePrevented)});return json({data:result,testOnly:true,liveMoney:false},action==="reserve"?201:200);}catch(error){if(error instanceof Error&&error.message==="Subscription wallet idempotency key was already used for a different mutation")return json({error:error.message},409);return authError(error,"Unable to update subscription wallet");}}
