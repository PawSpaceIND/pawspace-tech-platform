const failedAt=Date.now();try{await db.prepare("UPDATE ai_turn_reservations SET status='retryable',updated_at=? WHERE idempotency_key=? AND owner_token=? AND status='processing' AND turn_id IS NULL").bind(failedAt,input.idempotencyKey,ownerToken).run();}catch(releaseError){throw new AggregateError([error,releaseError],"AI turn failed and its idempotency reservation could not be released");}throw error;}}

export async function aiConversationSnapshot(db:D1Database,input:{actor:AuthenticatedActor;threadId:string;customerId:string}){await ensureAiConversationOrchestrator(db);await authorizeContext(db,input.actor,input.customerId);const thread=await db.prepare("SELECT id,customer_id,status,booking_id,ticket_id,assigned_to,sla_due_at FROM communication_threads WHERE id=?").bind(input.threadId).first<Row>();if(!thread||String(thread.customer_id)!==input.customerId)throw new Error("Conversation thread/customer mismatch");const session=await db.prepare("SELECT * FROM ai_conversation_sessions WHERE thread_id=? AND customer_id=?").bind(input.threadId,input.customerId).first<Row>(),turns=await db.prepare("SELECT id,input_message_id,channel,intent_code,intent_confidence,context_id,provider,model_ref,output_text,latency_ms,input_tokens,output_tokens,cost_minor,policy_decision,outcome,handoff_reason,created_at,completed_at FROM ai_conversation_turns WHERE thread_id=? AND customer_id=? ORDER BY created_at DESC LIMIT 50").bind(input.threadId,input.customerId).all<Row>();// providerStatus was the literal string "not_connected" regardless of what the session recorded, so a
 // staff screen reading this snapshot reported a disconnected provider while turns in the same payload
 // carried a real provider and model. The stored session is the only honest answer: it is what actually
 // served this thread's turns.
 //
 // Connectivity comes from the recorded STATUS, not from the provider name. Deriving it from the name
 // reported a `degraded` provider called "anthropic" as connected, which is the opposite of what an
 // operator diagnosing handoffs needs: degraded is precisely the state that produces them.
 const sessionProvider=session?String(session.provider||"not_connected"):"not_connected";
 const sessionProviderStatus=session?String(session.provider_status||"not_connected"):"not_connected";
 return{thread,session:session||null,turns:turns.results,providerRef:sessionProvider,providerStatus:sessionProviderStatus,providerConnected:sessionProviderStatus==="connected",autonomousExecution:false,productionReady:false};}
