import{ensureWalkingFinanceTables}from"./walking-finance-governance";
import{ensureWalkingProofTables}from"./walking-proof-governance";
import{createAssignmentOffer,ensureProviderCapacityTables}from"./provider-capacity-governance";
type Row=Record<string,unknown>;
export type WalkingOpsAction="assign_replacement"|"close_recovery"|"add_note";
export type WalkingOpsInput={bookingId:string;action:WalkingOpsAction;actorId:string;idempotencyKey:string;providerId?:string;reason?:string;note?:string};
const parse=<T>(value:unknown,fallback:T):T=>{try{return JSON.parse(String(value??"")) as T}catch{return fallback}};
export async function ensureWalkingOpsTables(db:D1Database){await ensureWalkingFinanceTables(db);await ensureWalkingProofTables(db);await ensureProviderCapacityTables(db);await db.batch([db.prepare("CREATE TABLE IF NOT EXISTS walking_sessions (id TEXT PRIMARY KEY,booking_id TEXT NOT NULL,schedule_group_id TEXT NOT NULL,reservation_id TEXT NOT NULL UNIQUE,provider_id TEXT NOT NULL,occurrence_number INTEGER NOT NULL,scheduled_start TEXT NOT NULL,scheduled_end TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'scheduled',handover_status TEXT NOT NULL DEFAULT 'pending',completion_status TEXT NOT NULL DEFAULT 'pending',created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS walking_ops_action_keys (idempotency_key TEXT PRIMARY KEY,booking_id TEXT NOT NULL,action TEXT NOT NULL,result_json TEXT NOT NULL,created_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS walking_ops_notes (id TEXT PRIMARY KEY,booking_id TEXT NOT NULL,note TEXT NOT NULL,actor_id TEXT NOT NULL,created_at INTEGER NOT NULL)"),
 db.prepare("CREATE INDEX IF NOT EXISTS idx_walking_ops_notes_booking ON walking_ops_notes(booking_id,created_at)"),
])}
async function prior(db:D1Database,key:string){const row=await db.prepare("SELECT result_json FROM walking_ops_action_keys WHERE idempotency_key=?").bind(key).first<Row>();return row?parse<Record<string,unknown>>(row.result_json,{}):null}
async function remember(db:D1Database,input:WalkingOpsInput,result:unknown){await db.prepare("INSERT INTO walking_ops_action_keys (idempotency_key,booking_id,action,result_json,created_at) VALUES (?,?,?,?,?)").bind(input.idempotencyKey,input.bookingId,input.action,JSON.stringify(result),Date.now()).run();return result}
async function event(db:D1Database,bookingId:string,providerId:string,eventType:string,actorId:string,detail:unknown){await db.prepare("INSERT INTO walking_session_events (id,booking_id,session_id,provider_id,event_type,actor_id,detail_json,created_at) VALUES (?,?,?,?,?,?,?,?)").bind(crypto.randomUUID(),bookingId,null,providerId,eventType,actorId,JSON.stringify(detail),Date.now()).run()}
async function notify(db:D1Database,booking:Row,eventId:string,message:string){for(const channel of["push","whatsapp"])await db.prepare("INSERT INTO walking_customer_notifications (id,booking_id,customer_id,channel,template_code,message,status,event_id,created_at) VALUES (?,?,?,?,?,?,'queued',?,?)").bind(crypto.randomUUID(),booking.id,booking.customer_id,channel,"walking_recovery_update",message,eventId,Date.now()).run()}
async function openRecoverySessions(db:D1Database,bookingId:string){const rows=await db.prepare("SELECT * FROM walking_sessions WHERE booking_id=? AND status='recovery_pending' ORDER BY occurrence_number").bind(bookingId).all<Row>();return rows.results}
async function replacementCandidates(db:D1Database,booking:Row){const sessions=await openRecoverySessions(db,String(booking.id));if(!sessions.length)return[];const rows=await db.prepare("SELECT id,name,provider_model,rating,quality_score,capacity,travel_buffer_minutes,max_daily_jobs,services_json,zones_json FROM provider_capacity_profiles WHERE city_id=? AND live=1 AND status='active' AND id!=? ORDER BY quality_score DESC,rating DESC").bind(booking.city_id,booking.provider_id).all<Row>(),out:Array<Record<string,unknown>>=[];for(const row of rows.results){if(!parse<string[]>(row.services_json,[]).includes("dog_walking")||!parse<string[]>(row.zones_json,[]).includes(String(booking.zone_id)))continue;let eligible=true;for(const s of sessions){const start=String(s.scheduled_start),end=String(s.scheduled_end),blocked=await db.prepare("SELECT id FROM provider_unavailability WHERE provider_id=? AND status='active' AND starts_at<? AND ends_at>? LIMIT 1").bind(row.id,end,start).first<Row>();if(blocked){eligible=false;break}const bufferMs=Math.max(0,Number(row.travel_buffer_minutes||20))*60_000,bufferedStart=new Date(new Date(start).getTime()-bufferMs).toISOString(),bufferedEnd=new Date(new Date(end).getTime()+bufferMs).toISOString(),conflicts=await db.prepare("SELECT id FROM scheduling_reservations WHERE provider_id=? AND group_id!=? AND status NOT IN ('cancelled','completed') AND scheduled_start<? AND scheduled_end>? LIMIT 1").bind(row.id,booking.schedule_group_id,bufferedEnd,bufferedStart).first<Row>();if(conflicts){eligible=false;break}const localDate=new Date(start).toLocaleDateString("en-CA",{timeZone:"Asia/Kolkata"}),dayCount=await db.prepare("SELECT COUNT(*) count FROM scheduling_reservations WHERE provider_id=? AND group_id!=? AND status NOT IN ('cancelled','completed') AND substr(scheduled_start,1,10)=?").bind(row.id,booking.schedule_group_id,localDate).first<{count:number}>();if(Number(dayCount?.count||0)>=Number(row.max_daily_jobs||10)){eligible=false;break}}if(eligible)out.push({providerId:String(row.id),name:String(row.name),model:String(row.provider_model),rating:Number(row.rating||0),qualityScore:Number(row.quality_score||0),remainingSessions:sessions.length,travelBufferMinutes:Number(row.travel_buffer_minutes||20)})}return out}
function priority(flags:string[],incidents:Row[]){if(incidents.some(item=>String(item.severity)==="emergency"&&String(item.status)!=="resolved"))return"emergency";if(flags.some(flag=>["walker_recovery","walker_acceptance_due","route_missing","walk_overdue"].includes(flag)))return"high";return flags.length?"attention":"clear"}
export async function getWalkingOpsSnapshot(db:D1Database){await ensureWalkingOpsTables(db);const now=Date.now();
 // Cold-DB safe: canonical booking tables are created by the booking routes. Before any booking
 // module has run (fresh staging D1), the queue is honestly empty instead of a 500.
 const rows=await db.prepare("SELECT name FROM sqlite_master WHERE type='table' AND name='canonical_bookings'").first<Row>()?await db.prepare("SELECT b.*,c.name customer_name,p.name provider_name,w.status work_order_status,pay.status payment_status FROM canonical_bookings b LEFT JOIN canonical_customers c ON c.id=b.customer_id LEFT JOIN provider_capacity_profiles p ON p.id=b.provider_id LEFT JOIN provider_work_orders w ON w.booking_id=b.id LEFT JOIN booking_payments pay ON pay.booking_id=b.id WHERE b.service_code='dog_walking' ORDER BY b.scheduled_start ASC").all<Row>():{results:[] as Row[]};const bookings:Array<Record<string,unknown>>=[];for(const booking of rows.results){const[sessions,recovery,incidents,cancellation,refunds,settlement,reconciliation,media,notes,offer]=await Promise.all([db.prepare("SELECT * FROM walking_sessions WHERE booking_id=? ORDER BY occurrence_number").bind(booking.id).all<Row>(),db.prepare("SELECT * FROM walking_recovery_cases WHERE booking_id=? ORDER BY opened_at DESC LIMIT 1").bind(booking.id).first<Row>(),db.prepare("SELECT * FROM walking_incidents WHERE booking_id=? ORDER BY reported_at DESC").bind(booking.id).all<Row>(),db.prepare("SELECT * FROM walking_cancellation_requests WHERE booking_id=? ORDER BY created_at DESC LIMIT 1").bind(booking.id).first<Row>(),db.prepare("SELECT * FROM walking_refund_ledger WHERE booking_id=? ORDER BY created_at DESC").bind(booking.id).all<Row>(),db.prepare("SELECT * FROM walking_walker_settlement_ledger WHERE booking_id=?").bind(booking.id).first<Row>(),db.prepare("SELECT * FROM walking_finance_reconciliation WHERE booking_id=? ORDER BY created_at DESC LIMIT 1").bind(booking.id).first<Row>(),db.prepare("SELECT a.id,a.purpose,a.scan_status,a.access_status,a.retention_status,m.session_id FROM service_media_assets a JOIN walking_media_session_bindings m ON m.media_id=a.id WHERE a.booking_id=? ORDER BY a.created_at DESC").bind(booking.id).all<Row>(),db.prepare("SELECT * FROM walking_ops_notes WHERE booking_id=? ORDER BY created_at DESC LIMIT 20").bind(booking.id).all<Row>(),db.prepare("SELECT status,provider_id,expires_at,attempt_no FROM provider_assignment_offers WHERE group_id=?").bind(booking.schedule_group_id).first<Row>()]);const flags:string[]=[],openIncidents=incidents.results.filter(item=>String(item.status)!=="resolved"),activeSessions=sessions.results.filter(item=>String(item.status)==="in_progress"),futureSessions=sessions.results.filter(item=>!["completed","cancelled"].includes(String(item.status)));if(["reassignment_needed","reassignment_offered"].includes(String(booking.status))||recovery&&!["resolved","closed"].includes(String(recovery.status)))flags.push("walker_recovery");if(offer&&String(offer.status)==="pending"&&Number(offer.expires_at)<now)flags.push("walker_acceptance_due");if(openIncidents.some(item=>String(item.severity)==="emergency"))flags.push("emergency_incident");else if(openIncidents.some(item=>String(item.severity)==="urgent"))flags.push("urgent_incident");else if(openIncidents.length)flags.push("care_incident");if(cancellation&&String(cancellation.status)==="policy_review_required")flags.push("cancellation_policy_review");if(refunds.results.some(item=>String(item.status)==="sandbox_pending"))flags.push("refund_pending");if(media.results.some(item=>String(item.scan_status)!=="clean"||String(item.access_status)!=="ready"||String(item.retention_status)!=="active"))flags.push("media_blocked");for(const s of activeSessions){const route=await db.prepare("SELECT COUNT(*) count FROM walking_session_events WHERE booking_id=? AND session_id=? AND event_type='route_location_sample'").bind(booking.id,s.id).first<{count:number}>();if(Number(route?.count||0)<2){flags.push("route_missing");break}}if(futureSessions.some(item=>new Date(String(item.scheduled_end)).getTime()<now&&!['completed','cancelled'].includes(String(item.status))))flags.push("walk_overdue");const due=await db.prepare("SELECT COALESCE(SUM(amount),0) total FROM walking_session_paymen