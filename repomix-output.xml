<file path="lib/funeral-memorial-governance.ts">
type Row=Record<string,unknown>;
export type FuneralServiceType="cremation"|"burial"|"memorial";
export type MemorialOption="none"|"ash_collection"|"plantation"|"digital_memorial";
export type FuneralCaseStatus="urgent_request"|"pickup_pending"|"pickup_coordinated"|"in_care"|"ritual_pending"|"ritual_complete"|"memorial_pending"|"closure_pending"|"closed"|"cancelled";

const serviceTypes=["cremation","burial","memorial"] as const;
const memorialOptions=["none","ash_collection","plantation","digital_memorial"] as const;
const milestoneCodes=["request_received","pickup_coordinated","pickup_complete","ritual_scheduled","ritual_complete","ash_collection_ready","ash_collected","memorial_record_created","closure_confirmed"] as const;
const memorialRecordTypes=["ash_collection","plantation","digital_memorial","acknowledgement"] as const;

export const funeralSensitiveTemplates={
 requestReceived:"We have received your request. A PawSpace support coordinator will contact you with the next confirmed step.",
 pickupConfirmed:"Pickup has been coordinated. We will only share updates that are confirmed by the assigned team.",
 closure:"The service has been completed. Your acknowledgement and support options remain available in this record.",
};

export async function ensureFuneralMemorialTables(db:D1Database){await db.batch([
 db.prepare("CREATE TABLE IF NOT EXISTS funeral_service_config (service_type TEXT PRIMARY KEY,enabled INTEGER NOT NULL DEFAULT 0,base_amount REAL,cash_allowed INTEGER NOT NULL DEFAULT 0,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS funeral_cases (id TEXT PRIMARY KEY,customer_id TEXT NOT NULL,pet_name TEXT NOT NULL,pet_species TEXT NOT NULL,pickup_address TEXT NOT NULL,alternate_contact TEXT,service_type TEXT NOT NULL,memorial_option TEXT NOT NULL DEFAULT 'none',urgency TEXT NOT NULL DEFAULT 'urgent',status TEXT NOT NULL DEFAULT 'urgent_request',assigned_agent_id TEXT,vendor_id TEXT,support_status TEXT NOT NULL DEFAULT 'none',certificate_status TEXT NOT NULL DEFAULT 'not_issued',closure_note TEXT,created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS funeral_media (id TEXT PRIMARY KEY,case_id TEXT NOT NULL,media_type TEXT NOT NULL,object_id TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'uat_registered',note TEXT,created_by TEXT NOT NULL,created_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS funeral_milestones (id TEXT PRIMARY KEY,case_id TEXT NOT NULL,code TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'pending',note TEXT,completed_at INTEGER,updated_by TEXT,updated_at INTEGER NOT NULL,UNIQUE(case_id,code))"),
 db.prepare("CREATE TABLE IF NOT EXISTS funeral_ash_collection (id TEXT PRIMARY KEY,case_id TEXT NOT NULL UNIQUE,preferred_at TEXT,status TEXT NOT NULL DEFAULT 'requested',note TEXT,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS funeral_payments (id TEXT PRIMARY KEY,case_id TEXT NOT NULL UNIQUE,amount REAL NOT NULL,status TEXT NOT NULL DEFAULT 'due',payment_mode TEXT NOT NULL DEFAULT 'internal_uat',payment_reference TEXT,provider TEXT NOT NULL DEFAULT 'internal_uat',paid_at INTEGER,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS funeral_invoices (id TEXT PRIMARY KEY,case_id TEXT NOT NULL UNIQUE,amount REAL NOT NULL,status TEXT NOT NULL DEFAULT 'uat_issued',tax_status TEXT NOT NULL DEFAULT 'not_configured',issued_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS funeral_refunds (id TEXT PRIMARY KEY,case_id TEXT NOT NULL,amount REAL NOT NULL,reason TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'requested',resolution_mode TEXT,decision_note TEXT,created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS funeral_support_tickets (id TEXT PRIMARY KEY,case_id TEXT NOT NULL,reason TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'open',resolution_note TEXT,created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS funeral_memorial_records (id TEXT PRIMARY KEY,case_id TEXT NOT NULL,record_type TEXT NOT NULL,reference TEXT NOT NULL,note TEXT,shared_status TEXT NOT NULL DEFAULT 'uat_only',created_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS funeral_acknowledgements (id TEXT PRIMARY KEY,case_id TEXT NOT NULL UNIQUE,template_code TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'issued_uat',issued_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS funeral_settlements (id TEXT PRIMARY KEY,case_id TEXT NOT NULL UNIQUE,vendor_id TEXT,commission_amount REAL,payout_status TEXT NOT NULL DEFAULT 'blocked_policy_missing',tax_status TEXT NOT NULL DEFAULT 'not_configured',created_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS funeral_events (id TEXT PRIMARY KEY,case_id TEXT NOT NULL,event_type TEXT NOT NULL,actor_id TEXT NOT NULL,detail_json TEXT NOT NULL DEFAULT '{}',created_at INTEGER NOT NULL)"),
]);const now=Date.now();for(const serviceType of serviceTypes)await db.prepare("INSERT OR IGNORE INTO funeral_service_config (service_type,enabled,base_amount,cash_allowed,updated_at) VALUES (?,0,NULL,0,?)").bind(serviceType,now).run();}

async function event(db:D1Database,caseId:string,eventType:string,actorId:string,detail:unknown={}){await db.prepare("INSERT INTO funeral_events (id,case_id,event_type,actor_id,detail_json,created_at) VALUES (?,?,?,?,?,?)").bind(crypto.randomUUID(),caseId,eventType,actorId,JSON.stringify(detail),Date.now()).run();}
async function seedMilestones(db:D1Database,caseId:string){const now=Date.now();for(const code of milestoneCodes)await db.prepare("INSERT OR IGNORE INTO funeral_milestones (id,case_id,code,status,updated_at) VALUES (?,?,?,'pending',?)").bind(crypto.randomUUID(),caseId,code,now).run();await db.prepare("UPDATE funeral_milestones SET status='complete',completed_at=?,updated_by='system',updated_at=? WHERE case_id=? AND code='request_received'").bind(now,now,caseId).run();}
async function markMilestone(db:D1Database,caseId:string,code:string,actorId:string,note?:string){const now=Date.now();await db.prepare("UPDATE funeral_milestones SET status='complete',note=?,completed_at=?,updated_by=?,updated_at=? WHERE case_id=? AND code=?").bind(note||null,now,actorId,now,caseId,code).run();}

export async function getFuneralServiceConfig(db:D1Database){await ensureFuneralMemorialTables(db);const rows=await db.prepare("SELECT * FROM funeral_service_config ORDER BY service_type").all<Row>();return rows.results;}
export async function saveFuneralServiceConfig(db:D1Database,input:{serviceType:FuneralServiceType;enabled:boolean;baseAmount?:number|null;cashAllowed:boolean},actorId:string){await ensureFuneralMemorialTables(db);if(!serviceTypes.includes(input.serviceType as never))throw new Response("Unknown funeral service type",{status:400});const amount=input.baseAmount==null?null:Number(input.baseAmount);if(amount!=null&&(!Number.isFinite(amount)||amount<=0))throw new Response("Configured amount must be positive",{status:400});const now=Date.now();await db.prepare("INSERT INTO funeral_service_config (service_type,enabled,base_amount,cash_allowed,updated_at) VALUES (?,?,?,?,?) ON CONFLICT(service_type) DO UPDATE SET enabled=excluded.enabled,base_amount=excluded.base_amount,cash_allowed=excluded.cash_allowed,updated_at=excluded.updated_at").bind(input.serviceType,input.enabled?1:0,amount,input.cashAllowed?1:0,now).run();return{config:await getFuneralServiceConfig(db),audit:{actorId,liveMoney:false}};}

export async function createFuneralCase(db:D1Database,input:{customerId:string;petName:string;petSpecies:string;pickupAddress:string;alternateContact?:string;serviceType:FuneralServiceType;memorialOption:MemorialOption;urgency?:string},actorId:string){await ensureFuneralMemorialTables(db);if(!input.customerId||!input.petName||!input.pickupAddress)throw new Response("Customer, pet and pickup details are required",{status:400});if(!serviceTypes.includes(input.serviceType as never))throw new Response("Unsupported funeral service type",{status:400});if(!memorialOptions.includes(input.memorialOption as never))throw new Response("Unsupported memorial option",{status:400});const config=await db.prepare("SELECT * FROM funeral_service_config WHERE service_type=?").bind(input.serviceType).first<Row>();if(!config||Number(config.enabled)!==1)throw new Response("This service type is not enabled",{status:409});const id=`FNL-${crypto.randomUUID().slice(0,10).toUpperCase()}`,now=Date.now();await db.prepare("INSERT INTO funeral_cases (id,customer_id,pet_name,pet_species,pickup_address,alternate_contact,service_type,memorial_option,urgency,status,created_at,updated_at) VALUES (?,?,?,?,?,?,?,?,?,'urgent_request',?,?)").bind(id,input.customerId,input.petName,input.petSpecies||"pet",input.pickupAddress,input.alternateContact||null,input.serviceType,input.memorialOption,input.urgency||"urgent",now,now).run();await seedMilestones(db,id);const configuredAmount=Number(config.base_amount||0);if(configuredAmount>0)await db.prepare("INSERT INTO funeral_payments (id,case_id,amount,status,payment_mode,provider,updated_at) VALUES (?,?,?,'due','internal_uat','internal_uat',?)").bind(`FNP-${crypto.randomUUID().slice(0,10).toUpperCase()}`,id,configuredAmount,now).run();await event(db,id,"urgent_request_created",actorId,{serviceType:input.serviceType,memorialOption:input.memorialOption,sensitiveTemplate:"requestReceived",commercialConfigured:configuredAmount>0,liveMoney:false});return getFuneralCase(db,id);}

export async function getFuneralCase(db:D1Database,caseId:string){await ensureFuneralMemorialTables(db);const row=await db.prepare("SELECT * FROM funeral_cases WHERE id=?").bind(caseId).first<Row>();if(!row)return null;const media=await db.prepare("SELECT * FROM funeral_media WHERE case_id=? ORDER BY created_at DESC").bind(caseId).all<Row>(),milestones=await db.prepare("SELECT * FROM funeral_milestones WHERE case_id=? ORDER BY rowid").bind(caseId).all<Row>(),ashCollection=await db.prepare("SELECT * FROM funeral_ash_collection WHERE case_id=?").bind(caseId).first<Row>(),payment=await db.prepare("SELECT * FROM funeral_payments WHERE case_id=?").bind(caseId).first<Row>(),invoice=await db.prepare("SELECT * FROM funeral_invoices WHERE case_id=?").bind(caseId).first<Row>(),refunds=await db.prepare("SELECT * FROM funeral_refunds WHERE case_id=? ORDER BY created_at DESC").bind(caseId).all<Row>(),tickets=await db.prepare("SELECT * FROM funeral_support_tickets WHERE case_id=? ORDER BY created_at DESC").bind(caseId).all<Row>(),memorialRecords=await db.prepare("SELECT * FROM funeral_memorial_records WHERE case_id=? ORDER BY created_at DESC").bind(caseId).all<Row>(),acknowledgement=await db.prepare("SELECT * FROM funeral_acknowledgements WHERE case_id=?").bind(caseId).first<Row>(),settlement=await db.prepare("SELECT * FROM funeral_settlements WHERE case_id=?").bind(caseId).first<Row>(),events=await db.prepare("SELECT * FROM funeral_events WHERE case_id=? ORDER BY created_at DESC LIMIT 60").bind(caseId).all<Row>();return{...row,media:media.results,milestones:milestones.results,ashCollection:ashCollection??null,payment:payment??null,invoice:invoice??null,refunds:refunds.results,supportTickets:tickets.results,memorialRecords:memorialRecords.results,acknowledgement:acknowledgement??null,settlement:settlement??null,events:events.results.map(item=>({...item,detail:JSON.parse(String(item.detail_json||"{}"))}))};}

export async function listFuneralCases(db:D1Database,input:{customerId?:string;status?:string;serviceType?:string}){await ensureFuneralMemorialTables(db);const where=["1=1"],binds:unknown[]=[];if(input.customerId){where.push("customer_id=?");binds.push(input.customerId)}if(input.status){where.push("status=?");binds.push(input.status)}if(input.serviceType){where.push("service_type=?");binds.push(input.serviceType)}const rows=await db.prepare(`SELECT * FROM funeral_cases WHERE ${where.join(" AND ")} ORDER BY created_at DESC LIMIT 100`).bind(...binds).all<Row>();return rows.results;}

export async function getFuneralReport(db:D1Database){await ensureFuneralMemorialTables(db);const byType=await db.prepare("SELECT service_type,COUNT(*) count FROM funeral_cases GROUP BY service_type ORDER BY service_type").all<Row>(),fulfillment=await db.prepare("SELECT status,COUNT(*) count FROM funeral_cases GROUP BY status ORDER BY status").all<Row>(),turnaround=await db.prepare("SELECT AVG(updated_at-created_at) average_ms FROM funeral_cases WHERE status='closed'").first<Row>(),records=await db.prepare("SELECT COUNT(*) count FROM funeral_memorial_records").first<Row>(),revenue=await db.prepare("SELECT COALESCE(SUM(amount),0) amount FROM funeral_payments WHERE status='paid'").first<Row>();return{requestsByType:byType.results.map(item=>({serviceType:String(item.service_type),count:Number(item.count||0)})),serviceFulfillment:fulfillment.results.map(item=>({status:String(item.status),count:Number(item.count||0)})),turnaroundTime:{averageMs:Number(turnaround?.average_ms||0),basis:"request_to_closure"},plantationMemorialRecords:Number(records?.count||0),revenueAndAverageOrderValue:{sandboxPaidAmount:Number(revenue?.amount||0),currency:"INR",liveMoney:false},generatedAt:Date.now()};}

export async function mutateFuneralCase(db:D1Database,input:{caseId:string;action:string;actorId:string;mediaType?:string;objectId?:string;note?:string;agentId?:string;vendorId?:string;milestoneCode?:string;amount?:number;paymentMode?:"internal_uat"|"cash_uat";paymentReference?:string;preferredAt?:string;ashStatus?:string;recordType?:string;reference?:string;refundAmount?:number;reason?:string;decision?:"approved"|"rejected"|"completed";resolutionMode?:"external_refund"|"wallet_credit_uat";closureNote?:string}){await ensureFuneralMemorialTables(db);const row=await db.prepare("SELECT * FROM funeral_cases WHERE id=?").bind(input.caseId).first<Row>();if(!row)throw new Response("Funeral or memorial request not found",{status:404});const now=Date.now();
 if(input.action==="register_media"||input.action==="register_customer_media"){if(!["photo","video"].includes(String(input.mediaType)))throw new Response("Photo or video type is required",{status:400});const objectId=input.objectId||`uat-media-${crypto.randomUUID()}`;await db.prepare("INSERT INTO funeral_media (id,case_id,media_type,object_id,status,note,created_by,created_at) VALUES (?,?,?,?, 'uat_registered',?,?,?)").bind(crypto.randomUUID(),input.caseId,input.mediaType,objectId,input.note||null,input.actorId,now).run();await event(db,input.caseId,"media_registered",input.actorId,{mediaType:input.mediaType,productionMediaStorage:false});return getFuneralCase(db,input.caseId);}
 if(input.action==="qualify"){await db.prepare("UPDATE funeral_cases SET status='pickup_pending',assigned_agent_id=?,updated_at=? WHERE id=?").bind(input.agentId||input.actorId,now,input.caseId).run();await event(db,input.caseId,"request_qualified",input.actorId,{agentId:input.agentId||input.actorId});return getFuneralCase(db,input.caseId);}
 if(input.action==="assign_vendor"){if(!input.vendorId)throw new Response("Vendor ID is required",{status:400});await db.prepare("UPDATE funeral_cases SET vendor_id=?,updated_at=? WHERE id=?").bind(input.vendorId,now,input.caseId).run();await event(db,input.caseId,"vendor_assigned",input.actorId,{vendorId:input.vendorId,liveVendorApi:false});return getFuneralCase(db,input.caseId);}
 if(input.action==="coordinate_pickup"){await markMilestone(db,input.caseId,"pickup_coordinated",input.actorId,input.note);await db.prepare("UPDATE funeral_cases SET status='pickup_coordinated',updated_at=? WHERE id=?").bind(now,input.caseId).run();await event(db,input.caseId,"pickup_coordinated",input.actorId,{note:input.note||null});return getFuneralCase(db,input.caseId);}
 if(input.action==="complete_milestone"){if(!milestoneCodes.includes(input.milestoneCode as never))throw new Response("Unknown funeral milestone",{status:400});await markMilestone(db,input.caseId,String(input.milestoneCode),input.actorId,input.note);let status=String(row.status);if(input.milestoneCode==="pickup_complete")status="in_care";if(input.milestoneCode==="ritual_scheduled")status="ritual_pending";if(input.milestoneCode==="ritual_complete")status=String(row.memorial_option)!=="none"?"memorial_pending":"closure_pending";if(["ash_collected","memorial_record_created"].includes(String(input.milestoneCode)))status="closure_pending";if(input.milestoneCode==="closure_confirmed")status="closed";await db.prepare("UPDATE funeral_cases SET status=?,updated_at=? WHERE id=?").bind(status,now,input.caseId).run();await event(db,input.caseId,"milestone_completed",input.actorId,{code:input.milestoneCode,note:input.note||null});return getFuneralCase(db,input.caseId);}
 if(input.action==="set_service_amount"){const amount=Number(input.amount||0);if(amount<=0)throw new Response("Service amount must be positive",{status:400});await db.prepare("INSERT INTO funeral_payments (id,case_id,amount,status,payment_mode,provider,updated_at) VALUES (?,?,?,'due','internal_uat','internal_uat',?) ON CONFLICT(case_id) DO UPDATE SET amount=excluded.amount,status='due',payment_reference=NULL,paid_at=NULL,updated_at=excluded.updated_at").bind(`FNP-${crypto.randomUUID().slice(0,10).toUpperCase()}`,input.caseId,amount,now).run();await event(db,input.caseId,"service_amount_set",input.actorId,{amount,liveMoney:false});return getFuneralCase(db,input.caseId);}
 if(input.action==="record_payment"){const payment=await db.prepare("SELECT * FROM funeral_payments WHERE case_id=?").bind(input.caseId).first<Row>();if(!payment)throw new Response("A configured service amount is required before payment",{status:409});const mode=input.paymentMode||"internal_uat";if(mode==="cash_uat"){const config=await db.prepare("SELECT cash_allowed FROM funeral_service_config WHERE service_type=?").bind(row.service_type).first<Row>();if(Number(config?.cash_allowed)!==1)throw new Response("Cash is not enabled for this service type",{status:409});}await db.batch([db.prepare("UPDATE funeral_payments SET status='paid',payment_mode=?,payment_reference=?,paid_at=?,updated_at=? WHERE case_id=?").bind(mode,input.paymentReference||`UAT-${crypto.randomUUID().slice(0,8).toUpperCase()}`,now,now,input.caseId),db.prepare("INSERT OR REPLACE INTO funeral_invoices (id,case_id,amount,status,tax_status,issued_at) VALUES (?,?,?,'uat_issued','not_configured',?)").bind(`FNI-${crypto.randomUUID().slice(0,10).toUpperCase()}`,input.caseId,payment.amount,now)]);await event(db,input.caseId,"payment_recorded",input.actorId,{mode,provider:"internal_uat",liveMoney:false,taxConfigured:false});return getFuneralCase(db,input.caseId);}
 if(input.action==="schedule_ash_collection"){if(!input.preferredAt)throw new Response("Preferred ash collection time is required",{status:400});await db.prepare("INSERT INTO funeral_ash_collection (id,case_id,preferred_at,status,note,updated_at) VALUES (?,?,?,'requested',NULL,?) ON CONFLICT(case_id) DO UPDATE SET preferred_at=excluded.preferred_at,status='requested',note=NULL,updated_at=excluded.updated_at").bind(crypto.randomUUID(),input.caseId,input.preferredAt,now).run();await event(db,input.caseId,"ash_collection_requested",input.actorId,{preferredAt:input.preferredAt});return getFuneralCase(db,input.caseId);}
