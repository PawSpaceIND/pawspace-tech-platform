export type TrainingPackage={package_code:string;name:string;sessions:number;validity_days:number;base_price:number;currency:string;meet_and_greet:number;max_pets:number;direct_minutes_per_pet:number;coaching_minutes_per_pet:number;split_due_percent:number;version:number};
export type TrainingQuote={quoteId:string;packageCode:string;packageName:string;packageVersion:number;sessions:number;validityDays:number;petCount:number;minutesPerSession:number;basePrice:number;discount:number;totalAmount:number;amountDueNow:number;paymentMode:"prepaid"|"split";meetAndGreet:boolean;expiresAt:number;liveMoney:false};
export type TrainingTrainer={id:string;name:string;model:"full_time"|"commission";rating:number;qualityScore:number;capacity:number;travelBufferMinutes:number;maxDailyJobs:number};
async function payload<T>(response:Response,fallback:string){const body=await response.json() as {data?:T;error?:string};if(!response.ok||!body.data)throw new Error(body.error||fallback);return body.data;}
export async function loadTrainingPackages(){return payload<{packages:TrainingPackage[];source:string;liveMoney:false}>(await fetch("/api/training-commercial",{cache:"no-store"}),"Unable to load Training catalogue");}
export async function quoteTraining(input:{packageCode:string;petCount:number;scheduledStart:string;paymentMode:"prepaid"|"split";couponCode?:string}){return payload<TrainingQuote>(await fetch("/api/training-commercial",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(input)}),"Unable to quote Training booking");}
export async function loadTrainingTrainers(input:{cityId:string;zoneId:string;at:string}){const query=new URLSearchParams({cityId:input.cityId,zoneId:input.zoneId,at:input.at});return payload<{providers:TrainingTrainer[];source:string;liveAvailability:false}>(await fetch(`/api/training-trainers?${query}`,{cache:"no-store"}),"Unable to load eligible Training trainers");}
