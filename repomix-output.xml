async function app(db:D1Database,id:string){await ensureProviderOnboardingHumanActivation(db);const row=await db.prepare("SELECT * FROM provider_onboarding_applications WHERE id=?").bind(id).first<Row>();if(!row)throw new Error("Application not found");return row;}
