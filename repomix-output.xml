<file path="app/api/revenue-intelligence/route.ts">
import{authError,authorize,database,securityAudit}from"../../../lib/server-auth";
import{buildCustomer360}from"../../../lib/customer-360";
import{rankRevenueActions}from"../../../lib/revenue-intelligence";

type Body={action?:"claim"|"complete"|"suppress";id?:string;customerId?:string;outcome?:string;bookingId?:string;collectedRevenue?:number;note?:string};
const json=(value:unknown,status=200)=>Response.json(value,{status,headers:{"cache-control":"no-store"}});
function sameOrigin(request:Request){const origin=request.headers.get("origin");if(origin&&origin!==new URL(request.url).origin)throw new Response("Cross-origin revenue intelligence write blocked",{status:403});}
async function ensure(db:D1Database){await db.batch([
 db.prepare("CREATE TABLE IF NOT EXISTS governed_revenue_actions (id TEXT PRIMARY KEY,customer_id TEXT NOT NULL,opportunity_type TEXT NOT NULL,reason TEXT NOT NULL,score INTEGER NOT NULL,expected_revenue REAL NOT NULL,expected_margin REAL,confidence REAL NOT NULL,owner TEXT NOT NULL,preferred_channel TEXT NOT NULL,status TEXT NOT NULL,suppression_json TEXT NOT NULL DEFAULT '[]',signals_json TEXT NOT NULL DEFAULT '{}',claimed_by TEXT,claimed_at INTEGER,completed_by TEXT,completed_at INTEGER,outcome TEXT,attributed_booking_id TEXT,collected_revenue REAL NOT NULL DEFAULT 0,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS governed_revenue_events (id TEXT PRIMARY KEY,action_id TEXT NOT NULL,customer_id TEXT NOT NULL,event_type TEXT NOT NULL,actor_email TEXT NOT NULL,detail_json TEXT NOT NULL DEFAULT '{}',created_at INTEGER NOT NULL)"),
]);}
async function refresh(db:D1Database){const records=await buildCustomer360(db),ranked=rankRevenueActions(records),now=Date.now();
 // Batched (chunks of 40) instead of one sequential round-trip per customer: this refresh runs on
 // every GET, so N customers previously meant N awaited D1 calls before the worklist could render.
 const statements=ranked.map(item=>db.prepare("INSERT INTO governed_revenue_actions (id,customer_id,opportunity_type,reason,score,expected_revenue,expected_margin,confidence,owner,preferred_channel,status,suppression_json,signals_json,updated_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?) ON CONFLICT(id) DO UPDATE SET opportunity_type=excluded.opportunity_type,reason=excluded.reason,score=excluded.score,expected_revenue=excluded.expected_revenue,expected_margin=excluded.expected_margin,confidence=excluded.confidence,owner=excluded.owner,preferred_channel=excluded.preferred_channel,status=CASE WHEN governed_revenue_actions.status IN ('claimed','completed') THEN governed_revenue_actions.status ELSE excluded.status END,suppression_json=excluded.suppression_json,signals_json=excluded.signals_json,updated_at=excluded.updated_at")
 .bind(item.id,item.customerId,item.opportunityType,item.reason,item.score,item.expectedRevenue,item.expectedMargin,item.confidence,item.owner,item.preferredChannel,item.status,JSON.stringify(item.suppressionReasons),JSON.stringify({...item.signals,scoringMode:item.scoringMode,estimateOnly:item.estimateOnly,marginStatus:item.marginStatus}),now));
 for(let index=0;index<statements.length;index+=40)await db.batch(statements.slice(index,index+40));return ranked.length;}
export async function GET(request:Request){try{await authorize(request,"customers.view");const db=await database();await ensure(db);await refresh(db);const status=new URL(request.url).searchParams.get("status");const rows=status?await db.prepare("SELECT * FROM governed_revenue_actions WHERE status=? ORDER BY score DESC,expected_revenue DESC LIMIT 200").bind(status).all():await db.prepare("SELECT * FROM governed_revenue_actions ORDER BY CASE status WHEN 'ready' THEN 0 WHEN 'claimed' THEN 1 WHEN 'completed' THEN 2 ELSE 3 END,score DESC,expected_revenue DESC LIMIT 200").all();return json({data:{actions:rows.results,source:"canonical_customer_signals",scoringMode:"uat_rules_v1",estimateOnly:true,marginStatus:"configuration_required"}});}catch(error){return authError(error,"Unable to load governed revenue intelligence");}}
export async function POST(request:Request){try{sameOrigin(request);const actor=await authorize(request,"customers.manage"),body=await request.json() as Body,db=await database();await ensure(db);if(!body.id||!body.action)return json({error:"Revenue action and ID are required"},400);const current=await db.prepare("SELECT * FROM governed_revenue_actions WHERE id=?").bind(body.id).first<Record<string,unknown>>();if(!current)return json({error:"Revenue action not found"},404);if(String(current.status)==="suppressed")return json({error:"Suppressed revenue actions cannot be worked until their suppression clears"},409);const now=Date.now();if(body.action==="claim"){if(!["ready","claimed"].includes(String(current.status)))return json({error:"Revenue action is not claimable"},409);await db.prepare("UPDATE governed_revenue_actions SET status='claimed',claimed_by=COALESCE(claimed_by,?),claimed_at=COALESCE(claimed_at,?),updated_at=? WHERE id=?").bind(actor.email,now,now,body.id).run();}
 else if(body.action==="complete"){if(String(current.status)!=="claimed")return json({error:"Revenue action must be claimed before completion"},409);await db.prepare("UPDATE governed_revenue_actions SET status='completed',completed_by=?,completed_at=?,outcome=?,attributed_booking_id=?,collected_revenue=?,updated_at=? WHERE id=?").bind(actor.email,now,body.outcome||"completed",body.bookingId||null,Math.max(0,Number(body.collectedRevenue||0)),now,body.id).run();}
 else if(body.action==="suppress"){await db.prepare("UPDATE governed_revenue_actions SET status='suppressed',suppression_json=?,updated_at=? WHERE id=?").bind(JSON.stringify([body.note||"manual_suppression"]),now,body.id).run();}
 await db.prepare("INSERT INTO governed_revenue_events (id,action_id,customer_id,event_type,actor_email,detail_json,created_at) VALUES (?,?,?,?,?,?,?)").bind(crypto.randomUUID(),body.id,String(current.customer_id),body.action,actor.email,JSON.stringify({outcome:body.outcome||null,bookingId:body.bookingId||null,collectedRevenue:Number(body.collectedRevenue||0),note:body.note||null}),now).run();await securityAudit(db,actor,`revenue.${body.action}`,"governed_revenue_action",body.id,"completed",{customerId:current.customer_id});return json({ok:true,id:body.id,status:body.action==="claim"?"claimed":body.action==="complete"?"completed":"suppressed"});}catch(error){if(error instanceof Response)return json({error:await error.text()},error.status);return authError(error,"Unable to update governed revenue action");}}
</file>

