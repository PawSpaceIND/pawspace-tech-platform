export async function GET(request:Request){try{const db=await database(),actor=await resolveActor(request);requirePermission(actor,"bookings.manage");await ensureTrainingSessionLifecycleTables(db);await seedProviderCapacityDefaults(db);const rows=await db.prepare("SELECT p.*,b.total_amount,b.status booking_status,b.currency,pay.status payment_status,pay.amount_due_now,pay.mode payment_mode,pay.gateway,c.name customer_name FROM training_programmes p JOIN canonical_bookings b ON b.id=p.booking_id LEFT JOIN booking_payments pay ON pay.booking_id=p.booking_id LEFT JOIN canonical_customers c ON c.id=p.customer_id ORDER BY p.updated_at DESC LIMIT 150").all<Row>();const programmes:Record<string,unknown>[]=[];for(const row of rows.results){const[sessions,recoveries]=await Promise.all([db.prepare("SELECT id,programme_id,booking_id,schedule_reservation_id,sequence_no,provider_id,scheduled_start,scheduled_end,status,started_at,completed_at,updated_at FROM training_sessions WHERE programme_id=? ORDER BY sequence_no").bind(row.id).all<Row>(),db.prepare("SELECT id,session_id,recovery_type,status,reason,requested_by,replacement_provider_id,new_start,new_end,created_at,updated_at FROM training_session_recovery_cases WHERE programme_id=? ORDER BY updated_at DESC").bind(row.id).all<Row>()]);programmes.push({...row,customer_name:maskName(String(row.customer_name||"Customer")),petIds:parse<string[]>(row.pet_ids_json,[]),requirements:parse<string[]>(row.requirements_json,[]),pricingSnapshot:parse(row.pricing_snapshot_json,{}),sessions:sessions.results,recoveries:recoveries.results});}
 const trainerRows=await db.prepare("SELECT id,name,provider_model,rating,quality_score,zones_json,services_json,status,live FROM provider_capacity_profiles WHERE status='active' AND live=1 ORDER BY quality_score DESC,rating DESC").all<Row>();const trainers=trainerRows.results.filter(row=>parse<string[]>(row.services_json??"[]",[]).includes("dog_training")||String(row.id).startsWith("train_")).map(row=>({id:String(row.id),name:String(row.name),model:String(row.provider_model),rating:Number(row.rating||0),qualityScore:Number(row.quality_score||0),zones:parse<string[]>(row.zones_json,[])}));const allSessions=programmes.flatMap(item=>(item.sessions as Row[])),today=new Date().toISOString().slice(0,10),metrics={activeProgrammes:programmes.filter(item=>!["completed","completed_with_exceptions","cancelled"].includes(String(item.status))).length,sessionsToday:allSessions.filter(item=>String(item.scheduled_start).slice(0,10)===today).length,openRecovery:programmes.reduce((sum,item)=>sum+(item.recoveries as Row[]).filter(caseRow=>String(caseRow.status)==="open").length,0),paymentExceptions:programmes.filter(item=>String(item.payment_status)!=="captured").length};return json({data:{programmes,trainers,metrics,source:"canonical_training_ops",liveMoney:false}});}catch(error){return authError(error,"Unable to load Training operations");}}
