<file path="lib/training-session-lifecycle.ts">
import{ensureTrainingProgrammeTables}from"./training-programme";
import{getGovernedProvider,seedProviderCapacityDefaults}from"./provider-capacity-governance";
import{listAuthoritativeAvailability}from"./scheduling-roster-authority";

type Row=Record<string,unknown>;
export type TrainingSessionAction="accept"|"on_the_way"|"arrive"|"start"|"save_report"|"complete"|"request_reschedule"|"no_show"|"reschedule"|"replace_provider"|"cancel_session";
export type TrainingReport={attendance?:Record<string,unknown>;homework?:string;progress?:Record<string,unknown>;evidenceRefs?:string[]};
export type TrainingSessionMutation={sessionId:string;action:TrainingSessionAction;actorId:string;idempotencyKey:string;reason?:string;report?:TrainingReport;newStart?:string;newEnd?:string;newProviderId?:string;staffOverride?:boolean};

export async function ensureTrainingSessionLifecycleTables(db:D1Database){await ensureTrainingProgrammeTables(db);await db.batch([
 db.prepare("CREATE TABLE IF NOT EXISTS training_session_events (id TEXT PRIMARY KEY,session_id TEXT NOT NULL,programme_id TEXT NOT NULL,booking_id TEXT NOT NULL,event_type TEXT NOT NULL,actor_id TEXT NOT NULL,idempotency_key TEXT NOT NULL UNIQUE,detail_json TEXT NOT NULL DEFAULT '{}',created_at INTEGER NOT NULL)"),
 db.prepare("CREATE INDEX IF NOT EXISTS idx_training_session_events_session ON training_session_events(session_id,created_at)"),
 db.prepare("CREATE TABLE IF NOT EXISTS training_session_consumptions (session_id TEXT PRIMARY KEY,programme_id TEXT NOT NULL,booking_id TEXT NOT NULL,actor_id TEXT NOT NULL,consumed_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS training_session_recovery_cases (id TEXT PRIMARY KEY,session_id TEXT NOT NULL,programme_id TEXT NOT NULL,booking_id TEXT NOT NULL,recovery_type TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'open',reason TEXT NOT NULL,requested_by TEXT NOT NULL,replacement_provider_id TEXT,new_start TEXT,new_end TEXT,detail_json TEXT NOT NULL DEFAULT '{}',created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE INDEX IF NOT EXISTS idx_training_session_recovery_open ON training_session_recovery_cases(session_id,status,updated_at)"),
 db.prepare("CREATE TABLE IF NOT EXISTS training_session_media_links (media_id TEXT PRIMARY KEY,session_id TEXT NOT NULL,programme_id TEXT NOT NULL,booking_id TEXT NOT NULL,provider_id TEXT NOT NULL,created_at INTEGER NOT NULL)"),
 db.prepare("CREATE INDEX IF NOT EXISTS idx_training_session_media_session ON training_session_media_links(session_id,created_at)"),
]);}

function parse<T>(value:unknown,fallback:T):T{try{return JSON.parse(String(value??"")) as T}catch{return fallback}}
async function sessionRow(db:D1Database,sessionId:string){await ensureTrainingSessionLifecycleTables(db);return db.prepare("SELECT s.*,p.customer_id,p.provider_id programme_provider_id,p.zone_id,p.plan_code,p.plan_name,p.pet_ids_json,p.requirements_json,p.total_sessions,p.completed_sessions,p.no_show_sessions,p.cancelled_sessions,p.status programme_status,c.name customer_name FROM training_sessions s JOIN training_programmes p ON p.id=s.programme_id LEFT JOIN canonical_customers c ON c.id=p.customer_id WHERE s.id=?").bind(sessionId).first<Row>();}
export async function getTrainingSession(db:D1Database,sessionId:string){return sessionRow(db,sessionId);}
async function event(db:D1Database,row:Row,input:TrainingSessionMutation,detail:unknown={}){await db.prepare("INSERT INTO training_session_events (id,session_id,programme_id,booking_id,event_type,actor_id,idempotency_key,detail_json,created_at) VALUES (?,?,?,?,?,?,?,?,?)").bind(crypto.randomUUID(),row.id,row.programme_id,row.booking_id,input.action,input.actorId,input.idempotencyKey,JSON.stringify(detail),Date.now()).run();}

// An idempotency key identifies ONE mutation of ONE record. This lookup used to match on the key alone
// and ran BEFORE the record was loaded, so a second caller reusing a key - a different provider, acting
// on a different customer's booking - was answered 200, had its mutation silently discarded, and
// received the FIRST caller's identifiers in the response body. The same collision swallowed a walker's
// decline with the earlier accept, so no recovery case opened and nobody learned the job had no
// provider. The columns needed to tell a replay from a collision were already being written here and
// simply never read back. Reused for a different record or a different action, a key is a CONFLICT and
// is refused rather than answered with somebody else's record. [PTJA-P1-F23]
async function duplicate(db:D1Database,idempotencyKey:string,sessionId:string,action:string){const row=await db.prepare("SELECT session_id,event_type,detail_json,created_at FROM training_session_events WHERE idempotency_key=?").bind(idempotencyKey).first<Row>();if(!row)return null;if(String(row.session_id)!==String(sessionId)||String(row.event_type)!==String(action))throw new Response("An idempotency key identifies one action on one record; this key was already used for a different one",{status:409});return row;}
async function recalcProgramme(db:D1Database,programmeId:string){const counts=await db.prepare("SELECT COUNT(*) total,SUM(CASE WHEN status='completed' THEN 1 ELSE 0 END) completed,SUM(CASE WHEN status='no_show' THEN 1 ELSE 0 END) no_show,SUM(CASE WHEN status='cancelled' THEN 1 ELSE 0 END) cancelled,SUM(CASE WHEN status IN ('accepted','on_the_way','arrived','in_session','reschedule_requested') THEN 1 ELSE 0 END) active FROM training_sessions WHERE programme_id=?").bind(programmeId).first<Row>();const total=Number(counts?.total||0),completed=Number(counts?.completed||0),noShow=Number(counts?.no_show||0),cancelled=Number(counts?.cancelled||0),active=Number(counts?.active||0);const terminal=completed+cancelled+noShow===total;const status=terminal?(noShow===0&&cancelled===0?"completed":"completed_with_exceptions"):active>0||completed>0||noShow>0?"in_progress":"scheduled";await db.prepare("UPDATE training_programmes SET completed_sessions=?,no_show_sessions=?,cancelled_sessions=?,status=?,updated_at=? WHERE id=?").bind(completed,noShow,cancelled,status,Date.now(),programmeId).run();return{total,completed,noShow,cancelled,status};}

export async function listTrainerSessions(db:D1Database,providerId:string){await ensureTrainingSessionLifecycleTables(db);const rows=await db.prepare("SELECT s.*,p.customer_id,p.plan_code,p.plan_name,p.pet_ids_json,p.requirements_json,p.total_sessions,p.completed_sessions,p.no_show_sessions,p.cancelled_sessions,p.status programme_status,c.name customer_name FROM training_sessions s JOIN training_programmes p ON p.id=s.programme_id LEFT JOIN canonical_customers c ON c.id=p.customer_id WHERE s.provider_id=? ORDER BY s.scheduled_start,s.sequence_no LIMIT 200").bind(providerId).all<Row>();const results=[];for(const row of rows.results){const events=await db.prepare("SELECT event_type,actor_id,detail_json,created_at FROM training_session_events WHERE session_id=? ORDER BY created_at DESC LIMIT 20").bind(row.id).all<Row>();results.push({...row,petIds:parse<string[]>(row.pet_ids_json,[]),requirements:parse<string[]>(row.requirements_json,[]),attendance:parse(row.attendance_json,{}),homework:parse(row.homework_json,{}),progress:parse(row.progress_json,{}),evidenceRefs:parse<string[]>(row.evidence_json,[]),events:events.results});}return results;}

async function secureEvidenceReady(db:D1Database,row:Row,refs:string[]){if(!refs.length)return{ready:false,reason:"At least one secure Training evidence asset is required"};for(const ref of refs){const match=/^media:\/\/asset\/(.+)$/.exec(ref);if(!match)return{ready:false,reason:"Training evidence must use a canonical media://asset reference"};const asset=await db.prepare("SELECT a.id,a.booking_id,a.provider_id,a.purpose,a.scan_status,a.access_status,a.retention_status,a.synthetic,l.session_id,l.provider_id link_provider_id FROM service_media_assets a JOIN training_session_media_links l ON l.media_id=a.id WHERE a.id=?").bind(match[1]).first<Row>();if(!asset||String(asset.session_id)!==String(row.id)||String(asset.booking_id)!==String(row.booking_id)||String(asset.provider_id)!==String(row.provider_id)||String(asset.link_provider_id)!==String(row.provider_id)||String(asset.purpose)!=="training_homework"||String(asset.scan_status)!=="clean"||String(asset.access_status)!=="ready"||String(asset.retention_status)!=="active"||Number(asset.synthetic||0)!==0)return{ready:false,reason:`Evidence ${ref} is not clean, ready, active, non-synthetic proof linked to this exact Training session/trainer`};}return{ready:true};}
function reportProblem(report:TrainingReport|undefined){const attendance=report?.attendance??{},mode=String(attendance.mode||"");if(!["parent","trainer_led"].includes(mode))return"Attendance mode must be parent or trainer_led";if(attendance.safeAreaConfirmed!==true)return"Safe training area confirmation is required";if(mode==="parent"&&attendance.parentOrCaretakerConfirmed!==true)return"Parent/caretaker attendance confirmation is required";if(String(report?.homework||"").trim().length<10)return"Meaningful homework is required before completion";const progress=report?.progress??{},scores=Object.values(progress).filter(value=>typeof value==="number") as number[];if(!scores.length||scores.some(score=>score<1||score>10))return"At least one 1-10 progress score is required";return null;}
function windowCovers(window:string,startMinutes:number,endMinutes:number){const match=/^(\d{2}):(\d{2})-(\d{2}):(\d{2})$/.exec(window);if(!match)return false;const from=Number(match[1])*60+Number(match[2]),to=Number(match[3])*60+Number(match[4]);return startMinutes>=from&&endMinutes<=to;}
async function rosterCovers(db:D1Database,providerId:string,zoneId:string,start:string,end:string){const table=await db.prepare("SELECT name FROM sqlite_master WHERE type='table' AND name='scheduling_availability'").first<Row>();if(!table)return{covered:false,reason:"Trainer roster availability is not configured; cannot verify the trainer works this window"};const localStart=new Date(new Date(start).getTime()+330*60_000),localEnd=new Date(new Date(end).getTime()+330*60_000),date=localStart.toISOString().slice(0,10),startMinutes=localStart.getUTCHours()*60+localStart.getUTCMinutes(),endMinutes=localEnd.getUTCHours()*60+localEnd.getUTCMinutes();// Authored availability wins over synthetic uat_roster rows for the same provider-date, so a
  // trainer's real published hours are what "the trainer works this window" means. [PTJA-W1-F27]
  const rows=await listAuthoritativeAvailability(db,providerId,date);const covered=rows.some(item=>String(item.zone_id)===String(zoneId)&&parse<string[]>(item.windows_json,[]).some(window=>windowCovers(window,startMinutes,endMinutes)));return covered?{covered:true}:{covered:false,reason:`Trainer has no roster availability covering ${date} in this zone for the requested window`};}
async function providerConflict(db:D1Database,providerId:string,zoneId:string,start:string,end:string,reservationId:string){await seedProviderCapacityDefaults(db);const profile=await db.prepare("SELECT travel_buffer_minutes FROM provider_capacity_profiles WHERE id=? AND status='active' AND live=1").bind(providerId).first<Row>();if(!profile)return{conflict:true,reason:"Replacement/reschedule provider is not active"};const roster=await rosterCovers(db,providerId,zoneId,start,end);if(!roster.covered)return{conflict:true,reason:roster.reason};const buffer=Math.max(0,Number(profile.travel_buffer_minutes||0))*60_000,startMs=new Date(start).getTime(),endMs=new Date(end).getTime();const rows=await db.prepare("SELECT id,scheduled_start,scheduled_end FROM scheduling_reservations WHERE provider_id=? AND id!=? AND status!='cancelled'").bind(providerId,reservationId).all<Row>();const conflict=rows.results.find(item=>new Date(String(item.scheduled_start)).getTime()<endMs+buffer&&new Date(String(item.scheduled_end)).getTime()>startMs-buffer);return conflict?{conflict:true,reason:`Provider schedule conflicts with reservation ${String(conflict.id)} including travel buffer`}:{conflict:false};}
async function recovery(db:D1Database,row:Row,type:string,reason:string,actorId:string,extra:Record<string,unknown>={}){const now=Date.now(),existing=await db.prepare("SELECT id FROM training_session_recovery_cases WHERE session_id=? AND recovery_type=? AND status='open' ORDER BY created_at DESC LIMIT 1").bind(row.id,type).first<Row>();if(existing){await db.prepare("UPDATE training_session_recovery_cases SET reason=?,requested_by=?,detail_json=?,updated_at=? WHERE id=?").bind(reason,actorId,JSON.stringify(extra),now,existing.id).run();return String(existing.id);}const id=`TSR-${crypto.randomUUID().slice(0,12).toUpperCase()}`;await db.prepare("INSERT INTO training_session_recovery_cases (id,session_id,programme_id,booking_id,recovery_type,status,reason,requested_by,replacement_provider_id,new_start,new_end,detail_json,created_at,updated_at) VALUES (?,?,?,?,?,'open',?,?,NULL,NULL,NULL,?,?,?)").bind(id,row.id,row.programme_id,row.booking_id,type,reason,actorId,JSON.stringify(extra),now,now).run();return id;}

