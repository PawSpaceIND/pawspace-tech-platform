<file path="lib/sitting-lifecycle.ts">
import{getStayPaymentSchedule}from"./stay-split-payments";
type Row=Record<string,unknown>;
export type SittingAction="accept"|"decline"|"submit_care_plan"|"check_in"|"care_event"|"sitter_unavailable"|"no_show"|"check_out";
export type SittingCarePlan={feeding?:string;medication?:string;emergencyContact?:string;vet?:string;homeAccess?:string;specialInstructions?:string};
export type SittingMutation={bookingId:string;action:SittingAction;actorId:string;idempotencyKey:string;reason?:string;carePlan?:SittingCarePlan;careEventType?:string;detail?:Record<string,unknown>};

export async function ensureSittingLifecycleTables(db:D1Database){await db.batch([
 db.prepare("CREATE TABLE IF NOT EXISTS sitting_action_keys (idempotency_key TEXT PRIMARY KEY,booking_id TEXT NOT NULL,action TEXT NOT NULL,result_json TEXT NOT NULL,created_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS sitting_care_plan_snapshots (booking_id TEXT PRIMARY KEY,customer_id TEXT NOT NULL,plan_json TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'ready',updated_by TEXT NOT NULL,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS sitting_care_events (id TEXT PRIMARY KEY,booking_id TEXT NOT NULL,event_type TEXT NOT NULL,actor_id TEXT NOT NULL,detail_json TEXT NOT NULL DEFAULT '{}',created_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS sitting_recovery_cases (id TEXT PRIMARY KEY,booking_id TEXT NOT NULL,group_id TEXT NOT NULL,failed_provider_id TEXT NOT NULL,reason_code TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'ops_escalation',replacement_provider_id TEXT,detail_json TEXT NOT NULL DEFAULT '{}',opened_at INTEGER NOT NULL,resolved_at INTEGER,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS sitting_customer_notifications (id TEXT PRIMARY KEY,booking_id TEXT NOT NULL,customer_id TEXT NOT NULL,channel TEXT NOT NULL,template_code TEXT NOT NULL,message TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'queued',event_id TEXT NOT NULL,created_at INTEGER NOT NULL)"),
 ]);}
function parse<T>(value:unknown,fallback:T):T{try{return JSON.parse(String(value??"")) as T}catch{return fallback}}
async function bookingRow(db:D1Database,bookingId:string){await ensureSittingLifecycleTables(db);return db.prepare("SELECT b.*,w.id work_order_id,w.status work_order_status,w.provider_id work_order_provider_id FROM canonical_bookings b LEFT JOIN provider_work_orders w ON w.booking_id=b.id WHERE b.id=? AND b.service_code='pet_sitting'").bind(bookingId).first<Row>();}
export async function getSittingBooking(db:D1Database,bookingId:string){return bookingRow(db,bookingId);}
export async function listSittingBookings(db:D1Database,input:{providerId?:string;customerId?:string;bookingId?:string}){await ensureSittingLifecycleTables(db);const where=["b.service_code='pet_sitting'"],binds:unknown[]=[];if(input.providerId){where.push("b.provider_id=?");binds.push(input.providerId)}if(input.customerId){where.push("b.customer_id=?");binds.push(input.customerId)}if(input.bookingId){where.push("b.id=?");binds.push(input.bookingId)}const rows=await db.prepare(`SELECT b.*,w.id work_order_id,w.status work_order_status FROM canonical_bookings b LEFT JOIN provider_work_orders w ON w.booking_id=b.id WHERE ${where.join(" AND ")} ORDER BY b.created_at DESC`).bind(...binds).all<Row>();const result=[];for(const row of rows.results){const care=await db.prepare("SELECT status,plan_json,updated_at FROM sitting_care_plan_snapshots WHERE booking_id=?").bind(row.id).first<Row>();const events=await db.prepare("SELECT id,event_type,actor_id,detail_json,created_at FROM sitting_care_events WHERE booking_id=? ORDER BY created_at DESC LIMIT 40").bind(row.id).all<Row>();const recovery=await db.prepare("SELECT * FROM sitting_recovery_cases WHERE booking_id=? ORDER BY opened_at DESC LIMIT 1").bind(row.id).first<Row>();result.push({...row,carePlan:care?{status:String(care.status),plan:parse(care.plan_json,{}),updatedAt:Number(care.updated_at)}:null,events:events.results.map(event=>({...event,detail:parse(event.detail_json,{})})),recovery:recovery??null})}return result;}
async function event(db:D1Database,booking:Row,eventType:string,actorId:string,detail:unknown={}){const id=crypto.randomUUID();await db.prepare("INSERT INTO sitting_care_events (id,booking_id,event_type,actor_id,detail_json,created_at) VALUES (?,?,?,?,?,?)").bind(id,booking.id,eventType,actorId,JSON.stringify(detail),Date.now()).run();return id;}
async function notify(db:D1Database,booking:Row,eventId:string,message:string){for(const channel of ["push","whatsapp"])await db.prepare("INSERT INTO sitting_customer_notifications (id,booking_id,customer_id,channel,template_code,message,status,event_id,created_at) VALUES (?,?,?,?,?,?,'queued',?,?)").bind(crypto.randomUUID(),booking.id,booking.customer_id,channel,"sitting_update",message,eventId,Date.now()).run();}

// An idempotency key identifies ONE mutation of ONE record. This lookup used to match on the key alone
// and ran BEFORE the record was loaded, so a second caller reusing a key - a different provider, acting
// on a different customer's booking - was answered 200, had its mutation silently discarded, and
// received the FIRST caller's identifiers in the response body. The same collision swallowed a walker's
// decline with the earlier accept, so no recovery case opened and nobody learned the job had no
// provider. The columns needed to tell a replay from a collision were already being written here and
// simply never read back. Reused for a different record or a different action, a key is a CONFLICT and
// is refused rather than answered with somebody else's record. [PTJA-P1-F23]
async function priorResult(db:D1Database,key:string,bookingId:string,action:string){const row=await db.prepare("SELECT booking_id,action,result_json FROM sitting_action_keys WHERE idempotency_key=?").bind(key).first<Row>();if(!row)return null;if(String(row.booking_id)!==String(bookingId)||String(row.action)!==String(action))throw new Response("An idempotency key identifies one action on one record; this key was already used for a different one",{status:409});return parse<Record<string,unknown>>(row.result_json,{});}
async function remember(db:D1Database,input:SittingMutation,result:unknown){await db.prepare("INSERT INTO sitting_action_keys (idempotency_key,booking_id,action,result_json,created_at) VALUES (?,?,?,?,?)").bind(input.idempotencyKey,input.bookingId,input.action,JSON.stringify(result),Date.now()).run();return result;}

export async function mutateSittingBooking(db:D1Database,input:SittingMutation){if(!input.bookingId||!input.action||!input.actorId||!input.idempotencyKey)throw new Response("Booking, action, actor and idempotency key are required",{status:400});await ensureSittingLifecycleTables(db);const prior=await priorResult(db,input.idempotencyKey,input.bookingId,input.action);if(prior)return{...prior,duplicatePrevented:true};const booking=await bookingRow(db,input.bookingId);if(!booking)throw new Response("Sitting booking not found",{status:404});const now=Date.now(),status=String(booking.status),providerId=String(booking.provider_id),groupId=String(booking.schedule_group_id||"");
 if(input.action==="accept"){
  if(!["confirmed","assigned","awaiting_provider_acceptance"].includes(status))throw new Response("Sitting booking is not awaiting sitter acceptance",{status:409});if(String(booking.work_order_provider_id||providerId)!==providerId)throw new Response("Sitting work order no longer matches the canonical booking",{status:409});const offer=groupId?await db.prepare("SELECT * FROM provider_assignment_offers WHERE group_id=?").bind(groupId).first<Row>():null;if(offer){if(String(offer.provider_id)!==providerId||String(offer.status)!=="pending")throw new Response("No pending sitter offer is available",{status:409});if(Number(offer.expires_at)<now)throw new Response("Sitter acceptance offer expired; Operations recovery is required",{status:409});}
  const statements=[db.prepare("UPDATE canonical_bookings SET status='assigned',updated_at=? WHERE id=?").bind(now,booking.id),db.prepare("UPDATE provider_work_orders SET status='accepted',updated_at=? WHERE booking_id=?").bind(now,booking.id)];if(offer)statements.push(db.prepare("UPDATE provider_assignment_offers SET status='accepted',responded_at=?,response_reason='Accepted in Sitting workspace',updated_at=? WHERE group_id=?").bind(now,now,groupId));await db.batch(statements);const eventId=await event(db,booking,"sitter_accepted",input.actorId,{providerId});await notify(db,booking,eventId,"Your PawSpace sitter has accepted the booking. The booking ID and care window are unchanged.");return remember(db,input,{bookingId:booking.id,status:"assigned",providerId});
 }
 if(input.action==="decline"||input.action==="sitter_unavailable"||input.action==="no_show"){
  // A booking that is already finished or cancelled has no assignment left to recover. This branch used
  // to read the booking and never look at its status, so one ordinary partner-authenticated call
  // overwrote a committed 'completed' or 'cancelled' booking with 'reassignment_needed' - and answered
  // success with the literal bookingPreserved:true while the completion was being destroyed. Settlement
  // keys off status='completed', so a regressed booking silently dropped out of the payout queue, and a
  // regressed CANCELLED booking re-entered the recovery queue as live work, letting Ops offer a
  // cancelled customer's slot to a new provider.
  if(["completed","cancelled","refunded"].includes(String(booking.status)))throw new Response(`This Sitting booking is already ${String(booking.status)}; there is no assignment left to recover`,{status:409});
  const reason=String(input.reason||"").trim();if(reason.length<3)throw new Response("A recovery reason is required",{status:400});if(groupId)await db.prepare("UPDATE provider_assignment_offers SET status=?,responded_at=?,response_reason=?,updated_at=? WHERE group_id=? AND provider_id=? AND status='pending'").bind(input.action==="decline"?"declined":"cancelled",now,reason,now,groupId,providerId).run();const recoveryId=crypto.randomUUID();await db.batch([db.prepare("UPDATE canonical_bookings SET status='reassignment_needed',updated_at=? WHERE id=?").bind(now,booking.id),db.prepare("UPDATE provider_work_orders SET status='recovery_pending',updated_at=? WHERE booking_id=?").bind(now,booking.id),db.prepare("UPDATE scheduling_reservations SET status='cancelled' WHERE group_id=? AND provider_id=? AND status!='cancelled'").bind(groupId,providerId),db.prepare("UPDATE scheduling_assignment_decisions SET status='reassignment_needed',actor_id=?,reason=?,updated_at=? WHERE group_id=?").bind(input.actorId,reason,now,groupId),db.prepare("INSERT INTO sitting_recovery_cases (id,booking_id,group_id,failed_provider_id,reason_code,status,replacement_provider_id,detail_json,opened_at,resolved_at,updated_at) VALUES (?,?,?,?,?,'ops_escalation',NULL,?,?,NULL,?)").bind(recoveryId,booking.id,groupId,providerId,input.action,JSON.stringify({reason,bookingPreserved:true}),now,now)]);const eventId=await event(db,booking,`sitter_${input.action}`,input.actorId,{reason,recoveryId});await notify(db,booking,eventId,"Your sitter needs to be recovered. PawSpace Operations is protecting the same booking while a replacement is arranged.");return remember(db,input,{bookingId:booking.id,status:"ops_escalation",recoveryId,bookingPreserved:true});
 }
 if(input.action==="submit_care_plan"){
  if(["completed","cancelled"].includes(status))throw new Response("Care plan cannot change after the Sitting booking is closed",{status:409});const plan=input.carePlan??{};if(!String(plan.emergencyContact||"").trim()||!String(plan.vet||"").trim()||!String(plan.homeAccess||"").trim())throw new Response("Sitting care plan requires emergency contact, vet and home access details",{status:409});await db.prepare("INSERT INTO sitting_care_plan_snapshots (booking_id,customer_id,plan_json,status,updated_by,updated_at) VALUES (?,?,?,'ready',?,?) ON CONFLICT(booking_id) DO UPDATE SET plan_json=excluded.plan_json,status='ready',updated_by=excluded.updated_by,updated_at=excluded.updated_at").bind(booking.id,booking.customer_id,JSON.stringify(plan),input.actorId,now).run();await event(db,booking,"care_plan_ready",input.actorId,{fields:Object.keys(plan)});return remember(db,input,{bookingId:booking.id,status:"care_plan_ready"});
 }
 if(input.action==="check_in"){
  if(status!=="assigned")throw new Response("Sitter acceptance is required before check-in",{status:409});const care=await db.prepare("SELECT status FROM sitting_care_plan_snapshots WHERE booking_id=?").bind(booking.id).first<Row>();if(String(care?.status)!=="ready")throw new Response("A ready Sitting care plan is required before check-in",{status:409});
  // 50/50 split-payment guard (shared stay policy): an unpaid or overdue balance blocks check-in.
  const paymentSchedule=await getStayPaymentSchedule(db,String(booking.id));
  if(paymentSchedule&&paymentSchedule.status!=="paid")throw new Response("The remaining 50% stay balance must be paid before check-in",{status:409});await db.batch([db.prepare("UPDATE canonical_bookings SET status='in_progress',updated_at=? WHERE id=?").bind(now,booking.id),db.prepare("UPDATE provider_work_orders SET status='in_progress',updated_at=? WHERE booking_id=?").bind(now,booking.id),db.prepare("UPDATE scheduling_reservations SET status='in_progress' WHERE group_id=? AND status!='cancelled'").bind(groupId)]);const eventId=await event(db,booking,"checked_in",input.actorId,{providerId});await notify(db,booking,eventId,"Your PawSpace sitter has checked in. Care updates are now attached to this booking.");return remember(db,input,{bookingId:booking.id,status:"in_progress"});
 }
 if(input.action==="care_event"){
  if(status!=="in_progress")throw new Response("Sitting care events can be logged only during an active booking",{status:409});const eventType=String(input.careEventType||"").trim();if(!["meal","walk","medication","photo_update","general_update","incident","home_check"].includes(eventType))throw new Response("Unsupported Sitting care event",{status:400});const eventId=await event(db,booking,`care_${eventType}`,input.actorId,input.detail??{});return remember(db,input,{bookingId:booking.id,status:"logged",eventId,eventType});
 }
 if(input.action==="check_out"){
  if(status!=="in_progress")throw new Response("Only an active Sitting booking can be checked out",{status:409});await db.batch([db.prepare("UPDATE canonical_bookings SET status='completed',updated_at=? WHERE id=?").bind(now,booking.id),db.prepare("UPDATE provider_work_orders SET status='completed',updated_at=? WHERE booking_id=?").bind(now,booking.id),db.prepare("UPDATE scheduling_reservations SET status='completed' WHERE group_id=? AND status!='cancelled'").bind(groupId)]);const eventId=await event(db,booking,"checked_out",input.actorId,{payout:"rule_pending",tax:"configuration_required"});await notify(db,booking,eventId,"Your PawSpace Sitting booking is complete. Final settlement remains governed by Finance policy.");return remember(db,input,{bookingId:booking.id,status:"completed",payout:"rule_pending",tax:"configuration_required"});
 }
 throw new Response("Unsupported Sitting lifecycle action",{status:400});
}
