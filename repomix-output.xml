export type TaxiOpsSnapshot={source:string;generatedAt:number;metrics:{total:number;clear:number;needsAttention:number;recovery:number;openIncidents:number;financeReview:number;routeMissing:number};bookings:Array<Record<string,unknown>>;readiness:Record<string,unknown>};
export async function loadTaxiOps(){const response=await fetch("/api/taxi-ops",{cache:"no-store"});const body=await response.json() as {data?:TaxiOpsSnapshot;error?:string};if(!response.ok||!body.data)throw new Error(body.error??"Unable to load Pet Taxi Operations queue");return body.data}
export async function updateTaxiOps(input:{bookingId:string;action:"assign_replacement"|"close_recovery"|"add_note";idempotencyKey:string;providerId?:string;reason?:string;note?:string}){const response=await fetch("/api/taxi-ops",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(input)});const body=await response.json() as {data?:Record<string,unknown>;error?:string};if(!response.ok||!body.data)throw new Error(body.error??"Unable to update Pet Taxi Operations queue");return body.data}
