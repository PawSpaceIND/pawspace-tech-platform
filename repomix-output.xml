<file path="lib/provider-onboarding-transactional.ts">
import{resolveProviderOnboardingPolicy}from"./provider-onboarding-configuration";

type Row=Record<string,unknown>;
const text=(v:unknown)=>String(v??"").trim();
const parse=<T>(v:unknown,f:T):T=>{try{return JSON.parse(String(v??"")) as T}catch{return f}};
const allowedAppActions=["submit","start_verification","complete_quiz","ready_for_interview"] as const;

export async function ensureProviderOnboardingTransactional(db:D1Database){await db.batch([
 db.prepare("CREATE TABLE IF NOT EXISTS provider_onboarding_applications (id TEXT PRIMARY KEY,provider_id TEXT,vertical_key TEXT NOT NULL,country_code TEXT NOT NULL,region_code TEXT,city_code TEXT,status TEXT NOT NULL,locale_code TEXT NOT NULL,basic_info_json TEXT NOT NULL,policy_ref TEXT,quiz_version_ref TEXT,verification_status TEXT NOT NULL DEFAULT 'not_started',quiz_status TEXT NOT NULL DEFAULT 'not_started',interview_status TEXT NOT NULL DEFAULT 'not_started',human_decision TEXT,created_by TEXT NOT NULL,created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS provider_onboarding_events (id TEXT PRIMARY KEY,application_id TEXT NOT NULL,event_type TEXT NOT NULL,from_status TEXT,to_status TEXT,actor_id TEXT NOT NULL,detail_json TEXT NOT NULL,created_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS provider_onboarding_documents (id TEXT PRIMARY KEY,application_id TEXT NOT NULL,document_type TEXT NOT NULL,file_ref TEXT NOT NULL,classification TEXT NOT NULL DEFAULT 'sensitive_identity',status TEXT NOT NULL DEFAULT 'uploaded',expires_at INTEGER,created_by TEXT NOT NULL,created_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS provider_onboarding_verifications (id TEXT PRIMARY KEY,application_id TEXT NOT NULL,adapter_key TEXT NOT NULL,environment TEXT NOT NULL,request_ref TEXT,status TEXT NOT NULL,manual_review_required INTEGER NOT NULL DEFAULT 0,detail_json TEXT NOT NULL,created_by TEXT NOT NULL,created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS provider_quiz_versions (id TEXT PRIMARY KEY,vertical_key TEXT NOT NULL,country_code TEXT,region_code TEXT,city_code TEXT,locale_code TEXT NOT NULL,status TEXT NOT NULL,question_count INTEGER NOT NULL,pass_threshold REAL NOT NULL,source_refs_json TEXT NOT NULL,questions_json TEXT NOT NULL,model_ref TEXT,provider_ref TEXT,created_by TEXT NOT NULL,approved_by TEXT,approved_at INTEGER,created_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS provider_quiz_attempts (id TEXT PRIMARY KEY,application_id TEXT NOT NULL,quiz_version_id TEXT NOT NULL,answers_json TEXT NOT NULL,score REAL NOT NULL,result TEXT NOT NULL,created_at INTEGER NOT NULL)"),
]);}
async function event(db:D1Database,applicationId:string,type:string,actor:string,from:string|null,to:string|null,detail:unknown={}){await db.prepare("INSERT INTO provider_onboarding_events (id,application_id,event_type,from_status,to_status,actor_id,detail_json,created_at) VALUES (?,?,?,?,?,?,?,?)").bind(crypto.randomUUID(),applicationId,type,from,to,actor,JSON.stringify(detail),Date.now()).run();}
async function application(db:D1Database,id:string){const row=await db.prepare("SELECT * FROM provider_onboarding_applications WHERE id=?").bind(id).first<Row>();if(!row)throw new Error("Application not found");return row;}
function requiredDocumentTypes(policy:Awaited<ReturnType<typeof resolveProviderOnboardingPolicy>>){const rules=policy?.verificationRules??{};return Array.isArray(rules.requiredDocumentTypes)?rules.requiredDocumentTypes.map(text).filter(Boolean):[];}

export async function createProviderApplication(db:D1Database,input:{actorEmail:string;payload:Record<string,unknown>}){await ensureProviderOnboardingTransactional(db);const p=input.payload,vertical=text(p.verticalKey),country=text(p.countryCode).toUpperCase(),region=text(p.regionCode).toUpperCase()||null,city=text(p.cityCode).toUpperCase()||null,locale=text(p.localeCode)||"en";if(!vertical||!country)throw new Error("Vertical and country are required");const policy=await resolveProviderOnboardingPolicy(db,{verticalKey:vertical,countryCode:country,regionCode:region,cityCode:city});const id=`POAPP-${crypto.randomUUID().slice(0,12).toUpperCase()}`,now=Date.now(),basic=p.basicInfo&&typeof p.basicInfo==="object"?p.basicInfo:{};await db.prepare("INSERT INTO provider_onboarding_applications (id,provider_id,vertical_key,country_code,region_code,city_code,status,locale_code,basic_info_json,policy_ref,quiz_version_ref,created_by,created_at,updated_at) VALUES (?,?,?,?,?,?,'draft',?,?,?,?,?,?,?)").bind(id,text(p.providerId)||null,vertical,country,region,city,locale,JSON.stringify(basic),policy?.id??null,policy?.quizPolicy?.activeQuizVersionRef?text(policy.quizPolicy.activeQuizVersionRef):null,input.actorEmail,now,now).run();await event(db,id,"application_created",input.actorEmail,null,"draft",{vertical,country,region,city,locale,policyRef:policy?.id??null});return{id,status:"draft",policyRef:policy?.id??null};}

export async function transitionProviderApplication(db:D1Database,input:{applicationId:string;action:(typeof allowedAppActions)[number];actorEmail:string}){await ensureProviderOnboardingTransactional(db);if(!allowedAppActions.includes(input.action))throw new Error("Unsupported application action");const row=await application(db,input.applicationId),from=text(row.status);let to=from;if(input.action==="submit"){if(from!=="draft")throw new Error("Only draft applications can be submitted");const policy=await resolveProviderOnboardingPolicy(db,{verticalKey:text(row.vertical_key),countryCode:text(row.country_code),regionCode:row.region_code?text(row.region_code):null,cityCode:row.city_code?text(row.city_code):null});if(!policy)throw new Error("An active onboarding policy is required before submission");const required=requiredDocumentTypes(policy),docs=(await db.prepare("SELECT document_type FROM provider_onboarding_documents WHERE application_id=? AND status='uploaded'").bind(input.applicationId).all<Row>()).results.map(r=>text(r.document_type)),missing=required.filter(type=>!docs.includes(type));if(missing.length)throw new Error(`Required onboarding documents are missing: ${missing.join(", ")}`);await db.prepare("UPDATE provider_onboarding_applications SET policy_ref=?,quiz_version_ref=COALESCE(?,quiz_version_ref),updated_at=? WHERE id=?").bind(policy.id,policy.quizPolicy?.activeQuizVersionRef?text(policy.quizPolicy.activeQuizVersionRef):null,Date.now(),input.applicationId).run();to="submitted";}else if(input.action==="start_verification"){if(!["submitted","verification"].includes(from))throw new Error("Application must be submitted before verification");to="verification";}else if(input.action==="complete_quiz"){if(text(row.verification_status)!=="verified")throw new Error("Verification must be explicitly verified before quiz");to="qualification";}else{if(text(row.quiz_status)!=="passed"&&text(row.quiz_status)!=="needs_review")throw new Error("Quiz must be completed before interview");to="interview";}await db.prepare("UPDATE provider_onboarding_applications SET status=?,updated_at=? WHERE id=?").bind(to,Date.now(),input.applicationId).run();await event(db,input.applicationId,`application_${input.action}`,input.actorEmail,from,to);return{id:input.applicationId,status:to};}

export async function addProviderDocument(db:D1Database,input:{applicationId:string;documentType:string;fileRef:string;expiresAt?:number|null;actorEmail:string}){await ensureProviderOnboardingTransactional(db);await application(db,input.applicationId);if(!text(input.documentType)||!text(input.fileRef))throw new Error("Document type and secure file reference are required");const id=`PODOC-${crypto.randomUUID().slice(0,12).toUpperCase()}`;await db.prepare("INSERT INTO provider_onboarding_documents (id,application_id,document_type,file_ref,classification,status,expires_at,created_by,created_at) VALUES (?,?,?,?,'sensitive_identity','uploaded',?,?,?)").bind(id,input.applicationId,text(input.documentType),text(input.fileRef),input.expiresAt??null,input.actorEmail,Date.now()).run();await event(db,input.applicationId,"document_uploaded",input.actorEmail,null,null,{documentId:id,documentType:input.documentType});return{id,classification:"sensitive_identity"};}

// Deliberately separate from onboardingTransactionalSnapshot, which excludes file_ref from its
// bulk SELECT as a safeguard against casually exposing sensitive_identity document references in
// a general list view. This is the one narrow, audited path a staff member uses to look up a
// single document's stored reference when reviewing an application.
export async function getProviderDocumentContent(db:D1Database,input:{documentId:string;actorEmail:string}){await ensureProviderOnboardingTransactional(db);const doc=await db.prepare("SELECT id,application_id,document_type,file_ref,status FROM provider_onboarding_documents WHERE id=?").bind(input.documentId).first<Row>();if(!doc)throw new Error("Document not found");await event(db,text(doc.application_id),"document_viewed_by_staff",input.actorEmail,null,null,{documentId:input.documentId,documentType:text(doc.document_type)});return{id:text(doc.id),documentType:text(doc.document_type),fileRef:text(doc.file_ref),status:text(doc.status)};}

export async function createVerification(db:D1Database,input:{applicationId:string;adapterKey:string;actorEmail:string;manualReviewRequired?:boolean}){await ensureProviderOnboardingTransactional(db);const app=await application(db,input.applicationId);if(!["submitted","verification"].includes(text(app.status)))throw new Error("Application must be submitted before verification");const id=`POVER-${crypto.randomUUID().slice(0,12).toUpperCase()}`,now=Date.now();await db.prepare("INSERT INTO provider_onboarding_verifications (id,application_id,adapter_key,environment,status,manual_review_required,detail_json,created_by,created_at,updated_at) VALUES (?,?,?,'uat','not_connected',?,'{}',?,?,?)").bind(id,input.applicationId,text(input.adapterKey)||"not_connected",input.manualReviewRequired?1:0,input.actorEmail,now,now).run();await db.prepare("UPDATE provider_onboarding_applications SET verification_status='not_connected',status='verification',updated_at=? WHERE id=?").bind(now,input.applicationId).run();await event(db,input.applicationId,"verification_created",input.actorEmail,text(app.status),"verification",{verificationId:id,environment:"uat",externalConnected:false});return{id,status:"not_connected",environment:"uat",externalConnected:false};}

export async function recordVerificationResult(db:D1Database,input:{verificationId:string;status:"verified"|"manual_review_required"|"failed";actorEmail:string;detail?:unknown}){await ensureProviderOnboardingTransactional(db);const row=await db.prepare("SELECT application_id FROM provider_onboarding_verifications WHERE id=?").bind(input.verificationId).first<Row>();if(!row)throw new Error("Verification not found");await db.batch([db.prepare("UPDATE provider_onboarding_verifications SET status=?,manual_review_required=?,detail_json=?,updated_at=? WHERE id=?").bind(input.status,input.status==="manual_review_required"?1:0,JSON.stringify(input.detail??{}),Date.now(),input.verificationId),db.prepare("UPDATE provider_onboarding_applications SET verification_status=?,updated_at=? WHERE id=?").bind(input.status,Date.now(),text(row.application_id))]);await event(db,text(row.application_id),"verification_result",input.actorEmail,null,null,{verificationId:input.verificationId,status:input.status});return{id:input.verificationId,status:input.status};}

export async function clearManualVerificationReview(db:D1Database,input:{verificationId:string;actorEmail:string;detail?:unknown}){await ensureProviderOnboardingTransactional(db);const row=await db.prepare("SELECT application_id,status FROM provider_onboarding_verifications WHERE id=?").bind(input.verificationId).first<Row>();if(!row||text(row.status)!=="manual_review_required")throw new Error("Verification is not awaiting manual review");await db.batch([db.prepare("UPDATE provider_onboarding_verifications SET status='verified',manual_review_required=0,detail_json=?,updated_at=? WHERE id=?").bind(JSON.stringify(input.detail??{}),Date.now(),input.verificationId),db.prepare("UPDATE provider_onboarding_applications SET verification_status='verified',updated_at=? WHERE id=?").bind(Date.now(),text(row.application_id))]);await event(db,text(row.application_id),"verification_manual_review_cleared",input.actorEmail,null,null,{verificationId:input.verificationId});return{id:input.verificationId,status:"verified"};}

export async function createQuizDraft(db:D1Database,input:{actorEmail:string;payload:Record<string,unknown>}){await ensureProviderOnboardingTransactional(db);const p=input.payload,questions=Array.isArray(p.questions)?p.questions:[];if(questions.length!==20)throw new Error("Assessment drafts must contain exactly 20 questions");for(const q of questions as Record<string,unknown>[]){if(!text(q.questionId)||!text(q.correctAnswerId))throw new Error("Each quiz question requires stable questionId and correctAnswerId");if(!Array.isArray(q.options)||!(q.options as unknown[]).length)throw new Error("Each quiz question requires answer options");}const id=`POQUIZ-${crypto.randomUUID().slice(0,12).toUpperCase()}`;await db.prepare("INSERT INTO provider_quiz_versions (id,vertical_key,country_code,region_code,city_code,locale_code,status,question_count,pass_threshold,source_refs_json,questions_json,model_ref,provider_ref,created_by,created_at) VALUES (?,?,?,?,?,?,'draft',20,?,?,?,?,?,?,?)").bind(id,text(p.verticalKey)||"default",text(p.countryCode).toUpperCase()||null,text(p.regionCode).toUpperCase()||null,text(p.cityCode).toUpperCase()||null,text(p.localeCode)||"en",Number(p.passThreshold??80),JSON.stringify(Array.isArray(p.sourceRefs)?p.sourceRefs:[]),JSON.stringify(questions),text(p.modelRef)||null,text(p.providerRef)||null,input.actorEmail,Date.now()).run();return{id,status:"draft",questionCount:20,aiGenerated:Boolean(p.modelRef||p.providerRef),autoPublished:false};}

export async function approveQuiz(db:D1Database,input:{quizVersionId:string;actorEmail:string}){await ensureProviderOnboardingTransactional(db);const row=await db.prepare("SELECT status,question_count FROM provider_quiz_versions WHERE id=?").bind(input.quizVersionId).first<Row>();if(!row||text(row.status)!=="draft"||Number(row.question_count)!==20)throw new Error("Only a complete 20-question draft can be approved");await db.prepare("UPDATE provider_quiz_versions SET status='approved',approved_by=?,approved_at=? WHERE id=?").bind(input.actorEmail,Date.now(),input.quizVersionId).run();return{id:input.quizVersionId,status:"approved"};}

export async function scoreQuiz(db:D1Database,input:{applicationId:string;quizVersionId:string;answers:Record<string,string>}){await ensureProviderOnboardingTransactional(db);const app=await application(db,input.applicationId);if(text(app.verification_status)!=="verified")throw new Error("Verified identity is required before quiz scoring");if(["interview","scheduled","profile","approved","accepted","activated_uat","post_activation_review","uat_ready","uat_review","complete","completed"].includes(text(app.status)))throw new Error("Quiz cannot be re-scored after the application has progressed past qualification");const quiz=await db.prepare("SELECT * FROM provider_quiz_versions WHERE id=? AND status='approved'").bind(input.quizVersionId).first<Row>();if(!quiz)throw new Error("Approved quiz version not found");const questions=parse<Record<string,unknown>[]>(quiz.questions_json,[]);if(questions.length!==20)throw new Error("Quiz version is not a 20-question assessment");let correct=0;for(const q of questions){if(input.answers[text(q.questionId)]===text(q.correctAnswerId))correct++;}const score=correct/20*100,threshold=Number(quiz.pass_threshold||80),result=score>=threshold?"passed":score>=Math.max(0,threshold-10)?"needs_review":"did_not_meet_quiz_threshold",id=`POATT-${crypto.randomUUID().slice(0,12).toUpperCase()}`;await db.prepare("INSERT INTO provider_quiz_attempts (id,application_id,quiz_version_id,answers_json,score,result,created_at) VALUES (?,?,?,?,?,?,?)").bind(id,input.applicationId,input.quizVersionId,JSON.stringify(input.answers),score,result,Date.now()).run();await db.prepare("UPDATE provider_onboarding_applications SET quiz_status=?,quiz_version_ref=?,status='qualification',updated_at=? WHERE id=?").bind(result,input.quizVersionId,Date.now(),input.applicationId).run();await event(db,input.applicationId,"quiz_scored","system:deterministic",text(app.status),"qualification",{quizVersionId:input.quizVersionId,score,result});return{id,score,result,questionCount:20,deterministicScoring:true,finalProviderDecision:false};}

export function buildInterviewGuide(input:{quizQuestions:Record<string,unknown>[];answers:Record<string,string>}){const misses=input.quizQuestions.filter(q=>input.answers[text(q.questionId)]!==text(q.correctAnswerId)).slice(0,5).map(q=>({questionId:text(q.questionId),competency:text(q.competency)||"general",prompt:`Ask the provider to explain their approach to ${text(q.competency)||"this service scenario"}.`}));return{durationMinutes:15,generatedFromQuizMisses:true,finalDecisionAuthority:"human_ops",topics:misses};}

export async function onboardingTransactionalSnapshot(db:D1Database){await ensureProviderOnboardingTransactional(db);const [apps,docs,verifications,quizzes,attempts,events]=await Promise.all([db.prepare("SELECT * FROM provider_onboarding_applications ORDER BY updated_at DESC LIMIT 100").all<Row>(),db.prepare("SELECT id,application_id,document_type,classification,status,expires_at,created_at FROM provider_onboarding_documents ORDER BY created_at DESC LIMIT 100").all<Row>(),db.prepare("SELECT * FROM provider_onboarding_verifications ORDER BY updated_at DESC LIMIT 100").all<Row>(),db.prepare("SELECT id,vertical_key,country_code,region_code,city_code,locale_code,status,question_count,pass_threshold,model_ref,provider_ref,approved_by,approved_at,created_at FROM provider_quiz_versions ORDER BY created_at DESC LIMIT 100").all<Row>(),db.prepare("SELECT * FROM provider_quiz_attempts ORDER BY created_at DESC LIMIT 100").all<Row>(),db.prepare("SELECT * FROM provider_onboarding_events ORDER BY created_at DESC LIMIT 200").all<Row>()]);return{applications:apps.results,documents:docs.results,verifications:verifications.results,quizVersions:quizzes.results,attempts:attempts.results,events:events.results,productionReady:false,externalKycConnected:false,externalAiQuizGenerationConnected:false,autonomousProviderApproval:false,defaultInterviewMinutes:15,defaultQuizQuestions:20};}
