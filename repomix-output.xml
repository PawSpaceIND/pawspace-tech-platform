const json=(value:unknown,status=200)=>Response.json(value,{status,headers:{"cache-control":"no-store"}});
function sameOriginWrite(request:Request){const origin=request.headers.get("origin");if(origin&&origin!==new URL(request.url).origin)throw governedJsonError({error:"Cross-origin Sitting quote blocked"},403);}
function failure(error:unknown){return authError(error,"Sitting commercial request failed");}
const readiness={productionReady:false,paymentMode:"uat_sandbox",liveMoney:false};
export async function GET(request:Request){try{const url=new URL(request.url),scheduledStart=String(url.searchParams.get("scheduledStart")||"").trim(),cityId=String(url.searchParams.get("cityId")||"blr").trim().toLowerCase(),zoneId=String(url.searchParams.get("zoneId")||"blr-east").trim().toLowerCase(),db=await database(),packages=await listLiveSittingPackages(db,{at:scheduledStart||undefined,cityId,zoneId});return json({data:{packages,source:"canonical_sitting_governance",availabilityMode:"catalogue_only",availabilityVerified:false,liveAvailability:false,...readiness}});}catch(error){return failure(error);}}
export async function POST(request:Request){try{sameOriginWrite(request);const body=await request.json() as{packageCode?:string;petCount?:number;scheduledStart?:string;scheduledEnd?:string;paymentMode?:SittingPaymentMode;couponCode?:string;cityId?:string;zoneId?:string};const packageCode=String(body.packageCode||"").trim(),scheduledStart=String(body.scheduledStart||"").trim(),scheduledEnd=String(body.scheduledEnd||"").trim(),paymentMode=body.paymentMode;if(!packageCode||!scheduledStart||!scheduledEnd||!paymentMode)return json({error:"Package, care window and payment mode are required"},400);const db=await database(),quote=await createLiveSittingQuote(db,{packageCode,petCount:Number(body.petCount||0),scheduledStart,scheduledEnd,paymentMode,couponCode:body.couponCode,cityId:body.cityId,zoneId:body.zoneId});return json({data:{...readiness,...quote}},201);}catch(error){return failure(error);}}
