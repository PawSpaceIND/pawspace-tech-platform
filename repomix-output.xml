 if(input.action==="arrive"){requireState(["on_the_way"]);await db.prepare("UPDATE training_sessions SET status='arrived',updated_at=? WHERE id=?").bind(now,row.id).run();await event(db,row,input,{from:current,to:"arrived"});return{duplicatePrevented:false,status:"arrived"};}
