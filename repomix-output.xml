 if(input.action==="revoke_media"){const id=mediaIdFromRef(String(input.mediaRef||""));await db.prepare("UPDATE service_media_assets SET access_status='revoked',retention_status='revoked',updated_at=? WHERE id=? AND booking_id=?").bind(now,id,order.id).run();await mediaEvent(db,id,String(order.id),"food_media_revoked",input.actorId,{reason:input.reason||"Revoked by authorized operator"});return remember(db,input,{orderId:order.id,mediaId:id,accessStatus:"revoked",proofReady:false})}
