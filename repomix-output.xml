test("E — a credential below the 32-character floor is refused", () => {
  for (const name of UAT_CREDENTIALS) {
    assert.notEqual(runConfig({ ...GOOD, [name]: "a".repeat(31) }).status, 0, `31 characters must be refused for ${name}`);
  }
