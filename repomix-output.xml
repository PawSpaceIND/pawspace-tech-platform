<file path="lib/walking-lifecycle.ts">
import{ensureWalkingGovernanceTables}from"./walking-governance";

type Row=Record<string,unknown>;
export type WalkingAction="accept"|"decline"|"confirm_handover"|"start_walk"|"walk_event"|"complete_walk"|"walker_unavailable"|"no_show";
export type WalkingMutation={bookingId:string;action:WalkingAction;actorId:string;idempotencyKey:string;sessionId?:string;reason?:string;handoverMethod?:"owner"|"building_staff"|"secure_key";walkEventType?:string;detail?:Record<string,unknown>};
const parse=<T>(value:unknown,fallback:T):T=>{try{return JSON.parse(String(value??"")) as T}catch{return fallback}};
export function walkingPerSessionAmount(pricing:Record<string,unknown>|null|undefined,totalAmount:unknown,sessionCount:unknown){const configured=Number(pricing?.perWalkAmount||0),configuredPaise=Math.round(configured*100);if(Number.isFinite(configured)&&configured>0&&Number.isSafeInteger(configuredPaise)&&Math.abs(configured*100-configuredPaise)<1e-9)return configuredPaise/100;if(pricing?.demoSeed===true){const total=Number(totalAmount),count=Number(sessionCount),totalPaise=Math.round(total*100);if(Number.isFinite(total)&&total>0&&Number.isSafeInteger(totalPaise)&&Math.abs(total*100-totalPaise)<1e-9&&Number.isInteger(count)&&count>0&&totalPaise%count===0)return totalPaise/count/100}return 0}

export async function ensureWalkingLifecycleTables(db:D1Database){await ensureWalkingGovernanceTables(db);await db.batch([
 db.prepare("CREATE TABLE IF NOT EXISTS walking_action_keys (idempotency_key TEXT PRIMARY KEY,booking_id TEXT NOT NULL,action TEXT NOT NULL,result_json TEXT NOT NULL,created_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS walking_session_events (id TEXT PRIMARY KEY,booking_id TEXT NOT NULL,session_id TEXT,provider_id TEXT NOT NULL,event_type TEXT NOT NULL,actor_id TEXT NOT NULL,detail_json TEXT NOT NULL DEFAULT '{}',created_at INTEGER NOT NULL)"),
 db.prepare("CREATE INDEX IF NOT EXISTS idx_walking_events_booking ON walking_session_events(booking_id,created_at)"),
 db.prepare("CREATE TABLE IF NOT EXISTS walking_handover_events (id TEXT PRIMARY KEY,booking_id TEXT NOT NULL,session_id TEXT NOT NULL UNIQUE,provider_id TEXT NOT NULL,method TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'confirmed',detail_json TEXT NOT NULL DEFAULT '{}',confirmed_by TEXT NOT NULL,confirmed_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS walking_recovery_cases (id TEXT PRIMARY KEY,booking_id TEXT NOT NULL,failed_session_id TEXT,failed_provider_id TEXT NOT NULL,reason_code TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'ops_escalation',replacement_provider_id TEXT,detail_json TEXT NOT NULL DEFAULT '{}',opened_at INTEGER NOT NULL,resolved_at INTEGER,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS walking_customer_notifications (id TEXT PRIMARY KEY,booking_id TEXT NOT NULL,customer_id TEXT,channel TEXT NOT NULL,template_code TEXT NOT NULL,message TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'queued',event_id TEXT NOT NULL,created_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS walking_session_payment_events (id TEXT PRIMARY KEY,booking_id TEXT NOT NULL,session_id TEXT NOT NULL UNIQUE,amount REAL NOT NULL,currency TEXT NOT NULL DEFAULT 'INR',status TEXT NOT NULL DEFAULT 'due',gateway TEXT NOT NULL DEFAULT 'uat_sandbox',reference TEXT,detail_json TEXT NOT NULL DEFAULT '{}',created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL)"),
]);}
async function bookingRow(db:D1Database,bookingId:string){await ensureWalkingLifecycleTables(db);return db.prepare("SELECT b.*,w.status work_order_status,w.provider_id work_order_provider_id,w.provider_name,p.status payment_status,p.amount payment_amount,p.amount_due_now FROM canonical_bookings b LEFT JOIN provider_work_orders w ON w.booking_id=b.id LEFT JOIN booking_payments p ON p.booking_id=b.id WHERE b.id=? AND b.service_code='dog_walking'").bind(bookingId).first<Row>();}
export async function getWalkingBooking(db:D1Database,bookingId:string){return bookingRow(db,bookingId)}
async function sessionRow(db:D1Database,bookingId:string,sessionId:string){return db.prepare("SELECT * FROM walking_sessions WHERE id=? AND booking_id=?").bind(sessionId,bookingId).first<Row>()}
async function event(db:D1Database,booking:Row,sessionId:string|null,eventType:string,actorId:string,detail:unknown={}){const id=crypto.randomUUID();await db.prepare("INSERT INTO walking_session_events (id,booking_id,session_id,provider_id,event_type,actor_id,detail_json,created_at) VALUES (?,?,?,?,?,?,?,?)").bind(id,booking.id,sessionId,booking.provider_id,eventType,actorId,JSON.stringify(detail),Date.now()).run();return id}
async function notify(db:D1Database,booking:Row,eventId:string,message:string){for(const channel of["push","whatsapp"])await db.prepare("INSERT INTO walking_customer_notifications (id,booking_id,customer_id,channel,template_code,message,status,event_id,created_at) VALUES (?,?,?,?,?,?, 'queued',?,?)").bind(crypto.randomUUID(),booking.id,booking.customer_id,channel,"walking_update",message,eventId,Date.now()).run()}

// An idempotency key identifies ONE mutation of ONE record. This lookup used to match on the key alone
// and ran BEFORE the record was loaded, so a second caller reusing a key - a different provider, acting
// on a different customer's booking - was answered 200, had its mutation silently discarded, and
// received the FIRST caller's identifiers in the response body. The same collision swallowed a walker's
// decline with the earlier accept, so no recovery case opened and nobody learned the job had no
// provider. The columns needed to tell a replay from a collision were already being written here and
// simply never read back. Reused for a different record or a different action, a key is a CONFLICT and
// is refused rather than answered with somebody else's record. [PTJA-P1-F23]
async function prior(db:D1Database,key:string,bookingId:string,action:string){const row=await db.prepare("SELECT booking_id,action,result_json FROM walking_action_keys WHERE idempotency_key=?").bind(key).first<Row>();if(!row)return null;if(String(row.booking_id)!==String(bookingId)||String(row.action)!==String(action))throw new Response("An idempotency key identifies one action on one record; this key was already used for a different one",{status:409});return parse<Record<string,unknown>>(row.result_json,{})}
async function remember(db:D1Database,input:WalkingMutation,result:unknown){await db.prepare("INSERT INTO walking_action_keys (idempotency_key,booking_id,action,result_json,created_at) VALUES (?,?,?,?,?)").bind(input.idempotencyKey,input.bookingId,input.action,JSON.stringify(result),Date.now()).run();return result}

export async function listWalkingBookings(db:D1Database,input:{providerId?:string;customerId?:string;bookingId?:string}){await ensureWalkingLifecycleTables(db);const where=["b.service_code='dog_walking'"],binds:unknown[]=[];if(input.providerId){where.push("b.provider_id=?");binds.push(input.providerId)}if(input.customerId){where.push("b.customer_id=?");binds.push(input.customerId)}if(input.bookingId){where.push("b.id=?");binds.push(input.bookingId)}const rows=await db.prepare(`SELECT b.*,w.status work_order_status,w.provider_name,p.status payment_status,p.amount payment_amount FROM canonical_bookings b LEFT JOIN provider_work_orders w ON w.booking_id=b.id LEFT JOIN booking_payments p ON p.booking_id=b.id WHERE ${where.join(" AND ")} ORDER BY b.scheduled_start DESC`).bind(...binds).all<Row>(),out=[];for(const booking of rows.results){const[sessions,events,recovery,payments]=await Promise.all([db.prepare("SELECT * FROM walking_sessions WHERE booking_id=? ORDER BY occurrence_number").bind(booking.id).all<Row>(),db.prepare("SELECT * FROM walking_session_events WHERE booking_id=? ORDER BY created_at DESC LIMIT 50").bind(booking.id).all<Row>(),db.prepare("SELECT * FROM walking_recovery_cases WHERE booking_id=? ORDER BY opened_at DESC LIMIT 1").bind(booking.id).first<Row>(),db.prepare("SELECT * FROM walking_session_payment_events WHERE booking_id=? ORDER BY created_at DESC").bind(booking.id).all<Row>()]);out.push({...booking,sessions:sessions.results,events:events.results.map(item=>({...item,detail:parse(item.detail_json,{})})),recovery:recovery??null,sessionPayments:payments.results})}return out}

export async function mutateWalkingBooking(db:D1Database,input:WalkingMutation){if(!input.bookingId||!input.action||!input.actorId||!input.idempotencyKey)throw new Response("Booking, action, actor and idempotency key are required",{status:400});await ensureWalkingLifecycleTables(db);const old=await prior(db,input.idempotencyKey,input.bookingId,input.action);if(old)return{...old,duplicatePrevented:true};const booking=await bookingRow(db,input.bookingId);if(!booking)throw new Response("Dog Walking booking not found",{status:404});const now=Date.now(),bookingStatus=String(booking.status),groupId=String(booking.schedule_group_id||"");
 if(input.action==="accept"){
  // Replacement offers (reassignment_offered) must go through acceptWalkingReplacement, which
  // verifies recovery case, sessions and reservations and marks the case replacement_accepted.
