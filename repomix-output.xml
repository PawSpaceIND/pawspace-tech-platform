<file path="lib/sitting-ops-governance.ts">
import{ensureSittingFinanceTables}from"./sitting-finance-governance";
import{ensureSittingProofTables}from"./sitting-proof-governance";
import{createAssignmentOffer}from"./provider-capacity-governance";
import{collectedForBooking}from"./collected-funds";

type Row=Record<string,unknown>;
export type SittingOpsAction="assign_replacement"|"close_recovery"|"add_note";
export type SittingOpsInput={bookingId:string;action:SittingOpsAction;actorId:string;idempotencyKey:string;reason?:string;note?:string;providerId?:string};
const parse=<T>(value:unknown,fallback:T):T=>{try{return JSON.parse(String(value??"")) as T}catch{return fallback}};

export async function ensureSittingOpsTables(db:D1Database){await ensureSittingFinanceTables(db);await ensureSittingProofTables(db);await db.batch([
 db.prepare("CREATE TABLE IF NOT EXISTS sitting_ops_action_keys (idempotency_key TEXT PRIMARY KEY,booking_id TEXT NOT NULL,action TEXT NOT NULL,result_json TEXT NOT NULL,created_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS sitting_ops_notes (id TEXT PRIMARY KEY,booking_id TEXT NOT NULL,note TEXT NOT NULL,actor_id TEXT NOT NULL,created_at INTEGER NOT NULL)"),
 db.prepare("CREATE INDEX IF NOT EXISTS idx_sitting_ops_notes_booking ON sitting_ops_notes(booking_id,created_at)"),
]);}
async function prior(db:D1Database,key:string){const row=await db.prepare("SELECT result_json FROM sitting_ops_action_keys WHERE idempotency_key=?").bind(key).first<Row>();return row?parse<Record<string,unknown>>(row.result_json,{}):null;}
async function remember(db:D1Database,input:SittingOpsInput,result:unknown){await db.prepare("INSERT INTO sitting_ops_action_keys (idempotency_key,booking_id,action,result_json,created_at) VALUES (?,?,?,?,?)").bind(input.idempotencyKey,input.bookingId,input.action,JSON.stringify(result),Date.now()).run();return result;}
async function careEvent(db:D1Database,booking:Row,eventType:string,actorId:string,detail:unknown){await db.prepare("INSERT INTO sitting_care_events (id,booking_id,event_type,actor_id,detail_json,created_at) VALUES (?,?,?,?,?,?)").bind(crypto.randomUUID(),booking.id,eventType,actorId,JSON.stringify(detail),Date.now()).run();}
async function notify(db:D1Database,booking:Row,eventId:string,message:string){for(const channel of["push","whatsapp"])await db.prepare("INSERT INTO sitting_customer_notifications (id,booking_id,customer_id,channel,template_code,message,status,event_id,created_at) VALUES (?,?,?,?,?,?,'queued',?,?)").bind(crypto.randomUUID(),booking.id,booking.customer_id,channel,"sitting_recovery_update",message,eventId,Date.now()).run();}
function priority(flags:string[],incidents:Row[]){if(incidents.some(item=>String(item.severity)==="emergency"&&String(item.status)!=="resolved"))return"emergency";if(flags.some(flag=>["sitter_recovery","urgent_incident","sitter_acceptance_due","checkin_due","checkout_due"].includes(flag)))return"high";return flags.length?"attention":"clear";}

async function replacementCandidates(db:D1Database,booking:Row){const petIds=parse<string[]>(booking.pet_ids_json,[]),petCount=Math.max(1,petIds.length),rows=await db.prepare("SELECT id,name,provider_model,rating,quality_score,capacity,services_json,zones_json,live,status FROM provider_capacity_profiles WHERE city_id=? AND live=1 AND status='active' AND id!=? ORDER BY quality_score DESC,rating DESC").bind(booking.city_id,booking.provider_id).all<Row>(),out=[] as Array<Record<string,unknown>>;for(const row of rows.results){if(!parse<string[]>(row.services_json,[]).includes("pet_sitting")||!parse<string[]>(row.zones_json,[]).includes(String(booking.zone_id)))continue;const blocked=await db.prepare("SELECT id FROM provider_unavailability WHERE provider_id=? AND status='active' AND starts_at<? AND ends_at>? LIMIT 1").bind(row.id,booking.scheduled_end,booking.scheduled_start).first<Row>();if(blocked)continue;const reservations=await db.prepare("SELECT capacity_units FROM scheduling_reservations WHERE provider_id=? AND group_id!=? AND status NOT IN ('cancelled','completed') AND scheduled_start<? AND scheduled_end>?").bind(row.id,booking.schedule_group_id,booking.scheduled_end,booking.scheduled_start).all<Row>(),used=reservations.results.reduce((sum,item)=>sum+Number(item.capacity_units||0),0),capacity=Math.max(1,Number(row.capacity||1));if(used+petCount>capacity)continue;out.push({providerId:String(row.id),name:String(row.name),model:String(row.provider_model),rating:Number(row.rating||0),qualityScore:Number(row.quality_score||0),capacity,usedCapacity:used,availableCapacity:capacity-used,petCount});}return out;}

export async function getSittingOpsSnapshot(db:D1Database){await ensureSittingOpsTables(db);const now=Date.now(),rows=await db.prepare(`SELECT b.*,c.name customer_name,p.name provider_name,w.status work_order_status,pay.status payment_status FROM canonical_bookings b LEFT JOIN canonical_customers c ON c.id=b.customer_id LEFT JOIN provider_capacity_profiles p ON p.id=b.provider_id LEFT JOIN provider_work_orders w ON w.booking_id=b.id LEFT JOIN booking_payments pay ON pay.booking_id=b.id WHERE b.service_code='pet_sitting' ORDER BY b.scheduled_start ASC`).all<Row>(),bookings=[] as Array<Record<string,unknown>>;for(const booking of rows.results){const[recovery,incidents,cancellation,dateChange,refunds,settlement,media,notes,reconciliation,care,offer]=await Promise.all([
 db.prepare("SELECT * FROM sitting_recovery_cases WHERE booking_id=? ORDER BY opened_at DESC LIMIT 1").bind(booking.id).first<Row>(),
 db.prepare("SELECT id,severity,summary,action_taken,status,ops_status,notification_status,customer_acknowledged_at,resolution,reported_at,updated_at FROM sitting_incidents WHERE booking_id=? ORDER BY reported_at DESC").bind(booking.id).all<Row>(),
 db.prepare("SELECT * FROM sitting_cancellation_requests WHERE booking_id=? ORDER BY created_at DESC LIMIT 1").bind(booking.id).first<Row>(),
 db.prepare("SELECT * FROM sitting_date_change_requests WHERE booking_id=? ORDER BY created_at DESC LIMIT 1").bind(booking.id).first<Row>(),
 db.prepare("SELECT id,amount,status,reference,policy_source,created_at,updated_at FROM sitting_refund_ledger WHERE booking_id=? ORDER BY created_at DESC").bind(booking.id).all<Row>(),
 db.prepare("SELECT * FROM sitting_sitter_settlement_ledger WHERE booking_id=?").bind(booking.id).first<Row>(),
 db.prepare("SELECT id,purpose,scan_status,access_status,retention_status,synthetic,created_at,updated_at FROM service_media_assets WHERE booking_id=? AND purpose LIKE 'sitting_%' ORDER BY created_at DESC").bind(booking.id).all<Row>(),
 db.prepare("SELECT id,note,actor_id,created_at FROM sitting_ops_notes WHERE booking_id=? ORDER BY created_at DESC LIMIT 20").bind(booking.id).all<Row>(),
 db.prepare("SELECT * FROM sitting_finance_reconciliation WHERE booking_id=? ORDER BY created_at DESC LIMIT 1").bind(booking.id).first<Row>(),
 db.prepare("SELECT status FROM sitting_care_plan_snapshots WHERE booking_id=?").bind(booking.id).first<Row>(),
 db.prepare("SELECT status,provider_id,expires_at,attempt_no FROM provider_assignment_offers WHERE group_id=?").bind(booking.schedule_group_id).first<Row>(),
 ]);const flags:string[]=[],openIncidents=incidents.results.filter(item=>String(item.status)!=="resolved");if(["reassignment_needed","reassignment_offered"].includes(String(booking.status))||recovery&&!["resolved","closed"].includes(String(recovery.status)))flags.push("sitter_recovery");if(offer&&String(offer.status)==="pending"&&Number(offer.expires_at)<now)flags.push("sitter_acceptance_due");if(openIncidents.some(item=>String(item.severity)==="emergency"))flags.push("emergency_incident");else if(openIncidents.some(item=>String(item.severity)==="urgent"))flags.push("urgent_incident");else if(openIncidents.length)flags.push("care_incident");if(cancellation&&String(cancellation.status)==="policy_review_required")flags.push("cancellation_policy_review");if(dateChange&&String(dateChange.status)==="commercial_quote_required")flags.push("date_change_quote_required");if(refunds.results.some(item=>String(item.status)==="sandbox_pending"))flags.push("refund_pending");if(media.results.some(item=>String(item.scan_status)!=="clean"||String(item.access_status)!=="ready"||String(item.retention_status)!=="active"||Number(item.synthetic||0)!==0))flags.push("media_blocked");if(["assigned","in_progress"].includes(String(booking.status))&&String(care?.status)!=="ready")flags.push("care_plan_required");const start=new Date(String(booking.scheduled_start)).getTime(),end=new Date(String(booking.scheduled_end)).getTime();if(String(booking.status)==="assigned"&&Number.isFinite(start)&&now>start)flags.push("checkin_due");if(String(booking.status)==="in_progress"&&Number.isFinite(end)&&now>end)flags.push("checkout_due");if(String(booking.status)==="completed"&&(!settlement||String(settlement.approval_status)!=="ready"||String(settlement.payout_status)==="not_instructed"))flags.push("settlement_not_ready");if(String(booking.payment_status)!=="captured"&&!['cancelled'].includes(String(booking.status)))flags.push("payment_attention");const candidates=flags.includes("sitter_recovery")?await replacementCandidates(db,booking):[];const capturedAmount=await collectedForBooking(db,String(booking.id));bookings.push({...booking,captured_amount:capturedAmount,recovery:recovery??null,incidents:incidents.results,cancellation:cancellation??null,dateChange:dateChange??null,refunds:refunds.results,settlement:settlement??null,media:media.results,notes:notes.results,reconciliation:reconciliation??null,carePlanStatus:String(care?.status||"missing"),offer:offer??null,replacementCandidates:candidates,exceptionFlags:flags,priority:priority(flags,openIncidents)});}const metrics={total:bookings.length,clear:bookings.filter(item=>(item.exceptionFlags as string[]).length===0).length,needsAttention:bookings.filter(item=>(item.exceptionFlags as string[]).length>0).length,recovery:bookings.filter(item=>(item.exceptionFlags as string[]).includes("sitter_recovery")).length,openIncidents:bookings.reduce((sum,item)=>sum+(item.incidents as Row[]).filter(row=>String(row.status)!=="resolved").length,0),financeReview:bookings.filter(item=>(item.exceptionFlags as string[]).some(flag=>["cancellation_policy_review","date_change_quote_required","refund_pending","settlement_not_ready","payment_attention"].includes(flag))).length,mediaBlocked:bookings.filter(item=>(item.exceptionFlags as string[]).includes("media_blocked")).length};return{source:"canonical Sitting UAT database",generatedAt:now,metrics,bookings,readiness:{engineeringGate:"gate_5_closed_uat_contract",productionReady:false,customerJourney:"canonical",sitterJourney:"canonical",opsExceptionQueue:"canonical",finance:"sandbox_governed",media:"private_scan_gated_contract",identity:"canonical_binding_and_session_contract",externalDependencies:{objectStorage:"disconnected",malwareScanner:"disconnected",whatsappPush:"queued_only",payments:"sandbox_only",tax:"configuration_required",sitterPayout:"rule_pending"}}};}

export async function mutateSittingOps(db:D1Database,input:SittingOpsInput){if(!input.bookingId||!input.action||!input.actorId||!input.idempotencyKey)throw new Response("Booking, action, actor and idempotency key are required",{status:400});await ensureSittingOpsTables(db);const old=await prior(db,input.idempotencyKey);if(old)return{...old,duplicatePrevented:true};const booking=await db.prepare("SELECT b.*,w.provider_id work_order_provider_id,w.status work_order_status FROM canonical_bookings b LEFT JOIN provider_work_orders w ON w.booking_id=b.id WHERE b.id=? AND b.service_code='pet_sitting'").bind(input.bookingId).first<Row>();if(!booking)throw new Response("Canonical Sitting booking not found",{status:404});const now=Date.now();if(input.action==="add_note"){const note=String(input.note||"").trim();if(note.length<5)throw new Response("A meaningful Operations note is required",{status:400});const id=crypto.randomUUID();await db.prepare("INSERT INTO sitting_ops_notes (id,booking_id,note,actor_id,created_at) VALUES (?,?,?,?,?)").bind(id,booking.id,note,input.actorId,now).run();await careEvent(db,booking,"ops_note_added",input.actorId,{noteId:id});return remember(db,input,{bookingId:booking.id,status:"noted",noteId:id});}
 if(input.action==="assign_replacement"){
  if(String(booking.status)!=="reassignment_needed")throw new Response("Replacement assignment requires a recovery-pending Sitting booking",{status:409});const recovery=await db.prepare("SELECT * FROM sitting_recovery_cases WHERE booking_id=? AND status!='resolved' ORDER BY opened_at DESC LIMIT 1").bind(booking.id).first<Row>();if(!recovery)throw new Response("No open Sitting recovery case exists",{status:409});const providerId=String(input.providerId||"").trim(),reason=String(input.reason||"").trim();if(!providerId||reason.length<5)throw new Response("Replacement sitter and assignment reason are required",{status:400});const candidates=await replacementCandidates(db,booking),candidate=candidates.find(item=>String(item.providerId)===providerId);if(!candidate)throw new Response("Selected replacement sitter is not currently eligible for this exact booking",{status:409});const groupId=String(booking.schedule_group_id||"");if(!groupId)throw new Response("Canonical schedule group is missing",{status:409});const offer=await createAssignmentOffer(db,{groupId,bookingId:String(booking.id),providerId,attemptNo:Number((await db.prepare("SELECT attempt_no FROM provider_assignment_offers WHERE group_id=?").bind(groupId).first<{attempt_no:number}>())?.attempt_no||0)+1});await db.batch([
   db.prepare("UPDATE sitting_recovery_cases SET status='replacement_offered',replacement_provider_id=?,detail_json=?,updated_at=? WHERE id=? AND status!='resolved'").bind(providerId,JSON.stringify({...parse<Record<string,unknown>>(recovery.detail_json,{}),replacementReason:reason,replacementOfferedBy:input.actorId,bookingPreserved:true}),now,recovery.id),
   db.prepare("UPDATE canonical_bookings SET provider_id=?,status='reassignment_offered',updated_at=? WHERE id=?").bind(providerId,now,booking.id),
   db.prepare("UPDATE provider_work_orders SET provider_id=?,provider_name=?,provider_model=?,status='reassignment_offered',updated_at=? WHERE booking_id=?").bind(providerId,candidate.name,candidate.model,now,booking.id),
   db.prepare("UPDATE scheduling_reservations SET provider_id=?,status='assigned' WHERE group_id=? AND status!='cancelled'").bind(providerId,groupId),
   db.prepare("UPDATE scheduling_assignment_decisions SET selected_provider_id=?,status='reassignment_offered',actor_id=?,reason=?,updated_at=? WHERE group_id=?").bind(providerId,input.actorId,reason,now,groupId),
  ]);const eventId=crypto.randomUUID();await db.prepare("INSERT INTO sitting_care_events (id,booking_id,event_type,actor_id,detail_json,created_at) VALUES (?,?,?,?,?,?)").bind(eventId,booking.id,"replacement_sitter_offered",input.actorId,JSON.stringify({recoveryId:recovery.id,failedProviderId:recovery.failed_provider_id,replacementProviderId:providerId,reason,offerExpiresAt:offer.expiresAt,bookingPreserved:true}),now).run();await notify(db,booking,eventId,"PawSpace Operations has offered your existing Sitting booking to an eligible replacement sitter. The booking ID and paid care window are unchanged while acceptance is pending.");return remember(db,input,{bookingId:booking.id,status:"replacement_offered",recoveryId:recovery.id,replacementProviderId:providerId,offer,bookingPreserved:true});
 }
 if(input.action==="close_recovery"){
  if(String(booking.status)!=="assigned")throw new Response("Replacement sitter must accept the recovered booking before Operations can close recovery",{status:409});const recovery=await db.prepare("SELECT * FROM sitting_recovery_cases WHERE booking_id=? AND status!='resolved' ORDER BY opened_at DESC LIMIT 1").bind(booking.id).first<Row>();if(!recovery)throw new Response("No open Sitting recovery case exists",{status:409});if(!String(recovery.replacement_provider_id||"").trim())throw new Response("Recovery has no replacement sitter recorded",{status:409});if(String(recovery.replacement_provider_id)!==String(booking.provider_id)||String(booking.work_order_provider_id)!==String(booking.provider_id))throw new Response("Recovered sitter does not match the canonical booking and work order",{status:409});const reason=String(input.reason||"").trim();if(reason.length<5)throw new Response("A recovery closure reason is required",{status:400});await db.prepare("UPDATE sitting_recovery_cases SET status='resolved',resolved_at=?,updated_at=?,detail_json=? WHERE id=? AND status!='resolved'").bind(now,now,JSON.stringify({...parse<Record<string,unknown>>(recovery.detail_json,{}),closureReason:reason,closedBy:input.actorId,bookingPreserved:true}),recovery.id).run();await careEvent(db,booking,"recovery_closed",input.actorId,{recoveryId:recovery.id,replacementProviderId:booking.provider_id,reason,bookingPreserved:true});return remember(db,input,{bookingId:booking.id,status:"resolved",recoveryId:recovery.id,replacementProviderId:booking.provider_id,bookingPreserved:true});
 }
 throw new Response("Unsupported Sitting Operations action",{status:400});
}
