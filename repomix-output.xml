export async function PATCH(request:Request){try{const actor=await authorize(request,"scheduling.manage");const db=await database();await seedProviderCapacityDefaults(db);const body=await request.json() as {providerId?:string;changes?:Record<string,unknown>;reason?:string};if(!body.providerId||!body.reason||body.reason.trim().length<5)return json({error:"Provider ID and a clear change reason are required"},400);const before=await db.prepare("SELECT * FROM provider_capacity_profiles WHERE id=?").bind(body.providerId).first<Row>();if(!before)return json({error:"Provider capacity profile not found"},404);const entries=Object.entries(body.changes||{}).filter(([key])=>editable.includes(key));if(!entries.length)return json({error:"No supported provider capacity changes supplied"},400);for(const [key,value] of entries){if(["capacity","travel_buffer_minutes","max_daily_jobs","acceptance_timeout_minutes"].includes(key)){
