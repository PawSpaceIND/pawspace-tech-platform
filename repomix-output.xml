iption_plan_audit (id,plan_id,plan_code,city_id,action,before_json,after_json,actor_id,reason,created_at) VALUES (?,?,?,?,?,NULL,?,?,?,?)").bind(crypto.randomUUID(),id,String(body.planCode),String(body.cityId),"created",JSON.stringify(created),actor.email,String(body.reason||"New business-configured plan"),now).run();await securityAudit(db,actor,"grooming.subscription_plan.create","subscription_plan",id,"completed",{cityId:body.cityId,planCode:body.planCode});return json({data:created},201);}catch(error){return authError(error,"Unable to create Grooming subscription plan");}}
