 if(input.action==="record_location_sample"){if(String(s.status)!=="in_progress")throw new Response("Route samples can be recorded only during an active walk",{status:409});const lat=Number(input.latitude),lng=Number(input.longitude),accuracy=Number(input.accuracyMeters);if(!Number.isFinite(lat)||lat<-90||lat>90||!Number.isFinite(lng)||lng<-180||lng>180||!Number.isFinite(accuracy)||accuracy<=0||accuracy>500)throw new Response("Valid Dog Walking sandbox coordinates and accuracy are required",{status:400});await walkEvent(db,b,sessionId,"route_location_sample",input.actorId,{latitude:lat,longitude:lng,accuracyMeters:accuracy,environment:"sandbox",productionVerified:false});return remember(db,input,{bookingId:b.id,sessionId,status:"recorded",environment:"sandbox",productionVerified:false})}
 if(input.action==="record_photo_update"){if(String(s.status)!=="in_progress")throw new Response("Photo updates require an active walk",{status:409});const media=await proofAsset(db,b,sessionId,String(input.mediaRef||""),"walking_update"),note=String(input.note||"").trim();if(note.length<3)throw new Response("A Dog Walking photo update note is required",{status:400});await walkEvent(db,b,sessionId,"proof_photo_update",input.actorId,{mediaRef:`media://asset/${media.id}`,note});return remember(db,input,{bookingId:b.id,sessionId,status:"recorded",mediaRef:`media://asset/${media.id}`})}
 if(input.action==="report_incident"){if(String(s.status)!=="in_progress")throw new Response("Dog Walking incidents require an active walk",{status:409});const severity=String(input.severity||"") as "attention"|"urgent"|"emergency",summary=String(input.summary||"").trim(),actionTaken=String(input.actionTaken||"").trim();if(!["attention","urgent","emergency"].includes(severity)||summary.length<5)throw new Response("Incident severity and summary are required",{status:400});let mediaId:string|null=null;if(String(input.mediaRef||"").trim())mediaId=String((await proofAsset(db,b,sessionId,String(input.mediaRef),"walking_incident")).id);const id=crypto.randomUUID();await db.prepare("INSERT INTO walking_incidents (id,booking_id,session_id,provider_id,severity,summary,action_taken,media_id,status,ops_status,notification_status,reported_by,reported_at,updated_at) VALUES (?,?,?,?,?,?,?,?,'open','queued','queued',?,?,?)").bind(id,b.id,sessionId,b.provider_id,severity,summary,actionTaken,mediaId,input.actorId,now,now).run();await incidentEvent(db,id,String(b.id),sessionId,"reported",input.actorId,{severity,summary,actionTaken,mediaRef:mediaId?`media://asset/${mediaId}`:null,bookingPreserved:true,automaticRefund:false,automaticPayoutChange:false});await walkEvent(db,b,sessionId,"walk_incident_reported",input.actorId,{incidentId:id,severity,opsEscalation:true});await notify(db,b,id,`A PawSpace Dog Walking incident was reported (${severity}). Operations review is queued; booking and money state are unchanged.`);return remember(db,input,{bookingId:b.id,sessionId,incidentId:id,status:"ops_escalation",bookingPreserved:true,automaticRefund:false,automaticPayoutChange:false,communications:{mode:"queued_only",liveDelivery:false}})}
 if(input.action==="acknowledge_incident"){const incidentId=String(input.incidentId||"").trim(),incident=await db.prepare("SELECT * FROM walking_incidents WHERE id=? AND booking_id=? AND session_id=?").bind(incidentId,b.id,sessionId).first<Row>();if(!incident)throw new Response("Dog Walking incident not found",{status:404});if(String(incident.reported_by)===input.actorId)throw new Response("A Dog Walking incident cannot be acknowledged by the actor who reported it",{status:403});if(incident.customer_acknowledged_at)return remember(db,input,{bookingId:b.id,sessionId,incidentId,status:String(incident.status),duplicateAcknowledgement:true});await db.prepare("UPDATE walking_incidents SET customer_acknowledged_at=?,updated_at=? WHERE id=?").bind(now,now,incidentId).run();await incidentEvent(db,incidentId,String(b.id),sessionId,"customer_acknowledged",input.actorId,{automaticRefund:false,automaticPayoutChange:false});return remember(db,input,{bookingId:b.id,sessionId,incidentId,status:String(incident.status),customerAcknowledged:true,automaticRefund:false,automaticPayoutChange:false})}
 if(input.action==="resolve_incident"){const incidentId=String(input.incidentId||"").trim(),resolution=String(input.resolution||"").trim();if(resolution.length<5)throw new Response("Incident resolution is required",{status:400});const incident=await db.prepare("SELECT * FROM walking_incidents WHERE id=? AND booking_id=? AND session_id=?").bind(incidentId,b.id,sessionId).first<Row>();if(!incident)throw new Response("Dog Walking incident not found",{status:404});if(String(incident.reported_by)===input.actorId)throw new Response("A Dog Walking incident cannot be resolved by the actor who reported it",{status:403});await db.prepare("UPDATE walking_incidents SET status='resolved',ops_status='resolved',resolution=?,resolved_by=?,resolved_at=?,updated_at=? WHERE id=?").bind(resolution,input.actorId,now,now,incidentId).run();await incidentEvent(db,incidentId,String(b.id),sessionId,"resolved",input.actorId,{resolution,automaticRefund:false,automaticPayoutChange:false});return remember(db,input,{bookingId:b.id,sessionId,incidentId,status:"resolved",automaticRefund:false,automaticPayoutChange:false})}
 throw new Response("Unsupported Dog Walking proof action",{status:400})}

