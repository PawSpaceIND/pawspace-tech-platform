 else{if(!["approved","retired"].includes(status))throw new Error("Rollback target must be approved or retired");await db.batch([db.prepare("UPDATE provider_onboarding_content_versions SET status='retired',retired_at=?,updated_at=? WHERE content_key=? AND locale_code=? AND status='active'").bind(now,now,key,locale),db.prepare("UPDATE provider_onboarding_content_versions SET status='active',activated_by=?,activated_at=?,retired_at=NULL,updated_at=? WHERE id=?").bind(input.actorEmail,now,now,input.contentId)]);}
 await audit(db,input.actorEmail,`content_${input.action}`,"content",input.contentId,{contentKey:key,locale,fromStatus:status});return{id:input.contentId,status:input.action==="submit_review"?"review":input.action==="approve"?"approved":"active"};}

export async function resolveProviderOnboardingContent(db:D1Database,input:{contentKey:string;localeCode:string;at?:number}){await ensureProviderOnboardingConfiguration(db);const now=input.at??Date.now(),visited=new Set<string>();let locale=text(input.localeCode).toLowerCase();while(locale&&!visited.has(locale)){visited.add(locale);const row=await db.prepare("SELECT * FROM provider_onboarding_content_versions WHERE content_key=? AND locale_code=? AND status='active' AND (effective_from IS NULL OR effective_from<=?) AND (effective_to IS NULL OR effective_to>=?) ORDER BY version DESC LIMIT 1").bind(input.contentKey,locale,now,now).first<Row>();if(row)return{id:text(row.id),contentKey:text(row.content_key),localeCode:text(row.locale_code),contentType:text(row.content_type),contentText:text(row.content_text),version:Number(row.version),aiAssisted:Number(row.ai_assisted)===1};const loc=await db.prepare("SELECT fallback_locale FROM provider_onboarding_locales WHERE locale_code=? AND enabled=1").bind(locale).first<Row>();locale=loc?.fallback_locale?text(loc.fallback_locale).toLowerCase():"";}return null;}

export async function providerOnboardingConfigurationSnapshot(db:D1Database){await ensureProviderOnboardingConfiguration(db);const [policies,locales,content]=await Promise.all([db.prepare("SELECT id,policy_key,version,status,vertical_key,country_code,region_code,city_code,pricing_policy_ref,updated_at FROM provider_onboarding_policy_versions ORDER BY updated_at DESC LIMIT 100").all<Row>(),db.prepare("SELECT * FROM provider_onboarding_locales ORDER BY locale_code").all<Row>(),db.prepare("SELECT id,content_key,locale_code,version,status,content_type,ai_assisted,legal_use_approved,updated_at FROM provider_onboarding_content_versions ORDER BY updated_at DESC LIMIT 200").all<Row>()]);return{policies:policies.results,locales:locales.results,content:content.results,productionReady:false,externalVerificationConnected:false,externalEsignConnected:false,externalAiTranslationRequired:false,autonomousProviderDecision:false};}
