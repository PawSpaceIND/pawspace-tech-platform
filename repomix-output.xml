export async function finalizeBoardingRecoveryAcceptance(db:D1Database,stayId:string,actorId:string){const stay=await db.prepare("SELECT s.id,s.booking_id,s.host_provider_id,s.status,b.provider_id booking_provider_id,b.status booking_status,b.schedule_group_id FROM boarding_stays s JOIN canonical_bookings b ON b.id=s.booking_id WHERE s.id=? AND b.service_code='boarding'").bind(stayId).first<Row>();if(!stay)throw new Response("Canonical Boarding stay not found",{status:404});if(String(stay.status)!=="confirmed")throw new Response("Replacement host acceptance is required before recovery finalization",{status:409});const recovery=await db.prepare("SELECT id,replacement_provider_id,status FROM boarding_recovery_cases WHERE stay_id=? ORDER BY opened_at DESC LIMIT 1").bind(stayId).first<Row>();if(!recovery)throw new Response("No Boarding recovery case exists",{status:409});const providerId=String(stay.host_provider_id),replacementId=String(recovery.replacement_provider_id||"");if(!replacementId||replacementId!==providerId||String(stay.booking_provider_id)!==providerId)throw new Response("Accepted recovery provider is inconsistent across canonical records",{status:409});const now=Date.now(),groupId=String(stay.schedule_group_id||"");await db.batch([
 db.prepare("UPDATE canonical_bookings SET status='assigned',updated_at=? WHERE id=? AND status IN ('reassignment_offered','reassignment_needed')").bind(now,stay.booking_id),
 db.prepare("UPDATE provider_work_orders SET status='assigned',updated_at=? WHERE booking_id=? AND provider_id=? AND status='reassignment_offered'").bind(now,stay.booking_id,providerId),
 db.prepare("UPDATE scheduling_assignment_decisions SET status='assigned',actor_id=?,reason='Replacement host accepted',updated_at=? WHERE group_id=? AND selected_provider_id=? AND status IN ('reassignment_offered','reassignment_needed')").bind(actorId,now,groupId,providerId),
 db.prepare("UPDATE scheduling_reservations SET status='assigned' WHERE group_id=? AND provider_id=? AND status!='cancelled'").bind(groupId,providerId),
 ]);return{stayId:String(stay.id),bookingId:String(stay.booking_id),providerId,status:"assigned",bookingPreserved:true};}
