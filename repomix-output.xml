async function context(db:D1Database,orderId:string){await ensureFoodProofTables(db);const row=await db.prepare("SELECT o.*,l.sku,f.status fulfilment_status,f.lot_id FROM food_orders o JOIN food_order_lines l ON l.order_id=o.id LEFT JOIN food_order_fulfilment f ON f.order_id=o.id WHERE o.id=?").bind(orderId).first<Row>();if(!row)throw new Response("Canonical Food order not found",{status:404});return row}
