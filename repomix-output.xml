 }

 if(input.action==="acknowledge_incident"){
  const incidentId=String(input.incidentId||"").trim(),incident=await db.prepare("SELECT * FROM boarding_incidents WHERE id=? AND stay_id=?").bind(incidentId,s.id).first<Row>();if(!incident)throw new Response("Boarding incident not found",{status:404});if(String(incident.reported_by)===input.actorId)throw new Response("A Boarding incident cannot be acknowledged by the actor who reported it",{status:403});if(incident.customer_acknowledged_at)return remember(db,input,{stayId:s.id,incidentId,status:"acknowledged",duplicatePrevented:true});await db.prepare("UPDATE boarding_incidents SET customer_acknowledged_at=?,updated_at=? WHERE id=?").bind(now,now,incidentId).run();await incidentEvent(db,incidentId,String(s.id),"customer_acknowledged",input.actorId,{});return remember(db,input,{stayId:s.id,incidentId,status:"acknowledged"});
 }

 if(input.action==="resolve_incident"){
  const incidentId=String(input.incidentId||"").trim(),resolution=String(input.resolution||"").trim();if(resolution.length<5)throw new Response("A resolution note is required",{status:400});const incident=await db.prepare("SELECT * FROM boarding_incidents WHERE id=? AND stay_id=?").bind(incidentId,s.id).first<Row>();if(!incident)throw new Response("Boarding incident not found",{status:404});if(String(incident.reported_by)===input.actorId)throw new Response("A Boarding incident cannot be resolved by the actor who reported it",{status:403});if(String(incident.status)==="resolved")throw new Response("Boarding incident is already resolved",{status:409});await db.prepare("UPDATE boarding_incidents SET status='resolved',ops_status='closed',resolution=?,resolved_by=?,resolved_at=?,updated_at=? WHERE id=?").bind(resolution,input.actorId,now,now,incidentId).run();await incidentEvent(db,incidentId,String(s.id),"resolved",input.actorId,{resolution});await stayEvent(db,s,"incident_resolved",input.actorId,{incidentId,resolution});return remember(db,input,{stayId:s.id,incidentId,status:"resolved",automaticRefund:false,automaticPayoutChange:false});
 }
 throw new Response("Unsupported Boarding proof action",{status:400});
}

export async function getBoardingProofSnapshot(db:D1Database,stayId:string){const s=await stay(db,stayId),media=await db.prepare("SELECT id,purpose,mime_type,size_bytes,scan_status,access_status,retention_status,synthetic,created_at,updated_at FROM service_media_assets WHERE booking_id=? AND provider_id=? AND purpose IN ('boarding_checkin','stay_update','boarding_medication','boarding_incident','boarding_checkout') ORDER BY created_at DESC").bind(s.booking_id,s.host_provider_id).all<Row>(),medication=await db.prepare("SELECT id,medication_name,dose,administered_at,media_id,note,recorded_by,created_at FROM boarding_medication_administrations WHERE stay_id=? ORDER BY administered_at DESC").bind(stayId).all<Row>(),incidents=await db.prepare("SELECT id,severity,summary,action_taken,media_id,status,ops_status,notification_status,customer_acknowledged_at,resolution,resolved_at,reported_at FROM boarding_incidents WHERE stay_id=? ORDER BY reported_at DESC").bind(stayId).all<Row>();return{stay:{id:s.id,bookingId:s.booking_id,providerId:s.host_provider_id,customerId:s.customer_id,status:s.status,carePlanStatus:s.care_plan_status,checkInAt:s.check_in_at,checkOutAt:s.check_out_at},media:media.results.map(row=>({...row,ref:`media://asset/${String(row.id)}`,proofReady:String(row.scan_status)==="clean"&&String(row.access_status)==="ready"&&String(row.retention_status)==="active"&&Number(row.synthetic||0)===0})),medication:medication.results.map(row=>({...row,mediaRef:`media://asset/${String(row.media_id)}`})),incidents:incidents.results.map(row=>({...row,mediaRef:row.media_id?`media://asset/${String(row.media_id)}`:null})),storage:{mode:"sandbox_contract",adapterConnected:false,rawPublicUrls:false},communications:{mode:"queued_only",liveDelivery:false}};}
