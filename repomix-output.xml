import type{WalkingAction}from"./walking-lifecycle";
export type WalkingLifecycleBooking=Record<string,unknown>&{id:string;status:string;provider_id:string;customer_id:string;sessions?:Array<Record<string,unknown>>;events?:Array<Record<string,unknown>>;recovery?:Record<string,unknown>|null;sessionPayments?:Array<Record<string,unknown>>};
async function payload(response:Response){const text=await response.text(),body=(()=>{try{const parsed=JSON.parse(text);if(parsed&&typeof parsed==="object"&&!Array.isArray(parsed))return parsed as {data?:unknown;error?:string};return{error:`Walking lifecycle request failed (${response.status})`}}catch{return{error:text.trim()||`Walking lifecycle request failed (${response.status})`}}})();return{response,body}}
export async function loadWalkingLifecycle(input:{bookingId?:string;providerId?:string;customerId?:string;scope?:"customer"}){const query=new URLSearchParams();if(input.bookingId)query.set("bookingId",input.bookingId);if(input.providerId)query.set("providerId",input.providerId);if(input.customerId)query.set("customerId",input.customerId);if(input.scope)query.set("scope",input.scope);const{response,body}=await payload(await fetch(`/api/walking-lifecycle?${query}`,{cache:"no-store"}));if(!response.ok||!body.data)throw new Error(body.error??"Unable to load Dog Walking lifecycle");return body.data as WalkingLifecycleBooking[];}
export async function loadCustomerWalkingLifecycle(bookingId:string){return loadWalkingLifecycle({bookingId,scope:"customer"})}
export async function updateWalkingLifecycle(input:{bookingId:string;action:WalkingAction;idempotencyKey:string;sessionId?:string;reason?:string;handoverMethod?:"owner"|"building_staff"|"secure_key";walkEventType?:string;detail?:Record<string,unknown>}){const{response,body}=await payload(await fetch("/api/walking-lifecycle",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(input)}));if(!response.ok||!body.data)throw new Error(body.error??"Unable to update Dog Walking lifecycle");return body.data as Record<string,unknown>;}
