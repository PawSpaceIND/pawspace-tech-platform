<file path="lib/communication-provider-boundary.ts">
import{ensureCommunicationAdapterTables}from"./communication-adapters";
import{ensureCommunicationTables,failOutboxAttempt,recordDeliveryEvent}from"./communication-engine";

type Db=D1Database;
type Row=Record<string,unknown>;
type Env=Record<string,unknown>;
type DeliveryEvent="accepted"|"sent"|"delivered"|"read"|"failed";

const text=(value:unknown)=>String(value??"").trim();
const list=(value:unknown)=>text(value).split(",").map(item=>item.trim()).filter(Boolean);
const safeEqual=(left:string,right:string)=>{if(left.length!==right.length)return false;let diff=0;for(let index=0;index<left.length;index++)diff|=left.charCodeAt(index)^right.charCodeAt(index);return diff===0;};
const hex=async(value:string,key:string)=>Array.from(new Uint8Array(await crypto.subtle.sign("HMAC",await crypto.subtle.importKey("raw",new TextEncoder().encode(key),{name:"HMAC",hash:"SHA-256"},false,["sign"]),new TextEncoder().encode(value)))).map(byte=>byte.toString(16).padStart(2,"0")).join("");

function providerUrl(env:Env){const raw=text(env.PAWSPACE_COMMUNICATION_PROVIDER_URL);if(!raw)return null;let url:URL;try{url=new URL(raw);}catch{throw new Error("Communication provider URL is invalid");}const environment=text(env.PAWSPACE_COMMUNICATION_ENV).toLowerCase();const loopback=["127.0.0.1","localhost","::1"].includes(url.hostname);if(url.protocol!=="https:"&&!(environment==="uat"&&url.protocol==="http:"&&loopback))throw new Error("Communication provider URL must use HTTPS (loopback HTTP is allowed only in UAT)");return url.toString();}
function allowlisted(env:Env,recipient:string){return list(env.PAWSPACE_COMMUNICATION_UAT_ALLOWLIST).includes(recipient);}
async function recipientBelongsToCustomer(db:Db,customerId:string,channel:string,recipient:string){let customer:Row|null=null;try{customer=await db.prepare("SELECT primary_phone,secondary_phone,email FROM canonical_customers WHERE id=?").bind(customerId).first<Row>();}catch(error){if(/no such table: canonical_customers/i.test(error instanceof Error?error.message:String(error)))return false;throw error;}if(!customer)return false;if(channel==="email")return text(customer.email).toLowerCase()===recipient.toLowerCase();const canonical=(value:unknown)=>text(value).replace(/[^0-9+]/g,"");return[customer.primary_phone,customer.secondary_phone].some(value=>canonical(value)===canonical(recipient));}

async function dispatchConsent(db:Db,customerId:string,purpose:string){const pref=await db.prepare("SELECT service_updates,marketing FROM communication_preferences WHERE customer_id=?").bind(customerId).first<Row>();if(purpose==="marketing")return pref?.marketing==null?false:Number(pref.marketing)===1;if(["transactional","service_recovery","lifecycle"].includes(purpose)&&pref?.service_updates!=null)return Number(pref.service_updates)===1;return true;}

export async function dispatchExternalCommunication(db:Db,env:Env,input:{messageId:string;adapterName:string;recipient:string;timeoutMs?:number}){
 await ensureCommunicationAdapterTables(db);const message=await db.prepare("SELECT m.*,o.status outbox_status,o.next_attempt_at FROM communication_messages m JOIN communication_outbox o ON o.message_id=m.id WHERE m.id=?").bind(input.messageId).first<Row>();if(!message)throw new Error("Queued communication message not found");
 if(!["queued","retry_pending","scheduled"].includes(text(message.outbox_status)))return{status:"already_dispatched",outboxStatus:text(message.outbox_status),externalDelivery:false};
 if(Number(message.next_attempt_at)>Date.now())return{status:"scheduled",nextAttemptAt:Number(message.next_attempt_at),externalDelivery:false};
 const config=await db.prepare("SELECT * FROM communication_adapter_configs WHERE channel=? AND adapter_name=? AND environment='sandbox'").bind(message.channel,input.adapterName).first<Row>();const url=providerUrl(env),token=text(env.PAWSPACE_COMMUNICATION_PROVIDER_TOKEN);
 if(text(env.PAWSPACE_COMMUNICATION_ENV).toLowerCase()!=="uat"||!config||text(config.status)!=="sandbox_ready"||text(config.credentials_status)!=="configured"||!url||!token)return{status:"not_configured",provider:input.adapterName,externalDelivery:false};
 if(!allowlisted(env,input.recipient))return{status:"recipient_not_allowlisted",provider:input.adapterName,externalDelivery:false};
 if(!await recipientBelongsToCustomer(db,text(message.customer_id),text(message.channel),input.recipient))return{status:"recipient_customer_mismatch",provider:input.adapterName,externalDelivery:false};
 if(!await dispatchConsent(db,text(message.customer_id),text(message.purpose)))return{status:"consent_refused",provider:input.adapterName,externalDelivery:false};
 const now=Date.now();await db.prepare("UPDATE communication_outbox SET status='dispatching',locked_at=?,updated_at=? WHERE message_id=? AND status IN ('queued','retry_pending','scheduled')").bind(now,now,input.messageId).run();
 const controller=new AbortController(),timer=setTimeout(()=>controller.abort(),Math.max(50,Math.min(Number(input.timeoutMs||10_000),30_000)));let response:Response;
 try{response=await fetch(url,{method:"POST",redirect:"error",signal:controller.signal,headers:{authorization:`Bearer ${token}`,"content-type":"application/json","x-pawspace-idempotency-key":text(message.idempotency_key)},body:JSON.stringify({message_id:input.messageId,channel:text(message.channel),recipient:input.recipient,template_key:text(message.template_key),payload:JSON.parse(text(message.payload_json)||"{}")})});}
 catch(error){clearTimeout(timer);const reason=error instanceof Error&&error.name==="AbortError"?"provider_timeout":"provider_network_failure";const retry=await failOutboxAttempt(db,input.messageId,reason);return{...retry,provider:input.adapterName,reason,externalDelivery:false};}
 clearTimeout(timer);let payload:Record<string,unknown>={};try{payload=await response.json() as Record<string,unknown>;}catch{}
 if(!response.ok){const reason=`provider_http_${response.status}`;const retry=await failOutboxAttempt(db,input.messageId,reason);return{...retry,provider:input.adapterName,httpStatus:response.status,reason,externalDelivery:false};}
 const providerReference=text(payload.reference||payload.provider_reference||payload.id);if(!providerReference){const retry=await failOutboxAttempt(db,input.messageId,"provider_reference_missing");return{...retry,provider:input.adapterName,reason:"provider_reference_missing",externalDelivery:false};}
 await db.prepare("UPDATE communication_messages SET provider=?,provider_reference=?,updated_at=? WHERE id=?").bind(input.adapterName,providerReference,Date.now(),input.messageId).run();const eventId=text(payload.event_id)||`accepted:${providerReference}`;await recordDeliveryEvent(db,{messageId:input.messageId,provider:input.adapterName,eventId,eventType:"accepted",detail:{httpStatus:response.status,providerReference}});return{status:"provider_accepted",provider:input.adapterName,providerReference,httpStatus:response.status,externalDelivery:true};
}

export async function recordCommunicationProviderCallback(db:Db,env:Env,input:{provider:string;rawBody:string;headers:Headers;asOf?:number}){
 await ensureCommunicationTables(db);const secret=text(env.PAWSPACE_COMMUNICATION_WEBHOOK_SECRET);if(!secret)return{accepted:false,status:503,reason:"webhook_not_configured",externalDelivery:false};const timestamp=text(input.headers.get("x-pawspace-communication-timestamp")),signature=text(input.headers.get("x-pawspace-communication-signature")).toLowerCase(),now=input.asOf??Date.now(),stamp=Number(timestamp);if(!timestamp||!Number.isFinite(stamp)||Math.abs(now-stamp)>5*60_000)return{accepted:false,status:401,reason:"invalid_or_stale_timestamp",externalDelivery:false};const expected=await hex(`${timestamp}.${input.rawBody}`,secret);if(!signature||!safeEqual(expected,signature))return{accepted:false,status:401,reason:"invalid_signature",externalDelivery:false};let body:Record<string,unknown>;try{body=JSON.parse(input.rawBody) as Record<string,unknown>;}catch{return{accepted:false,status:400,reason:"invalid_json",externalDelivery:false};}
 const eventId=text(body.event_id),providerReference=text(body.provider_reference),eventType=text(body.status) as DeliveryEvent;if(!eventId||!providerReference||!["accepted","sent","delivered","read","failed"].includes(eventType))return{accepted:false,status:400,reason:"invalid_callback",externalDelivery:false};const message=await db.prepare("SELECT id FROM communication_messages WHERE provider=? AND provider_reference=?").bind(input.provider,providerReference).first<Row>();if(!message)return{accepted:true,status:202,matched:false,reason:"unknown_provider_reference",externalDelivery:true};const result=await recordDeliveryEvent(db,{messageId:text(message.id),provider:input.provider,eventId,eventType,detail:{reason:text(body.reason)||undefined}});return{...result,accepted:true,status:200,deliveryStatus:result.status,matched:true,messageId:text(message.id),eventType,externalDelivery:true};
