 db.prepare("CREATE TABLE IF NOT EXISTS provider_onboarding_profile_media (id TEXT PRIMARY KEY,application_id TEXT NOT NULL,media_type TEXT NOT NULL,file_ref TEXT NOT NULL,classification TEXT NOT NULL,status TEXT NOT NULL,publish_approved INTEGER NOT NULL DEFAULT 0,created_by TEXT NOT NULL,created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL)"),
