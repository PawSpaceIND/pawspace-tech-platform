export type LeadSlaPolicyStatus="draft"|"active_uat"|"retired";
export type LeadSlaClockType="first_response"|"follow_up"|"quote_follow_up"|"high_intent";
export type LeadSlaClockStatus="running"|"paused"|"met"|"breached"|"cancelled";
export type LeadBusinessHours={mode:"elapsed"|"windowed";weekdays?:Record<string,{startMinute:number;endMinute:number}>};

import { reassignLead } from "./lead-assignment-governance";

type Db=D1Database;
type Row=Record<string,unknown>;
const text=(value:unknown)=>String(value??"").trim();
const uid=(prefix:string)=>`${prefix}-${crypto.randomUUID().slice(0,12).toUpperCase()}`;
const positive=(value:unknown,name:string)=>{const n=Number(value);if(!Number.isInteger(n)||n<1)throw new Error(`${name} must be a positive integer`);return n;};
const json=(value:unknown)=>{if(value&&typeof value==="object")return value as Record<string,unknown>;try{return JSON.parse(String(value||"{}")) as Record<string,unknown>}catch{return{} as Record<string,unknown>}};
const stringList=(value:unknown)=>{if(Array.isArray(value))return value.map(text).filter(Boolean);try{return JSON.parse(String(value||"[]")) as string[]}catch{return[] as string[]}};
const weekdayMap:Record<string,string>={Sun:"0",Mon:"1",Tue:"2",Wed:"3",Thu:"4",Fri:"5",Sat:"6"};

export async function ensureLeadSlaTables(db:Db){await db.batch([
 db.prepare("CREATE TABLE IF NOT EXISTS lead_sla_policies (id TEXT PRIMARY KEY,name TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'draft',version INTEGER NOT NULL DEFAULT 1,team_code TEXT NOT NULL,service_codes_json TEXT NOT NULL,city_ids_json TEXT NOT NULL,timezone TEXT NOT NULL,business_hours_json TEXT NOT NULL,first_response_minutes INTEGER,follow_up_minutes INTEGER,quote_follow_up_minutes INTEGER,high_intent_minutes INTEGER,manager_escalation_after_minutes INTEGER,reassignment_after_minutes INTEGER,require_next_action INTEGER NOT NULL DEFAULT 1,terminal_outcomes_json TEXT NOT NULL DEFAULT '[]',effective_from INTEGER NOT NULL,effective_until INTEGER,approval_reference TEXT,created_by TEXT NOT NULL,created_at INTEGER NOT NULL,updated_by TEXT NOT NULL,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS lead_sla_policy_versions (id TEXT PRIMARY KEY,policy_id TEXT NOT NULL,version INTEGER NOT NULL,snapshot_json TEXT NOT NULL,reason TEXT NOT NULL,actor_id TEXT NOT NULL,created_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS lead_sla_clocks (id TEXT PRIMARY KEY,idempotency_key TEXT NOT NULL UNIQUE,lead_id TEXT NOT NULL,assignment_id TEXT NOT NULL,policy_id TEXT NOT NULL,policy_version INTEGER NOT NULL,clock_type TEXT NOT NULL,cycle INTEGER NOT NULL DEFAULT 1,status TEXT NOT NULL DEFAULT 'running',started_at INTEGER NOT NULL,due_at INTEGER NOT NULL,manager_escalation_due_at INTEGER NOT NULL,reassignment_due_at INTEGER NOT NULL,met_at INTEGER,breached_at INTEGER,paused_at INTEGER,pause_reason TEXT,paused_remaining_minutes INTEGER,last_action_at INTEGER,next_action_at INTEGER,detail_json TEXT NOT NULL DEFAULT '{}',created_by TEXT NOT NULL,created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL,UNIQUE(lead_id,clock_type,cycle))"),
 db.prepare("CREATE INDEX IF NOT EXISTS lead_sla_clocks_due_idx ON lead_sla_clocks(status,due_at,manager_escalation_due_at,reassignment_due_at)"),
 db.prepare("CREATE TABLE IF NOT EXISTS lead_sla_events (id TEXT PRIMARY KEY,idempotency_key TEXT NOT NULL UNIQUE,clock_id TEXT NOT NULL,lead_id TEXT NOT NULL,event_type TEXT NOT NULL,actor_id TEXT NOT NULL,detail_json TEXT NOT NULL DEFAULT '{}',created_at INTEGER NOT NULL)"),
]);}

function parseBusinessHours(value:unknown):LeadBusinessHours{const raw=json(value),mode=text(raw.mode) as LeadBusinessHours["mode"];if(!["elapsed","windowed"].includes(mode))throw new Error("Business hours mode must be elapsed or windowed");if(mode==="elapsed")return{mode:"elapsed"};const weekdays=(raw.weekdays&&typeof raw.weekdays==="object"?raw.weekdays:{}) as Record<string,{startMinute?:unknown;endMinute?:unknown}>;const normalized:Record<string,{startMinute:number;endMinute:number}>={};for(const[key,window]of Object.entries(weekdays)){if(!/^[0-6]$/.test(key))throw new Error("Business-hours weekday keys must be 0-6");const start=Number(window.startMinute),end=Number(window.endMinute);if(!Number.isInteger(start)||!Number.isInteger(end)||start<0||end>1440||end<=start)throw new Error("Business-hours windows require valid minute-of-day start/end");normalized[key]={startMinute:start,endMinute:end};}if(!Object.keys(normalized).length)throw new Error("Windowed business hours require at least one weekday window");return{mode:"windowed",weekdays:normalized};}
function localMinute(value:number,timezone:string){const parts=new Intl.DateTimeFormat("en-US",{timeZone:timezone,weekday:"short",hour:"2-digit",minute:"2-digit",hour12:false}).formatToParts(new Date(value));const get=(type:string)=>parts.find(part=>part.type===type)?.value||"";const weekday=weekdayMap[get("weekday")],hour=Number(get("hour"))%24,minute=Number(get("minute"));return{weekday,minuteOfDay:hour*60+minute};}
function isWorkingMinute(value:number,timezone:string,hours:LeadBusinessHours){if(hours.mode==="elapsed")return true;const local=localMinute(value,timezone),window=hours.weekdays?.[local.weekday];return Boolean(window&&local.minuteOfDay>=window.startMinute&&local.minuteOfDay<window.endMinute);}
function addPolicyMinutes(start:number,minutes:number,timezone:string,hours:LeadBusinessHours){if(hours.mode==="elapsed")return start+minutes*60_000;let cursor=start,count=0,guard=0;while(count<minutes){cursor+=60_000;guard++;if(guard>120*24*60)throw new Error("Configured business-hours calendar cannot satisfy SLA window within 120 days");if(isWorkingMinute(cursor,timezone,hours))count++;}return cursor;}
function businessMinutesBetween(start:number,end:number,timezone:string,hours:LeadBusinessHours){if(end<=start)return 0;if(hours.mode==="elapsed")return Math.ceil((end-start)/60_000);let cursor=start,count=0,guard=0;while(cursor<end){cursor+=60_000;guard++;if(guard>120*24*60)break;if(isWorkingMinute(cursor,timezone,hours))count++;}return count;}

function policySnapshot(row:Row){return{id:text(row.id),name:text(row.name),status:text(row.status) as LeadSlaPolicyStatus,version:Number(row.version||1),teamCode:text(row.team_code),serviceCodes:stringList(row.service_codes_json),cityIds:stringList(row.city_ids_json),timezone:text(row.timezone),businessHours:parseBusinessHours(row.business_hours_json),firstResponseMinutes:row.first_response_minutes==null?null:Number(row.first_response_minutes),followUpMinutes:row.follow_up_minutes==null?null:Number(row.follow_up_minutes),quoteFollowUpMinutes:row.quote_follow_up_minutes==null?null:Number(row.quote_follow_up_minutes),highIntentMinutes:row.high_intent_minutes==null?null:Number(row.high_intent_minutes),managerEscalationAfterMinutes:row.manager_escalation_after_minutes==null?null:Number(row.manager_escalation_after_minutes),reassignmentAfterMinutes:row.reassignment_after_minutes==null?null:Number(row.reassignment_after_minutes),requireNextAction:Number(row.require_next_action)===1,terminalOutcomes:stringList(row.terminal_outcomes_json),effectiveFrom:Number(row.effective_from),effectiveUntil:row.effective_until==null?null:Number(row.effective_until),approvalReference:row.approval_reference?text(row.approval_reference):null,createdBy:text(row.created_by),createdAt:Number(row.created_at),updatedBy:text(row.updated_by),updatedAt:Number(row.updated_at)};}
function validatePolicy(input:{name:string;teamCode:string;serviceCodes:string[];cityIds:string[];timezone:string;businessHours:LeadBusinessHours;firstResponseMinutes:number|null;followUpMinutes:number|null;quoteFollowUpMinutes:number|null;highIntentMinutes:number|null;managerEscalationAfterMinutes:number|null;reassignmentAfterMinutes:number|null;terminalOutcomes:string[];effectiveFrom:number;effectiveUntil?:number|null}){if(input.name.trim().length<3||!input.teamCode.trim())throw new Error("SLA policy name and team are required");if(!input.serviceCodes.length||!input.cityIds.length)throw new Error("SLA policy service and city scope are required");if(!input.timezone.trim())throw new Error("SLA timezone is required");parseBusinessHours(input.businessHours);positive(input.firstResponseMinutes,"First-response SLA");positive(input.followUpMinutes,"Follow-up SLA");positive(input.quoteFollowUpMinutes,"Quote follow-up SLA");positive(input.highIntentMinutes,"High-intent SLA");positive(input.managerEscalationAfterMinutes,"Manager escalation threshold");positive(input.reassignmentAfterMinutes,"Reassignment threshold");if(!input.terminalOutcomes.length)throw new Error("At least one terminal lead outcome must be configured");if(!Number.isFinite(input.effectiveFrom)||input.effectiveFrom<=0)throw new Error("SLA policy effective-from is required");if(input.effectiveUntil!=null&&input.effectiveUntil<=input.effectiveFrom)throw new Error("SLA policy effective-until must be after effective-from");}
async function versionPolicy(db:Db,row:Row,reason:string,actorId:string){await db.prepare("INSERT INTO lead_sla_policy_versions (id,policy_id,version,snapshot_json,reason,actor_id,created_at) VALUES (?,?,?,?,?,?,?)").bind(uid("SLAV"),row.id,row.version,JSON.stringify(policySnapshot(row)),reason,actorId,Date.now()).run();}

export async function saveLeadSlaPolicy(db:Db,input:{id?:string;name:string;teamCode:string;serviceCodes:string[];cityIds:string[];timezone:string;businessHours:LeadBusinessHours;firstResponseMinutes?:number|null;followUpMinutes?:number|null;quoteFollowUpMinutes?:number|null;highIntentMinutes?:number|null;managerEscalationAfterMinutes?:number|null;reassignmentAfterMinutes?:number|null;requireNextAction:boolean;terminalOutcomes:string[];effectiveFrom:number;effectiveUntil?:number|null;reason:string;actorId:string}){await ensureLeadSlaTables(db);const normalized={name:input.name.trim(),teamCode:input.teamCode.trim(),serviceCodes:[...new Set(input.serviceCodes.map(text).filter(Boolean))],cityIds:[...new Set(input.cityIds.map(text).filter(Boolean))],timezone:input.timezone.trim(),businessHours:parseBusinessHours(input.businessHours),firstResponseMinutes:input.firstResponseMinutes==null?null:Number(input.firstResponseMinutes),followUpMinutes:input.followUpMinutes==null?null:Number(input.followUpMinutes),quoteFollowUpMinutes:input.quoteFollowUpMinutes==null?null:Number(input.quoteFollowUpMinutes),highIntentMinutes:input.highIntentMinutes==null?null:Number(input.highIntentMinutes),managerEscalationAfterMinutes:input.managerEscalationAfterMinutes==null?null:Number(input.managerEscalationAfterMinutes),reassignmentAfterMinutes:input.reassignmentAfterMinutes==null?null:Number(input.reassignmentAfterMinutes),requireNextAction:Boolean(input.requireNextAction),terminalOutcomes:[...new Set(input.terminalOutcomes.map(text).filter(Boolean))],effectiveFrom:Number(input.effectiveFrom),effectiveUntil:input.effectiveUntil==null?null:Number(input.effectiveUntil)};if(input.reason.trim().length<8)throw new Error("A clear SLA policy change reason is required");const now=Date.now(),policyId=input.id?.trim()||uid("SLAP"),prior=await db.prepare("SELECT * FROM lead_sla_policies WHERE id=?").bind(policyId).first<Row>();if(prior&&text(prior.status)!=="draft")throw new Error("Active/retired SLA policy is immutable; create a new policy instead");const nextVersion=prior?Number(prior.version||1)+1:1;if(prior){await db.prepare("UPDATE lead_sla_policies SET name=?,version=?,team_code=?,service_codes_json=?,city_ids_json=?,timezone=?,business_hours_json=?,first_response_minutes=?,follow_up_minutes=?,quote_follow_up_minutes=?,high_intent_minutes=?,manager_escalation_after_minutes=?,reassignment_after_minutes=?,require_next_action=?,terminal_outcomes_json=?,effective_from=?,effective_until=?,updated_by=?,updated_at=? WHERE id=?").bind(normalized.name,nextVersion,normalized.teamCode,JSON.stringify(normalized.serviceCodes),JSON.stringify(normalized.cityIds),normalized.timezone,JSON.stringify(normalized.businessHours),normalized.firstResponseMinutes,normalized.followUpMinutes,normalized.quoteFollowUpMinutes,normalized.highIntentMinutes,normalized.managerEscalationAfterMinutes,normalized.reassignmentAfterMinutes,normalized.requireNextAction?1:0,JSON.stringify(normalized.terminalOutcomes),normalized.effectiveFrom,normalized.effectiveUntil,input.actorId,now,policyId).run();}else{await db.prepare("INSERT INTO lead_sla_policies (id,name,status,version,team_code,service_codes_json,city_ids_json,timezone,business_hours_json,first_response_minutes,follow_up_minutes,quote_follow_up_minutes,high_intent_minutes,manager_escalation_after_minutes,reassignment_after_minutes,require_next_action,terminal_outcomes_json,effective_from,effective_until,approval_reference,created_by,created_at,updated_by,updated_at) VALUES (?,?,'draft',1,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,NULL,?,?,?,?)").bind(policyId,normalized.name,normalized.teamCode,JSON.stringify(normalized.serviceCodes),JSON.stringify(normalized.cityIds),normalized.timezone,JSON.stringify(normalized.businessHours),normalized.firstResponseMinutes,normalized.followUpMinutes,normalized.quoteFollowUpMinutes,normalized.highIntentMinutes,normalized.managerEscalationAfterMinutes,normalized.reassignmentAfterMinutes,normalized.requireNextAction?1:0,JSON.stringify(normalized.terminalOutcomes),normalized.effectiveFrom,normalized.effectiveUntil,input.actorId,now,input.actorId,now).run();}const row=await db.prepare("SELECT * FROM lead_sla_policies WHERE id=?").bind(policyId).first<Row>();if(!row)throw new Error("Lead SLA policy could not be saved");await versionPolicy(db,row,input.reason,input.actorId);return policySnapshot(row);}

export async function activateLeadSlaPolicy(db:Db,input:{policyId:string;approvalReference:string;reason:string;actorId:string}){await ensureLeadSlaTables(db);if(input.approvalReference.trim().length<4)throw new Error("SLA policy activation requires an approval reference");if(input.reason.trim().length<8)throw new Error("A clear activation reason is required");const row=await db.prepare("SELECT * FROM lead_sla_policies WHERE id=?").bind(input.policyId).first<Row>();if(!row)throw new Error("Lead SLA policy not found");if(text(row.status)!=="draft")throw new Error("Only draft SLA policy can be activated");const snapshot=policySnapshot(row);validatePolicy(snapshot);const now=Date.now();await db.prepare("UPDATE lead_sla_policies SET status='active_uat',approval_reference=?,updated_by=?,updated_at=? WHERE id=?").bind(input.approvalReference.trim(),input.actorId,now,input.policyId).run();const after=await db.prepare("SELECT * FROM lead_sla_policies WHERE id=?").bind(input.policyId).first<Row>();await versionPolicy(db,after!,input.reason,input.actorId);return policySnapshot(after!);}

async function leadContext(db:Db,leadId:string){const row=await db.prepare("SELECT l.id,l.customer_id,l.service,l.status,c.area,a.id assignment_id,a.employee_email,a.team_code FROM lead_work_items l LEFT JOIN crm_contacts c ON c.id=l.customer_id JOIN lead_assignments a ON a.lead_id=l.id AND a.status='current' WHERE l.id=?").bind(leadId).first<Row>();if(!row)throw new Error("Lead requires a current canonical assignment before SLA can start");return{leadId:text(row.id),service:text(row.service).toLowerCase().replaceAll(" ","_"),city:text(row.area)||"Bengaluru",leadStatus:text(row.status),assignmentId:text(row.assignment_id),employeeEmail:text(row.employee_email),teamCode:text(row.team_code)};}
async function activePolicy(db:Db,lead:{service:string;city:string;teamCode:string},asOf:number){const rows=await db.prepare("SELECT * FROM lead_sla_policies WHERE status='active_uat' AND team_code=? AND effective_from<=? AND (effective_until IS NULL OR effective_until>=?) ORDER BY updated_at DESC").bind(lead.teamCode,asOf,asOf).all<Row>();return rows.results.find(row=>stringList(row.service_codes_json).includes(lead.service)&&stringList(row.city_ids_json).some(city=>lead.city.toLowerCase().includes(city.toLowerCase())))||null;}
function minutesFor(policy:ReturnType<typeof policySnapshot>,clockType:LeadSlaClockType){const value=clockType==="first_response"?policy.firstResponseMinutes:clockType==="follow_up"?policy.followUpMinutes:clockType==="quote_follow_up"?policy.quoteFollowUpMinutes:policy.highIntentMinutes;return positive(value,`${clockType} SLA`);}
async function emit(db:Db,input:{clockId:string;leadId:string;eventType:string;actorId:string;detail?:unknown;idempotencyKey:string}){const now=Date.now(),result=await db.prepare("INSERT OR IGNORE INTO lead_sla_events (id,idempotency_key,clock_id,lead_id,event_type,actor_id,detail_json,created_at) VALUES (?,?,?,?,?,?,?,?)").bind(uid("SLAE"),input.idempotencyKey,input.clockId,input.leadId,input.eventType,input.actorId,JSON.stringify(input.detail||{}),now).run();return Number(result.meta?.changes||0)>0;}

export async function startLeadSlaClock(db:Db,input:{leadId:string;clockType:LeadSlaClockType;idempotencyKey:string;actorId:string;asOf?:number;cycle?:number}){await ensureLeadSlaTables(db);if(!input.idempotencyKey.trim())throw new Error("SLA clock idempotency key is required");const prior=await db.prepare("SELECT * FROM lead_sla_clocks WHERE idempotency_key=?").bind(input.idempotencyKey).first<Row>();if(prior)return{clock:prior,duplicatePrevented:true};const lead=await leadContext(db,input.leadId),now=input.asOf??Date.now(),policyRow=await activePolicy(db,lead,now);if(!policyRow)throw new Error("No active SLA policy matches this assigned lead");const policy=policySnapshot(policyRow),duration=minutesFor(policy,input.clockType),dueAt=addPolicyMinutes(now,duration,policy.timezone,policy.businessHours),managerDue=addPolicyMinutes(dueAt,positive(policy.managerEscalationAfterMinutes,"Manager escalation threshold"),policy.timezone,policy.businessHours),reassignmentDue=addPolicyMinutes(managerDue,positive(policy.reassignmentAfterMinutes,"Reassignment threshold"),policy.timezone,policy.businessHours),cycle=input.cycle??1,clockId=uid("SLAC"),detail={policyName:policy.name,durationMinutes:duration,timezone:policy.timezone,businessHours:policy.businessHours,canonicalAssignmentId:lead.assignmentId,legacyFixedSlaAuthoritative:false};await db.prepare("INSERT INTO lead_sla_clocks (id,idempotency_key,lead_id,assignment_id,policy_id,policy_version,clock_type,cycle,status,started_at,due_at,manager_escalation_due_at,reassignment_due_at,detail_json,created_by,created_at,updated_at) VALUES (?,?,?,?,?,?,?,?, 'running',?,?,?,?,?,?,?,?)").bind(clockId,input.idempotencyKey,input.leadId,lead.assignmentId,policy.id,policy.version,input.clockType,cycle,now,dueAt,managerDue,reassignmentDue,JSON.stringify(detail),input.actorId,now,now).run();if(input.clockType==="first_response")await db.prepare("UPDATE lead_work_items SET first_action_due_at=?,manager_alert_at=?,updated_at=? WHERE id=?").bind(dueAt,managerDue,now,input.leadId).run();else await db.prepare("UPDATE lead_work_items SET next_action_at=?,updated_at=? WHERE id=?").bind(dueAt,now,input.leadId).run();await emit(db,{clockId,leadId:input.leadId,eventType:"clock_started",actorId:input.actorId,idempotencyKey:`start:${clockId}`,detail:{clockType:input.clockType,dueAt,managerDue,reassignmentDue,policyId:policy.id,policyVersion:policy.version}});const clock=await db.prepare("SELECT * FROM lead_sla_clocks WHERE id=?").bind(clockId).first<Row>();return{clock,duplicatePrevented:false};}

export async function recordLeadSlaAction(db:Db,input:{leadId:string;actionType:string;outcome:string;nextClockType?:Exclude<LeadSlaClockType,"first_response">|null;idempotencyKey:string;actorId:string;asOf?:number}){await ensureLeadSlaTables(db);if(!input.actionType.trim()||!input.outcome.trim()||!input.idempotencyKey.trim())throw new Error("Lead action, outcome and idempotency key are required");const priorEvent=await db.prepare("SELECT * FROM lead_sla_events WHERE idempotency_key=?").bind(input.idempotencyKey).first<Row>();if(priorEvent)return{duplicatePrevented:true,event:priorEvent};const now=input.asOf??Date.now(),clock=await db.prepare("SELECT c.*,p.terminal_outcomes_json,p.require_next_action FROM lead_sla_clocks c JOIN lead_sla_policies p ON p.id=c.policy_id WHERE c.lead_id=? AND c.status IN ('running','breached','paused') ORDER BY c.started_at DESC LIMIT 1").bind(input.leadId).first<Row>();if(!clock)throw new Error("No active SLA clock exists for this lead");const terminalOutcomes=stringList(clock.terminal_outcomes_json),terminal=terminalOutcomes.map(item=>item.toLowerCase()).includes(input.outcome.trim().toLowerCase()),requiresNext=Number(clock.require_next_action)===1&&!terminal;if(requiresNext&&!input.nextClockType)throw new Error("This non-terminal lead outcome requires a governed next action");await db.prepare("UPDATE lead_sla_clocks SET status='met',met_at=?,last_action_at=?,updated_at=? WHERE id=? AND status IN ('running','breached','paused')").bind(now,now,now,clock.id).run();await db.prepare("UPDATE lead_work_items SET first_action_at=COALESCE(first_action_at,?),last_outcome=?,status=CASE WHEN ? THEN 'closed' WHEN status='sla_breached' THEN 'active' ELSE status END,updated_at=? WHERE id=?").bind(now,input.outcome,terminal?1:0,now,input.leadId).run();await emit(db,{clockId:text(clock.id),leadId:input.leadId,eventType:"action_recorded",actorId:input.actorId,idempotencyKey:input.idempotencyKey,detail:{actionType:input.actionType,outcome:input.outcome,terminal,nextClockType:input.nextClockType||null}});let next=null;if(requiresNext&&input.nextClockType){const cycleRow=await db.prepare("SELECT COALESCE(MAX(cycle),0) max_cycle FROM lead_sla_clocks WHERE lead_id=? AND clock_type=?").bind(input.leadId,input.nextClockType).first<Row>();next=await startLeadSlaClock(db,{leadId:input.leadId,clockType:input.nextClockType,idempotencyKey:`next:${input.idempotencyKey}`,actorId:input.actorId,asOf:now,cycle:Number(cycleRow?.max_cycle||0)+1});}return{duplicatePrevented:false,terminal,next};}

export async function pauseLeadSlaClock(db:Db,input:{clockId:string;reason:string;actorId:string;asOf?:number}){await ensureLeadSlaTables(db);if(input.reason.trim().length<4)throw new Error("SLA pause requires a reason");const clock=await db.prepare("SELECT c.*,p.timezone,p.business_hours_json FROM lead_sla_clocks c JOIN lead_sla_policies p ON p.id=c.policy_id WHERE c.id=?").bind(input.clockId).first<Row>();if(!clock)throw new Error("SLA clock not found");if(!["running","breached"].includes(text(clock.status)))throw new Error("Only running/breached SLA clock can be paused");const now=input.asOf??Date.now(),hours=parseBusinessHours(clock.business_hours_json),remaining=businessMinutesBetween(now,Number(clock.due_at),text(clock.timezone),hours);await db.prepare("UPDATE lead_sla_clocks SET status='paused',paused_at=?,pause_reason=?,paused_remaining_minutes=?,updated_at=? WHERE id=?").bind(now,input.reason.trim(),remaining,now,input.clockId).run();await emit(db,{clockId:input.clockId,leadId:text(clock.lead_id),eventType:"paused",actorId:input.actorId,idempotencyKey:`pause:${input.clockId}:${now}`,detail:{reason:input.reason,remainingMinutes:remaining}});return{clockId:input.clockId,status:"paused",remainingMinutes:remaining};}

export async function resumeLeadSlaClock(db:Db,input:{clockId:string;reason:string;actorId:string;asOf?:number}){await ensureLeadSlaTables(db);if(input.reason.trim().length<4)throw new Error("SLA resume requires a reason");const clock=await db.prepare("SELECT c.*,p.timezone,p.business_hours_json,p.manager_escalation_after_minutes,p.reassignment_after_minutes FROM lead_sla_clocks c JOIN lead_sla_policies p ON p.id=c.policy_id WHERE c.id=?").bind(input.clockId).first<Row>();if(!clock)throw new Error("SLA clock not found");if(text(clock.status)!=="paused")throw new Error("Only paused SLA clock can be resumed");const now=input.asOf??Date.now(),hours=parseBusinessHours(clock.business_hours_json),remaining=Math.max(1,Number(clock.paused_remaining_minutes||1)),dueAt=addPolicyMinutes(now,remaining,text(clock.timezone),hours),managerDue=addPolicyMinutes(dueAt,positive(clock.manager_escalation_after_minutes,"Manager escalation threshold"),text(clock.timezone),hours),reassignmentDue=addPolicyMinutes(managerDue,positive(clock.reassignment_after_minutes,"Reassignment threshold"),text(clock.timezone),hours);await db.prepare("UPDATE lead_sla_clocks SET status='running',started_at=?,due_at=?,manager_escalation_due_at=?,reassignment_due_at=?,paused_at=NULL,pause_reason=NULL,paused_remaining_minutes=NULL,updated_at=? WHERE id=?").bind(now,dueAt,managerDue,reassignmentDue,now,input.clockId).run();await emit(db,{clockId:input.clockId,leadId:text(clock.lead_id),eventType:"resumed",actorId:input.actorId,idempotencyKey:`resume:${input.clockId}:${now}`,detail:{reason:input.reason,dueAt,managerDue,reassignmentDue}});return{clockId:input.clockId,status:"running",dueAt,managerDue,reassignmentDue};}

export async function runLeadSlaGovernance(db:Db,input:{actorId:string;asOf?:number}){await ensureLeadSlaTables(db);const now=input.asOf??Date.now(),rows=await db.prepare("SELECT c.*,p.timezone,p.business_hours_json FROM lead_sla_clocks c JOIN lead_sla_policies p ON p.id=c.policy_id WHERE c.status IN ('running','breached') AND (c.due_at<=? OR c.manager_escalation_due_at<=? OR c.reassignment_due_at<=?) ORDER BY c.due_at").bind(now,now,now).all<Row>();let breached=0,escalated=0,reassignmentDue=0,autoReassigned=0;for(const clock of rows.results){if(text(clock.status)==="running"&&Number(clock.due_at)<=now){await db.prepare("UPDATE lead_sla_clocks SET status='breached',breached_at=COALESCE(breached_at,?),updated_at=? WHERE id=?").bind(now,now,clock.id).run();if(await emit(db,{clockId:text(clock.id),leadId:text(clock.lead_id),eventType:"breached",actorId:input.actorId,idempotencyKey:`breach:${text(clock.id)}`,detail:{dueAt:Number(clock.due_at),policyId:text(clock.policy_id),policyVersion:Number(clock.policy_version)}}))breached++;await db.prepare("UPDATE lead_work_items SET status='sla_breached',updated_at=? WHERE id=? AND status NOT IN ('closed','converted')").bind(now,clock.lead_id).run();}if(Number(clock.manager_escalation_due_at)<=now){if(await emit(db,{clockId:text(clock.id),leadId:text(clock.lead_id),eventType:"manager_escalation_due",actorId:input.actorId,idempotencyKey:`manager-escalation:${text(clock.id)}`,detail:{dueAt:Number(clock.manager_escalation_due_at)}}))escalated++;}if(Number(clock.reassignment_due_at)<=now&&text(clock.status)!=="cancelled"){reassignmentDue++;const currentRow=await db.prepare("SELECT a.employee_email FROM lead_assignments a WHERE a.id=?").bind(clock.assignment_id).first<Row>(),failingAgent=currentRow?text(currentRow.employee_email):null;try{const reassignment=await reassignLead(db,{leadId:text(clock.lead_id),idempotencyKey:`auto-reassign:${text(clock.id)}`,reason:`Automatic SLA reassignment - reassignment threshold passed for the previous agent (${failingAgent||"unassigned"})`,actorId:input.actorId,excludeEmployeeEmail:failingAgent,asOf:now});await db.prepare("UPDATE lead_sla_clocks SET status='cancelled',updated_at=? WHERE id=?").bind(now,clock.id).run();if(!(reassignment as{duplicatePrevented?:boolean}).duplicatePrevented){const cycleRow=await db.prepare("SELECT COALESCE(MAX(cycle),0) max_cycle FROM lead_sla_clocks WHERE lead_id=? AND clock_type='first_response'").bind(text(clock.lead_id)).first<Row>();await startLeadSlaClock(db,{leadId:text(clock.lead_id),clockType:"first_response",idempotencyKey:`auto-reassign-clock:${text(clock.id)}`,actorId:input.actorId,asOf:now,cycle:Number(cycleRow?.max_cycle||0)+1});autoReassigned++;}await emit(db,{clockId:text(clock.id),leadId:text(clock.lead_id),eventType:"auto_reassigned",actorId:input.actorId,idempotencyKey:`reassignment-done:${text(clock.id)}`,detail:{dueAt:Number(clock.reassignment_due_at),previousAgent:failingAgent,newAgent:(reassignment.assignment as Row)?.employee_email??null}});}catch(error){await emit(db,{clockId:text(clock.id),leadId:text(clock.lead_id),eventType:"auto_reassignment_failed",actorId:input.actorId,idempotencyKey:`reassignment-failed:${text(clock.id)}`,detail:{dueAt:Number(clock.reassignment_due_at),error:error instanceof Error?error.message:String(error),escalateToManager:true}});}}}return{processed:rows.results.length,breached,escalated,reassignmentDue,autoReassigned,automaticReassignment:true};}

function displayState(row:Row,asOf:number){if(text(row.status)==="breached")return{state:"breached",reason:"Configured SLA deadline passed"};if(text(row.status)==="paused")return{state:"paused",reason:text(row.pause_reason)||"Manually paused"};if(text(row.status)!=="running")return{state:text(row.status),reason:null};const hours=parseBusinessHours(row.business_hours_json);if(hours.mode==="windowed"&&!isWorkingMinute(asOf,text(row.timezone),hours))return{state:"paused",reason:"Outside configured business hours"};return{state:"running",reason:"Within configured SLA clock"};}

export async function leadSlaDirectory(db:Db,asOf=Date.now()){await ensureLeadSlaTables(db);const[policies,clocks,events]=await Promise.all([db.prepare("SELECT * FROM lead_sla_policies ORDER BY updated_at DESC").all<Row>(),db.prepare("SELECT c.*,p.name policy_name,p.timezone,p.business_hours_json,l.owner legacy_owner,a.employee_email canonical_owner FROM lead_sla_clocks c JOIN lead_sla_policies p ON p.id=c.policy_id LEFT JOIN lead_work_items l ON l.id=c.lead_id LEFT JOIN lead_assignments a ON a.id=c.assignment_id ORDER BY c.started_at DESC LIMIT 300").all<Row>(),db.prepare("SELECT * FROM lead_sla_events ORDER BY created_at DESC LIMIT 300").all<Row>()]);return{policies:policies.results.map(policySnapshot),clocks:clocks.results.map(row=>({...row,display:displayState(row,asOf)})),events:events.results,truth:{slaSource:"lead_sla_policies + lead_sla_clocks",legacyFixed10And30MinuteRulesAuthoritative:false,nextActionGoverned:true,automaticReassignment:false,productionReady:false}};}
