export async function ensureBackgroundSchedulerTables(db:Db){await db.batch([
 db.prepare("CREATE TABLE IF NOT EXISTS background_scheduler_runs (slot_key TEXT PRIMARY KEY,scheduled_at INTEGER NOT NULL,cron TEXT NOT NULL,status TEXT NOT NULL,attempts INTEGER NOT NULL DEFAULT 1,result_json TEXT NOT NULL DEFAULT '{}',last_error TEXT,started_at INTEGER NOT NULL,finished_at INTEGER,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE INDEX IF NOT EXISTS background_scheduler_status_idx ON background_scheduler_runs(status,scheduled_at)"),
]);}
async function tableExists(db:Db,name:string){return Boolean(await db.prepare("SELECT name FROM sqlite_master WHERE type='table' AND name=?").bind(name).first<Row>());}
async function audit(db:Db,actorId:string,entityType:string,entityId:string,action:string,detail:unknown,asOf:number){if(!(await tableExists(db,"crm_engine_audit_events")))return;await db.prepare("INSERT INTO crm_engine_audit_events (id,entity_type,entity_id,action,actor_email,detail_json,created_at) VALUES (?,?,?,?,?,?,?)").bind(uid("SCHAUD"),entityType,entityId,action,actorId,JSON.stringify(detail),asOf).run();}

async function reopenColdLeads(db:Db,actorId:string,asOf:number){if(!(await tableExists(db,"lead_work_items"))||!(await tableExists(db,"lead_reopen_events")))return{processed:0,skipped:true};const{assignLeadOwner}=await import("./lead-owner-identity");const due=await db.prepare("SELECT * FROM lead_work_items WHERE status='cold' AND opt_out=0 AND converted_booking_id IS NULL AND recycle_at IS NOT NULL AND recycle_at<=? AND recycle_cycle<3").bind(asOf).all<Row>();let processed=0;for(const lead of due.results){const cycle=Number(lead.recycle_cycle||0)+1;
    // A cold lead being reopened is re-owned through lib/lead-owner-identity rather than stepped to the
    // next first name in a list. If no active member can take it, it reopens Unassigned and Operations
    // gets the mapping exception - which is a queue somebody looks at, unlike a label nobody can page.
    // [PTJA-W3-CO]
    const owner=(await assignLeadOwner(db,{customerId:text(lead.customer_id),leadId:text(lead.id),service:text(lead.service)})).owner;const changed=await db.prepare("UPDATE lead_work_items SET status='active',stage=?,work_day=1,owner=?,assigned_at=?,first_action_due_at=?,manager_alert_at=?,first_action_at=NULL,call_attempts=0,whatsapp_attempts=0,last_outcome='Automatically reopened',next_action_at=?,recycle_at=NULL,recycle_cycle=?,updated_at=? WHERE id=? AND status='cold' AND recycle_at<=?").bind(`reopened_${cycle===1?30:cycle===2?60:90}_day`,owner,asOf,asOf+600000,asOf+1800000,asOf,cycle,asOf,lead.id,asOf).run();if(Number(changed.meta?.changes||0)===0)continue;processed++;await db.prepare("INSERT INTO lead_reopen_events (id,lead_id,cycle,reopened_at,assigned_owner,previous_status,outcome,created_at) VALUES (?,?,?,?,?,'cold','reopened',?)").bind(uid("REOPEN"),lead.id,cycle,asOf,owner,asOf).run();await audit(db,actorId,"lead",text(lead.id),"automatically_reopened",{cycle,owner},asOf);}return{processed,skipped:false};}

async function enforceLegacyLeadSla(db:Db,actorId:string,asOf:number){if(!(await tableExists(db,"lead_work_items")))return{processed:0,skipped:true};const due=await db.prepare("SELECT * FROM lead_work_items WHERE status='active' AND first_action_at IS NULL AND manager_alert_at<=?").bind(asOf).all<Row>();let processed=0;for(const lead of due.results){const changed=await db.prepare("UPDATE lead_work_items SET status='sla_breached',updated_at=? WHERE id=? AND status='active' AND first_action_at IS NULL AND manager_alert_at<=?").bind(asOf,lead.id,asOf).run();if(Number(changed.meta?.changes||0)===0)continue;processed++;if(await tableExists(db,"customer_experience_tickets"))await db.prepare("INSERT OR IGNORE INTO customer_experience_tickets (id,customer_id,lead_id,category,priority,subject,detail,owner,manager,sla_due_at,status,escalation_level,customer_status,created_by,created_at,updated_at) VALUES (?,?,?,?,?,?,?,?,?,?,'open',1,?,?,?,?)").bind(`SLA-${lead.id}`,lead.customer_id,lead.id,"Lead SLA","high","30-minute lead response breached",`Lead ${lead.id} was not acted on within 30 minutes`,lead.manager,lead.manager,asOf+900000,"A manager is reviewing this request",actorId,asOf,asOf).run();await audit(db,actorId,"lead",text(lead.id),"manager_alerted",{manager:lead.manager},asOf);}return{processed,skipped:false};}

async function enforceLegacyOps(db:Db,actorId:string,asOf:number){if(!(await tableExists(db,"ops_completion_controls")))return{processed:0,skipped:true};const due=await db.prepare("SELECT * FROM ops_completion_controls WHERE status!='completed' AND scheduled_end_at<? AND escalation_level=0").bind(asOf).all<Row>();let processed=0;for(const item of due.results){const changed=await db.prepare("UPDATE ops_completion_controls SET escalation_level=1,exception_reason=COALESCE(exception_reason,'Completion overdue'),updated_at=? WHERE id=? AND status!='completed' AND escalation_level=0").bind(asOf,item.id).run();if(Number(changed.meta?.changes||0)===0)continue;processed++;if(await tableExists(db,"customer_experience_tickets"))await db.prepare("INSERT OR IGNORE INTO customer_experience_tickets (id,booking_id,category,priority,subject,detail,owner,manager,sla_due_at,status,escalation_level,customer_status,created_by,created_at,updated_at) VALUES (?,?,?,?,?,?,?,?,?,'open',1,?,?,?,?)").bind(`OPS-${item.booking_id}`,item.booking_id,"Ops completion","high","Service completion overdue",`Evidence or completion is pending for ${item.booking_id}`,item.owner,"Operations Manager",asOf+900000,"Operations is validating service completion",actorId,asOf,asOf).run();await audit(db,actorId,"booking",text(item.booking_id),"ops_completion_escalated",{owner:item.owner},asOf);}return{processed,skipped:false};}

async function generateCommandReports(db:Db,actorId:string,asOf:number){if(istHour(asOf)<19||!(await tableExists(db,"command_report_runs")))return{processed:0,skipped:istHour(asOf)<19};const date=dayKey(asOf),created:string[]=[];const count=async(sql:string,binds:unknown[]=[])=>{try{let statement=db.prepare(sql);if(binds.length)statement=statement.bind(...binds);return await statement.first<Row>();}catch{return null;}};const[opps,leads,tickets,ops,close]=await Promise.all([count("SELECT COUNT(*) count,COALESCE(SUM(expected_revenue),0) value FROM revenue_opportunities WHERE opportunity_date=? AND status!='completed'",[date]),count("SELECT COUNT(*) count,SUM(CASE WHEN status='sla_breached' THEN 1 ELSE 0 END) breaches FROM lead_work_items"),count("SELECT COUNT(*) count,SUM(CASE WHEN escalation_level>0 THEN 1 ELSE 0 END) escalated FROM customer_experience_tickets WHERE status!='resolved'"),count("SELECT COUNT(*) count,SUM(CASE WHEN escalation_level>0 THEN 1 ELSE 0 END) escalated FROM ops_completion_controls WHERE status!='completed'"),count("SELECT status,variance_amount FROM finance_day_closures WHERE closure_date=?",[date])]);const metrics={revenue100:Number(opps?.count||0),expectedRevenue:Number(opps?.value||0),leads:Number(leads?.count||0),slaBreaches:Number(leads?.breaches||0),openTickets:Number(tickets?.count||0),ticketEscalations:Number(tickets?.escalated||0),openOps:Number(ops?.count||0),opsEscalations:Number(ops?.escalated||0),accountsStatus:close?.status||"open",accountsVariance:Number(close?.variance_amount||0)};for(const period of["daily","weekly","monthly"]){const id=`CMD-${date}-${period}`,result=await db.prepare("INSERT OR IGNORE INTO command_report_runs (id,report_date,period_type,scheduled_for,status,metrics_json,recipients_json,delivery_channels_json,generated_at) VALUES (?,?,?,?,?,?,?,?,?)").bind(id,date,period,asOf,"uat_queued",JSON.stringify(metrics),JSON.stringify(["Founder","Sales Manager","Operations Manager","Finance Manager"]),JSON.stringify(["email","whatsapp","dashboard"]),asOf).run();if(Number(result.meta?.changes||0)>0)created.push(id);}if(created.length)await audit(db,actorId,"command_report",date,"7pm_reports_generated",{periods:created},asOf);return{processed:created.length,skipped:false};}

export async function runBackgroundScheduler(db:Db,input:{actorId?:string;asOf?:number;cron?:string}={}){const asOf=input.asOf??Date.now(),scheduledAt=slot(asOf),slotKey=`five-minute:${scheduledAt}`,actorId=input.actorId||"system:scheduled-worker",cron=input.cron||"*/5 * * * *";await ensureBackgroundSchedulerTables(db);const prior=await db.prepare("SELECT status,result_json FROM background_scheduler_runs WHERE slot_key=?").bind(slotKey).first<Row>();if(text(prior?.status)==="completed")return{...(JSON.parse(text(prior?.result_json)||"{}") as Row),duplicatePrevented:true};const now=Date.now();if(prior)await db.prepare("UPDATE background_scheduler_runs SET status='running',attempts=attempts+1,last_error=NULL,started_at=?,updated_at=? WHERE slot_key=?").bind(now,now,slotKey).run();else await db.prepare("INSERT INTO background_scheduler_runs (slot_key,scheduled_at,cron,status,attempts,started_at,updated_at) VALUES (?,?,?,'running',1,?,?)").bind(slotKey,scheduledAt,cron,now,now).run();try{const tasks=await Promise.allSettled([runStaffAlertSweep(db,{actorId,asOf}),runLeadCallbackSweep(db,{actorId,asOf}),reopenColdLeads(db,actorId,asOf),enforceLegacyLeadSla(db,actorId,asOf),enforceLegacyOps(db,actorId,asOf),generateCommandReports(db,actorId,asOf),runCustomerReminderSweep(db,{actorId,asOf}),runPetBirthdaySweep(db,{today:new Date(asOf).toISOString().slice(0,10)}),runVaccinationDueSweep(db,{today:new Date(asOf).toISOString().slice(0,10)}),runPawPointsEarnSweep(db,{}),runServiceReviewSweep(db,{asOf}),runRevenueRecognitionSweep(db,{asOf}),runRiskAnomalySweep(db,{asOf}),runCustomerTargetingSweep(db,{asOf}),runHaptikOutboundSweep(db,{asOf}),runAppFunnelSweep(db,{asOf}),runDailyIncentiveAccrualSweep(db,{asOf}),runStatutoryReminderSweep(db,{asOf}),runMarketingAutomationSandboxSweep(db,{actor:actorId,asOf,signalKey:`scheduler:${slotKey}`,signals:{}}),sweepWorkQueue(db,{actorId,now:asOf}),sweepExpiredFoodBatches(db,{actorId,asOfDate:new Date(asOf).toISOString().slice(0,10)}),sweepOverdueStayBalances(db,asOf)]);const names=["staffAlerts","callbacks","leadReopening","legacyLeadSla","opsEscalation","commandReports","customerReminders","petBirthdayRewards","vaccinationReminders","pawPointsEarn","serviceReviews","revenueRecognition","riskAnomaly","customerTargeting","haptikOutbound","appToRevenueFunnel","dailyIncentiveAccrual","statutoryReminders","marketingAutomationSandbox","opsWorkQueue","foodBatchExpiry","overdueStayBalances"],result:Record<string,unknown>={scheduledAt,cron,runner:"cloudflare_scheduled_handler",pageLoadRequired:false,externalDelivery:false};const errors:string[]=[];tasks.forEach((task,index)=>{if(task.status==="fulfilled")result[names[index]]=task.value;else errors.push(`${names[index]}:${task.reason instanceof Error?task.reason.message:String(task.reason)}`);});result.errors=errors;result.ok=errors.length===0;result.duplicatePrevented=false;await db.prepare("UPDATE background_scheduler_runs SET status=?,result_json=?,last_error=?,finished_at=?,updated_at=? WHERE slot_key=?").bind(errors.length?"partial":"completed",JSON.stringify(result),errors.length?errors.join(" | "):null,Date.now(),Date.now(),slotKey).run();return result;}catch(error){await db.prepare("UPDATE background_scheduler_runs SET status='failed',last_error=?,finished_at=?,updated_at=? WHERE slot_key=?").bind(error instanceof Error?error.message:String(error),Date.now(),Date.now(),slotKey).run();throw error;}}

export async function backgroundSchedulerStatus(db:Db){await ensureBackgroundSchedulerTables(db);const latest=await db.prepare("SELECT * FROM background_scheduler_runs ORDER BY scheduled_at DESC LIMIT 1").first<Row>();return{configured:true,cron:"*/5 * * * *",runner:"worker.scheduled",pageLoadRequired:false,lastRun:latest||null,externalDelivery:false};}
</file>

<file path="lib/boarding-booking-client.ts">
import{createCanonicalLifecycle,type CanonicalLifecycleResult}from"./canonical-lifecycle-client";
import type{BoardingQuote}from"./boarding-commercial-client";

export type BoardingCustomer={id:string;name:string;primaryPhone:string;secondaryPhone?:string;email?:string};
export type BoardingPet={sourceId:string;name:string;species?:"dog"|"cat"|"other";breed?:string;vaccinationStatus?:string};
export type BoardingProvider={id:string;name:string;model:"full_time"|"commission"};
export type BoardingBookingResult=CanonicalLifecycleResult&{liveMoney:false};

export async function createCanonicalBoardingBooking(input:{
 idempotencyKey:string;
 scheduleGroupId:string;
 boardingQuote:BoardingQuote;
 customer:BoardingCustomer;
 pets:BoardingPet[];
 cityId:string;
 zoneId:string;
 provider:BoardingProvider;
}){
 const quote=input.boardingQuote;
 const result=await createCanonicalLifecycle({
  idempotencyKey:input.idempotencyKey,
