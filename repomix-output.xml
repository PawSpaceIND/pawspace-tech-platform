 if(input.action==="save_report"){requireState(["arrived","in_session"]);const report=input.report??{};await db.prepare("UPDATE training_sessions SET attendance_json=?,homework_json=?,progress_json=?,evidence_json=?,updated_at=? WHERE id=?").bind(JSON.stringify(report.attendance??parse(row.attendance_json,{})),JSON.stringify({text:String(report.homework??parse<Record<string,unknown>>(row.homework_json,{}).text??"")}),JSON.stringify(report.progress??parse(row.progress_json,{})),JSON.stringify(report.evidenceRefs??parse(row.evidence_json,[])),now,row.id).run();await event(db,row,input,{saved:true});return{duplicatePrevented:false,status:current,reportSaved:true};}
 if(input.action==="complete"){requireState(["in_session"]);const report=input.report??{attendance:parse(row.attendance_json,{}),homework:String(parse<Record<string,unknown>>(row.homework_json,{}).text||""),progress:parse(row.progress_json,{}),evidenceRefs:parse(row.evidence_json,[])};const problem=reportProblem(report);if(problem)throw new Response(problem,{status:409});const refs=report.evidenceRefs??[];const evidence=await secureEvidenceReady(db,row,refs);if(!evidence.ready)throw new Response(evidence.reason||"Secure Training evidence is not ready",{status:409});await db.batch([db.prepare("UPDATE training_sessions SET status='completed',attendance_json=?,homework_json=?,progress_json=?,evidence_json=?,completed_at=?,updated_at=? WHERE id=?").bind(JSON.stringify(report.attendance),JSON.stringify({text:String(report.homework)}),JSON.stringify(report.progress),JSON.stringify(refs),now,now,row.id),db.prepare("INSERT OR IGNORE INTO training_session_consumptions (session_id,programme_id,booking_id,actor_id,consumed_at) VALUES (?,?,?,?,?)").bind(row.id,row.programme_id,row.booking_id,input.actorId,now),db.prepare("UPDATE scheduling_reservations SET status='completed' WHERE id=?").bind(row.schedule_reservation_id)]);const programme=await recalcProgramme(db,String(row.programme_id));await event(db,row,input,{from:current,to:"completed",consumedExactlyOnce:true,evidenceRefs:refs,programme});return{duplicatePrevented:false,status:"completed",consumedExactlyOnce:true,programme};}
 if(input.action==="request_reschedule"){requireState(["scheduled","accepted","on_the_way","arrived"]);const reason=String(input.reason||"").trim();if(reason.length<8)throw new Response("Reschedule request requires a clear reason",{status:400});const caseId=await recovery(db,row,"reschedule",reason,input.actorId);await db.prepare("UPDATE training_sessions SET status='reschedule_requested',updated_at=? WHERE id=?").bind(now,row.id).run();await event(db,row,input,{from:current,to:"reschedule_requested",caseId,reason});return{duplicatePrevented:false,status:"reschedule_requested",caseId};}
 if(input.action==="no_show"){requireState(["scheduled","accepted","on_the_way","arrived"]);const reason=String(input.reason||"").trim();if(reason.length<8)throw new Response("No-show requires a clear reason",{status:400});if(!input.staffOverride&&now<new Date(String(row.scheduled_start)).getTime()+15*60_000)throw new Response("Provider no-show can only be recorded after the session start grace period",{status:409});const caseId=await recovery(db,row,"no_show",reason,input.actorId,{consumption:"pending_policy"});await db.prepare("UPDATE training_sessions SET status='no_show',updated_at=? WHERE id=?").bind(now,row.id).run();await db.prepare("UPDATE scheduling_reservations SET status='no_show' WHERE id=?").bind(row.schedule_reservation_id).run();const programme=await recalcProgramme(db,String(row.programme_id));await event(db,row,input,{from:current,to:"no_show",caseId,consumption:"not_automatic",programme});return{duplicatePrevented:false,status:"no_show",caseId,consumption:"pending_policy",programme};}
