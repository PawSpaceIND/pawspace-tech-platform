async function pinnedPolicy(db:D1Database,application:Row){const ref=text(application.policy_ref);if(!ref)throw new Error("Application has no frozen onboarding policy");const row=await db.prepare("SELECT id,interview_policy_json,media_requirements_json,sla_template_ref,activation_requirements_json FROM provider_onboarding_policy_versions WHERE id=?").bind(ref).first<Row>();if(!row)throw new Error("Frozen onboarding policy not found");return{id:ref,interviewPolicy:parse<Record<string,unknown>>(row.interview_policy_json,{}),mediaRequirements:parse<unknown[]>(row.media_requirements_json,[]),slaTemplateRef:text(row.sla_template_ref)||null,activationRequirements:parse<unknown[]>(row.activation_requirements_json,[])};}

export async function scheduleProviderInterview(db:D1Database,input:{applicationId:string;startAt:string;opsEmail:string;actorEmail:string}){const application=await app(db,input.applicationId),state=text(application.status);if(!["interview","interview_review"].includes(state))throw new Error("Application must be ready for interview scheduling");if(!["passed","needs_review"].includes(text(application.quiz_status)))throw new Error("Qualified quiz result is required before interview scheduling");const policy=await pinnedPolicy(db,application),duration=Math.max(5,Number(policy.interviewPolicy.durationMinutes??15));if(!Number.isFinite(duration)||duration>120)throw new Error("Configured interview duration is invalid");const start=new Date(input.startAt);if(Number.isNaN(start.getTime()))throw new Error("Valid interview start time is required");const ops=text(input.opsEmail);if(!ops)throw new Error("Ops assignee is required");const end=new Date(start.getTime()+duration*60_000),conflict=await db.prepare("SELECT id FROM provider_onboarding_interviews WHERE ops_email=? AND status='scheduled' AND start_at<? AND end_at>? LIMIT 1").bind(ops,end.toISOString(),start.toISOString()).first<Row>();if(conflict)throw new Error("Ops assignee already has an overlapping interview");const existing=await db.prepare("SELECT id FROM provider_onboarding_interviews WHERE application_id=? AND status='scheduled' LIMIT 1").bind(input.applicationId).first<Row>();if(existing)throw new Error("Application already has a scheduled interview");const id=`POINT-${crypto.randomUUID().slice(0,12).toUpperCase()}`,now=Date.now();await db.prepare("INSERT INTO provider_onboarding_interviews (id,application_id,start_at,end_at,duration_minutes,ops_email,status,created_by,created_at,updated_at) VALUES (?,?,?,?,?,?,'scheduled',?,?,?)").bind(id,input.applicationId,start.toISOString(),end.toISOString(),duration,ops,input.actorEmail,now,now).run();await db.prepare("UPDATE provider_onboarding_applications SET interview_status='scheduled',status='interview',updated_at=? WHERE id=?").bind(now,input.applicationId).run();await event(db,input.applicationId,"interview_scheduled",input.actorEmail,state,"interview",{interviewId:id,opsEmail:ops,durationMinutes:duration,startAt:start.toISOString()});return{id,status:"scheduled",durationMinutes:duration,startAt:start.toISOString(),endAt:end.toISOString(),opsEmail:ops};}

export async function completeProviderInterview(db:D1Database,input:{interviewId:string;notes:string;actorEmail:string}){await ensureProviderOnboardingHumanActivation(db);const row=await db.prepare("SELECT * FROM provider_onboarding_interviews WHERE id=?").bind(input.interviewId).first<Row>();if(!row||text(row.status)!=="scheduled")throw new Error("Scheduled interview not found");if(text(row.ops_email).toLowerCase()!==text(input.actorEmail).toLowerCase())throw new Error("Only the assigned Ops interviewer can complete this interview");const notes=text(input.notes);if(notes.length<10)throw new Error("Interview notes are required");const now=Date.now(),applicationId=text(row.application_id);await db.batch([db.prepare("UPDATE provider_onboarding_interviews SET status='completed',notes=?,updated_at=? WHERE id=?").bind(notes,now,input.interviewId),db.prepare("UPDATE provider_onboarding_applications SET interview_status='completed',updated_at=? WHERE id=?").bind(now,applicationId)]);await event(db,applicationId,"interview_completed",input.actorEmail,"interview","interview",{interviewId:input.interviewId});return{id:input.interviewId,status:"completed",finalDecisionRecorded:false};}

export async function saveInterviewAiSummaryDraft(db:D1Database,input:{interviewId:string;summary:string;actorEmail:string;providerRef?:string;modelRef?:string}){await ensureProviderOnboardingHumanActivation(db);const row=await db.prepare("SELECT application_id FROM provider_onboarding_interviews WHERE id=?").bind(input.interviewId).first<Row>();if(!row)throw new Error("Interview not found");const summary=text(input.summary);if(!summary)throw new Error("Summary draft is required");await db.prepare("UPDATE provider_onboarding_interviews SET ai_summary_draft=?,ai_provider_ref=?,ai_model_ref=?,updated_at=? WHERE id=?").bind(summary,text(input.providerRef)||null,text(input.modelRef)||null,Date.now(),input.interviewId).run();await event(db,text(row.application_id),"interview_ai_summary_draft_saved",input.actorEmail,null,null,{interviewId:input.interviewId,providerRef:text(input.providerRef)||null,modelRef:text(input.modelRef)||null,decisionAuthority:"human_ops"});return{id:input.interviewId,status:"draft",decisionAuthority:"human_ops",autoDecision:false};}

export async function recordProviderHumanDecision(db:D1Database,input:{interviewId:string;decision:HumanDecision;decisionNotes:string;actorEmail:string}){await ensureProviderOnboardingHumanActivation(db);if(!["approved","rejected","review"].includes(input.decision))throw new Error("Unsupported human interview decision");const row=await db.prepare("SELECT * FROM provider_onboarding_interviews WHERE id=?").bind(input.interviewId).first<Row>();if(!row||text(row.status)!=="completed")throw new Error("Completed interview is required before a human decision");const notes=text(input.decisionNotes);if(notes.length<5)throw new Error("Decision notes are required");const applicationId=text(row.application_id),application=await app(db,applicationId),from=text(application.status),to=input.decision==="approved"?"agreement":input.decision==="rejected"?"rejected":"interview_review",now=Date.now();await db.batch([db.prepare("UPDATE provider_onboarding_interviews SET outcome=?,decision_notes=?,decision_actor=?,decision_at=?,updated_at=? WHERE id=?").bind(input.decision,notes,input.actorEmail,now,now,input.interviewId),db.prepare("UPDATE provider_onboarding_applications SET human_decision=?,status=?,updated_at=? WHERE id=?").bind(input.decision,to,now,applicationId)]);await event(db,applicationId,"human_interview_decision",input.actorEmail,from,to,{interviewId:input.interviewId,decision:input.decision});return{applicationId,decision:input.decision,status:to,decisionAuthority:"human_ops",aiDecision:false};}

export async function createProviderSla(db:D1Database,input:{applicationId:string;actorEmail:string;adapterKey?:string}){const application=await app(db,input.applicationId);if(text(application.human_decision)!=="approved")throw new Error("Explicit human approval is required before SLA creation");const policy=await pinnedPolicy(db,application);if(!policy.slaTemplateRef)throw new Error("Frozen onboarding policy has no SLA template reference");const legal=await resolveProviderOnboardingContent(db,{contentKey:policy.slaTemplateRef,localeCode:text(application.locale_code)||"en"});if(!legal||legal.contentType!=="legal")throw new Error("An active legally approved SLA localization is required");const versionRow=await db.prepare("SELECT MAX(agreement_version) version FROM provider_onboarding_agreements WHERE application_id=?").bind(input.applicationId).first<Row>(),version=Number(versionRow?.version||0)+1,id=`POSLA-${crypto.randomUUID().slice(0,12).toUpperCase()}`,now=Date.now(),adapter=text(input.adapterKey)||"not_connected";await db.prepare("INSERT INTO provider_onboarding_agreements (id,application_id,agreement_version,template_ref,content_id,content_version,locale_code,esign_adapter,environment,external_connected,status,created_by,created_at,updated_at) VALUES (?,?,?,?,?,?,?,?, 'uat',0,'awaiting_acceptance',?,?,?)").bind(id,input.applicationId,version,policy.slaTemplateRef,legal.id,legal.version,legal.localeCode,adapter,input.actorEmail,now,now).run();await event(db,input.applicationId,"sla_created",input.actorEmail,text(application.status),"agreement",{agreementId:id,agreementVersion:version,templateRef:policy.slaTemplateRef,contentId:legal.id,environment:"uat",externalConnected:false});return{id,agreementVersion:version,status:"awaiting_acceptance",environment:"uat",externalConnected:false,liveEsignExecuted:false};}

export async function acceptProviderSla(db:D1Database,input:{agreementId:string;acceptedBy:string;actorEmail:string}){await ensureProviderOnboardingHumanActivation(db);const row=await db.prepare("SELECT * FROM provider_onboarding_agreements WHERE id=?").bind(input.agreementId).first<Row>();if(!row||text(row.status)!=="awaiting_acceptance")throw new Error("SLA is not awaiting acceptance");const acceptedBy=text(input.acceptedBy);if(!acceptedBy)throw new Error("Provider acceptance identity is required");const applicationId=text(row.application_id),application=await app(db,applicationId);if(text(application.human_decision)!=="approved")throw new Error("Human approval is required before SLA acceptance");const now=Date.now(),acceptanceRef=`UAT-ACCEPT-${crypto.randomUUID().slice(0,12).toUpperCase()}`;await db.batch([db.prepare("UPDATE provider_onboarding_agreements SET status='accepted',accepted_by=?,accepted_at=?,acceptance_ref=?,updated_at=? WHERE id=?").bind(acceptedBy,now,acceptanceRef,now,input.agreementId),db.prepare("UPDATE provider_onboarding_applications SET status='profile',updated_at=? WHERE id=?").bind(now,applicationId)]);await event(db,applicationId,"sla_uat_acceptance_recorded",input.actorEmail,text(application.status),"profile",{agreementId:input.agreementId,acceptedBy,acceptanceRef,liveEsignExecuted:false});return{id:input.agreementId,status:"accepted",acceptanceRef,liveEsignExecuted:false};}

function profileSnapshot(row:Row|null){if(!row)return null;return{displayName:text(row.display_name),bio:text(row.bio),businessName:text(row.business_name),businessDetails:parse<Record<string,unknown>>(row.business_details_json,{}),services:parse<string[]>(row.services_json,[]),serviceAreas:parse<string[]>(row.service_areas_json,[]),languages:parse<string[]>(row.languages_json,[]),packageDetails:parse<unknown[]>(row.package_details_json,[]),facilityDetails:parse<Record<string,unknown>>(row.facility_details_json,{}),references:parse<unknown[]>(row.references_json,[]),status:text(row.status),providerId:text(row.provider_id)||null};}
function completionFor(profile:ReturnType<typeof profileSnapshot>){return{displayName:Boolean(profile?.displayName),businessName:Boolean(profile?.businessName),services:Boolean(profile?.services.length),serviceAreas:Boolean(profile?.serviceAreas.length),languages:Boolean(profile?.languages.length)};}

export async function saveProviderProfile(db:D1Database,input:{applicationId:string;payload:Record<string,unknown>;actorEmail:string}){const application=await app(db,input.applicationId);if(text(application.human_decision)!=="approved")throw new Error("Human approval is required before profile completion");const agreement=await db.prepare("SELECT id FROM provider_onboarding_agreements WHERE application_id=? AND status='accepted' ORDER BY agreement_version DESC LIMIT 1").bind(input.applicationId).first<Row>();if(!agreement)throw new Error("Accepted SLA is required before profile completion");const p=input.payload,displayName=text(p.displayName),businessName=text(p.businessName);if(!displayName||!businessName)throw new Error("Display name and business name are required");const before=await db.prepare("SELECT * FROM provider_onboarding_profiles WHERE application_id=?").bind(input.applicationId).first<Row>(),now=Date.now(),services=arr(p.services),serviceAreas=arr(p.serviceAreas),languages=arr(p.languages),businessDetails=object(p.businessDetails),packageDetails=Array.isArray(p.packageDetails)?p.packageDetails:[],facilityDetails=object(p.facilityDetails),references=Array.isArray(p.references)?p.references:[],snapshot={displayName,bio:text(p.bio),businessName,businessDetails,services,serviceAreas,languages,packageDetails,facilityDetails,references,status:"complete",providerId:text(application.provider_id)||null},completion=completionFor(snapshot);await db.prepare("INSERT INTO provider_onboarding_profiles (application_id,provider_id,status,display_name,bio,business_name,business_details_json,services_json,service_areas_json,languages_json,package_details_json,facility_details_json,references_json,profile_completion_json,created_by,updated_by,created_at,updated_at) VALUES (?,?, 'complete',?,?,?,?,?,?,?,?,?,?,?,?,?,?,?) ON CONFLICT(application_id) DO UPDATE SET provider_id=excluded.provider_id,status='complete',display_name=excluded.display_name,bio=excluded.bio,business_name=excluded.business_name,business_details_json=excluded.business_details_json,services_json=excluded.services_json,service_areas_json=excluded.service_areas_json,languages_json=excluded.languages_json,package_details_json=excluded.package_details_json,facility_details_json=excluded.facility_details_json,references_json=excluded.references_json,profile_completion_json=excluded.profile_completion_json,updated_by=excluded.updated_by,updated_at=excluded.updated_at").bind(input.applicationId,text(application.provider_id)||null,displayName,text(p.bio),businessName,JSON.stringify(businessDetails),JSON.stringify(services),JSON.stringify(serviceAreas),JSON.stringify(languages),JSON.stringify(packageDetails),JSON.stringify(facilityDetails),JSON.stringify(references),JSON.stringify(completion),input.actorEmail,input.actorEmail,now,now).run();const after=await db.prepare("SELECT * FROM provider_onboarding_profiles WHERE application_id=?").bind(input.applicationId).first<Row>();await db.prepare("INSERT INTO provider_onboarding_profile_audit (id,application_id,actor_id,action,reason,before_json,after_json,review_required,reverification_required,created_at) VALUES (?,?,?,?,?,?,?,0,0,?)").bind(crypto.randomUUID(),input.applicationId,input.actorEmail,before?"profile_updated":"profile_created","onboarding profile completion",before?JSON.stringify(profileSnapshot(before)):null,JSON.stringify(profileSnapshot(after)),now).run();await event(db,input.applicationId,"provider_profile_saved",input.actorEmail,text(application.status),"profile",{completion});return{applicationId:input.applicationId,status:"complete",completion};}

function mediaClassification(type:MediaType){if(type==="home_photo"||type==="facility_photo")return"sensitive_location";if(type==="reference")return"sensitive_reference";return"provider_profile_media";}
export async function addProviderProfileMedia(db:D1Database,input:{applicationId:string;mediaType:MediaType;fileRef:string;actorEmail:string}){const application=await app(db,input.applicationId);if(text(application.human_decision)!=="approved")throw new Error("Human approval is required before profile media upload");if(!mediaTypes.includes(input.mediaType)||!text(input.fileRef))throw new Error("Supported media type and secure file reference are required");const id=`POMEDIA-${crypto.randomUUID().slice(0,12).toUpperCase()}`,classification=mediaClassification(input.mediaType),now=Date.now();await db.prepare("INSERT INTO provider_onboarding_profile_media (id,application_id,media_type,file_ref,classification,status,publish_approved,created_by,created_at,updated_at) VALUES (?,?,?,?,?,'uploaded',0,?,?,?)").bind(id,input.applicationId,input.mediaType,text(input.fileRef),classification,input.actorEmail,now,now).run();await event(db,input.applicationId,"provider_profile_media_added",input.actorEmail,null,null,{mediaId:id,mediaType:input.mediaType,classification,publishApproved:false});return{id,mediaType:input.mediaType,classification,publishApproved:false};}

function requiredMedia(requirements:unknown[]){const out:{mediaType:string;minCount:number}[]=[];for(const item of requirements){if(typeof item==="string"){const type=text(item);if(type)out.push({mediaType:type,minCount:1});continue;}const r=object(item),type=text(r.mediaType||r.type||r.kind);if(type&&r.required!==false)out.push({mediaType:type,minCount:Math.max(1,Number(r.minCount||1))});}return out;}
function hasProfileField(profile:ReturnType<typeof profileSnapshot>,field:string){if(!profile)return false;const value=(profile as Record<string,unknown>)[field];return Array.isArray(value)?value.length>0:typeof value==="object"&&value!==null?Object.keys(value as Record<string,unknown>).length>0:Boolean(text(value));}
type ActivationCheck={code:string;passed:boolean;detail?:unknown};
const check=(code:string,passed:boolean,detail?:unknown):ActivationCheck=>({code,passed,...(detail===undefined?{}:{detail})});

export async function evaluateProviderActivation(db:D1Database,input:{applicationId:string}){const application=await app(db,input.applicationId),policy=await pinnedPolicy(db,application),profileRow=await db.prepare("SELECT * FROM provider_onboarding_profiles WHERE application_id=?").bind(input.applicationId).first<Row>(),profile=profileSnapshot(profileRow),interview=await db.prepare("SELECT status,outcome FROM provider_onboarding_interviews WHERE application_id=? ORDER BY created_at DESC LIMIT 1").bind(input.applicationId).first<Row>(),agreement=await db.prepare("SELECT status FROM provider_onboarding_agreements WHERE application_id=? ORDER BY agreement_version DESC LIMIT 1").bind(input.applicationId).first<Row>(),media=(await db.prepare("SELECT media_type,COUNT(*) count FROM provider_onboarding_profile_media WHERE application_id=? AND status='uploaded' GROUP BY media_type").bind(input.applicationId).all<Row>()).results,counts=new Map(media.map(r=>[text(r.media_type),Number(r.count||0)])),checks:ActivationCheck[]=[
 check("verification_verified",text(application.verification_status)==="verified"),
 check("quiz_qualified",["passed","needs_review"].includes(text(application.quiz_status))),
 check("interview_approved",text(interview?.status)==="completed"&&text(interview?.outcome)==="approved"),
 check("human_decision_approved",text(application.human_decision)==="approved"),
 check("sla_accepted",text(agreement?.status)==="accepted"),
 check("profile_complete",Boolean(profile)&&Object.values(completionFor(profile)).every(Boolean),completionFor(profile)),
 check("city_present",Boolean(text(application.city_code))),
 ];
 // The per-category verification mandate (lib/provider-verification-mandate.ts) was never consulted
 // here: activation only looked at the application-level verification_status, which the older generic
 // verification flow can set to 'verified' on its own. A host could therefore be activated with
 // house_verification and pet_proofing_photo still not started.
 /*
  * WHAT A VERTICAL MUST HAVE VERIFIED is now decided by lib/provider-verification-policy.ts, which is
  * scoped by service AND city and edited in Control Center - so a city can demand more of a taxi driver
  * without a deploy. [PTJA-W1-F53]
  *
  * The `else` branch below used to push `check(..., true)`: an unmapped vertical produced a PASSING
  * check. dog_walking and pet_taxi were both unmapped, so two of the six canonical services activated
  * providers with no identity mandate at all - measured, a dog walker activated end to end with zero
  * verification rows and zero onboarding documents. Unknown is now BLOCKING, and the check says which
  * vertical nobody has decided about rather than implying somebody had.
  */
