  s2.prepare("INSERT INTO booking_payments (id,booking_id,customer_id,amount,status,idempotency_key,created_at,updated_at) VALUES ('PAY-BK-C','BK-C','CUS-3',8000,'created','k-c',?,?)").run(now, now);
