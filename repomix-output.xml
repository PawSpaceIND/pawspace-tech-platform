import{resolveLivePrice}from"./live-pricing-resolver";
import{sameInstant}from"./booking-window-instant";

type Row=Record<string,unknown>;
export type TrainingPaymentMode="prepaid"|"split";
export type TrainingCommercialQuote={quoteId:string;packageCode:string;packageName:string;packageVersion:number;sessions:number;validityDays:number;petCount:number;minutesPerSession:number;basePrice:number;discount:number;totalAmount:number;amountDueNow:number;paymentMode:TrainingPaymentMode;meetAndGreet:boolean;expiresAt:number};
const defaults=[
 {code:"trainer-meet-greet",name:"Trainer Meet & Greet",sessions:1,validityDays:7,price:500,meet:1,maxPets:4,direct:30,coaching:15,split:0},
 {code:"training-2-starter",name:"Starter Plan",sessions:2,validityDays:31,price:3500,meet:0,maxPets:4,direct:45,coaching:15,split:50},
 {code:"training-4-puppy",name:"Puppy Training Plan",sessions:4,validityDays:31,price:6000,meet:0,maxPets:4,direct:45,coaching:15,split:50},
 {code:"training-8-basic",name:"Basic Obedience Plan",sessions:8,validityDays:62,price:12000,meet:0,maxPets:4,direct:45,coaching:15,split:50},
 {code:"training-8-leash",name:"Leash Obedience Plan · 8",sessions:8,validityDays:62,price:12000,meet:0,maxPets:4,direct:45,coaching:15,split:50},
 {code:"training-12-leash",name:"Leash Obedience Plan · 12",sessions:12,validityDays:93,price:16500,meet:0,maxPets:4,direct:45,coaching:15,split:50},
 {code:"training-12-advanced",name:"Advanced Obedience Plan",sessions:12,validityDays:93,price:16500,meet:0,maxPets:4,direct:45,coaching:15,split:50},
 {code:"training-16-pro",name:"Pro Training Plan",sessions:16,validityDays:93,price:20000,meet:0,maxPets:4,direct:45,coaching:15,split:50},
] as const;

export async function ensureTrainingCommercialTables(db:D1Database){await db.batch([
 db.prepare("CREATE TABLE IF NOT EXISTS training_commercial_packages (package_code TEXT PRIMARY KEY,name TEXT NOT NULL,sessions INTEGER NOT NULL,validity_days INTEGER NOT NULL,base_price REAL NOT NULL,currency TEXT NOT NULL DEFAULT 'INR',meet_and_greet INTEGER NOT NULL DEFAULT 0,max_pets INTEGER NOT NULL DEFAULT 4,direct_minutes_per_pet INTEGER NOT NULL DEFAULT 45,coaching_minutes_per_pet INTEGER NOT NULL DEFAULT 15,split_due_percent REAL NOT NULL DEFAULT 50,active INTEGER NOT NULL DEFAULT 1,version INTEGER NOT NULL DEFAULT 1,effective_from TEXT NOT NULL,effective_to TEXT,updated_by TEXT NOT NULL,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS training_commercial_quotes (id TEXT PRIMARY KEY,package_code TEXT NOT NULL,package_version INTEGER NOT NULL,pet_count INTEGER NOT NULL,scheduled_start TEXT NOT NULL,payment_mode TEXT NOT NULL,coupon_code TEXT,discount REAL NOT NULL DEFAULT 0,total_amount REAL NOT NULL,amount_due_now REAL NOT NULL,minutes_per_session INTEGER NOT NULL,sessions INTEGER NOT NULL,validity_days INTEGER NOT NULL,expires_at INTEGER NOT NULL,status TEXT NOT NULL DEFAULT 'open',created_at INTEGER NOT NULL,used_at INTEGER,used_booking_id TEXT)"),
 db.prepare("CREATE INDEX IF NOT EXISTS idx_training_quote_expiry ON training_commercial_quotes(status,expires_at)"),
 db.prepare("CREATE TABLE IF NOT EXISTS training_booking_quote_links (quote_id TEXT PRIMARY KEY,booking_id TEXT NOT NULL UNIQUE,created_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS training_coupon_rules (code TEXT PRIMARY KEY,discount_type TEXT NOT NULL,value REAL NOT NULL,max_discount REAL,status TEXT NOT NULL DEFAULT 'active',effective_from TEXT NOT NULL,effective_to TEXT,updated_by TEXT NOT NULL,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS training_quote_payment_attestations (quote_id TEXT PRIMARY KEY,status TEXT NOT NULL,amount REAL NOT NULL,currency TEXT NOT NULL DEFAULT 'INR',environment TEXT NOT NULL DEFAULT 'sandbox',reference TEXT NOT NULL,bound_payment_key TEXT NOT NULL,created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL)"),
]);const now=Date.now();for(const item of defaults)await db.prepare("INSERT OR IGNORE INTO training_commercial_packages (package_code,name,sessions,validity_days,base_price,currency,meet_and_greet,max_pets,direct_minutes_per_pet,coaching_minutes_per_pet,split_due_percent,active,version,effective_from,effective_to,updated_by,updated_at) VALUES (?,?,?,?,?,'INR',?,?,?,?,?,1,1,'2026-08-01',NULL,'founder_seed',?)").bind(item.code,item.name,item.sessions,item.validityDays,item.price,item.meet,item.maxPets,item.direct,item.coaching,item.split,now).run();}

function activePackage(row:Row,at:string){const date=at.slice(0,10);return Number(row.active)===1&&date>=String(row.effective_from)&&(!row.effective_to||date<=String(row.effective_to));}
async function discountFor(db:D1Database,couponCode:string|undefined,total:number,scheduledStart:string){const code=String(couponCode||"").trim().toUpperCase();if(!code)return{code:null,discount:0};const row=await db.prepare("SELECT * FROM training_coupon_rules WHERE code=? AND status='active'").bind(code).first<Row>();if(!row)return{code,discount:0,invalid:true};const date=scheduledStart.slice(0,10);if(date<String(row.effective_from)||row.effective_to&&date>String(row.effective_to))return{code,discount:0,invalid:true};let discount=String(row.discount_type)==="percent"?total*Number(row.value)/100:Number(row.value);if(row.max_discount!==null&&row.max_discount!==undefined)discount=Math.min(discount,Number(row.max_discount));return{code,discount:Math.max(0,Math.min(total,Math.round(discount)))};}

export async function createTrainingQuote(db:D1Database,input:{packageCode:string;petCount:number;scheduledStart:string;paymentMode:TrainingPaymentMode;couponCode?:string}){await ensureTrainingCommercialTables(db);const startMs=new Date(input.scheduledStart).getTime();if(!Number.isFinite(startMs)||startMs<=Date.now())throw new Response("Training quote requires a future scheduled start",{status:400});const row=await db.prepare("SELECT * FROM training_commercial_packages WHERE package_code=?").bind(input.packageCode).first<Row>();if(!row||!activePackage(row,input.scheduledStart))throw new Response("Active Training package not found for this date",{status:404});const petCount=Math.floor(Number(input.petCount));if(petCount<1||petCount>Number(row.max_pets))throw new Response(`Training supports 1-${Number(row.max_pets)} pets per programme`,{status:409});const meet=Number(row.meet_and_greet)===1;if(meet&&input.paymentMode!=="prepaid")throw new Response("Trainer Meet & Greet must be paid in full",{status:409});if(!meet&&!(["prepaid","split"] as string[]).includes(input.paymentMode))throw new Response("Training programmes support full prepaid or approved split payment",{status:409});if(input.paymentMode==="split"&&String(input.couponCode||"").trim())throw new Response("Training coupons require full prepaid payment",{status:409});const live=await resolveLivePrice(db,{packageCode:String(row.package_code),fallbackPrice:Number(row.base_price),scheduledStart:input.scheduledStart,cityId:"blr",zoneId:"blr-east"}),basePrice=live.price,coupon=await discountFor(db,input.couponCode,basePrice,input.scheduledStart);if(coupon.invalid)throw new Response("Training coupon is not active or eligible",{status:409});const totalAmount=Math.max(0,basePrice-coupon.discount),amountDueNow=meet||input.paymentMode==="prepaid"?totalAmount:Math.round(totalAmount*Number(row.split_due_percent)/100),minutesPerSession=petCount*(Number(row.direct_minutes_per_pet)+Number(row.coaching_minutes_per_pet)),now=Date.now(),expiresAt=now+15*60_000,id=`TQ-${crypto.randomUUID().slice(0,12).toUpperCase()}`;await db.prepare("INSERT INTO training_commercial_quotes (id,package_code,package_version,pet_count,scheduled_start,payment_mode,coupon_code,discount,total_amount,amount_due_now,minutes_per_session,sessions,validity_days,expires_at,status,created_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,'open',?)").bind(id,row.package_code,row.version,petCount,input.scheduledStart,input.paymentMode,coupon.code,coupon.discount,totalAmount,amountDueNow,minutesPerSession,row.sessions,row.validity_days,expiresAt,now).run();return{quoteId:id,packageCode:String(row.package_code),packageName:String(row.name),packageVersion:Number(row.version),sessions:Number(row.sessions),validityDays:Number(row.validity_days),petCount,minutesPerSession,basePrice,discount:coupon.discount,totalAmount,amountDueNow,paymentMode:input.paymentMode,meetAndGreet:meet,expiresAt} satisfies TrainingCommercialQuote;}

export async function captureTrainingQuoteSandbox(db:D1Database,input:{quoteId:string;amount:number;paymentKey:string}){await ensureTrainingCommercialTables(db);const paymentKey=String(input.paymentKey||"").trim();if(!paymentKey)throw new Response("MISSING_CAPTURE_KEY",{status:400});const quote=await db.prepare("SELECT q.id,q.amount_due_now,q.status,q.expires_at,p.meet_and_greet FROM training_commercial_quotes q JOIN training_commercial_packages p ON p.package_code=q.package_code AND p.version=q.package_version WHERE q.id=?").bind(input.quoteId).first<Row>();if(!quote)throw new Response("Training quote not found",{status:404});if(Number(quote.meet_and_greet)===1)throw new Response("Meet & Greet remains pending until a verified payment event",{status:409});if(String(quote.status)!=="open")throw new Response("Only an open Training quote can be sandbox-captured",{status:409});if(Number(quote.expires_at)<Date.now())throw new Response("Training quote expired before sandbox capture",{status:409});if(Number(quote.amount_due_now)!==Number(input.amount))throw new Response("Sandbox capture amount must match the Training quote amount due now",{status:409});const existing=await db.prepare("SELECT * FROM training_quote_payment_attestations WHERE quote_id=?").bind(input.quoteId).first<Row>();if(existing){if(String(existing.bound_payment_key)!==paymentKey||Number(existing.amount)!==Number(input.amount))throw new Response("PAYMENT_CAPTURE_REPLAY",{status:403});return{quoteId:input.quoteId,status:"captured" as const,amount:Number(existing.amount),currency:String(existing.currency),environment:"sandbox" as const,reference:String(existing.reference),duplicatePrevented:true};}const now=Date.now(),reference=`TRN-UAT-PAY-${crypto.randomUUID().slice(0,12).toUpperCase()}`;await db.prepare("INSERT INTO training_quote_payment_attestations (quote_id,status,amount,currency,environment,reference,bound_payment_key,created_at,updated_at) VALUES (?,'captured',?,'INR','sandbox',?,?,?,?)").bind(input.quoteId,input.amount,reference,paymentKey,now,now).run();return{quoteId:input.quoteId,status:"captured" as const,amount:input.amount,currency:"INR",environment:"sandbox" as const,reference,duplicatePrevented:false};}

export async function requireTrainingQuoteSandboxCapture(db:D1Database,input:{quoteId:string;amount:number}){await ensureTrainingCommercialTables(db);const row=await db.prepare("SELECT * FROM training_quote_payment_attestations WHERE quote_id=?").bind(input.quoteId).first<Row>();if(!row||String(row.status)!=="captured")throw new Response("Training quote requires server-confirmed sandbox capture before programme booking",{status:409});if(String(row.environment)!=="sandbox"||Number(row.amount)!==Number(input.amount))throw new Response("Training sandbox capture does not match the governed quote amount",{status:409});return{status:"captured" as const,reference:String(row.reference),environment:"sandbox" as const};}

export async function governTrainingBooking(db:D1Database,input:{quoteId:string;packageCode:string;packageName:string;petCount:number;scheduledStart:string;submittedTotal:number;submittedAmountDueNow:number;paymentMode:string;paymentStatus:string;reservationCount:number}){await ensureTrainingCommercialTables(db);const linked=await db.prepare("SELECT booking_id FROM training_booking_quote_links WHERE quote_id=?").bind(input.quoteId).first<Row>();if(linked)throw new Response("Training quote is already linked to a booking",{status:409});const quote=await db.prepare("SELECT q.*,p.name,p.meet_and_greet FROM training_commercial_quotes q JOIN training_commercial_packages p ON p.package_code=q.package_code AND p.version=q.package_version WHERE q.id=?").bind(input.quoteId).first<Row>();if(!quote)throw new Response("A valid server Training quote is required",{status:409});if(String(quote.status)!=="open")throw new Response("Training quote has already been used",{status:409});if(Number(quote.expires_at)<Date.now())throw new Response("Training quote expired; refresh price and availability",{status:409});if(String(quote.package_code)!==input.packageCode||String(quote.name)!==input.packageName)throw new Response("Training package does not match the server quote",{status:409});if(Number(quote.pet_count)!==input.petCount)throw new Response("Training pet count changed after quote",{status:409});if(!sameInstant(quote.scheduled_start,input.scheduledStart))throw new Response("Training schedule changed after quote",{status:409});if(Number(quote.total_amount)!==input.submittedTotal||Number(quote.amount_due_now)!==input.submittedAmountDueNow)throw new Response("Training amount does not match the server quote",{status:409});if(String(quote.payment_mode)!==input.paymentMode)throw new Response("Training payment mode does not match the server quote",{status:409});const meet=Number(quote.meet_and_greet)===1;if(meet){if(!["created","authorised","captured"].includes(input.paymentStatus))throw new Response("Meet & Greet payment state is invalid",{status:409});if(input.reservationCount!==1)throw new Response("Trainer Meet & Greet requires exactly one reservation",{status:409});}else{if(input.paymentStatus!=="captured")throw new Response("Training payment must be captured in sandbox before confirmation",{status:409});await requireTrainingQuoteSandboxCapture(db,{quoteId:input.quoteId,amount:Number(quote.amount_due_now)});if(input.reservationCount!==Number(quote.sessions))throw new Response(`Training programme requires exactly ${Number(quote.sessions)} reserved sessions`,{status:409});}return{quoteId:String(quote.id),packageCode:String(quote.package_code),packageName:String(quote.name),catalogueVersion:`training-v${Number(quote.package_version)}`,petCount:Number(quote.pet_count),sessions:Number(quote.sessions),validityDays:Number(quote.validity_days),minutesPerSession:Number(quote.minutes_per_session),totalAmount:Number(quote.total_amount),amountDueNow:Number(quote.amount_due_now),discount:Number(quote.discount),paymentMode:String(quote.payment_mode),meetAndGreet:meet,couponCode:quote.coupon_code?String(quote.coupon_code):undefined};}

export function trainingQuoteLinkStatement(db:D1Database,quoteId:string,bookingId:string){return db.prepare("INSERT INTO training_booking_quote_links (quote_id,booking_id,created_at) VALUES (?,?,?)").bind(quoteId,bookingId,Date.now());}
export async function consumeTrainingQuote(db:D1Database,quoteId:string,bookingId:string){const result=await db.prepare("UPDATE training_commercial_quotes SET status='used',used_at=?,used_booking_id=? WHERE id=? AND status='open'").bind(Date.now(),bookingId,quoteId).run();if(Number(result.meta.changes||0)!==1)throw new Response("Training quote could not be consumed exactly once",{status:409});}

export async function listTrainingPackages(db:D1Database,at=new Date().toISOString()){await ensureTrainingCommercialTables(db);const rows=await db.prepare("SELECT package_code,name,sessions,validity_days,base_price,currency,meet_and_greet,max_pets,direct_minutes_per_pet,coaching_minutes_per_pet,split_due_percent,version FROM training_commercial_packages WHERE active=1 AND effective_from<=? AND (effective_to IS NULL OR effective_to>=?) ORDER BY meet_and_greet DESC,sessions,base_price").bind(at.slice(0,10),at.slice(0,10)).all<Row>();return rows.results;}
