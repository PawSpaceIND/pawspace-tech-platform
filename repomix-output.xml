export async function qualifyReferralClaim(db:Db,input:{claimId:string;bookingId:string;idempotencyKey:string;actorId:string}){await ensureReferralTables(db);if(!input.claimId||!input.bookingId||!input.idempotencyKey)throw new Error("Referral claim, booking and idempotency key are required");const existingReward=await db.prepare("SELECT * FROM referral_rewards WHERE claim_id=?").bind(input.claimId).first<Row>();if(existingReward)return{reward:existingReward,duplicatePrevented:true};const claim=await db.prepare("SELECT * FROM referral_claims WHERE id=?").bind(input.claimId).first<Row>();if(!claim)throw new Error("Referral claim not found");if(String(claim.status)==="rejected")throw new Error("Referral claim was rejected");const booking=await db.prepare("SELECT id,customer_id,status,service_code,city_id,total_amount,created_at FROM canonical_bookings WHERE id=?").bind(input.bookingId).first<Row>();if(!booking||String(booking.customer_id)!==String(claim.referred_customer_id))throw new Error("Canonical booking does not belong to the referred customer");const first=await db.prepare("SELECT id FROM canonical_bookings WHERE customer_id=? ORDER BY created_at ASC,id ASC LIMIT 1").bind(claim.referred_customer_id).first<Row>();if(!first||String(first.id)!==input.bookingId)throw new Error("Referral qualification requires the referred customer's first canonical booking");if(String(booking.service_code)!==String(claim.service_code)||String(booking.city_id)!==String(claim.city_id))throw new Error("Referral claim does not match the qualifying booking service/city");if(String(booking.status)!=="completed")return{qualified:false,status:"pending_completion",reason:"Qualifying booking is not completed"};const payment=await db.prepare("SELECT status,amount FROM booking_payments WHERE booking_id=?").bind(input.bookingId).first<Row>();if(!payment||!["captured","paid","settled"].includes(String(payment.status)))return{qualified:false,status:"pending_payment",reason:"Qualifying booking is n