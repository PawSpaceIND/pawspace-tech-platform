type Db=D1Database;type Row=Record<string,unknown>;
const text=(v:unknown)=>String(v??"").trim();
const slot=(asOf:number)=>Math.floor(asOf/300000)*300000;
const dayKey=(value:number)=>new Date(value).toISOString().slice(0,10);
const istHour=(value:number)=>Number(new Intl.DateTimeFormat("en-GB",{timeZone:"Asia/Kolkata",hour:"2-digit",hour12:false}).format(new Date(value)));
const uid=(prefix:string)=>`${prefix}-${crypto.randomUUID().slice(0,12).toUpperCase()}`;

