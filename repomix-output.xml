  assert.match(runConfig({ ...GOOD, RELEASE_PREVIEW_D1_ID: GOOD.SHARED_STAGING_D1_ID }).stderr, /^isolated=false$/m);
  assert.match(runConfig({ ...GOOD, SHARED_STAGING_D1_ID: "" }).stderr, /^isolated=false$/m);
