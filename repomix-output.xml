import{ensureTrainingSessionLifecycleTables}from"./training-session-lifecycle";
type Row=Record<string,unknown>;
export type TrainingCompensationRuleInput={cityId:string;providerId?:string;packageCode?:string;rateValue:number;effectiveFrom:string;reason:string;actorId:string};
export type TrainingTaxPolicyInput={cityId:string;taxMode:"inclusive"|"exclusive";taxRate:number;effectiveFrom:string;reason:string;actorId:string};

export async function ensureTrainingFinanceTables(db:D1Database){await ensureTrainingSessionLifecycleTables(db);await db.batch([
 db.prepare("CREATE TABLE IF NOT EXISTS training_tax_policies (city_id TEXT PRIMARY KEY,tax_mode TEXT,tax_rate REAL,status TEXT NOT NULL DEFAULT 'configuration_required',version INTEGER NOT NULL DEFAULT 1,effective_from TEXT,effective_to TEXT,updated_by TEXT NOT NULL,reason TEXT NOT NULL,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS training_finance_invoices (id TEXT PRIMARY KEY,booking_id TEXT NOT NULL UNIQUE,programme_id TEXT NOT NULL,customer_id TEXT NOT NULL,city_id TEXT NOT NULL,currency TEXT NOT NULL DEFAULT 'INR',commercial_total REAL NOT NULL,tax_mode TEXT,tax_rate REAL,taxable_amount REAL,tax_amount REAL,invoice_total REAL,invoice_number TEXT,status TEXT NOT NULL,tax_policy_version INTEGER,payment_status TEXT NOT NULL,created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS training_invoice_sequences (city_id TEXT NOT NULL,financial_year TEXT NOT NULL,next_number INTEGER NOT NULL DEFAULT 0,updated_at INTEGER NOT NULL,PRIMARY KEY(city_id,financial_year))"),
 db.prepare("CREATE TABLE IF NOT EXISTS training_compensation_rules (id TEXT PRIMARY KEY,city_id TEXT NOT NULL,provider_id TEXT,package_code TEXT,rate_type TEXT NOT NULL DEFAULT 'per_completed_session',rate_value REAL NOT NULL,currency TEXT NOT NULL DEFAULT 'INR',status TEXT NOT NULL DEFAULT 'published',version INTEGER NOT NULL DEFAULT 1,effective_from TEXT NOT NULL,effective_to TEXT,updated_by TEXT NOT NULL,reason TEXT NOT NULL,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE INDEX IF NOT EXISTS idx_training_comp_rules_lookup ON training_compensation_rules(city_id,status,effective_from,effective_to)"),
 db.prepare("CREATE TABLE IF NOT EXISTS training_session_earnings (session_id TEXT PRIMARY KEY,programme_id TEXT NOT NULL,booking_id TEXT NOT NULL,provider_id TEXT NOT NULL,city_id TEXT NOT NULL,package_code TEXT NOT NULL,rule_id TEXT,rule_version INTEGER,rate_type TEXT,rate_value REAL,gross_earning REAL,currency TEXT NOT NULL DEFAULT 'INR',status TEXT NOT NULL,hold_reason TEXT,completed_at INTEGER NOT NULL,calculated_at INTEGER NOT NULL,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE INDEX IF NOT EXISTS idx_training_earnings_provider ON training_session_earnings(provider_id,status,updated_at)"),
 db.prepare("CREATE TABLE IF NOT EXISTS training_payout_statements (id TEXT PRIMARY KEY,provider_id TEXT NOT NULL,period_code TEXT NOT NULL,currency TEXT NOT NULL DEFAULT 'INR',earned_amount REAL NOT NULL DEFAULT 0,earned_sessions INTEGER NOT NULL DEFAULT 0,pending_sessions INTEGER NOT NULL DEFAULT 0,held_sessions INTEGER NOT NULL DEFAULT 0,status TEXT NOT NULL,execution_mode TEXT NOT NULL DEFAULT 'sandbox_not_connected',approval_idempotency_key TEXT UNIQUE,approved_by TEXT,approved_at INTEGER,updated_at INTEGER NOT NULL,UNIQUE(provider_id,period_code))"),
 db.prepare("CREATE TABLE IF NOT EXISTS training_finance_events (id TEXT PRIMARY KEY,entity_type TEXT NOT NULL,entity_id TEXT NOT NULL,event_type TEXT NOT NULL,actor_id TEXT NOT NULL,reason TEXT NOT NULL,detail_json TEXT NOT NULL DEFAULT '{}',created_at INTEGER NOT NULL)"),
]);await db.prepare("INSERT OR IGNORE INTO training_tax_policies (city_id,tax_mode,tax_rate,status,version,effective_from,effective_to,updated_by,reason,updated_at) VALUES ('blr',NULL,NULL,'configuration_required',1,NULL,NULL,'system','Tax/GST policy must be explicitly configured before Training invoices are final',?)").bind(Date.now()).run();}
async function financeEvent(db:D1Database,entityType:string,entityId:string,eventType:string,actorId:string,reason:string,detail:unknown){await db.prepare("INSERT INTO training_finance_events (id,entity_type,entity_id,event_type,actor_id,reason,detail_json,created_at) VALUES (?,?,?,?,?,?,?,?)").bind(crypto.randomUUID(),entityType,entityId,eventType,actorId,reason,JSON.stringify(detail),Date.now()).run();}
async function compensationRule(db:D1Database,input:{cityId:string;providerId:string;packageCode:string;at:string}){const rows=await db.prepare("SELECT * FROM training_compensation_rules WHERE city_id=? AND status='published' AND effective_from<=? AND (effective_to IS NULL OR effective_to>=?) AND (provider_id IS NULL OR provider_id=?) AND (package_code IS NULL OR package_code=?) ORDER BY CASE WHEN provider_id=? THEN 0 ELSE 1 END,CASE WHEN package_code=? THEN 0 ELSE 1 END,version DESC LIMIT 1").bind(input.cityId,input.at,input.at,input.providerId,input.packageCode,input.providerId,input.packageCode).all<Row>();return rows.results[0]||null;}
function invoiceAmounts(total:number,policy:Row|null){if(!policy||String(policy.status)!=="published"||policy.tax_rate===null||policy.tax_rate===undefined||!policy.tax_mode)return{status:"blocked_tax_configuration",taxMode:null,taxRate:null,taxable:null,tax:null,invoiceTotal:null};const rate=Number(policy.tax_rate),mode=String(policy.tax_mode);if(mode==="inclusive"){const taxable=Math.round(total/(1+rate/100)*100)/100,tax=Math.round((total-taxable)*100)/100;return{status:"draft_ready_for_number",taxMode:mode,taxRate:rate,taxable,tax,invoiceTotal:total};}const tax=Math.round(total*(rate/100)*100)/100;return{status:"draft_ready_for_number",taxMode:mode,taxRate:rate,taxable:total,tax,invoiceTotal:Math.round((total+tax)*100)/100};}

export async function refreshTrainingFinanceReadModel(db:D1Database){await ensureTrainingFinanceTables(db);const programmes=await db.prepare("SELECT p.*,b.total_amount,b.currency,b.status booking_status,pay.status payment_status,pay.amount_due_now captured_amount FROM training_programmes p JOIN canonical_bookings b ON b.id=p.booking_id LEFT JOIN booking_payments pay ON pay.booking_id=p.booking_id").all<Row>(),now=Date.now();for(const p of programmes.results){const policy=await db.prepare("SELECT * FROM training_tax_policies WHERE city_id=?").bind(p.city_id).first<Row>(),amounts=invoiceAmounts(Number(p.total_amount||0),policy),invoiceId=`TINV-${String(p.booking_id)}`;await db.prepare("INSERT INTO training_finance_invoices (id,booking_id,programme_id,customer_id,city_id,currency,commercial_total,tax_mode,tax_rate,taxable_amount,tax_amount,invoice_total,invoice_number,status,tax_policy_version,payment_status,created_at,updated_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,NULL,?,?,?, ?,?) ON CONFLICT(booking_id) DO UPDATE SET commercial_total=excluded.commercial_total,tax_mode=excluded.tax_mode,tax_rate=excluded.tax_rate,taxable_amount=excluded.taxable_amount,tax_amount=excluded.tax_amount,invoice_total=excluded.invoice_total,status=CASE WHEN training_finance_invoices.invoice_number IS NOT NULL THEN training_finance_invoices.status ELSE excluded.status END,tax_policy_version=excluded.tax_policy_version,payment_status=excluded.payment_status,updated_at=excluded.updated_at").bind(invoiceId,p.booking_id,p.id,p.customer_id,p.city_id,p.currency||"INR",p.total_amount,amounts.taxMode,amounts.taxRate,amounts.taxable,amounts.tax,amounts.invoiceTotal,amounts.status,policy?.version??null,p.payment_status??"unknown",now,now).run();const sessions=await db.prepare("SELECT * FROM training_sessions WHERE programme_id=? AND status='completed' ORDER BY COALESCE(completed_at,updated_at),sequence_no").bind(p.id).all<Row>();for(const [sessionIndex,session] of sessions.results.entries()){const completedAt=Number(session.completed_at||session.updated_at||now),at=new Date(completedAt).toISOString().slice(0,10),rule=await compensationRule(db,{cityId:String(p.city_id),providerId:String(session.provider_id),packageCode:String(p.plan_code),at});let status="pending_rate_configuration",gross:null|number=null,hold:string|null="No published trainer compensation rule matches this completed session";if(rule){gross=Math.round(Number(rule.rate_value)*100)/100;const captured=String(p.payment_status)==="captured"?Number(p.captured_amount||0):0,perSession=Number(p.total_sessions)>0?Number(p.total_amount||0)/Number(p.total_sessions):Number(p.total_amount||0),requiredCoverage=Math.round(perSession*(sessionIndex+1)*100)/100;status=captured+0.01>=requiredCoverage?"earned":"held_payment";hold=status==="earned"?null:`Captured customer money INR ${captured.toFixed(2)} does not yet cover delivered Training value INR ${requiredCoverage.toFixed(2)}`;}await db.prepare("INSERT INTO training_session_earnings (session_id,programme_id,booking_id,provider_id,city_id,package_code,rule_id,rule_version,rate_type,rate_value,gross_earning,currency,status,hold_reason,completed_at,calculated_at,updated_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?) ON CONFLICT(session_id) DO UPDATE SET provider_id=excluded.provider_id,rule_id=excluded.rule_id,rule_version=excluded.rule_version,rate_type=excluded.rate_type,rate_value=excluded.rate_value,gross_earning=excluded.gross_earning,status=excluded.status,hold_reason=excluded.hold_reason,calculated_at=excluded.calculated_at,updated_at=excluded.updated_at").bind(session.id,p.id,p.booking_id,session.provider_id,p.city_id,p.plan_code,rule?.id??null,rule?.version??null,rule?.rate_type??null,rule?.rate_value??null,gross,p.currency||"INR",status,hold,completedAt,now,now).run();}}
 const providers=await db.prepare("SELECT DISTINCT provider_id FROM training_session_earnings").all<{provider_id:string}>();for(const item of providers.results){const periods=await db.prepare("SELECT DISTINCT substr(datetime(completed_at/1000,'unixepoch'),1,7) period_code FROM training_session_earnings WHERE provider_id=?").bind(item.provider_id).all<{period_code:string}>();for(const period of periods.results){const start=`${period.period_code}-01`,end=new Date(Date.UTC(Number(period.period_code.slice(0,4)),Number(period.period_code.slice(5,7)),1)).toISOString().slice(0,10),rows=await db.prepare("SELECT status,gross_earning FROM training_session_earnings WHERE provider_id=? AND completed_at>=? AND completed_at<?").bind(item.provider_id,Date.parse(`${start}T00:00:00Z`),Date.parse(`${end}T00:00:00Z`)).all<Row>();const earned=rows.results.filter(row=>String(row.status)==="earned"),pending=rows.results.filter(row=>String(row.status)==="pending_rate_configuration").length,held=rows.results.filter(row=>String(row.status).startsWith("held")).length,amount=Math.round(earned.reduce((sum,row)=>sum+Number(row.gross_earning||0),0)*100)/100,status=pending||held?"blocked":"ready_for_finance_approval",id=`TPAY-${item.provider_id}-${period.period_code}`;await db.prepare("INSERT INTO training_payout_statements (id,provider_id,period_code,currency,earned_amount,earned_sessions,pending_sessions,held_sessions,status,execution_mode,updated_at) VALUES (?,?,?,?,?,?,?,?,?,'sandbox_not_connected',?) ON CONFLICT(provider_id,period_code) DO UPDATE SET earned_amount=excluded.earned_amount,earned_sessions=excluded.earned_sessions,pending_sessions=excluded.pending_sessions,held_sessions=excluded.held_sessions,status=CASE WHEN training_payout_statements.status='instruction_ready_sandbox' THEN training_payout_statements.status ELSE excluded.status END,updated_at=excluded.updated_at").bind(id,item.provider_id,period.period_code,"INR",amount,earned.length,pending,held,status,now).run();}}
 return{programmeCount:programmes.results.length,refreshedAt:now};}

export async function listTrainingFinance(db:D1Database){await refreshTrainingFinanceReadModel(db);const[invoices,earnings,payouts,policies,rules,events]=await Promise.all([db.prepare("SELECT * FROM training_finance_invoices ORDER BY updated_at DESC LIMIT 150").all<Row>(),db.prepare("SELECT * FROM training_session_earnings ORDER BY updated_at DESC LIMIT 300").all<Row>(),db.prepare("SELECT * FROM training_payout_statements ORDER BY period_code DESC,provider_id").all<Row>(),db.prepare("SELECT * FROM training_tax_policies ORDER BY city_id").all<Row>(),db.prepare("SELECT * FROM training_compensation_rules ORDER BY updated_at DESC LIMIT 100").all<Row>(),db.prepare("SELECT * FROM training_finance_events ORDER BY created_at DESC LIMIT 100").all<Row>()]);return{invoices:invoices.results,earnings:earnings.results,payouts:payouts.results,taxPolicies:policies.results,compensationRules:rules.results,events:events.results,livePayout:false,executionMode:"sandbox_not_connected"};}
export async function listTrainerEarnings(db:D1Database,providerId:string){await refreshTrainingFinanceReadModel(db);const[earnings,payouts]=await Promise.all([db.prepare("SELECT * FROM training_session_earnings WHERE provider_id=? ORDER BY completed_at DESC LIMIT 150").bind(providerId).all<Row>(),db.prepare("SELECT * FROM training_payout_statements WHERE provider_id=? ORDER BY period_code DESC").bind(providerId).all<Row>()]);return{providerId,earnings:earnings.results,payouts:payouts.results,livePayout:false,executionMode:"sandbox_not_connected"};}

export async function saveTrainingCompensationRule(db:D1Database,input:TrainingCompensationRuleInput){await ensureTrainingFinanceTables(db);if(!input.cityId||!input.effectiveFrom||!Number.isFinite(input.rateValue)||input.rateValue<=0||input.reason.trim().length<8)throw new Response("City, positive per-session rate, effective date and clear reason are required",{status:400});const id=`TCR-${crypto.randomUUID().slice(0,12).toUpperCase()}`,now=Date.now();await db.prepare("INSERT INTO training_compensation_rules (id,city_id,provider_id,package_code,rate_type,rate_value,currency,status,version,effective_from,effective_to,updated_by,reason,updated_at) VALUES (?,?,?,?,'per_completed_session',?,'INR','published',1,?,NULL,?,?,?)").bind(id,input.cityId,input.providerId??null,input.packageCode??null,input.rateValue,input.effectiveFrom,input.actorId,input.reason,now).run();await financeEvent(db,"compensation_rule",id,"published",input.actorId,input.reason,{cityId:input.cityId,providerId:input.providerId??null,packageCode:input.packageCode??null,rateValue:input.rateValue});await refreshTrainingFinanceReadModel(db);return{id,status:"published",rateType:"per_completed_session",rateValue:input.rateValue};}
export async function saveTrainingTaxPolicy(db:D1Database,input:TrainingTaxPolicyInput){await ensureTrainingFinanceTables(db);if(!input.cityId||!input.effectiveFrom||!["inclusive","exclusive"].includes(input.taxMode)||!Number.isFinite(input.taxRate)||input.taxRate<0||input.taxRate>40||input.reason.trim().length<8)throw new Response("City, inclusive/exclusive tax mode, 0-40% tax rate, effective date and clear reason are required",{status:400});const current=await db.prepare("SELECT version FROM training_tax_policies WHERE city_id=?").bind(input.cityId).first<{version:number}>(),version=Number(current?.version||0)+1,now=Date.now();await db.prepare("INSERT INTO training_tax_policies (city_id,tax_mode,tax_rate,status,version,effective_from,effective_to,updated_by,reason,updated_at) VALUES (?,?,?,'published',?,?,NULL,?,?,?) ON CONFLICT(city_id) DO UPDATE SET tax_mode=excluded.tax_mode,tax_rate=excluded.tax_rate,status='published',version=excluded.version,effective_from=excluded.effective_from,effective_to=NULL,updated_by=excluded.updated_by,reason=excluded.reason,updated_at=excluded.updated_at").bind(input.cityId,input.taxMode,input.taxRate,version,input.effectiveFrom,input.actorId,input.reason,now).run();await financeEvent(db,"tax_policy",input.cityId,"published",input.actorId,input.reason,{taxMode:input.taxMode,taxRate:input.taxRate,version});await refreshTrainingFinanceReadModel(db);return{cityId:input.cityId,status:"published",version,taxMode:input.taxMode,taxRate:input.taxRate};}
export async function issueTrainingInvoice(db:D1Database,input:{bookingId:string;reason:string;actorId:string}){await refreshTrainingFinanceReadModel(db);if(!input.bookingId||input.reason.trim().length<8)throw new Response("Booking and clear invoice issue reason are required",{status:400});const existing=await db.prepare("SELECT * FROM training_finance_invoices WHERE booking_id=?").bind(input.bookingId).first<Row>();if(!existing)throw new Response("Training invoice draft not found",{status:404});if(existing.invoice_number)return{bookingId:input.bookingId,invoiceNumber:String(existing.invoice_number),status:String(existing.status),duplicatePrevented:true,liveTaxFiling:false};if(String(existing.status)!=="draft_ready_for_number")throw new Response("Training invoice is blocked until a published tax policy produces a valid draft",{status:409});if(String(existing.payment_status)!=="captured")throw new Response("Training invoice cannot be issued until the sandbox payment is captured",{status:409});const now=Date.now(),date=new Date(now),year=date.getUTCMonth()>=3?date.getUTCFullYear():date.getUTCFullYear()-1,financialYear=`${String(year).slice(-2)}-${String(year+1).slice(-2)}`,cityId=String(existing.city_id),cityCode=cityId.toUpperCase();await db.prepare("INSERT OR IGNORE INTO training_invoice_sequences (city_id,financial_year,next_number,updated_at) VALUES (?,?,0,?)").bind(cityId,financialYear,now).run();const sequence=await db.prepare("UPDATE training_invoice_sequences SET next_number=next_number+1,updated_at=? WHERE city_id=? AND financial_year=? RETURNING next_number").bind(now,cityId,financialYear).first<{next_number:number}>();if(!sequence)throw new Response("Training invoice sequence could not be reserved",{status:409});const invoiceNumber=`TRN-${cityCode}-${financialYear}-${String(sequence.next_number).padStart(6,"0")}`,result=await db.prepare("UPDATE training_finance_invoices SET invoice_number=?,status='issued_uat',updated_at=? WHERE booking_id=? AND invoice_number IS NULL AND status='draft_ready_for_number' AND payment_status='captured'").bind(invoiceNumber,now,input.bookingId).run();if(Number(result.meta.changes||0)!==1){const raced=await db.prepare("SELECT invoice_number,status FROM training_finance_invoices WHERE booking_id=?").bind(input.bookingId).first<Row>();if(raced?.invoice_number)return{bookingId:input.bookingId,invoiceNumber:String(raced.invoice_number),status:String(raced.status),duplicatePrevented:true,liveTaxFiling:false};throw new Response("Training invoice could not be issued",{status:409});}await financeEvent(db,"training_invoice",input.bookingId,"issued_uat",input.actorId,input.reason,{invoiceNumber,financialYear,liveTaxFiling:false});return{bookingId:input.bookingId,invoiceNumber,status:"issued_uat",duplicatePrevented:false,liveTaxFiling:false};}
export async function approveTrainingPayout(db:D1Database,input:{providerId:string;periodCode:string;idempotencyKey:string;reason:string;actorId:string}){await refreshTrainingFinanceReadModel(db);if(!input.providerId||!/^[0-9]{4}-[0-9]{2}$/.test(input.periodCode)||!input.idempotencyKey||input.reason.trim().length<8)throw new Response("Provider, period, idempotency key and clear reason are required",{status:400});const prior=await db.prepare("SELECT * FROM training_payout_statements WHERE approval_idempotency_key=?").bind(input.idempotencyKey).first<Row>();if(prior)return{...prior,duplicatePrevented:true};const row=await db.prepare("SELECT * FROM training_payout_statements WHERE provider_id=? AND period_code=?").bind(input.providerId,input.periodCode).first<Row>();if(!row)throw new Response("Training payout statement not found",{status:404});if(String(row.status)!=="ready_for_finance_approval")throw new Response("Training payout is blocked by pending/held sessions or is already approved",{status:409});const now=Date.now();await db.prepare("UPDATE training_payout_statements SET status='instruction_ready_sandbox',execution_mode='sandbox_not_connected',approval_idempotency_key=?,approved_by=?,approved_at=?,updated_at=? WHERE provider_id=? AND period_code=? AND status='ready_for_finance_approval'").bind(input.idempotencyKey,input.actorId,now,now,input.providerId,input.periodCode).run();await financeEvent(db,"payout_statement",String(row.id),"instruction_ready_sandbox",input.actorId,input.reason,{providerId:input.providerId,periodCode:input.periodCode,amount:row.earned_amount,livePayout:false});return{providerId:input.providerId,periodCode:input.periodCode,status:"instruction_ready_sandbox",amount:Number(row.earned_amount||0),livePayout:false,duplicatePrevented:false};}
