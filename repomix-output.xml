import {authError,authorize,database,securityAudit} from "../../../lib/server-auth";
import {POST as schedulingPost} from "../uat-scheduling/route";
import {POST as canonicalBookingPost} from "../canonical-bookings/route";
import {POST as trainingCommercialPost} from "../training-commercial/route";
import {POST as boardingCommercialPost} from "../boarding-commercial/route";
import {POST as sittingCommercialPost} from "../sitting-commercial/route";
import {POST as sittingPaymentPost} from "../sitting-payment-sandbox/route";
import {POST as sittingBookingPost} from "../sitting-bookings/route";
import {POST as bookingOperationsPost} from "../booking-operations/route";
import {activateRevenueMission,backfillRevenueMissionFromCanonicalSources,closeRevenueMission,saveRevenueMission} from "../../../lib/revenue-mission-control";

type Row=Record<string,unknown>;
type Handler=(request:Request)=>Promise<Response>;
type ServiceCode="grooming"|"dog_training"|"boarding"|"pet_sitting";
type Provider={id:string;name:string;model:"full_time"|"commission"};
type SwarmState={providers:Partial<Record<ServiceCode,Provider>>;duplicatePass:number;refundCases:number;delayCases:number;processed:number};
type Assertion={name:string;pass:boolean;severity:"blocker"|"warning";detail:string};

const VERSION="layer2-live-swarm-v1";
const CONFIRM="RUN_LAYER_2_UAT_SWARM";
const SERVICES:ServiceCode[]=["grooming","dog_training","boarding","pet_sitting"];
const PER_SERVICE=15;
const TOTAL=SERVICES.length*PER_SERVICE;
const json=(value:unknown,status=200)=>Response.json(value,{status,headers:{"cache-control":"no-store"}});
const text=(value:unknown)=>String(value??"").trim();
const num=(value:unknown)=>Number(value||0);
const parseJson=<T>(value:unknown,fallback:T):T=>{try{return JSON.parse(String(value??"")) as T;}catch{return fallback;}};

async function ensureTables(db:D1Database){await db.batch([
 db.prepare("CREATE TABLE IF NOT EXISTS prelaunch_swarm_runs (id TEXT PRIMARY KEY,version TEXT NOT NULL,status TEXT NOT NULL,total INTEGER NOT NULL,next_index INTEGER NOT NULL DEFAULT 0,state_json TEXT NOT NULL DEFAULT '{}',requested_by TEXT NOT NULL,started_at INTEGER NOT NULL,updated_at INTEGER NOT NULL,completed_at INTEGER,summary_json TEXT,error_json TEXT)"),
 db.prepare("CREATE INDEX IF NOT EXISTS prelaunch_swarm_runs_status_idx ON prelaunch_swarm_runs(status,updated_at)"),
]);}

function forwardedHeaders(parent:Request,originOverride?:string){const headers=new Headers(parent.headers);headers.set("content-type","application/json");headers.set("origin",originOverride??new URL(parent.url).origin);return headers;}
async function callPost(handler:Handler,parent:Request,path:string,body:unknown){const url=new URL(path,parent.url);const response=await handler(new Request(url,{method:"POST",headers:forwardedHeaders(parent),body:JSON.stringify(body)}));const payload=await response.json().catch(()=>({error:`HTTP ${response.status}`})) as Row;if(!response.ok)throw new Error(`${path} ${response.status}: ${text(payload.error)||"request failed"}`);return payload;}
async function expectStatus(handler:Handler,parent:Request,path:string,body:unknown,status:number,originOverride?:string){const response=await handler(new Request(new URL(path,parent.url),{method:"POST",headers:forwardedHeaders(parent,originOverride),body:JSON.stringify(body)}));return response.status===status;}
function data(payload:Row){return (payload.data&&typeof payload.data==="object"?payload.data:{}) as Row;}

function windowFor(service:ServiceCode,slot:number){const date=new Date(Date.now()+(10+slot*2)*86_400_000);const hour=service==="grooming"?9:service==="dog_training"?11:service==="boarding"?13:16;date.setUTCHours(hour,0,0,0);const start=date.toISOString();const durationHours=service==="boarding"?3:1;const end=new Date(date.getTime()+durationHours*3_600_000).toISOString();return{start,end};}
function serviceAt(index:number){const service=SERVICES[Math.floor(index/PER_SERVICE)],slot=index%PER_SERVICE;return{service,slot};}
function providerShape(value:unknown):Provider{const row=(value&&typeof value==="object"?value:{}) as Row;const id=text(row.id||row.providerId),name=text(row.name)||id,model=text(row.model||row.provider_model)==="commission"?"commission":"full_time";if(!id)throw new Error("Scheduling did not return a provider");return{id,name,model};}

async function directAssignment(db:D1Database,input:{groupId:string;service:ServiceCode;customerId:string;petId:string;start:string;end:string;provider:Provider}){const now=Date.now(),request={clientRequestId:input.groupId,customerId:input.customerId,petIds:[input.petId],serviceCode:input.service,zoneId:"blr-east",scheduledStart:input.start,scheduledEnd:input.end,occurrences:1,careMode:input.service==="pet_sitting"?"visit":undefined};await db.batch([
 db.prepare("INSERT INTO scheduling_assignment_decisions (group_id,strategy,shortlist_json,selected_provider_id,status,actor_id,reason,updated_at) VALUES (?,'auto',?,?,'assigned','layer2_swarm','Layer 2 deterministic assignment',?) ON CONFLICT(group_id) DO NOTHING").bind(input.groupId,JSON.stringify({request,choices:[{provider:input.provider}]}),input.provider.id,now),
 db.prepare("INSERT OR IGNORE INTO scheduling_reservations (id,group_id,provider_id,service_code,city_id,zone_id,customer_id,pet_ids_json,scheduled_start,scheduled_end,capacity_units,occurrence_number,care_mode,status,explanation_json,created_at) VALUES (?,?,?,?,?,?,?,?,?,?,1,1,?,'assigned',?,?)").bind(`L2RES-${input.groupId}`,input.groupId,input.provider.id,input.service,"blr","blr-east",input.customerId,JSON.stringify([input.petId]),input.start,input.end,input.service==="pet_sitting"?"visit":null,JSON.stringify({source:"layer2_swarm"}),now),
]);}

async function ensureProvider(db:D1Database,parent:Request,state:SwarmState,input:{service:ServiceCode;groupId:string;customerId:string;petId:string;start:string;end:string}){const cached=state.providers[input.service];if(cached){await directAssignment(db,{...input,provider:cached});return cached;}const payload=await callPost(schedulingPost,parent,"/api/uat-scheduling",{clientRequestId:input.groupId,customerId:input.customerId,petIds:[input.petId],serviceCode:input.service,zoneId:"blr-east",scheduledStart:input.start,scheduledEnd:input.end,occurrences:1,careMode:input.service==="pet_sitting"?"visit":undefined,assignmentStrategy:"auto"});const provider=providerShape(data(payload).provider);state.providers[input.service]=provider;return provider;}

async function existingBooking(db:D1Database,idempotencyKey:string){return db.prepare("SELECT id,customer_id,provider_id,service_code,total_amount,status FROM canonical_bookings WHERE idempotency_key=?").bind(idempotencyKey).first<Row>();}

async function runOperations(parent:Request,state:SwarmState,input:{bookingId:string;providerId:string;slot:number;runId:string;index:number}){if(input.slot%5===1){await callPost(bookingOperationsPost,parent,"/api/booking-operations",{bookingId:input.bookingId,providerId:input.providerId,action:"running_late",reason:"Layer 2 controlled SLA delay injection",impactMinutes:45});state.delayCases++;}
 if(input.slot%7===2){const requested=data(await callPost(bookingOperationsPost,parent,"/api/booking-operations",{bookingId:input.bookingId,providerId:input.providerId,action:"refund_requested",reason:"Layer 2 controlled full refund test"}));const refundCaseId=text(requested.refundCaseId);if(!refundCaseId)throw new Error("Refund request did not return a case ID");for(const status of ["approved","processing","completed"] as const)await callPost(bookingOperationsPost,parent,"/api/booking-operations",{bookingId:input.bookingId,providerId:input.providerId,action:"refund_status",reason:`Layer 2 refund transition ${status}`,refundCaseId,refundStatus:status,gatewayReference:status==="completed"?`L2-SANDBOX-${input.runId}-${input.index}`:undefined});state.refundCases++;}}

async function createItem(db:D1Database,parent:Request,runId:string,index:number,state:SwarmState){const{service,slot}=serviceAt(index),customerId=`L2-${runId}-CUST-${service}-${String(slot+1).padStart(2,"0")}`,sourcePetId=`L2PET-${service}-${slot+1}`,groupId=`L2-${runId}-GRP-${service}-${String(slot+1).padStart(2,"0")}`,idempotencyKey=`l2:${runId}:${service}:${slot+1}`;const prior=await existingBooking(db,idempotencyKey);if(prior){state.processed++;return{bookingId:text(prior.id),service,resumed:true};}
 const{start,end}=windowFor(service,slot),provider=await ensureProvider(db,parent,state,{service,groupId,customerId,petId:sourcePetId,start,end});const customer={id:customerId,name:`Layer 2 ${service} ${slot+1}`,primaryPhone:`+919900${String(index).padStart(6,"0")}`,email:`layer2-${runId}-${index}@example.invalid`},pets=[{sourceId:sourcePetId,name:`Test Pet ${slot+1}`,species:"dog",breed:"UAT",vaccinationStatus:"verified"}],payment={method:"uat_sandbox",mode:"prepaid",status:"captured",detail:"Layer 2 synthetic sandbox capture; no live money"};let bookingPayload:Row;let requestBody:Row;
 if(service==="grooming"){requestBody={idempotencyKey,scheduleGroupId:groupId,customer,pets,cityId:"blr",zoneId:"blr-east",serviceCode:service,packageCode:"dog-bath",packageName:"Essential Bath",scheduledStart:start,scheduledEnd:end,provider,totalAmount:1349,amountDueNow:1349,payment,pricing:{discount:0}};bookingPayload=await callPost(canonicalBookingPost,parent,"/api/canonical-bookings",requestBody);const replay=data(await callPost(canonicalBookingPost,parent,"/api/canonical-bookings",requestBody));if(replay.duplicatePrevented!==true)throw new Error(`Duplicate replay was not prevented for ${idempotencyKey}`);state.duplicatePass++;}
 else if(service==="dog_training"){const quote=data(await callPost(trainingCommercialPost,parent,"/api/training-commercial",{packageCode:"trainer-meet-greet",petCount:1,scheduledStart:start,paymentMode:"prepaid"}));requestBody={idempotencyKey,scheduleGroupId:groupId,customer,pets,cityId:"blr",zoneId:"blr-east",serviceCode:service,packageCode:text(quote.packageCode),packageName:text(quote.packageName),scheduledStart:start,scheduledEnd:end,provider,totalAmount:num(quote.totalAmount),amountDueNow:num(quote.amountDueNow),payment,pricing:{discount:num(quote.discount),trainingQuoteId:text(quote.quoteId)}};bookingPayload=await callPost(canonicalBookingPost,parent,"/api/canonical-bookings",requestBody);const replay=data(await callPost(canonicalBookingPost,parent,"/api/canonical-bookings",requestBody));if(replay.duplicatePrevented!==true)throw new Error(`Duplicate replay was not prevented for ${idempotencyKey}`);state.duplicatePass++;}
 else if(service==="boarding"){const quote=data(await callPost(boardingCommercialPost,parent,"/api/boarding-commercial",{packageCode:"boarding-4h",petCount:1,scheduledStart:start,scheduledEnd:end,paymentMode:"prepaid"}));requestBody={idempotencyKey,scheduleGroupId:groupId,customer,pets,cityId:"blr",zoneId:"blr-east",serviceCode:service,packageCode:text(quote.packageCode),packageName:text(quote.packageName),scheduledStart:start,scheduledEnd:end,provider,totalAmount:num(quote.totalAmount),amountDueNow:num(quote.amountDueNow),payment,pricing:{discount:0,boardingQuoteId:text(quote.quoteId)}};bookingPayload=await callPost(canonicalBookingPost,parent,"/api/canonical-bookings",requestBody);const replay=data(await callPost(canonicalBookingPost,parent,"/api/canonical-bookings",requestBody));if(replay.duplicatePrevented!==true)throw new Error(`Duplicate replay was not prevented for ${idempotencyKey}`);state.duplicatePass++;}
