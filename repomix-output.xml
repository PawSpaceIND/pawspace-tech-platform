<file path="lib/walking-governance.ts">
type Row=Record<string,unknown>;
export type WalkingMode="once"|"recurring";
export type WalkingPaymentMode="pay_after_service";
export type WalkingQuote={quoteId:string;packageCode:string;packageName:string;packageVersion:number;durationMinutes:30|60;mode:WalkingMode;petCount:number;walkCount:number;weekdays:number[];scheduledStart:string;scheduledEnd:string;perWalkAmount:number;totalAmount:number;amountDueNow:0;paymentMode:WalkingPaymentMode;expiresAt:number};

const packages=[
 {code:"walking-30",name:"30-minute Solo Walk",durationMinutes:30,amount:349,maxPets:1},
 {code:"walking-60",name:"60-minute Solo Walk",durationMinutes:60,amount:549,maxPets:1},
] as const;

export async function ensureWalkingGovernanceTables(db:D1Database){const now=Date.now();await db.batch([
 db.prepare("CREATE TABLE IF NOT EXISTS walking_commercial_packages (package_code TEXT PRIMARY KEY,name TEXT NOT NULL,duration_minutes INTEGER NOT NULL,amount_per_walk REAL NOT NULL,currency TEXT NOT NULL DEFAULT 'INR',max_pets INTEGER NOT NULL DEFAULT 1,active INTEGER NOT NULL DEFAULT 1,version INTEGER NOT NULL DEFAULT 1,effective_from TEXT NOT NULL,effective_to TEXT,updated_by TEXT NOT NULL,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS walking_commercial_quotes (id TEXT PRIMARY KEY,package_code TEXT NOT NULL,package_version INTEGER NOT NULL,duration_minutes INTEGER NOT NULL,mode TEXT NOT NULL,pet_count INTEGER NOT NULL,walk_count INTEGER NOT NULL,weekdays_json TEXT NOT NULL DEFAULT '[]',scheduled_start TEXT NOT NULL,scheduled_end TEXT NOT NULL,payment_mode TEXT NOT NULL,total_amount REAL NOT NULL,amount_due_now REAL NOT NULL DEFAULT 0,expires_at INTEGER NOT NULL,status TEXT NOT NULL DEFAULT 'open',created_at INTEGER NOT NULL,used_at INTEGER,used_booking_id TEXT)"),
 db.prepare("CREATE INDEX IF NOT EXISTS idx_walking_quote_expiry ON walking_commercial_quotes(status,expires_at)"),
 db.prepare("CREATE TABLE IF NOT EXISTS walking_booking_quote_links (quote_id TEXT PRIMARY KEY,booking_id TEXT NOT NULL UNIQUE,created_at INTEGER NOT NULL)"),
]);for(const item of packages)await db.prepare("INSERT OR IGNORE INTO walking_commercial_packages (package_code,name,duration_minutes,amount_per_walk,currency,max_pets,active,version,effective_from,effective_to,updated_by,updated_at) VALUES (?,?,?,?,'INR',?,1,1,'2026-08-01',NULL,'founder_seed',?)").bind(item.code,item.name,item.durationMinutes,item.amount,item.maxPets,now).run();}
import{sameInstant}from"./booking-window-instant";
function activePackage(row:Row,at:string){const date=at.slice(0,10);return Number(row.active)===1&&date>=String(row.effective_from)&&(!row.effective_to||date<=String(row.effective_to));}
function validWeekdays(value:number[]){return value.length>0&&value.every(day=>Number.isInteger(day)&&day>=0&&day<=6)&&new Set(value).size===value.length;}

export async function listWalkingPackages(db:D1Database,at=new Date().toISOString()){await ensureWalkingGovernanceTables(db);const date=at.slice(0,10);const rows=await db.prepare("SELECT package_code,name,duration_minutes,amount_per_walk,currency,max_pets,version FROM walking_commercial_packages WHERE active=1 AND effective_from<=? AND (effective_to IS NULL OR effective_to>=?) ORDER BY duration_minutes").bind(date,date).all<Row>();return rows.results;}

export async function createWalkingQuote(db:D1Database,input:{packageCode:string;mode:WalkingMode;petCount:number;walkCount:number;weekdays?:number[];scheduledStart:string;scheduledEnd:string;paymentMode:WalkingPaymentMode;couponCode?:string}){await ensureWalkingGovernanceTables(db);if(input.paymentMode!=="pay_after_service")throw new Response("Dog Walking Gate 1 uses pay-after-service UAT billing only",{status:409});if(String(input.couponCode||"").trim())throw new Response("Dog Walking coupon policy is not enabled",{status:409});const row=await db.prepare("SELECT * FROM walking_commercial_packages WHERE package_code=?").bind(input.packageCode).first<Row>();if(!row||!activePackage(row,input.scheduledStart))throw new Response("Active Dog Walking package not found for this date",{status:404});const start=new Date(input.scheduledStart).getTime(),end=new Date(input.scheduledEnd).getTime();if(!Number.isFinite(start)||!Number.isFinite(end)||start<=Date.now()||end<=start)throw new Response("Dog Walking quote requires a valid future walk window",{status:400});const duration=(end-start)/60_000;if(duration!==Number(row.duration_minutes))throw new Response("Dog Walking duration does not match the canonical package",{status:409});const petCount=Math.floor(Number(input.petCount));if(petCount!==1)throw new Response("Dog Walking Gate 1 supports one registered dog per canonical booking",{status:409});const walkCount=Math.floor(Number(input.walkCount));if(input.mode==="once"&&walkCount!==1)throw new Response("One-time Dog Walking requires exactly one walk",{status:409});if(input.mode==="recurring"&&(walkCount<2||walkCount>12))throw new Response("Recurring Dog Walking supports 2-12 reserved walks per UAT booking",{status:409});const weekdays=input.mode==="recurring"?[...(input.weekdays??[])].sort((a,b)=>a-b):[];if(input.mode==="recurring"&&!validWeekdays(weekdays))throw new Response("Recurring Dog Walking requires valid selected weekdays",{status:409});const perWalkAmount=Number(row.amount_per_walk),totalAmount=perWalkAmount*walkCount,now=Date.now(),expiresAt=now+15*60_000,id=`WQ-${crypto.randomUUID().slice(0,12).toUpperCase()}`;await db.prepare("INSERT INTO walking_commercial_quotes (id,package_code,package_version,duration_minutes,mode,pet_count,walk_count,weekdays_json,scheduled_start,scheduled_end,payment_mode,total_amount,amount_due_now,expires_at,status,created_at) VALUES (?,?,?,?,?,?,?,?,?,?,?, ?,0,?,'open',?)").bind(id,row.package_code,row.version,row.duration_minutes,input.mode,petCount,walkCount,JSON.stringify(weekdays),input.scheduledStart,input.scheduledEnd,input.paymentMode,totalAmount,expiresAt,now).run();return{quoteId:id,packageCode:String(row.package_code),packageName:String(row.name),packageVersion:Number(row.version),durationMinutes:Number(row.duration_minutes) as 30|60,mode:input.mode,petCount,walkCount,weekdays,scheduledStart:input.scheduledStart,scheduledEnd:input.scheduledEnd,perWalkAmount,totalAmount,amountDueNow:0 as const,paymentMode:input.paymentMode,expiresAt} satisfies WalkingQuote;}

export async function governWalkingBooking(db:D1Database,input:{quoteId:string;packageCode:string;packageName:string;petCount:number;walkCount:number;weekdays:number[];scheduledStart:string;scheduledEnd:string;submittedTotal:number;submittedAmountDueNow:number;paymentMode:string;reservations:Array<Record<string,unknown>>}){await ensureWalkingGovernanceTables(db);const linked=await db.prepare("SELECT booking_id FROM walking_booking_quote_links WHERE quote_id=?").bind(input.quoteId).first<Row>();if(linked)throw new Response("Dog Walking quote is already linked to a booking",{status:409});const quote=await db.prepare("SELECT q.*,p.name,p.amount_per_walk FROM walking_commercial_quotes q JOIN walking_commercial_packages p ON p.package_code=q.package_code AND p.version=q.package_version WHERE q.id=?").bind(input.quoteId).first<Row>();if(!quote)throw new Response("A valid server Dog Walking quote is required",{status:409});if(String(quote.status)!=="open")throw new Response("Dog Walking quote has already been used",{status:409});if(Number(quote.expires_at)<Date.now())throw new Response("Dog Walking quote expired; refresh price and availability",{status:409});if(String(quote.package_code)!==input.packageCode||String(quote.name)!==input.packageName)throw new Response("Dog Walking package does not match the server quote",{status:409});if(Number(quote.pet_count)!==input.petCount||Number(quote.walk_count)!==input.walkCount)throw new Response("Dog Walking booking shape changed after quote",{status:409});const quotedWeekdays=JSON.parse(String(quote.weekdays_json||"[]")) as number[];if(JSON.stringify([...quotedWeekdays].sort())!==JSON.stringify([...input.weekdays].sort()))throw new Response("Dog Walking weekdays changed after quote",{status:409});if(!sameInstant(String(quote.scheduled_start),input.scheduledStart)||!sameInstant(String(quote.scheduled_end),input.scheduledEnd))throw new Response("Dog Walking first walk window changed after quote",{status:409});if(Number(quote.total_amount)!==input.submittedTotal||Number(quote.amount_due_now)!==input.submittedAmountDueNow)throw new Response("Dog Walking amount does not match the server quote",{status:409});if(String(quote.payment_mode)!==input.paymentMode)throw new Response("Dog Walking payment mode does not match the server quote",{status:409});if(input.reservations.length!==Number(quote.walk_count))throw new Response("Dog Walking reservation count does not match the server quote",{status:409});const providerIds=new Set(input.reservations.map(item=>String(item.provider_id)));if(providerIds.size!==1)throw new Response("All Dog Walking Gate 1 occurrences must use one canonical walker",{status:409});const ordered=[...input.reservations].sort((a,b)=>Number(a.occurrence_number)-Number(b.occurrence_number));if(!sameInstant(String(ordered[0].scheduled_start),String(quote.scheduled_start))||!sameInstant(String(ordered[0].scheduled_end),String(quote.scheduled_end)))throw new Response("First Dog Walking reservation does not match the canonical quote",{status:409});for(const item of ordered){const duration=(new Date(String(item.scheduled_end)).getTime()-new Date(String(item.scheduled_start)).getTime())/60_000;if(duration!==Number(quote.duration_minutes))throw new Response("Dog Walking reservation duration does not match the canonical package",{status:409});}return{quoteId:String(quote.id),packageCode:String(quote.package_code),packageName:String(quote.name),catalogueVersion:`walking-v${Number(quote.package_version)}`,durationMinutes:Number(quote.duration_minutes),mode:String(quote.mode) as WalkingMode,petCount:Number(quote.pet_count),walkCount:Number(quote.walk_count),weekdays:quotedWeekdays,scheduledStart:String(quote.scheduled_start),scheduledEnd:String(quote.scheduled_end),perWalkAmount:Number(quote.amount_per_walk),totalAmount:Number(quote.total_amount),amountDueNow:Number(quote.amount_due_now),paymentMode:String(quote.payment_mode),providerId:String(ordered[0].provider_id),reservations:ordered};}
