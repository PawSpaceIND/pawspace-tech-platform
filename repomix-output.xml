import type{SittingMediaPurpose,SittingProofAction}from"./sitting-proof-governance";
export type SittingProofSnapshot={bookingId:string;providerId:string;customerId:string;status:string;media:Array<Record<string,unknown>>;medications:Array<Record<string,unknown>>;incidents:Array<Record<string,unknown>>;communications:Record<string,unknown>;sandboxOnly:true};
export type SittingProofMutation={bookingId:string;action:SittingProofAction;idempotencyKey:string;purpose?:SittingMediaPurpose;mimeType?:string;sizeBytes?:number;sha256?:string;uploadToken?:string;storageObjectId?:string;mediaRef?:string;scanResult?:"clean"|"rejected";reason?:string;note?:string;medicationName?:string;dose?:string;administeredAt?:string;incidentId?:string;severity?:"attention"|"urgent"|"emergency";summary?:string;actionTaken?:string;resolution?:string};

export async function loadSittingProof(input:{bookingId:string;scope?:"customer"|"provider"}){const query=new URLSearchParams({bookingId:input.bookingId});if(input.scope)query.set("scope",input.scope);const response=await fetch(`/api/sitting-proof?${query}`,{cache:"no-store"});const body=await response.json() as {data?:SittingProofSnapshot;error?:string};if(!response.ok||!body.data)throw new Error(body.error??"Unable to load Sitting proof records");return body.data;}
export async function updateSittingProof(input:SittingProofMutation){const response=await fetch("/api/sitting-proof",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(input)});const body=await response.json() as {data?:Record<string,unknown>;error?:string};if(!response.ok||!body.data)throw new Error(body.error??"Unable to update Sitting proof records");return body.data;}
