<file path="lib/whatsapp-uat-adapter.ts">
import{ensureCommunicationTables,recordDeliveryEvent}from"./communication-engine";
import{ensureLeadWorkItemsTable}from"./lead-conversion-attribution";

type Row=Record<string,unknown>;
export const whatsappUatProviders=["limechat","meta_whatsapp","sandbox_simulator"]as const;
export type WhatsAppUatProvider=(typeof whatsappUatProviders)[number];

const text=(value:unknown)=>String(value??"").trim();
const phone=(value:unknown)=>text(value).replace(/\D/g,"").slice(-10);
const parse=<T>(value:unknown,fallback:T):T=>{try{return JSON.parse(String(value??""))as T}catch{return fallback}};

export async function ensureWhatsAppUatTables(db:D1Database){
 await ensureCommunicationTables(db);
 await db.batch([
  db.prepare("CREATE TABLE IF NOT EXISTS whatsapp_uat_events (id TEXT PRIMARY KEY,provider TEXT NOT NULL,event_id TEXT NOT NULL,event_type TEXT NOT NULL,payload_hash TEXT NOT NULL,customer_id TEXT,message_id TEXT,thread_id TEXT,detail_json TEXT NOT NULL DEFAULT '{}',created_at INTEGER NOT NULL,UNIQUE(provider,event_id))"),
  db.prepare("CREATE TABLE IF NOT EXISTS whatsapp_uat_identity_reviews (id TEXT PRIMARY KEY,provider TEXT NOT NULL,provider_identity TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'unresolved',candidate_customer_ids_json TEXT NOT NULL DEFAULT '[]',detail_json TEXT NOT NULL DEFAULT '{}',created_at INTEGER NOT NULL,resolved_at INTEGER,resolved_by TEXT)"),
  db.prepare("CREATE INDEX IF NOT EXISTS whatsapp_uat_identity_review_idx ON whatsapp_uat_identity_reviews(status,provider,created_at)"),
  db.prepare("CREATE TABLE IF NOT EXISTS whatsapp_uat_sessions (customer_id TEXT NOT NULL,provider TEXT NOT NULL,last_inbound_at INTEGER NOT NULL,last_outbound_at INTEGER,PRIMARY KEY(customer_id,provider))"),
  db.prepare("CREATE TABLE IF NOT EXISTS whatsapp_uat_templates (template_key TEXT PRIMARY KEY,status TEXT NOT NULL,category TEXT NOT NULL,approved_language TEXT NOT NULL,updated_by TEXT NOT NULL,updated_at INTEGER NOT NULL)"),
  db.prepare("CREATE TABLE IF NOT EXISTS whatsapp_uat_provider_controls (provider TEXT PRIMARY KEY,disabled INTEGER NOT NULL DEFAULT 0,reason TEXT NOT NULL DEFAULT '',updated_by TEXT NOT NULL,updated_at INTEGER NOT NULL)"),
 ]);
 for(const provider of whatsappUatProviders)await db.prepare("INSERT OR IGNORE INTO whatsapp_uat_provider_controls (provider,disabled,reason,updated_by,updated_at) VALUES (?,0,'','system',?)").bind(provider,Date.now()).run();
}

async function providerAvailable(db:D1Database,provider:WhatsAppUatProvider){const row=await db.prepare("SELECT disabled,reason FROM whatsapp_uat_provider_controls WHERE provider=?").bind(provider).first<Row>();return{available:Number(row?.disabled||0)!==1,reason:text(row?.reason)||null};}
async function canonicalCustomer(db:D1Database,customerId:string){const customer=await db.prepare("SELECT id FROM canonical_customers WHERE id=?").bind(customerId).first<Row>();if(!customer)throw new Response("Canonical customer not found",{status:404});return text(customer.id);}

export async function resolveWhatsAppUatCustomer(db:D1Database,input:{provider:WhatsAppUatProvider;customerId?:string|null;providerIdentity?:string|null;detail?:Record<string,unknown>}){
 await ensureWhatsAppUatTables(db);
 if(input.customerId){const claimed=await canonicalCustomer(db,text(input.customerId));const sending=phone(input.providerIdentity);if(sending){const claimedRow=await db.prepare("SELECT primary_phone FROM canonical_customers WHERE id=?").bind(claimed).first<Row>();if(phone(claimedRow?.primary_phone)!==sending){const reviewId=`WAID-${crypto.randomUUID().slice(0,12).toUpperCase()}`;await db.prepare("INSERT INTO whatsapp_uat_identity_reviews (id,provider,provider_identity,status,candidate_customer_ids_json,detail_json,created_at) VALUES (?,?,?,'unresolved',?,?,?)").bind(reviewId,input.provider,sending,JSON.stringify([claimed]),JSON.stringify({reason:"claimed_customer_id_contradicts_sending_phone",claimedCustomerId:claimed,...(input.detail||{})}),Date.now()).run();throw new Response("WhatsApp identity requires governed customer resolution",{status:409});}}return{customerId:claimed,identitySource:"canonical_customer_id"as const};}
 const identity=phone(input.providerIdentity);if(!identity)throw new Error("Canonical customerId or provider phone identity is required");const rows=await db.prepare("SELECT id,primary_phone FROM canonical_customers").all<Row>(),matches=rows.results.filter(row=>phone(row.primary_phone)===identity).map(row=>text(row.id));if(matches.length===1)return{customerId:matches[0],identitySource:"verified_phone_match"as const};const id=`WAID-${crypto.randomUUID().slice(0,12).toUpperCase()}`;await db.prepare("INSERT INTO whatsapp_uat_identity_reviews (id,provider,provider_identity,status,candidate_customer_ids_json,detail_json,created_at) VALUES (?,?,?,'unresolved',?,?,?)").bind(id,input.provider,identity,JSON.stringify(matches),JSON.stringify(input.detail??{}),Date.now()).run();throw new Response("WhatsApp identity requires governed customer resolution",{status:409});
}

async function openCustomerThread(db:D1Database,customerId:string){await ensureLeadWorkItemsTable(db);const lead=await db.prepare("SELECT id FROM lead_work_items WHERE customer_id=? AND converted_booking_id IS NULL AND status NOT IN ('closed','converted') ORDER BY assigned_at DESC LIMIT 1").bind(customerId).first<Row>().catch(()=>null),leadId=text(lead?.id)||null;const existing=await db.prepare("SELECT id,lead_id FROM communication_threads WHERE customer_id=? AND booking_id IS NULL AND ticket_id IS NULL AND status='open' ORDER BY CASE WHEN lead_id IS NOT NULL THEN 0 ELSE 1 END,updated_at DESC LIMIT 1").bind(customerId).first<Row>();if(existing){const threadId=text(existing.id);if(!text(existing.lead_id)&&leadId)await db.prepare("UPDATE communication_threads SET lead_id=?,updated_at=? WHERE id=? AND lead_id IS NULL").bind(leadId,Date.now(),threadId).run();return threadId;}const now=Date.now(),threadId=`THREAD-${crypto.randomUUID().slice(0,12).toUpperCase()}`;await db.batch([db.prepare("INSERT INTO communication_threads (id,customer_id,booking_id,lead_id,ticket_id,status,assigned_to,sla_due_at,created_at,updated_at) VALUES (?,?,NULL,?,NULL,'open',NULL,NULL,?,?)").bind(threadId,customerId,leadId,now,now),db.prepare("INSERT OR IGNORE INTO communication_participants (id,thread_id,participant_type,participant_id,display_ref,role,created_at) VALUES (?,?,?,?,?,'customer',?)").bind(crypto.randomUUID(),threadId,"customer",customerId,customerId,now)]);return threadId;}

export async function recordWhatsAppUatInbound(db:D1Database,input:{provider:WhatsAppUatProvider;eventId:string;payloadHash:string;customerId?:string|null;providerIdentity?:string|null;text:string;receivedAt?:number;detail?:Record<string,unknown>}){await ensureWhatsAppUatTables(db);if(!whatsappUatProviders.includes(input.provider))throw new Error("Unsupported WhatsApp UAT provider");const availability=await providerAvailable(db,input.provider);if(!availability.available)throw new Response(`WhatsApp UAT provider disabled${availability.reason?`: ${availability.reason}`:""}`,{status:503});const eventId=text(input.eventId),messageText=text(input.text);if(!eventId||!messageText)throw new Error("Event ID and message text are required");const prior=await db.prepare("SELECT * FROM whatsapp_uat_events WHERE provider=? AND event_id=?").bind(input.provider,eventId).first<Row>();if(prior)return{duplicatePrevented:true as const,event:prior,externalDelivery:false};const identity=await resolveWhatsAppUatCustomer(db,{provider:input.provider,customerId:input.customerId,providerIdentity:input.providerIdentity,detail:input.detail}),customerId=identity.customerId,threadId=await openCustomerThread(db,customerId),now=Number(input.receivedAt||Date.now()),messageId=`MSG-WA-${crypto.randomUUID().slice(0,12).toUpperCase()}`,policy={environment:"uat",provider:input.provider,externalDelivery:false,identitySource:identity.identitySource,signatureRequired:true,sessionWindowHours:24},detail={source:"whatsapp_uat_inbound",provider:input.provider,...(input.detail??{})};const thread=await db.prepare("SELECT lead_id FROM communication_threads WHERE id=?").bind(threadId).first<Row>();const leadId=text(thread?.lead_id)||null;await db.batch([db.prepare("INSERT INTO communication_messages (id,thread_id,customer_id,booking_id,lead_id,ticket_id,direction,channel,purpose,template_key,payload_json,status,provider,provider_reference,idempotency_key,policy_json,created_by,created_at,updated_at) VALUES (?,?,?,NULL,?,NULL,'inbound','whatsapp','transactional','whatsapp_uat_inbound',?,'received',?,?,?,?,'whatsapp_uat_webhook',?,?)").bind(messageId,threadId,customerId,leadId,JSON.stringify({text:messageText,...detail}),input.provider,eventId,`whatsapp-uat:${input.provider}:${eventId}`,JSON.stringify(policy),now,now),db.prepare("INSERT INTO whatsapp_uat_events (id,provider,event_id,event_type,payload_hash,customer_id,message_id,thread_id,detail_json,created_at) VALUES (?,?,?,?,?,?,?,?,?,?)").bind(`WAUAT-${crypto.randomUUID().slice(0,12).toUpperCase()}`,input.provider,eventId,"inbound_message",input.payloadHash,customerId,messageId,threadId,JSON.stringify(detail),now),db.prepare("INSERT INTO whatsapp_uat_sessions (customer_id,provider,last_inbound_at,last_outbound_at) VALUES (?,?,?,NULL) ON CONFLICT(customer_id,provider) DO UPDATE SET last_inbound_at=excluded.last_inbound_at").bind(customerId,input.provider,now),db.prepare("UPDATE communication_threads SET updated_at=? WHERE id=?").bind(now,threadId)]);return{duplicatePrevented:false as const,messageId,threadId,customerId,status:"received",identitySource:identity.identitySource,externalDelivery:false};}

async function whatsappConsent(db:D1Database,customerId:string){const pref=await db.prepare("SELECT whatsapp_consent FROM customer_contact_preferences WHERE customer_id=?").bind(customerId).first<Row>().catch(()=>null);if(pref&&pref.whatsapp_consent!=null)return Number(pref.whatsapp_consent)===1;const customer=await db.prepare("SELECT consent_json FROM canonical_customers WHERE id=?").bind(customerId).first<Row>();const consent=customer?parse<Record<string,unknown>>(customer.consent_json,{}):{};return consent.whatsapp===true||consent.whatsappConsent===true;}
async function marketingConsent(db:D1Database,customerId:string){const pref=await db.prepare("SELECT marketing_consent,opt_out FROM customer_contact_preferences WHERE customer_id=?").bind(customerId).first<Row>().catch(()=>null);return Boolean(pref&&Number(pref.marketing_consent||0)===1&&Number(pref.opt_out||0)!==1);}

export async function queueWhatsAppUatOutbound(db:D1Database,input:{provider:WhatsAppUatProvider;threadId:string;customerId:string;text:string;idempotencyKey:string;createdBy:string;templateKey?:string|null;language?:string|null;now?:number}){
 await ensureWhatsAppUatTables(db);const idempotencyKey=text(input.idempotencyKey);if(!idempotencyKey)throw new Response("WhatsApp outbound idempotency key is required",{status:400});const prior=await db.prepare("SELECT id,status,thread_id,customer_id,channel,provider FROM communication_messages WHERE idempotency_key=?").bind(idempotencyKey).first<Row>();if(prior){if(text(prior.thread_id)!==input.threadId||text(prior.customer_id)!==input.customerId||text(prior.channel)!=="whatsapp"||text(prior.provider)!==input.provider)throw new Response("WhatsApp idempotency key is already bound to another canonical message",{status:409});return{queued:true,duplicatePrevented:true,messageId:text(prior.id),status:text(prior.status),externalDelivery:false};}const availability=await providerAvailable(db,input.provider);if(!availability.available)return{queued:false,staffFallbackRequired:true,reason:"provider_kill_switch",externalDelivery:false};if(!await whatsappConsent(db,input.customerId))return{queued:false,staffFallbackRequired:true,reason:"whatsapp_consent_required",externalDelivery:false};const session=await db.prepare("SELECT last_inbound_at FROM whatsapp_uat_sessions WHERE customer_id=? AND provider=?").bind(input.customerId,input.provider).first<Row>(),now=input.now??Date.now(),withinSession=Boolean(session&&now-Number(session.last_inbound_at||0)<=24*60*60_000),key=text(input.templateKey);let templateCategory:string|null=null;if(key){const template=await db.prepare("SELECT status,approved_language,category FROM whatsapp_uat_templates WHERE template_key=?").bind(key).first<Row>();if(!template||text(template.status)!=="approved"||text(template.approved_language)!==text(input.language||"en"))return{queued:false,staffFallbackRequired:true,reason:"approved_template_required",externalDelivery:false};templateCategory=text(template.category);if(templateCategory==="marketing"&&!await marketingConsent(db,input.customerId))return{queued:false,staffFallbackRequired:true,reason:"marketing_consent_required",externalDelivery:false};}else if(!withinSession)return{queued:false,staffFallbackRequired:true,reason:"approved_template_required_outside_session",externalDelivery:false};
 const thread=await db.prepare("SELECT id FROM communication_threads WHERE id=? AND customer_id=? AND status='open'").bind(input.threadId,input.customerId).first<Row>();if(!thread)throw new Error("Canonical open conversation thread not found");const messageId=`MSG-WA-${crypto.randomUUID().slice(0,12).toUpperCase()}`,purpose=templateCategory==="marketing"?"marketing":"transactional",policy={environment:"uat",provider:input.provider,externalDelivery:false,sessionWindowHours:24,withinSession,templateKey:key||null,templateCategory,consentVerified:true,marketingConsentVerified:templateCategory==="marketing"};await db.batch([db.prepare("INSERT INTO communication_messages (id,thread_id,customer_id,booking_id,lead_id,ticket_id,direction,channel,purpose,template_key,payload_json,status,provider,provider_reference,idempotency_key,policy_json,created_by,created_at,updated_at) VALUES (?,?,?,NULL,NULL,NULL,'outbound','whatsapp',?,?,?, 'queued',?,NULL,?,?,?, ?,?)").bind(messageId,input.threadId,input.customerId,purpose,key||"whatsapp_session_reply",JSON.stringify({text:input.text}),input.provider,idempotencyKey,JSON.stringify(policy),input.createdBy,now,now),db.prepare("INSERT INTO communication_outbox (message_id,status,next_attempt_at,attempt_count,max_attempts,last_error,locked_at,updated_at) VALUES (?,'queued',?,0,5,NULL,NULL,?)").bind(messageId,now,now),db.prepare("UPDATE whatsapp_uat_sessions SET last_outbound_at=? WHERE customer_id=? AND provider=?").bind(now,input.customerId,input.provider)]);return{queued:true,duplicatePrevented:false,messageId,status:"queued",externalDelivery:false};
}

export async function recordWhatsAppUatDelivery(db:D1Database,input:{provider:WhatsAppUatProvider;eventId:string;messageId:string;eventType:"accepted"|"sent"|"delivered"|"read"|"failed";payloadHash:string;detail?:Record<string,unknown>}){await ensureWhatsAppUatTables(db);if(!whatsappUatProviders.includes(input.provider))throw new Error("Unsupported WhatsApp UAT provider");const prior=await db.prepare("SELECT * FROM whatsapp_uat_events WHERE provider=? AND event_id=?").bind(input.provider,input.eventId).first<Row>();if(prior)return{duplicatePrevented:true,event:prior,externalDelivery:false};const result=await recordDeliveryEvent(db,{messageId:input.messageId,provider:input.provider,eventId:input.eventId,eventType:input.eventType,detail:{environment:"uat",externalDelivery:false,...(input.detail??{})}}),now=Date.now();await db.prepare("INSERT INTO whatsapp_uat_events (id,provider,event_id,event_type,payload_hash,customer_id,message_id,thread_id,detail_json,created_at) SELECT ?,?,?,?,?,m.customer_id,m.id,m.thread_id,?,? FROM communication_messages m WHERE m.id=?").bind(`WAUAT-${crypto.randomUUID().slice(0,12).toUpperCase()}`,input.provider,input.eventId,`delivery_${input.eventType}`,input.payloadHash,JSON.stringify({environment:"uat",externalDelivery:false,...(input.detail??{})}),now,input.messageId).run();return{...result,staffFallbackRequired:input.eventType==="failed",externalDelivery:false};}
