async function resolveScope(db:Db,input:{actorEmail:string;roleCode:string;permissions:string[]}):Promise<Scope>{if(has(input.permissions,"people.manage")||has(input.permissions,"payroll.view")||has(input.permissions,"audit.view"))return{mode:"all",managerEmployeeId:null,employeeIds:[],employeeEmails:[]};const own=await db.prepare("SELECT id FROM employees WHERE lower(COALESCE(user_email,work_email))=? AND employment_status='active'").bind(input.actorEmail.toLowerCase()).first<Row>();if(!own)return{mode:"manager",managerEmployeeId:null,employeeIds:[],employeeEmails:[]};const managerId=text(own.id),direct=await all(db,"SELECT e.id,e.work_email,e.user_email FROM employees e JOIN employee_employment_versions v ON v.employee_id=e.id AND v.effective_until IS NULL WHERE e.employment_status='active' AND v.manager_employee_id=? ORDER BY e.id",[managerId]);return{mode:"manager",managerEmployeeId:managerId,employeeIds:direct.map(r=>text(r.id)),employeeEmails:direct.map(r=>text(r.user_email||r.work_email).toLowerCase()).filter(Boolean)};}
