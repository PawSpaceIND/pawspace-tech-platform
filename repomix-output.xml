 if(input.action==="replace_provider"){if(!input.staffOverride)throw new Response("Trainer replacement requires staff booking permission",{status:403});requireState(["scheduled","accepted","reschedule_requested"]);const newProviderId=String(input.newProviderId||"").trim(),reason=String(input.reason||"").trim();if(!newProviderId||reason.length<8)throw new Response("Replacement trainer and clear reason are required",{status:400});const provider=await getGovernedProvider(db,newProviderId);if(!provider||!provider.live||!provider.services.includes("dog_training")||!provider.zones.includes(String(row.zone_id||"")))throw new Response("Replacement trainer is not eligible for this Training session",{status:409});const conflict=await providerConflict(db,newProviderId,String(row.zone_id||""),String(row.scheduled_start),String(row.scheduled_end),String(row.schedule_reservation_id));if(conflict.conflict)throw new Response(conflict.reason||"Replacement trainer is unavailable",{status:409});const caseId=await recovery(db,row,"replacement",reason,input.actorId,{fromProviderId:row.provider_id,toProviderId:newProviderId});await db.batch([db.prepare("UPDATE training_sessions SET provider_id=?,status='scheduled',updated_at=? WHERE id=?").bind(newProviderId,now,row.id),db.prepare("UPDATE scheduling_reservations SET provider_id=?,status='assigned' WHERE id=?").bind(newProviderId,row.schedule_reservation_id),db.prepare("UPDATE training_session_recovery_cases SET status='resolved',replacement_provider_id=?,updated_at=? WHERE id=?").bind(newProviderId,now,caseId)]);await event(db,row,input,{fromProviderId:row.provider_id,toProviderId:newProviderId,reason,caseId});return{duplicatePrevented:false,status:"scheduled",providerId:newProviderId,caseId};}
 if(input.action==="cancel_session"){if(!input.staffOverride)throw new Response("Training session cancellation requires staff booking permission",{status:403});requireState(["scheduled","accepted","reschedule_requested"]);const reason=String(input.reason||"").trim();if(reason.length<8)throw new Response("Session cancellation requires a clear reason",{status:400});const caseId=await recovery(db,row,"cancel",reason,input.actorId,{consumption:"not_consumed"});await db.batch([db.prepare("UPDATE training_sessions SET status='cancelled',updated_at=? WHERE id=?").bind(now,row.id),db.prepare("UPDATE scheduling_reservations SET status='cancelled' WHERE id=?").bind(row.schedule_reservation_id)]);const programme=await recalcProgramme(db,String(row.programme_id));await event(db,row,input,{from:current,to:"cancelled",reason,caseId,consumption:"not_consumed",programme});return{duplicatePrevented:false,status:"cancelled",caseId,programme};}
