    assert.ok(flow.includes(field), `flow must send ${field}`);
  }
  assert.match(flow, /"domestic" \| "international"|\["domestic", "international"\]/);
  const fetches = [...flow.matchAll(/fetch\("([^"]+)"/g)].map(m => m[1]);
