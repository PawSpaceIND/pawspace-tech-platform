 const reservation=await db.prepare("SELECT * FROM ai_turn_reservations WHERE idempotency_key=?").bind(input.idempotencyKey).first<Row>();
 if(!reservation)throw new Error("AI turn reservation failed");
 if(String(reservation.thread_id)!==input.threadId||String(reservation.customer_id)!==input.customerId||String(reservation.input_message_id)!==input.inputMessageId||String(reservation.channel)!==input.channel)throw new Error("AI idempotency key was already used for a different canonical turn");
 if(String(reservation.owner_token)!==ownerToken){const completed=reservation.turn_id?await db.prepare("SELECT * FROM ai_conversation_turns WHERE id=?").bind(String(reservation.turn_id)).first<Row>():null;if(completed)return{duplicatePrevented:true,turn:completed,autonomousExecution:false};return{duplicatePrevented:true,pending:true,retryable:true,turn:null,autonomousExecution:false};}
 try{const intent=classifyAiIntent(text),context=await minimumContext(db,{customerId:input.customerId,threadId:input.threadId,bookingId:message.booking_id?String(message.booking_id):null,ticketId:message.ticket_id?String(message.ticket_id):null}),contextRef=await createAiContext(db,{actorEmail:input.actor.email,customerId:input.customerId,bookingId:message.booking_id?String(message.booking_id):undefined,ticketId:message.ticket_id?String(message.ticket_id):undefined,scope,context,ttlMinutes:15}),provider=input.provider||notConnectedAiProvider,session=await sessionForThread(db,input.threadId,input.customerId,provider);const started=Date.now();let output="",policyDecision="draft_review_required",outcome="draft_review_required",handoffReason:string|null=null,providerResult:AiProviderResult={text:"",provider:provider.provider,modelRef:provider.modelRef,latencyMs:0,unsupported:provider.status!=="connected"};const lowConfidence=intent.confidence<0.65||intent.intent==="unknown",explicitHandoff=intent.intent==="human_handoff",policyRisk=intent.policyRisk||intent.intent==="refund_review"||detectPromptInjection(text).blocked;const audience=isStaffActor(input.actor)?"staff":"customer",rolloutGate=await resolveAiAudienceGate(db,{audience}),rolloutGated=!rolloutGate.allowed;if(lowConfidence||explicitHandoff||policyRisk||rolloutGated||provider.status!=="connected"){// Order matters for diagnosis, not for safety - every branch here hands off either way. Safety and
