type Row=Record<string,unknown>;
export type AiConfigEntityType="profile"|"intent"|"knowledge"|"prompt";
export type AiConfigLifecycleAction="submit_review"|"approve"|"activate"|"rollback";
export type AiKillSwitchScope="global"|"channel"|"intent"|"provider"|"model";

const entityMeta={
 profile:{table:"ai_assistant_profile_versions",keyColumn:"profile_key"},
 intent:{table:"ai_intent_versions",keyColumn:"intent_code"},
 knowledge:{table:"ai_knowledge_source_versions",keyColumn:"source_key"},
 prompt:{table:"ai_prompt_policy_versions",keyColumn:"policy_key"},
} as const;
const text=(value:unknown)=>String(value??"").trim();
const jsonArray=(value:unknown)=>Array.isArray(value)?value.map(item=>text(item)).filter(Boolean):[];
const jsonObject=(value:unknown)=>value&&typeof value==="object"&&!Array.isArray(value)?value as Record<string,unknown>:{};
const parse=<T>(value:unknown,fallback:T):T=>{try{return JSON.parse(String(value??"")) as T}catch{return fallback}};

async function hashValue(value:unknown){const bytes=new TextEncoder().encode(JSON.stringify(value)),digest=await crypto.subtle.digest("SHA-256",bytes);return[...new Uint8Array(digest)].map(v=>v.toString(16).padStart(2,"0")).join("");}
async function audit(db:D1Database,actorEmail:string,action:string,entityType:string,entityId:string|null,detail:unknown){await db.prepare("INSERT INTO ai_config_audit_events (id,actor_email,action,entity_type,entity_id,detail_json,created_at) VALUES (?,?,?,?,?,?,?)").bind(crypto.randomUUID(),actorEmail,action,entityType,entityId,JSON.stringify(detail??{}),Date.now()).run();}

export async function ensureAiBusinessConfiguration(db:D1Database){await db.batch([
 db.prepare("CREATE TABLE IF NOT EXISTS ai_assistant_profile_versions (id TEXT PRIMARY KEY,profile_key TEXT NOT NULL,version INTEGER NOT NULL,status TEXT NOT NULL,brand_voice TEXT NOT NULL,supported_languages_json TEXT NOT NULL,greeting_text TEXT NOT NULL,fallback_text TEXT NOT NULL,provider_ref TEXT,model_ref TEXT,effective_from INTEGER,effective_to INTEGER,immutable_hash TEXT NOT NULL,created_by TEXT NOT NULL,reviewed_by TEXT,reviewed_at INTEGER,approved_by TEXT,approved_at INTEGER,activated_by TEXT,activated_at INTEGER,retired_at INTEGER,created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL,UNIQUE(profile_key,version))"),
 db.prepare("CREATE TABLE IF NOT EXISTS ai_intent_versions (id TEXT PRIMARY KEY,intent_code TEXT NOT NULL,version INTEGER NOT NULL,status TEXT NOT NULL,business_owner TEXT NOT NULL,enabled INTEGER NOT NULL,confidence_threshold REAL NOT NULL,required_fields_json TEXT NOT NULL,workflow_mapping TEXT NOT NULL,escalation_rule TEXT NOT NULL,effective_from INTEGER,effective_to INTEGER,immutable_hash TEXT NOT NULL,created_by TEXT NOT NULL,reviewed_by TEXT,reviewed_at INTEGER,approved_by TEXT,approved_at INTEGER,activated_by TEXT,activated_at INTEGER,retired_at INTEGER,created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL,UNIQUE(intent_code,version))"),
 db.prepare("CREATE TABLE IF NOT EXISTS ai_knowledge_source_versions (id TEXT PRIMARY KEY,source_key TEXT NOT NULL,version INTEGER NOT NULL,status TEXT NOT NULL,title TEXT NOT NULL,source_type TEXT NOT NULL,content_text TEXT NOT NULL,visibility_scope_json TEXT NOT NULL,effective_from INTEGER,effective_to INTEGER,immutable_hash TEXT NOT NULL,created_by TEXT NOT NULL,reviewed_by TEXT,reviewed_at INTEGER,approved_by TEXT,approved_at INTEGER,activated_by TEXT,activated_at INTEGER,retired_at INTEGER,created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL,UNIQUE(source_key,version))"),
 db.prepare("CREATE TABLE IF NOT EXISTS ai_prompt_policy_versions (id TEXT PRIMARY KEY,policy_key TEXT NOT NULL,version INTEGER NOT NULL,status TEXT NOT NULL,system_prompt TEXT NOT NULL,policy_json TEXT NOT NULL,effective_from INTEGER,effective_to INTEGER,immutable_hash TEXT NOT NULL,created_by TEXT NOT NULL,reviewed_by TEXT,reviewed_at INTEGER,approved_by TEXT,approved_at INTEGER,activated_by TEXT,activated_at INTEGER,retired_at INTEGER,created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL,UNIQUE(policy_key,version))"),
 db.prepare("CREATE TABLE IF NOT EXISTS ai_kill_switches (scope_type TEXT NOT NULL,scope_key TEXT NOT NULL,disabled INTEGER NOT NULL,reason TEXT NOT NULL,updated_by TEXT NOT NULL,updated_at INTEGER NOT NULL,PRIMARY KEY(scope_type,scope_key))"),
 db.prepare("CREATE TABLE IF NOT EXISTS ai_config_audit_events (id TEXT PRIMARY KEY,actor_email TEXT NOT NULL,action TEXT NOT NULL,entity_type TEXT NOT NULL,entity_id TEXT,detail_json TEXT NOT NULL,created_at INTEGER NOT NULL)"),
 db.prepare("CREATE INDEX IF NOT EXISTS ai_config_audit_created_idx ON ai_config_audit_events(created_at)"),
]);}

async function nextVersion(db:D1Database,entityType:AiConfigEntityType,key:string){const meta=entityMeta[entityType],row=await db.prepare(`SELECT MAX(version) version FROM ${meta.table} WHERE ${meta.keyColumn}=?`).bind(key).first<Row>();return Number(row?.version||0)+1;}

export async function createAiBusinessDraft(db:D1Database,input:{entityType:AiConfigEntityType;payload:Record<string,unknown>;actorEmail:string}){await ensureAiBusinessConfiguration(db);const p=input.payload,now=Date.now();if(input.entityType==="profile"){const key=text(p.profileKey)||"pawspace_default",languages=jsonArray(p.supportedLanguages);if(!text(p.brandVoice)||!languages.length||!text(p.greetingText)||!text(p.fallbackText))throw new Error("Profile draft requires brand voice, supported languages, greeting and fallback");const version=await nextVersion(db,"profile",key),id=`AIPROFILE-${crypto.randomUUID().slice(0,12).toUpperCase()}`,snapshot={key,version,brandVoice:text(p.brandVoice),supportedLanguages:languages,greetingText:text(p.greetingText),fallbackText:text(p.fallbackText),providerRef:text(p.providerRef)||null,modelRef:text(p.modelRef)||null,effectiveFrom:p.effectiveFrom==null?null:Number(p.effectiveFrom),effectiveTo:p.effectiveTo==null?null:Number(p.effectiveTo)},hash=await hashValue(snapshot);await db.prepare("INSERT INTO ai_assistant_profile_versions (id,profile_key,version,status,brand_voice,supported_languages_json,greeting_text,fallback_text,provider_ref,model_ref,effective_from,effective_to,immutable_hash,created_by,created_at,updated_at) VALUES (?,?,?,'draft',?,?,?,?,?,?,?,?,?,?,?,?)").bind(id,key,version,snapshot.brandVoice,JSON.stringify(languages),snapshot.greetingText,snapshot.fallbackText,snapshot.providerRef,snapshot.modelRef,snapshot.effectiveFrom,snapshot.effectiveTo,hash,input.actorEmail,now,now).run();await audit(db,input.actorEmail,"draft_created","profile",id,{key,version,hash});return{id,key,version,status:"draft",immutableHash:hash};}
 if(input.entityType==="intent"){const key=text(p.intentCode);if(!key||!text(p.businessOwner)||!text(p.workflowMapping)||!text(p.escalationRule))throw new Error("Intent draft requires code, business owner, workflow mapping and escalation rule");const threshold=Number(p.confidenceThreshold);if(!Number.isFinite(threshold)||threshold<0||threshold>1)throw new Error("Intent confidence threshold must be between 0 and 1");const requiredFields=jsonArray(p.requiredFields),enabled=p.enabled!==false,version=await nextVersion(db,"intent",key),id=`AIINTENT-${crypto.randomUUID().slice(0,12).toUpperCase()}`,snapshot={key,version,businessOwner:text(p.businessOwner),enabled,confidenceThreshold:threshold,requiredFields,workflowMapping:text(p.workflowMapping),escalationRule:text(p.escalationRule),effectiveFrom:p.effectiveFrom==null?null:Number(p.effectiveFrom),effectiveTo:p.effectiveTo==null?null:Number(p.effectiveTo)},hash=await hashValue(snapshot);await db.prepare("INSERT INTO ai_intent_versions (id,intent_code,version,status,business_owner,enabled,confidence_threshold,required_fields_json,workflow_mapping,escalation_rule,effective_from,effective_to,immutable_hash,created_by,created_at,updated_at) VALUES (?,?,?,'draft',?,?,?,?,?,?,?,?,?,?,?,?)").bind(id,key,version,snapshot.businessOwner,enabled?1:0,threshold,JSON.stringify(requiredFields),snapshot.workflowMapping,snapshot.escalationRule,snapshot.effectiveFrom,snapshot.effectiveTo,hash,input.actorEmail,now,now).run();await audit(db,input.actorEmail,"draft_created","intent",id,{key,version,hash});return{id,key,version,status:"draft",immutableHash:hash};}
 if(input.entityType==="knowledge"){const key=text(p.sourceKey),title=text(p.title),content=text(p.contentText),visibility=jsonArray(p.visibilityScope);if(!key||!title||!content||!visibility.length)throw new Error("Knowledge draft requires source key, title, content and visibility scope");const version=await nextVersion(db,"knowledge",key),id=`AIKNOW-${crypto.randomUUID().slice(0,12).toUpperCase()}`,snapshot={key,version,title,sourceType:text(p.sourceType)||"policy",contentText:content,visibilityScope:visibility,effectiveFrom:p.effectiveFrom==null?null:Number(p.effectiveFrom),effectiveTo:p.effectiveTo==null?null:Number(p.effectiveTo)},hash=await hashValue(snapshot);await db.prepare("INSERT INTO ai_knowledge_source_versions (id,source_key,version,status,title,source_type,content_text,visibility_scope_json,effective_from,effective_to,immutable_hash,created_by,created_at,updated_at) VALUES (?,?,?,'draft',?,?,?,?,?,?,?,?,?,?)").bind(id,key,version,title,snapshot.sourceType,content,JSON.stringify(visibility),snapshot.effectiveFrom,snapshot.effectiveTo,hash,input.actorEmail,now,now).run();await audit(db,input.actorEmail,"draft_created","knowledge",id,{key,version,hash});return{id,key,version,status:"draft",immutableHash:hash};}
 const key=text(p.policyKey)||"pawspace_system",systemPrompt=text(p.systemPrompt),policy=jsonObject(p.policy);if(!systemPrompt)throw new Error("Prompt policy draft requires system prompt");const version=await nextVersion(db,"prompt",key),id=`AIPROMPT-${crypto.randomUUID().slice(0,12).toUpperCase()}`,snapshot={key,version,systemPrompt,policy,effectiveFrom:p.effectiveFrom==null?null:Number(p.effectiveFrom),effectiveTo:p.effectiveTo==null?null:Number(p.effectiveTo)},hash=await hashValue(snapshot);await db.prepare("INSERT INTO ai_prompt_policy_versions (id,policy_key,version,status,system_prompt,policy_json,effective_from,effective_to,immutable_hash,created_by,created_at,updated_at) VALUES (?,?,?,'draft',?,?,?,?,?,?,?,?)").bind(id,key,version,systemPrompt,JSON.stringify(policy),snapshot.effectiveFrom,snapshot.effectiveTo,hash,input.actorEmail,now,now).run();await audit(db,input.actorEmail,"draft_created","prompt",id,{key,version,hash});return{id,key,version,status:"draft",immutableHash:hash};}

export async function transitionAiBusinessConfig(db:D1Database,input:{entityType:AiConfigEntityType;entityId:string;action:AiConfigLifecycleAction;actorEmail:string}){await ensureAiBusinessConfiguration(db);const meta=entityMeta[input.entityType],row=await db.prepare(`SELECT * FROM ${meta.table} WHERE id=?`).bind(input.entityId).first<Row>();if(!row)throw new Error("AI configuration version not found");const status=text(row.status),key=text(row[meta.keyColumn]),now=Date.now();if(input.action==="submit_review"){if(status!=="draft")throw new Error("Only draft configuration can enter review");await db.prepare(`UPDATE ${meta.table} SET status='review',reviewed_by=?,reviewed_at=?,updated_at=? WHERE id=? AND status='draft'`).bind(input.actorEmail,now,now,input.entityId).run();}
 else if(input.action==="approve"){if(status!=="review")throw new Error("Only configuration in review can be approved");await db.prepare(`UPDATE ${meta.table} SET status='approved',approved_by=?,approved_at=?,updated_at=? WHERE id=? AND status='review'`).bind(input.actorEmail,now,now,input.entityId).run();}
 else if(input.action==="activate"){if(status!=="approved")throw new Error("Only approved configuration can be activated");await db.batch([db.prepare(`UPDATE ${meta.table} SET status='retired',retired_at=?,updated_at=? WHERE ${meta.keyColumn}=? AND status='active'`).bind(now,now,key),db.prepare(`UPDATE ${meta.table} SET status='active',activated_by=?,activated_at=?,retired_at=NULL,updated_at=? WHERE id=? AND status='approved'`).bind(input.actorEmail,now,now,input.entityId)]);}
 else{if(status!=="retired"&&status!=="approved")throw new Error("Rollback target must be an approved or previously active version");await db.batch([db.prepare(`UPDATE ${meta.table} SET status='retired',retired_at=?,updated_at=? WHERE ${meta.keyColumn}=? AND status='active'`).bind(now,now,key),db.prepare(`UPDATE ${meta.table} SET status='active',activated_by=?,activated_at=?,retired_at=NULL,updated_at=? WHERE id=?`).bind(input.actorEmail,now,now,input.entityId)]);}
 await audit(db,input.actorEmail,`lifecycle_${input.action}`,input.entityType,input.entityId,{key,fromStatus:status});return{id:input.entityId,key,status:input.action==="submit_review"?"review":input.action==="approve"?"approved":"active",immutableHash:text(row.immutable_hash)};}

export async function setAiKillSwitch(db:D1Database,input:{scopeType:AiKillSwitchScope;scopeKey:string;disabled:boolean;reason:string;actorEmail:string}){await ensureAiBusinessConfiguration(db);if(!["global","channel","intent","provider","model"].includes(input.scopeType))throw new Error("Unsupported AI kill-switch scope");const key=text(input.scopeKey);if(!key)throw new Error("Kill-switch scope key is required");if(input.disabled&&text(input.reason).length<5)throw new Error("Kill-switch reason must be at least 5 characters");const now=Date.now();await db.prepare("INSERT INTO ai_kill_switches (scope_type,scope_key,disabled,reason,updated_by,updated_at) VALUES (?,?,?,?,?,?) ON CONFLICT(scope_type,scope_key) DO UPDATE SET disabled=excluded.disabled,reason=excluded.reason,updated_by=excluded.updated_by,updated_at=excluded.updated_at").bind(input.scopeType,key,input.disabled?1:0,text(input.reason)||"enabled",input.actorEmail,now).run();await audit(db,input.actorEmail,input.disabled?"kill_switch_disabled":"kill_switch_enabled","kill_switch",`${input.scopeType}:${key}`,{reason:text(input.reason)||null});return{scopeType:input.scopeType,scopeKey:key,disabled:input.disabled};}

function activeNow(row:Row|undefined,now:number){if(!row)return false;const from=row.effective_from==null?null:Number(row.effective_from),to=row.effective_to==null?null:Number(row.effective_to);return text(row.status)==="active"&&(from==null||from<=now)&&(to==null||to>=now);}
export async function resolveActiveAiBusinessConfig(db:D1Database,input:{channel:string;intent:string;provider?:string|null;model?:string|null}){await ensureAiBusinessConfiguration(db);const now=Date.now(),[profile,intent,prompt,switches]=await Promise.all([db.prepare("SELECT * FROM ai_assistant_profile_versions WHERE status='active' ORDER BY version DESC LIMIT 1").first<Row>(),db.prepare("SELECT * FROM ai_intent_versions WHERE intent_code=? AND status='active' ORDER BY version DESC LIMIT 1").bind(input.intent).first<Row>(),db.prepare("SELECT * FROM ai_prompt_policy_versions WHERE status='active' ORDER BY version DESC LIMIT 1").first<Row>(),db.prepare("SELECT * FROM ai_kill_switches WHERE disabled=1").all<Row>()]);const relevant=switches.results.filter(row=>{const type=text(row.scope_type),key=text(row.scope_key);return(type==="global"&&key==="ai")||(type==="channel"&&key===input.channel)||(type==="intent"&&key===input.intent)||(type==="provider"&&Boolean(input.provider)&&key===input.provider)||(type==="model"&&Boolean(input.model)&&key===input.model);});const activeProfile=activeNow(profile||undefined,now)?profile:null,activeIntent=activeNow(intent||undefined,now)?intent:null,activePrompt=activeNow(prompt||undefined,now)?prompt:null,intentEnabled=!activeIntent||Number(activeIntent.enabled)===1;return{enabled:relevant.length===0&&intentEnabled,killSwitches:relevant.map(row=>({scopeType:text(row.scope_type),scopeKey:text(row.scope_key),reason:text(row.reason)})),profile:activeProfile?{id:text(activeProfile.id),key:text(activeProfile.profile_key),version:Number(activeProfile.version),brandVoice:text(activeProfile.brand_voice),supportedLanguages:parse<string[]>(activeProfile.supported_languages_json,[]),greetingText:text(activeProfile.greeting_text),fallbackText:text(activeProfile.fallback_text),providerRef:activeProfile.provider_ref?text(activeProfile.provider_ref):null,modelRef:activeProfile.model_ref?text(activeProfile.model_ref):null}:null,intent:activeIntent?{id:text(activeIntent.id),code:text(activeIntent.intent_code),version:Number(activeIntent.version),businessOwner:text(activeIntent.business_owner),enabled:Number(activeIntent.enabled)===1,confidenceThreshold:Number(activeIntent.confidence_threshold),requiredFields:parse<string[]>(activeIntent.required_fields_json,[]),workflowMapping:text(activeIntent.workflow_mapping),escalationRule:text(activeIntent.escalation_rule)}:null,promptPolicy:activePrompt?{id:text(activePrompt.id),key:text(activePrompt.policy_key),version:Number(activePrompt.version),systemPrompt:text(activePrompt.system_prompt),policy:parse<Record<string,unknown>>(activePrompt.policy_json,{})}:null,configurationRequired:!activeProfile||!activePrompt};}

const tokens=(value:string)=>[...new Set(value.toLowerCase().split(/[^a-z0-9]+/).filter(item=>item.length>=3))];
export async function retrieveApprovedKnowledge(db:D1Database,input:{query:string;visibilityScopes:string[];limit?:number}){await ensureAiBusinessConfiguration(db);const now=Date.now(),rows=await db.prepare("SELECT id,source_key,version,title,source_type,content_text,visibility_scope_json,effective_from,effective_to,immutable_hash FROM ai_knowledge_source_versions WHERE status='active' AND (effective_from IS NULL OR effective_from<=?) AND (effective_to IS NULL OR effective_to>=?) ORDER BY version DESC").bind(now,now).all<Row>(),queryTokens=tokens(input.query),allowed=new Set(input.visibilityScopes.map(item=>item.toLowerCase())),ranked=rows.results.map(row=>{const scopes=parse<string[]>(row.visibility_scope_json,[]).map(item=>item.toLowerCase()),visible=scopes.includes("public")||scopes.some(scope=>allowed.has(scope));if(!visible)return null;const haystack=`${text(row.title)} ${text(row.content_text)}`.toLowerCase(),score=queryTokens.reduce((sum,token)=>sum+(haystack.includes(token)?1:0),0);return score>0?{id:text(row.id),sourceKey:text(row.source_key),version:Number(row.version),title:text(row.title),sourceType:text(row.source_type),visibilityScope:scopes,immutableHash:text(row.immutable_hash),score,content:text(row.content_text).slice(0,1600)}:null;}).filter((item):item is NonNullable<typeof item>=>Boolean(item)).sort((a,b)=>b.score-a.score||b.version-a.version).slice(0,Math.min(10,Math.max(1,input.limit||5)));return{query:input.query,approvedCurrentOnly:true,results:ranked};}

