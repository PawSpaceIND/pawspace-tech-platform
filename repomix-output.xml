<file path="lib/partner-settlement-governance.ts">
type Row=Record<string,unknown>;
const rows=<T=Row>(r:{results?:unknown[]})=>(r.results||[]) as T[];
async function safeAll(db:D1Database,sql:string){try{return rows(await db.prepare(sql).all<Row>());}catch{return [] as Row[];}}

export async function ensurePartnerSettlementTables(db:D1Database){await db.batch([
 db.prepare("CREATE TABLE IF NOT EXISTS partner_settlement_statements (id TEXT PRIMARY KEY,provider_id TEXT NOT NULL,period_code TEXT NOT NULL,currency TEXT NOT NULL DEFAULT 'INR',earned_amount REAL NOT NULL DEFAULT 0,adjustment_amount REAL NOT NULL DEFAULT 0,payable_amount REAL NOT NULL DEFAULT 0,status TEXT NOT NULL DEFAULT 'draft',source_json TEXT NOT NULL DEFAULT '[]',policy_status TEXT NOT NULL DEFAULT 'configuration_required',approved_by TEXT,approved_at INTEGER,created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL,UNIQUE(provider_id,period_code))"),
 db.prepare("CREATE TABLE IF NOT EXISTS partner_settlement_adjustments (id TEXT PRIMARY KEY,statement_id TEXT NOT NULL,adjustment_type TEXT NOT NULL,amount REAL NOT NULL,reason TEXT NOT NULL,created_by TEXT NOT NULL,created_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS partner_payout_instructions (id TEXT PRIMARY KEY,statement_id TEXT NOT NULL UNIQUE,provider_id TEXT NOT NULL,amount REAL NOT NULL,currency TEXT NOT NULL DEFAULT 'INR',environment TEXT NOT NULL DEFAULT 'sandbox',status TEXT NOT NULL DEFAULT 'approval_required',idempotency_key TEXT NOT NULL UNIQUE,provider_reference TEXT,last_error TEXT,created_by TEXT NOT NULL,created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS partner_settlement_events (id TEXT PRIMARY KEY,statement_id TEXT NOT NULL,event_type TEXT NOT NULL,actor_email TEXT NOT NULL,detail_json TEXT NOT NULL DEFAULT '{}',created_at INTEGER NOT NULL)"),
]);}

/**
 * A settlement a human has APPROVED is frozen against this refresh.
 *
 * The DO UPDATE below used to carry no status predicate, and this function is invoked unconditionally
 * from the READ path - GET /api/partner-finance calls it before selecting - so a plain page load
 * rewrote already-approved statements. Measured: a statement approved by Finance at Rs 5,000, with a
 * Rs 5,000 payout instruction already raised, became payable Rs 50,000 on a single GET after the
 * underlying earning was corrected, while approved_by and approved_at continued to assert the original
 * approval and no partner_settlement_event recorded the change. Whoever pays from the statement pays an
 * amount no human approved; whoever pays from the instruction leaves the ledger unreconciled. The
 * refresh spans the whole period on every load, so one earnings correction rewrote every provider's
 * approved month.
 *
 * This is the guard the sibling read-model already has - lib/training-finance.ts protects a committed
 * statement the same way. An OPEN statement still follows the earnings exactly as before, which is what
 * the refresh is for. A genuine post-approval correction is an explicit settlement action, not a
 * side effect of somebody opening a page.
 */
export async function refreshPartnerSettlementStatements(db:D1Database,periodCode=new Date().toISOString().slice(0,7)){await ensurePartnerSettlementTables(db);const [spy,spm]=periodCode.split("-").map(Number),periodStartMs=Date.UTC(spy,spm-1,1),periodEndMs=Date.UTC(spy,spm,1);if(!Number.isFinite(periodStartMs)||!Number.isFinite(periodEndMs))throw new Error("Invalid settlement period code");const training=await safeAll(db,`SELECT e.provider_id,COALESCE(SUM(e.gross_earning),0) earned FROM training_session_earnings e JOIN training_sessions s ON s.id=e.session_id WHERE s.status='completed' AND e.status='earned' AND e.completed_at>=${periodStartMs} AND e.completed_at<${periodEndMs} GROUP BY e.provider_id`);const now=Date.now();for(const item of training){const providerId=String(item.provider_id),earned=Number(item.earned||0),source=[{service:"dog_training",amount:earned,source:"training_session_earnings"}];await db.prepare("INSERT INTO partner_settlement_statements (id,provider_id,period_code,currency,earned_amount,adjustment_amount,payable_amount,status,source_json,policy_status,created_at,updated_at) VALUES (?,?,?,?,?,0,?,'draft',?,'configuration_required',?,?) ON CONFLICT(provider_id,period_code) DO UPDATE SET earned_amount=CASE WHEN partner_settlement_statements.status IN ('approved','paid','settled') THEN partner_settlement_statements.earned_amount ELSE excluded.earned_amount END,payable_amount=CASE WHEN partner_settlement_statements.status IN ('approved','paid','settled') THEN partner_settlement_statements.payable_amount ELSE excluded.earned_amount+partner_settlement_statements.adjustment_amount END,source_json=CASE WHEN partner_settlement_statements.status IN ('approved','paid','settled') THEN partner_settlement_statements.source_json ELSE excluded.source_json END,updated_at=CASE WHEN partner_settlement_statements.status IN ('approved','paid','settled') THEN partner_settlement_statements.updated_at ELSE excluded.updated_at END") .bind(`SET-${periodCode}-${providerId}`,providerId,periodCode,"INR",earned,earned,JSON.stringify(source),now,now).run();}return training.length;}

export async function addSettlementAdjustment(db:D1Database,input:{statementId:string;type:"incentive"|"deduction"|"reversal"|"manual_correction";amount:number;reason:string;actor:string}){await ensurePartnerSettlementTables(db);if(!Number.isFinite(input.amount)||input.amount===0)throw new Error("Non-zero adjustment amount is required");if(input.reason.trim().length<8)throw new Error("Adjustment reason must be at least 8 characters");const statement=await db.prepare("SELECT * FROM partner_settlement_statements WHERE id=?").bind(input.statementId).first<Row>();if(!statement)throw new Error("Settlement statement not found");if(!["draft","held"].includes(String(statement.status)))throw new Error("Only draft or held settlement statements can be adjusted");const now=Date.now(),id=`ADJ-${crypto.randomUUID().slice(0,12).toUpperCase()}`;await db.batch([db.prepare("INSERT INTO partner_settlement_adjustments (id,statement_id,adjustment_type,amount,reason,created_by,created_at) VALUES (?,?,?,?,?,?,?)").bind(id,input.statementId,input.type,input.amount,input.reason,input.actor,now),db.prepare("UPDATE partner_settlement_statements SET adjustment_amount=adjustment_amount+?,payable_amount=MAX(0,earned_amount+adjustment_amount+?),updated_at=? WHERE id=?").bind(input.amount,input.amount,now,input.statementId),db.prepare("INSERT INTO partner_settlement_events (id,statement_id,event_type,actor_email,detail_json,created_at) VALUES (?,?,?,?,?,?)").bind(crypto.randomUUID(),input.statementId,"adjustment_added",input.actor,JSON.stringify({id,type:input.type,amount:input.amount,reason:input.reason}),now)]);return{id};}

export async function approveSettlementPolicy(db:D1Database,input:{statementId:string;reason:string;actor:string}){await ensurePartnerSettlementTables(db);if(input.reason.trim().length<8)throw new Error("A real reason (at least 8 characters) is required to approve a partner settlement policy");const statement=await db.prepare("SELECT * FROM partner_settlement_statements WHERE id=?").bind(input.statementId).first<Row>();if(!statement)throw new Error("Settlement statement not found");if(String(statement.policy_status)==="approved")return{statementId:input.statementId,policyStatus:"approved",duplicatePrevented:true};const now=Date.now();await db.batch([db.prepare("UPDATE partner_settlement_statements SET policy_status='approved',updated_at=? WHERE id=?").bind(now,input.statementId),db.prepare("INSERT INTO partner_settlement_events (id,statement_id,event_type,actor_email,detail_json,created_at) VALUES (?,?,?,?,?,?)").bind(crypto.randomUUID(),input.statementId,"policy_approved",input.actor,JSON.stringify({reason:input.reason.trim()}),now)]);return{statementId:input.statementId,policyStatus:"approved",duplicatePrevented:false};}

export async function approveSettlement(db:D1Database,input:{statementId:string;actor:string}){await ensurePartnerSettlementTables(db);const statement=await db.prepare("SELECT * FROM partner_settlement_statements WHERE id=?").bind(input.statementId).first<Row>();if(!statement)throw new Error("Settlement statement not found");if(String(statement.policy_status)!=="approved")throw new Error("Partner payout policy is not approved/configured");if(Number(statement.payable_amount)<0)throw new Error("Settlement payable amount cannot be negative");if(!["draft","held"].includes(String(statement.status)))throw new Error("Only a draft or held settlement statement can be approved");const now=Date.now();await db.batch([db.prepare("UPDATE partner_settlement_statements SET status='approved',approved_by=?,approved_at=?,updated_at=? WHERE id=? AND status IN ('draft','held')").bind(input.actor,now,now,input.statementId),db.prepare("INSERT INTO partner_settlement_events (id,statement_id,event_type,actor_email,detail_json,created_at) SELECT ?,?,'approved',?,'{}',? WHERE EXISTS (SELECT 1 FROM partner_settlement_statements WHERE id=? AND status='approved' AND approved_by=? AND approved_at=?)").bind(crypto.randomUUID(),input.statementId,input.actor,now,input.statementId,input.actor,now)]);return{statementId:input.statementId,status:"approved"};}

export async function createSandboxPayoutInstruction(db:D1Database,input:{statementId:string;idempotencyKey:string;actor:string}){await ensurePartnerSettlementTables(db);const prior=await db.prepare("SELECT * FROM partner_payout_instructions WHERE idempotency_key=?").bind(input.idempotencyKey).first<Row>();if(prior)return{...prior,duplicatePrevented:true};const statement=await db.prepare("SELECT * FROM partner_settlement_statements WHERE id=?").bind(input.statementId).first<Row>();if(!statement||String(statement.status)!=="approved")throw new Error("Approved settlement statement is required");const now=Date.now(),id=`PAYOUT-${crypto.randomUUID().slice(0,12).toUpperCase()}`;await db.prepare("INSERT INTO partner_payout_instructions (id,statement_id,provider_id,amount,currency,environment,status,idempotency_key,created_by,created_at,updated_at) VALUES (?,?,?,?,?,'sandbox','approval_required',?,?,?,?)").bind(id,input.statementId,statement.provider_id,statement.payable_amount,statement.currency,input.idempotencyKey,input.actor,now,now).run();return{id,statementId:input.statementId,providerId:String(statement.provider_id),amount:Number(statement.payable_amount),currency:String(statement.currency),environment:"sandbox",status:"approval_required",liveMoney:false,duplicatePrevented:false};}
