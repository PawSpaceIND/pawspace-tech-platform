<file path="lib/relocation-enquiry.ts">
/**
 * Pet Relocation enquiry capture — the front-door lead form at /relocation-enquiry. A prospective
 * customer leaves contact + pickup/drop details before any case exists; staff triage the list at
 * /team/relocation-enquiries. Deliberately separate from the richer relocation-case pipeline in
 * lib/relocation-governance.ts (documents/quotes/vendors/milestones) — this is just intake.
 * Sandbox/UAT, no live money.
 */
type Db=D1Database;
type Row=Record<string,unknown>;
const text=(v:unknown)=>String(v??"").trim();
const uid=(p:string)=>`${p}-${crypto.randomUUID().slice(0,10).toUpperCase()}`;

const PHONE_RE=/^\d{10}$/;
const EMAIL_RE=/^[^\s@]+@[^\s@]+\.[^\s@]+$/;
const DATE_RE=/^\d{4}-\d{2}-\d{2}$/;
const TIME_RE=/^([01]\d|2[0-3]):[0-5]\d$/;
const PET_TYPES=["dog","cat"] as const;
export type PetType=typeof PET_TYPES[number];
const RELOCATION_KINDS=["domestic","international"] as const;
export type RelocationKind=typeof RELOCATION_KINDS[number];

export type RelocationEnquiryInput={
  customerName:string;phonePrimary:string;phoneSecondary?:string;email:string;petType:string;relocationKind:string;
  pickupDate:string;pickupApproxTime:string;pickupLocation:string;dropLocation:string;expectedTravelDate:string;
};

export type RelocationEnquiry={
  id:string;customerName:string;phonePrimary:string;phoneSecondary:string|null;email:string;petType:PetType;relocationKind:RelocationKind;
  pickupDate:string;pickupApproxTime:string;pickupLocation:string;dropLocation:string;expectedTravelDate:string;
  status:"new";createdAt:number;
};

// Per-isolate memoization: this DDL is idempotent and createRelocationEnquiry runs it on every
// submission; the WeakSet keeps it to one round-trip per D1 binding, then a no-op for the rest of
// the isolate's life (same pattern as lib/server-auth.ts / lib/provider-capacity-governance.ts).
const relocationEnquiryTablesEnsured=new WeakSet<Db>();
export async function ensureRelocationEnquiryTables(db:Db){
  if(relocationEnquiryTablesEnsured.has(db))return;
  await db.batch([
    db.prepare("CREATE TABLE IF NOT EXISTS relocation_enquiries (id TEXT PRIMARY KEY,customer_name TEXT NOT NULL,phone_primary TEXT NOT NULL,phone_secondary TEXT,email TEXT NOT NULL,pet_type TEXT NOT NULL,pickup_date TEXT NOT NULL,pickup_approx_time TEXT NOT NULL,pickup_location TEXT NOT NULL,drop_location TEXT NOT NULL,expected_travel_date TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'new',created_at INTEGER NOT NULL)"),
    db.prepare("CREATE INDEX IF NOT EXISTS idx_relocation_enquiries_created ON relocation_enquiries(created_at)"),
  ]);
  // Additive: founder requires capturing whether the relocation is domestic or international.
  // The table already exists on staging, so migrate via PRAGMA/ALTER (customer-account pattern);
  // pre-existing rows read back as 'domestic' (India-first default) rather than null.
  const columns=await db.prepare("PRAGMA table_info(relocation_enquiries)").all<Row>();
  if(!columns.results.some(row=>String(row.name)==="relocation_kind"))await db.prepare("ALTER TABLE relocation_enquiries ADD COLUMN relocation_kind TEXT NOT NULL DEFAULT 'domestic'").run();
  relocationEnquiryTablesEnsured.add(db);
}

function rowToEnquiry(row:Row):RelocationEnquiry{return{
  id:text(row.id),customerName:text(row.customer_name),phonePrimary:text(row.phone_primary),phoneSecondary:row.phone_secondary?text(row.phone_secondary):null,
  email:text(row.email),petType:text(row.pet_type) as PetType,relocationKind:(text(row.relocation_kind)||"domestic") as RelocationKind,pickupDate:text(row.pickup_date),pickupApproxTime:text(row.pickup_approx_time),
  pickupLocation:text(row.pickup_location),dropLocation:text(row.drop_location),expectedTravelDate:text(row.expected_travel_date),
  status:"new",createdAt:Number(row.created_at||0),
};}

/** Strict field-contract validation. Throws a plain Error with a human-readable message on the first violation. */
function validate(input:RelocationEnquiryInput){
  const customerName=text(input.customerName);
  if(!customerName)throw new Error("Customer name is required");
  const phonePrimary=text(input.phonePrimary);
  if(!PHONE_RE.test(phonePrimary))throw new Error("Primary phone number must be exactly 10 digits");
  const phoneSecondaryRaw=text(input.phoneSecondary);
  if(phoneSecondaryRaw&&!PHONE_RE.test(phoneSecondaryRaw))throw new Error("Secondary phone number must be exactly 10 digits");
  const email=text(input.email);
  if(!EMAIL_RE.test(email))throw new Error("A valid email address is required");
  const petType=text(input.petType).toLowerCase();
  if(!(PET_TYPES as readonly string[]).includes(petType))throw new Error('Pet type must be "dog" or "cat"');
  const relocationKind=text(input.relocationKind).toLowerCase();
  if(!(RELOCATION_KINDS as readonly string[]).includes(relocationKind))throw new Error('Relocation type must be "domestic" or "international"');
  const pickupDate=text(input.pickupDate);
  if(!DATE_RE.test(pickupDate))throw new Error("Pickup date must be in YYYY-MM-DD format");
  const pickupApproxTime=text(input.pickupApproxTime);
  if(!TIME_RE.test(pickupApproxTime))throw new Error('Pickup approximate time must be in HH:MM format (e.g. "10:00")');
  const pickupLocation=text(input.pickupLocation);
  if(!pickupLocation)throw new Error("Pickup location is required");
  const dropLocation=text(input.dropLocation);
  if(!dropLocation)throw new Error("Drop location is required");
  const expectedTravelDate=text(input.expectedTravelDate);
  if(!DATE_RE.test(expectedTravelDate))throw new Error("Expected travel date must be in YYYY-MM-DD format");
  return{customerName,phonePrimary,phoneSecondary:phoneSecondaryRaw||null,email,petType:petType as PetType,relocationKind:relocationKind as RelocationKind,pickupDate,pickupApproxTime,pickupLocation,dropLocation,expectedTravelDate};
}

/** Customer-facing, public: capture one relocation enquiry. No case, quote or vendor logic — pure lead intake. */
export async function createRelocationEnquiry(db:Db,input:RelocationEnquiryInput):Promise<RelocationEnquiry>{
  await ensureRelocationEnquiryTables(db);
  const clean=validate(input);
  const id=uid("RELQ"),now=Date.now();
  await db.prepare("INSERT INTO relocation_enquiries (id,customer_name,phone_primary,phone_secondary,email,pet_type,relocation_kind,pickup_date,pickup_approx_time,pickup_location,drop_location,expected_travel_date,status,created_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?)")
    .bind(id,clean.customerName,clean.phonePrimary,clean.phoneSecondary,clean.email,clean.petType,clean.relocationKind,clean.pickupDate,clean.pickupApproxTime,clean.pickupLocation,clean.dropLocation,clean.expectedTravelDate,"new",now).run();
  return{id,...clean,status:"new",createdAt:now};
}

/** Staff-facing: newest-first directory of submitted enquiries. Cold-DB safe. */
export async function listRelocationEnquiries(db:Db):Promise<RelocationEnquiry[]>{
  await ensureRelocationEnquiryTables(db);
  const rows=await db.prepare("SELECT * FROM relocation_enquiries ORDER BY created_at DESC LIMIT 500").all<Row>().catch(()=>({results:[] as Row[]}));
  return rows.results.map(rowToEnquiry);
}
</file>

<file path="lib/relocation-governance.ts">
type Row=Record<string,unknown>;
export type RelocationMode="air"|"road"|"sea";
export type RelocationCaseStatus="lead"|"qualified"|"documents_pending"|"quote_pending"|"quote_sent"|"quote_accepted"|"payment_pending"|"transport_ready"|"in_transit"|"delivered"|"cancelled";

const checklist=["vaccination_record","health_certificate","identity_document","travel_authorisation","crate_confirmation"] as const;
const milestones=["lead_captured","documents_review","quote_issued","payment_confirmed","transport_booked","origin_handover","in_transit","destination_handover","delivery_confirmed"] as const;

export async function ensureRelocationTables(db:D1Database){await db.batch([
 db.prepare("CREATE TABLE IF NOT EXISTS relocation_cases (id TEXT PRIMARY KEY,customer_id TEXT NOT NULL,pet_name TEXT NOT NULL,breed TEXT NOT NULL,age_years REAL NOT NULL,size_class TEXT NOT NULL,travel_mode TEXT NOT NULL,origin_country TEXT NOT NULL,origin_city TEXT NOT NULL,destination_country TEXT NOT NULL,destination_city TEXT NOT NULL,target_travel_date TEXT NOT NULL,crate_requirement TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'lead',assigned_agent_id TEXT,vendor_id TEXT,regulation_status TEXT NOT NULL DEFAULT 'manual_verification_required',support_status TEXT NOT NULL DEFAULT 'none',created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS relocation_documents (id TEXT PRIMARY KEY,case_id TEXT NOT NULL,document_type TEXT NOT NULL,object_id TEXT,status TEXT NOT NULL DEFAULT 'required',review_note TEXT,updated_by TEXT,updated_at INTEGER NOT NULL,UNIQUE(case_id,document_type))"),
 db.prepare("CREATE TABLE IF NOT EXISTS relocation_quotes (id TEXT PRIMARY KEY,case_id TEXT NOT NULL UNIQUE,currency TEXT NOT NULL DEFAULT 'INR',amount REAL NOT NULL,status TEXT NOT NULL DEFAULT 'draft',vendor_cost REAL,margin REAL,valid_until INTEGER NOT NULL,issued_at INTEGER,accepted_at INTEGER,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS relocation_milestones (id TEXT PRIMARY KEY,case_id TEXT NOT NULL,code TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'pending',note TEXT,completed_at INTEGER,updated_by TEXT,updated_at INTEGER NOT NULL,UNIQUE(case_id,code))"),
 db.prepare("CREATE TABLE IF NOT EXISTS relocation_payments (id TEXT PRIMARY KEY,case_id TEXT NOT NULL UNIQUE,quote_id TEXT NOT NULL,amount REAL NOT NULL,status TEXT NOT NULL DEFAULT 'due',payment_reference TEXT,provider TEXT NOT NULL DEFAULT 'internal_uat',paid_at INTEGER,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS relocation_refunds (id TEXT PRIMARY KEY,case_id TEXT NOT NULL,amount REAL NOT NULL,reason TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'requested',decision_note TEXT,created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS relocation_events (id TEXT PRIMARY KEY,case_id TEXT NOT NULL,event_type TEXT NOT NULL,actor_id TEXT NOT NULL,detail_json TEXT NOT NULL DEFAULT '{}',created_at INTEGER NOT NULL)"),
]);}

async function event(db:D1Database,caseId:string,eventType:string,actorId:string,detail:unknown={}){await db.prepare("INSERT INTO relocation_events (id,case_id,event_type,actor_id,detail_json,created_at) VALUES (?,?,?,?,?,?)").bind(crypto.randomUUID(),caseId,eventType,actorId,JSON.stringify(detail),Date.now()).run();}
async function seedCaseRows(db:D1Database,caseId:string){const now=Date.now();for(const doc of checklist)await db.prepare("INSERT OR IGNORE INTO relocation_documents (id,case_id,document_type,status,updated_at) VALUES (?,?,?,'required',?)").bind(crypto.randomUUID(),caseId,doc,now).run();for(const code of milestones)await db.prepare("INSERT OR IGNORE INTO relocation_milestones (id,case_id,code,status,updated_at) VALUES (?,?,?,'pending',?)").bind(crypto.randomUUID(),caseId,code,now).run();await db.prepare("UPDATE relocation_milestones SET status='complete',completed_at=?,updated_by='system',updated_at=? WHERE case_id=? AND code='lead_captured'").bind(now,now,caseId).run();}

export async function createRelocationCase(db:D1Database,input:{customerId:string;petName:string;breed:string;ageYears:number;sizeClass:string;travelMode:RelocationMode;originCountry:string;originCity:string;destinationCountry:string;destinationCity:string;targetTravelDate:string;crateRequirement:string},actorId:string){await ensureRelocationTables(db);if(!input.customerId||!input.petName||!input.originCity||!input.destinationCity)throw new Response("Customer, pet, origin and destination are required",{status:400});if(!["air","road","sea"].includes(input.travelMode))throw new Response("Unsupported relocation travel mode",{status:400});const travelAt=new Date(input.targetTravelDate).getTime();if(!Number.isFinite(travelAt)||travelAt<=Date.now())throw new Response("Relocation target date must be in the future",{status:400});const id=`RLC-${crypto.randomUUID().slice(0,10).toUpperCase()}`,now=Date.now();await db.prepare("INSERT INTO relocation_cases (id,customer_id,pet_name,breed,age_years,size_class,travel_mode,origin_country,origin_city,destination_country,destination_city,target_travel_date,crate_requirement,status,regulation_status,created_at,updated_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,'lead','manual_verification_required',?,?)").bind(id,input.customerId,input.petName,input.breed,Number(input.ageYears||0),input.sizeClass,input.travelMode,input.originCountry,input.originCity,input.destinationCountry,input.destinationCity,input.targetTravelDate,input.crateRequirement,now,now).run();await seedCaseRows(db,id);await event(db,id,"lead_captured",actorId,{travelMode:input.travelMode,origin:`${input.originCity}, ${input.originCountry}`,destination:`${input.destinationCity}, ${input.destinationCountry}`});return getRelocationCase(db,id);}

export async function getRelocationCase(db:D1Database,caseId:string){await ensureRelocationTables(db);const row=await db.prepare("SELECT * FROM relocation_cases WHERE id=?").bind(caseId).first<Row>();if(!row)return null;const docs=await db.prepare("SELECT * FROM relocation_documents WHERE case_id=? ORDER BY document_type").bind(caseId).all<Row>(),milestonesResult=await db.prepare("SELECT * FROM relocation_milestones WHERE case_id=? ORDER BY rowid").bind(caseId).all<Row>(),quote=await db.prepare("SELECT * FROM relocation_quotes WHERE case_id=?").bind(caseId).first<Row>(),payment=await db.prepare("SELECT * FROM relocation_payments WHERE case_id=?").bind(caseId).first<Row>(),refunds=await db.prepare("SELECT * FROM relocation_refunds WHERE case_id=? ORDER BY created_at DESC").bind(caseId).all<Row>(),events=await db.prepare("SELECT * FROM relocation_events WHERE case_id=? ORDER BY created_at DESC LIMIT 50").bind(caseId).all<Row>();return{...row,documents:docs.results,milestones:milestonesResult.results,quote:quote??null,payment:payment??null,refunds:refunds.results,events:events.results.map(item=>({...item,detail:JSON.parse(String(item.detail_json||"{}"))}))};}

export async function listRelocationCases(db:D1Database,input:{customerId?:string;status?:string}){await ensureRelocationTables(db);const where=["1=1"],binds:unknown[]=[];if(input.customerId){where.push("customer_id=?");binds.push(input.customerId)}if(input.status){where.push("status=?");binds.push(input.status)}const rows=await db.prepare(`SELECT * FROM relocation_cases WHERE ${where.join(" AND ")} ORDER BY created_at DESC LIMIT 100`).bind(...binds).all<Row>();return rows.results;}

export async function mutateRelocationCase(db:D1Database,input:{caseId:string;action:string;actorId:string;documentType?:string;objectId?:string;reviewNote?:string;amount?:number;vendorCost?:number;validDays?:number;vendorId?:string;agentId?:string;milestoneCode?:string;note?:string;paymentReference?:string;refundAmount?:number;reason?:string;decision?:"approved"|"rejected"|"completed"}){await ensureRelocationTables(db);const row=await db.prepare("SELECT * FROM relocation_cases WHERE id=?").bind(input.caseId).first<Row>();if(!row)throw new Response("Relocation case not found",{status:404});const now=Date.now();
 if(input.action==="register_document"){if(!checklist.includes(input.documentType as never))throw new Response("Unknown relocation document type",{status:400});await db.prepare("UPDATE relocation_documents SET object_id=?,status='uploaded',review_note=NULL,updated_by=?,updated_at=? WHERE case_id=? AND document_type=?").bind(input.objectId||`uat-object-${crypto.randomUUID()}`,input.actorId,now,input.caseId,input.documentType).run();await event(db,input.caseId,"document_uploaded",input.actorId,{documentType:input.documentType});return getRelocationCase(db,input.caseId);}
 if(input.action==="review_document"){if(!input.documentType)throw new Response("Document type is required",{status:400});const status=input.reviewNote?"needs_attention":"verified";await db.prepare("UPDATE relocation_documents SET status=?,review_note=?,updated_by=?,updated_at=? WHERE case_id=? AND document_type=?").bind(status,input.reviewNote||null,input.actorId,now,input.caseId,input.documentType).run();const pending=await db.prepare("SELECT COUNT(*) count FROM relocation_documents WHERE case_id=? AND status!='verified'").bind(input.caseId).first<{count:number}>();await db.prepare("UPDATE relocation_cases SET status=?,updated_at=? WHERE id=?").bind(Number(pending?.count||0)===0?"quote_pending":"documents_pending",now,input.caseId).run();await event(db,input.caseId,"document_reviewed",input.actorId,{documentType:input.documentType,status});return getRelocationCase(db,input.caseId);}
 if(input.action==="qualify"){await db.prepare("UPDATE relocation_cases SET status='documents_pending',assigned_agent_id=?,updated_at=? WHERE id=?").bind(input.agentId||input.actorId,now,input.caseId).run();await event(db,input.caseId,"lead_qualified",input.actorId,{agentId:input.agentId||input.actorId});return getRelocationCase(db,input.caseId);}
 if(input.action==="assign_vendor"){if(!input.vendorId)throw new Response("Vendor ID is required",{status:400});await db.prepare("UPDATE relocation_cases SET vendor_id=?,updated_at=? WHERE id=?").bind(input.vendorId,now,input.caseId).run();await event(db,input.caseId,"vendor_assigned",input.actorId,{vendorId:input.vendorId,externalApiConnected:false});return getRelocationCase(db,input.caseId);}
 if(input.action==="issue_quote"){if(!["quote_pending","quote_sent"].includes(String(row.status)))throw new Response("A relocation quote can only be issued once all documents are verified",{status:409});const amount=Number(input.amount||0),vendorCost=Number(input.vendorCost||0);if(amount<=0)throw new Response("Quote amount must be positive",{status:400});const validUntil=now+Math.max(1,Number(input.validDays||7))*86_400_000,quoteId=`RLQ-${crypto.randomUUID().slice(0,10).toUpperCase()}`;await db.prepare("INSERT INTO relocation_quotes (id,case_id,currency,amount,status,vendor_cost,margin,valid_until,issued_at,updated_at) VALUES (?,?,'INR',?,'sent',?,?,?,?,?) ON CONFLICT(case_id) DO UPDATE SET amount=excluded.amount,status='sent',vendor_cost=excluded.vendor_cost,margin=excluded.margin,valid_until=excluded.valid_until,issued_at=excluded.issued_at,updated_at=excluded.updated_at").bind(quoteId,input.caseId,amount,vendorCost,amount-vendorCost,validUntil,now,now).run();await db.prepare("UPDATE relocation_cases SET status='quote_sent',updated_at=? WHERE id=?").bind(now,input.caseId).run();await event(db,input.caseId,"quote_sent",input.actorId,{amount,vendorCost,liveMoney:false});return getRelocationCase(db,input.caseId);}
 if(input.action==="accept_quote"){const quote=await db.prepare("SELECT * FROM relocation_quotes WHERE case_id=?").bind(input.caseId).first<Row>();if(!quote||String(quote.status)!=="sent"||Number(quote.valid_until)<now)throw new Response("An active relocation quote is required",{status:409});await db.batch([db.prepare("UPDATE relocation_quotes SET status='accepted',accepted_at=?,updated_at=? WHERE case_id=?").bind(now,now,input.caseId),db.prepare("INSERT OR REPLACE INTO relocation_payments (id,case_id,quote_id,amount,status,payment_reference,provider,paid_at,updated_at) VALUES (?,?,?,?, 'due',NULL,'internal_uat',NULL,?)").bind(`RLP-${crypto.randomUUID().slice(0,10).toUpperCase()}`,input.caseId,quote.id,quote.amount,now),db.prepare("UPDATE relocation_cases SET status='payment_pending',updated_at=? WHERE id=?").bind(now,input.caseId)]);await event(db,input.caseId,"quote_accepted",input.actorId,{paymentProvider:"internal_uat",liveMoney:false});return getRelocationCase(db,input.caseId);}
 if(input.action==="record_payment"){const payment=await db.prepare("SELECT * FROM relocation_payments WHERE case_id=?").bind(input.caseId).first<Row>();if(!payment)throw new Response("Relocation payment request not found",{status:409});await db.batch([db.prepare("UPDATE relocation_payments SET status='paid',payment_reference=?,paid_at=?,updated_at=? WHERE case_id=?").bind(input.paymentReference||`UAT-${crypto.randomUUID().slice(0,8)}`,now,now,input.caseId),db.prepare("UPDATE relocation_cases SET status='transport_ready',updated_at=? WHERE id=?").bind(now,input.caseId)]);await event(db,input.caseId,"payment_confirmed",input.actorId,{provider:"internal_uat",liveMoney:false});return getRelocationCase(db,input.caseId);}
 if(input.action==="complete_milestone"){if(!milestones.includes(input.milestoneCode as never))throw new Response("Unknown relocation milestone",{status:400});await db.prepare("UPDATE relocation_milestones SET status='complete',note=?,completed_at=?,updated_by=?,updated_at=? WHERE case_id=? AND code=?").bind(input.note||null,now,input.actorId,now,input.caseId,input.milestoneCode).run();let nextStatus=String(row.status);if(input.milestoneCode==="transport_booked")nextStatus="transport_ready";if(input.milestoneCode==="in_transit")nextStatus="in_transit";if(input.milestoneCode==="delivery_confirmed")nextStatus="delivered";await db.prepare("UPDATE relocation_cases SET status=?,updated_at=? WHERE id=?").bind(nextStatus,now,input.caseId).run();await event(db,input.caseId,"milestone_completed",input.actorId,{code:input.milestoneCode,note:input.note});return getRelocationCase(db,input.caseId);}
 if(input.action==="request_refund"){const amount=Number(input.refundAmount||0);if(amount<=0||!input.reason)throw new Response("Refund amount and reason are required",{status:400});await db.prepare("INSERT INTO relocation_refunds (id,case_id,amount,reason,status,created_at,updated_at) VALUES (?,?,?,?, 'requested',?,?)").bind(`RLR-${crypto.randomUUID().slice(0,10).toUpperCase()}`,input.caseId,amount,input.reason,now,now).run();await event(db,input.caseId,"refund_requested",input.actorId,{amount,reason:input.reason});return getRelocationCase(db,input.caseId);}
 if(input.action==="resolve_refund"){const refund=await db.prepare("SELECT * FROM relocation_refunds WHERE case_id=? AND status='requested' ORDER BY created_at DESC LIMIT 1").bind(input.caseId).first<Row>();if(!refund)throw new Response("No pending relocation refund request",{status:409});if(!input.decision)throw new Response("Refund decision is required",{status:400});await db.prepare("UPDATE relocation_refunds SET status=?,decision_note=?,updated_at=? WHERE id=?").bind(input.decision,input.note||null,now,refund.id).run();await event(db,input.caseId,"refund_updated",input.actorId,{decision:input.decision,externalRefundExecution:false});return getRelocationCase(db,input.caseId);}
 if(input.action==="open_support"){await db.prepare("UPDATE relocation_cases SET support_status='open',updated_at=? WHERE id=?").bind(now,input.caseId).run();await event(db,input.caseId,"support_opened",input.actorId,{reason:input.reason||"Customer requested support"});return getRelocationCase(db,input.caseId);}
 throw new Response("Unsupported relocation action",{status:400});
}

