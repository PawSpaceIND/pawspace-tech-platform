<file path="lib/whatsapp-conversion-feedback.ts">
import{ensureConversationGovernance}from"./conversation-governance";
import{ensureLeadWorkItemsTable}from"./lead-conversion-attribution";

type Db=D1Database;type Row=Record<string,unknown>;export type WhatsAppAttributionPlatform="meta"|"google";
const text=(value:unknown)=>String(value??"").trim();const uid=(prefix:string)=>`${prefix}-${crypto.randomUUID().slice(0,12).toUpperCase()}`;
const allowedEvents=new Set(["lead_qualified","booking_created","payment_captured"]);

export async function ensureWhatsAppConversionFeedback(db:Db){await ensureConversationGovernance(db);await ensureLeadWorkItemsTable(db);await db.batch([
 db.prepare("CREATE TABLE IF NOT EXISTS whatsapp_lead_attribution (id TEXT PRIMARY KEY,source_platform TEXT NOT NULL,source_event_id TEXT NOT NULL,lead_id TEXT NOT NULL,customer_id TEXT NOT NULL,thread_id TEXT NOT NULL,campaign_id TEXT,ad_id TEXT,form_id TEXT,click_id TEXT,utm_source TEXT,utm_medium TEXT,utm_campaign TEXT,metadata_json TEXT NOT NULL DEFAULT '{}',created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL,UNIQUE(source_platform,source_event_id))"),
 db.prepare("CREATE INDEX IF NOT EXISTS whatsapp_lead_attribution_link_idx ON whatsapp_lead_attribution(lead_id,customer_id,thread_id)"),
 db.prepare("CREATE TABLE IF NOT EXISTS whatsapp_conversion_facts (id TEXT PRIMARY KEY,event_type TEXT NOT NULL,business_reference TEXT NOT NULL,lead_id TEXT NOT NULL,customer_id TEXT NOT NULL,thread_id TEXT NOT NULL,booking_id TEXT,payment_id TEXT,value_minor INTEGER NOT NULL DEFAULT 0,currency TEXT NOT NULL DEFAULT 'INR',occurred_at INTEGER NOT NULL,created_at INTEGER NOT NULL,UNIQUE(event_type,business_reference))"),
 db.prepare("CREATE TABLE IF NOT EXISTS whatsapp_conversion_feedback_outbox (id TEXT PRIMARY KEY,fact_id TEXT NOT NULL,platform TEXT NOT NULL,payload_json TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'pending',attempts INTEGER NOT NULL DEFAULT 0,next_attempt_at INTEGER NOT NULL,last_error TEXT,external_mutation INTEGER NOT NULL DEFAULT 0,created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL,UNIQUE(fact_id,platform))"),
 db.prepare("CREATE INDEX IF NOT EXISTS whatsapp_conversion_feedback_due_idx ON whatsapp_conversion_feedback_outbox(status,next_attempt_at)"),
]);}

async function canonicalLink(db:Db,input:{leadId:string;customerId:string;threadId:string}){const [thread,lead]=await Promise.all([db.prepare("SELECT customer_id,lead_id FROM communication_threads WHERE id=?").bind(input.threadId).first<Row>(),db.prepare("SELECT customer_id FROM lead_work_items WHERE id=?").bind(input.leadId).first<Row>()]);if(!thread||text(thread.customer_id)!==input.customerId||text(thread.lead_id)!==input.leadId)throw new Response("Canonical conversation/lead/customer link is required",{status:409});if(!lead||text(lead.customer_id)!==input.customerId)throw new Response("Canonical lead/customer link is required",{status:409});}

export async function recordWhatsAppLeadAttribution(db:Db,input:{sourcePlatform:WhatsAppAttributionPlatform;sourceEventId:string;leadId:string;customerId:string;threadId:string;campaignId?:string|null;adId?:string|null;formId?:string|null;clickId?:string|null;utmSource?:string|null;utmMedium?:string|null;utmCampaign?:string|null;metadata?:Record<string,unknown>;now?:number}){await ensureWhatsAppConversionFeedback(db);const sourceEventId=text(input.sourceEventId);if(!sourceEventId)throw new Response("Source event id is required",{status:400});await canonicalLink(db,input);const existing=await db.prepare("SELECT * FROM whatsapp_lead_attribution WHERE source_platform=? AND source_event_id=?").bind(input.sourcePlatform,sourceEventId).first<Row>();if(existing){if(text(existing.lead_id)!==input.leadId||text(existing.customer_id)!==input.customerId||text(existing.thread_id)!==input.threadId)throw new Response("Source event id is already linked to another canonical lead",{status:409});return{attribution:existing,duplicatePrevented:true,externalMutation:false};}const now=input.now??Date.now(),id=uid("WATTR");await db.prepare("INSERT INTO whatsapp_lead_attribution (id,source_platform,source_event_id,lead_id,customer_id,thread_id,campaign_id,ad_id,form_id,click_id,utm_source,utm_medium,utm_campaign,metadata_json,created_at,updated_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)").bind(id,input.sourcePlatform,sourceEventId,input.leadId,input.customerId,input.threadId,text(input.campaignId)||null,text(input.adId)||null,text(input.formId)||null,text(input.clickId)||null,text(input.utmSource)||null,text(input.utmMedium)||null,text(input.utmCampaign)||null,JSON.stringify(input.metadata||{}),now,now).run();return{attribution:await db.prepare("SELECT * FROM whatsapp_lead_attribution WHERE id=?").bind(id).first<Row>(),duplicatePrevented:false,externalMutation:false};}

export async function recordWhatsAppConversionFact(db:Db,input:{eventType:"lead_qualified"|"booking_created"|"payment_captured";businessReference:string;leadId:string;customerId:string;threadId:string;bookingId?:string|null;paymentId?:string|null;valueMinor?:number;currency?:string;occurredAt?:number}){await ensureWhatsAppConversionFeedback(db);if(!allowedEvents.has(input.eventType)||!text(input.businessReference))throw new Response("Valid conversion event and business reference are required",{status:400});await canonicalLink(db,input);if(input.eventType!=="lead_qualified"){const bookingId=text(input.bookingId);if(!bookingId)throw new Response("Booking id is required for booking/payment conversion",{status:400});const booking=await db.prepare("SELECT customer_id FROM canonical_bookings WHERE id=?").bind(bookingId).first<Row>().catch(()=>null);if(!booking||text(booking.customer_id)!==input.customerId)throw new Response("Canonical booking/customer link is required",{status:409});}const existing=await db.prepare("SELECT * FROM whatsapp_conversion_facts WHERE event_type=? AND business_reference=?").bind(input.eventType,input.businessReference).first<Row>();let factId=text(existing?.id);const duplicatePrevented=Boolean(existing);if(!existing){factId=uid("WCF");const now=Date.now();await db.prepare("INSERT INTO whatsapp_conversion_facts (id,event_type,business_reference,lead_id,customer_id,thread_id,booking_id,payment_id,value_minor,currency,occurred_at,created_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?)").bind(factId,input.eventType,input.businessReference,input.leadId,input.customerId,input.threadId,text(input.bookingId)||null,text(input.paymentId)||null,Math.max(0,Math.trunc(Number(input.valueMinor||0))),text(input.currency)||"INR",input.occurredAt??now,now).run();}const attribution=await db.prepare("SELECT * FROM whatsapp_lead_attribution WHERE lead_id=? AND customer_id=? AND thread_id=? ORDER BY created_at DESC LIMIT 1").bind(input.leadId,input.customerId,input.threadId).first<Row>();if(attribution){const platform=text(attribution.source_platform) as WhatsAppAttributionPlatform,payload={eventName:input.eventType,eventReference:input.businessReference,occurredAt:input.occurredAt??Date.now(),leadId:input.leadId,bookingId:text(input.bookingId)||null,paymentId:text(input.paymentId)||null,valueMinor:Math.max(0,Math.trunc(Number(input.valueMinor||0))),currency:text(input.currency)||"INR",sourceEventId:text(attribution.source_event_id),campaignId:text(attribution.campaign_id)||null,adId:text(attribution.ad_id)||null,formId:text(attribution.form_id)||null,clickId:text(attribution.click_id)||null};await db.prepare("INSERT OR IGNORE INTO whatsapp_conversion_feedback_outbox (id,fact_id,platform,payload_json,status,attempts,next_attempt_at,last_error,external_mutation,created_at,updated_at) VALUES (?,?,?,?,'pending',0,?,NULL,0,?,?)").bind(uid("WCFB"),factId,platform,JSON.stringify(payload),Date.now(),Date.now(),Date.now()).run();}return{fact:await db.prepare("SELECT * FROM whatsapp_conversion_facts WHERE id=?").bind(factId).first<Row>(),duplicatePrevented,feedbackQueued:Boolean(attribution),externalMutation:false};}

export async function processWhatsAppConversionFeedback(db:Db,input:{now?:number;mode?:"simulator";limit?:number;failPlatforms?:WhatsAppAttributionPlatform[];maxAttempts?:number}={}){await ensureWhatsAppConversionFeedback(db);if(input.mode&&input.mode!=="simulator")throw new Response("Live ad-account mutation is disabled during closure",{status:409});const now=input.now??Date.now(),limit=Math.min(100,Math.max(1,input.limit||25)),maxAttempts=Math.max(1,input.maxAttempts||3),fail=new Set(input.failPlatforms||[]),due=await db.prepare("SELECT * FROM whatsapp_conversion_feedback_outbox WHERE status IN ('pending','retry') AND next_attempt_at<=? ORDER BY created_at LIMIT ?").bind(now,limit).all<Row>(),results:Array<Record<string,unknown>>=[];for(const row of due.results){const id=text(row.id),platform=text(row.platform) as WhatsAppAttributionPlatform,attempts=Number(row.attempts||0)+1;if(fail.has(platform)){const dead=attempts>=maxAttempts;await db.prepare("UPDATE whatsapp_conversion_feedback_outbox SET status=?,attempts=?,next_attempt_at=?,last_error='uat_simulated_provider_failure',external_mutation=0,updated_at=? WHERE id=?").bind(dead?"dead_letter":"retry",attempts,dead?now:now+attempts*60_000,now,id).run();results.push({id,platform,status:dead?"dead_letter":"retry",attempts,externalMutation:false});continue;}await db.prepare("UPDATE whatsapp_conversion_feedback_outbox SET status='simulated_delivered',attempts=?,next_attempt_at=?,last_error=NULL,external_mutation=0,updated_at=? WHERE id=?").bind(attempts,now,now,id).run();results.push({id,platform,status:"simulated_delivered",attempts,externalMutation:false});}return{processed:results.length,results,mode:"simulator",externalMutation:false};}

export async function whatsappConversionReconciliation(db:Db,input:{from?:number;to?:number}={}){await ensureWhatsAppConversionFeedback(db);const from=input.from??0,to=input.to??Number.MAX_SAFE_INTEGER,[sources,facts,feedback]=await Promise.all([db.prepare("SELECT source_platform,COUNT(*) count FROM whatsapp_lead_attribution WHERE created_at>=? AND created_at<=? GROUP BY source_platform").bind(from,to).all<Row>(),db.prepare("SELECT event_type,COUNT(*) count,SUM(value_minor) value_minor FROM whatsapp_conversion_facts WHERE occurred_at>=? AND occurred_at<=? GROUP BY event_type").bind(from,to).all<Row>(),db.prepare("SELECT platform,status,COUNT(*) count,SUM(attempts) attempts FROM whatsapp_conversion_feedback_outbox WHERE created_at>=? AND created_at<=? GROUP BY platform,status").bind(from,to).all<Row>()]);return{from,to,sourceLeads:sources.results,conversionFacts:facts.results,feedback:feedback.results,liveAdMutation:false};}
