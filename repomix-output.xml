 if(input.action==="report_quality_incident"){const severity=String(input.severity||"") as "attention"|"urgent"|"critical",summary=String(input.summary||"").trim(),actionTaken=String(input.actionTaken||"").trim();if(!["attention","urgent","critical"].includes(severity)||summary.length<5)throw new Response("Food quality incident severity and summary are required",{status:400});let mediaId:string|null=null;if(String(input.mediaRef||"").trim())mediaId=String((await proofAsset(db,order,String(input.mediaRef),"food_quality_incident")).id);const id=crypto.randomUUID();await db.prepare("INSERT INTO food_quality_incidents (id,order_id,sku,lot_id,severity,summary,action_taken,media_id,status,ops_status,reported_by,reported_at,updated_at) VALUES (?,?,?,?,?,?,?,?,'open','queued',?,?,?)").bind(id,order.id,order.sku,order.lot_id??null,severity,summary,actionTaken,mediaId,input.actorId,now,now).run();await incidentEvent(db,id,String(order.id),"reported",input.actorId,{severity,summary,actionTaken,mediaRef:mediaId?`media://asset/${mediaId}`:null,orderPreserved:true,automaticRefund:false,automaticSupplierSettlementChange:false});await event(db,String(order.id),"quality_incident_reported",input.actorId,{incidentId:id,severity,opsEscalation:true});return remember(db,input,{orderId:order.id,incidentId:id,status:"ops_escalation",orderPreserved:true,automaticRefund:false,automaticSupplierSettlementChange:false})}
 if(input.action==="acknowledge_incident"){const incidentId=String(input.incidentId||"").trim(),incident=await db.prepare("SELECT * FROM food_quality_incidents WHERE id=? AND order_id=?").bind(incidentId,order.id).first<Row>();if(!incident)throw new Response("Food quality incident not found",{status:404});if(incident.customer_acknowledged_at)return remember(db,input,{orderId:order.id,incidentId,status:String(incident.status),duplicateAcknowledgement:true});await db.prepare("UPDATE food_quality_incidents SET customer_acknowledged_at=?,updated_at=? WHERE id=?").bind(now,now,incidentId).run();await incidentEvent(db,incidentId,String(order.id),"customer_acknowledged",input.actorId,{automaticRefund:false});return remember(db,input,{orderId:order.id,incidentId,status:String(incident.status),customerAcknowledged:true,automaticRefund:false})}
 if(input.action==="resolve_incident"){const incidentId=String(input.incidentId||"").trim(),resolution=String(input.resolution||"").trim();if(resolution.length<5)throw new Response("Food quality incident resolution is required",{status:400});const incident=await db.prepare("SELECT * FROM food_quality_incidents WHERE id=? AND order_id=?").bind(incidentId,order.id).first<Row>();if(!incident)throw new Response("Food quality incident not found",{status:404});await db.prepare("UPDATE food_quality_incidents SET status='resolved',ops_status='resolved',resolution=?,resolved_by=?,resolved_at=?,updated_at=? WHERE id=?").bind(resolution,input.actorId,now,now,incidentId).run();await incidentEvent(db,incidentId,String(order.id),"resolved",input.actorId,{resolution,automaticRefund:false,automaticSupplierSettlementChange:false});return remember(db,input,{orderId:order.id,incidentId,status:"resolved",automaticRefund:false,automaticSupplierSettlementChange:false})}
 throw new Response("Unsupported Food proof action",{status:400})}
export async function getFoodProofSnapshot(db:D1Database,orderId:string){const order=await context(db,orderId),[media,incidents]=await Promise.all([db.prepare("SELECT a.id,a.purpose,a.scan_status,a.access_status,a.retention_status,m.sku,m.lot_id,a.created_at,a.updated_at FROM service_media_assets a JOIN food_media_order_bindings m ON m.media_id=a.id WHERE a.booking_id=? AND a.purpose LIKE 'food_%' ORDER BY a.created_at DESC").bind(order.id).all<Row>(),db.prepare("SELECT * FROM food_quality_incidents WHERE order_id=? ORDER BY reported_at DESC").bind(order.id).all<Row>()]);return{orderId:order.id,customerId:order.customer_id,sku:order.sku,lotId:order.lot_id??null,status:order.status,fulfilmentStatus:order.fulfilment_status,media:media.results.map(row=>({...row,mediaRef:`media://asset/${row.id}`})),incidents:incidents.results,inventoryMode:"uat_seed",productionInventoryVerified:false,productionLotVerified:false,storageAdapterConnected:false,scannerConnected:false,sandboxOnly:true}}
