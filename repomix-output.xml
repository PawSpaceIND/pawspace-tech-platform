 if(outcome==="draft_review_required"){const grounding=await verifiedGroundingRefs(db,providerResult.groundingRefs),safety=outputSafety({text:providerResult.text,groundingRefs:grounding.references,groundingVerified:grounding.verified,authorizedCustomerId:input.customerId,referencedCustomerIds:providerResult.referencedCustomerIds,highImpactAction:providerResult.highImpactAction,approvalReference:null});if(!safety.safe){handoffReason="policy_risk";policyDecision="blocked_high_impact";outcome="handoff";output=await handoff(db,{threadId:input.threadId,customerId:input.customerId,sessionId:session.id,reason:"policy_risk",actorEmail:input.actor.email,confidence:providerResult.confidence??intent.confidence});}}
