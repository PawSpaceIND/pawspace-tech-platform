  db.prepare("UPDATE referral_claims SET status='qualified',fraud_state='clear',first_booking_id=?,review_reason=NULL,updated_at=? WHERE id=?").bind(input.bookingId,now,input.claimId),
  // The monthly ceiling is enforced INSIDE the insert, not by the advisory count read above. That count
