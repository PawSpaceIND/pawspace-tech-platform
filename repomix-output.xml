<file path="lib/training-cancellation.ts">
import{ensureTrainingFinanceTables,refreshTrainingFinanceReadModel}from"./training-finance";
import{creditWallet,ensurePawspaceWalletTables}from"./pawspace-wallet-governance";
import{restoreRedeemedPointsForCancelledBooking}from"./paw-points-governance";

type Row=Record<string,unknown>;
export type TrainingCancellationPolicyInput={cityId:string;feeType:"none"|"flat"|"percent_captured";feeValue:number;noShowTreatment:"chargeable"|"refundable";effectiveFrom:string;reason:string;actorId:string};

type Calculation={policyVersion:number;totalSessions:number;completedSessions:number;noShowSessions:number;cancelledSessions:number;chargeableSessions:number;commercialTotal:number;capturedAmount:number;perSessionValue:number;usedValue:number;cancellationFee:number;calculatedRefund:number;outstandingServiceValue:number};

export async function ensureTrainingCancellationTables(db:D1Database){await ensureTrainingFinanceTables(db);await db.batch([
 db.prepare("CREATE TABLE IF NOT EXISTS training_cancellation_policies (city_id TEXT PRIMARY KEY,status TEXT NOT NULL DEFAULT 'configuration_required',version INTEGER NOT NULL DEFAULT 1,refund_basis TEXT NOT NULL DEFAULT 'captured_less_pro_rata_used',fee_type TEXT,fee_value REAL,no_show_treatment TEXT,effective_from TEXT,effective_to TEXT,updated_by TEXT NOT NULL,reason TEXT NOT NULL,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS training_cancellation_cases (id TEXT PRIMARY KEY,programme_id TEXT NOT NULL,booking_id TEXT NOT NULL,customer_id TEXT NOT NULL,city_id TEXT NOT NULL,status TEXT NOT NULL,reason TEXT NOT NULL,request_idempotency_key TEXT NOT NULL UNIQUE,policy_version INTEGER,total_sessions INTEGER NOT NULL DEFAULT 0,completed_sessions INTEGER NOT NULL DEFAULT 0,no_show_sessions INTEGER NOT NULL DEFAULT 0,cancelled_sessions INTEGER NOT NULL DEFAULT 0,chargeable_sessions INTEGER NOT NULL DEFAULT 0,commercial_total REAL NOT NULL DEFAULT 0,captured_amount REAL NOT NULL DEFAULT 0,per_session_value REAL NOT NULL DEFAULT 0,used_value REAL NOT NULL DEFAULT 0,cancellation_fee REAL NOT NULL DEFAULT 0,calculated_refund REAL NOT NULL DEFAULT 0,approved_refund REAL,outstanding_service_value REAL NOT NULL DEFAULT 0,waive_outstanding INTEGER NOT NULL DEFAULT 0,requested_by TEXT NOT NULL,approved_by TEXT,approved_at INTEGER,updated_at INTEGER NOT NULL,created_at INTEGER NOT NULL)"),
 db.prepare("CREATE INDEX IF NOT EXISTS idx_training_cancellation_booking ON training_cancellation_cases(booking_id,status,updated_at)"),
 db.prepare("CREATE TABLE IF NOT EXISTS training_refund_instructions (id TEXT PRIMARY KEY,case_id TEXT NOT NULL UNIQUE,booking_id TEXT NOT NULL,payment_id TEXT,amount REAL NOT NULL,currency TEXT NOT NULL DEFAULT 'INR',status TEXT NOT NULL,execution_mode TEXT NOT NULL DEFAULT 'sandbox_not_connected',idempotency_key TEXT NOT NULL UNIQUE,provider_reference TEXT,live INTEGER NOT NULL DEFAULT 0,created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS training_credit_notes (id TEXT PRIMARY KEY,case_id TEXT NOT NULL UNIQUE,booking_id TEXT NOT NULL,invoice_id TEXT,amount REAL NOT NULL,currency TEXT NOT NULL DEFAULT 'INR',credit_note_number TEXT,status TEXT NOT NULL,live_tax_filing INTEGER NOT NULL DEFAULT 0,created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS training_credit_note_sequences (city_id TEXT NOT NULL,financial_year TEXT NOT NULL,next_number INTEGER NOT NULL DEFAULT 0,updated_at INTEGER NOT NULL,PRIMARY KEY(city_id,financial_year))"),
 db.prepare("CREATE TABLE IF NOT EXISTS training_cancellation_events (id TEXT PRIMARY KEY,case_id TEXT NOT NULL,booking_id TEXT NOT NULL,event_type TEXT NOT NULL,actor_id TEXT NOT NULL,reason TEXT NOT NULL,detail_json TEXT NOT NULL DEFAULT '{}',created_at INTEGER NOT NULL)"),
]);await db.prepare("INSERT OR IGNORE INTO training_cancellation_policies (city_id,status,version,refund_basis,fee_type,fee_value,no_show_treatment,effective_from,effective_to,updated_by,reason,updated_at) VALUES ('blr','configuration_required',1,'captured_less_pro_rata_used',NULL,NULL,NULL,NULL,NULL,'system','Training cancellation/refund policy must be explicitly configured before refunds are calculated',?)").bind(Date.now()).run();}

async function cancellationEvent(db:D1Database,caseId:string,bookingId:string,eventType:string,actorId:string,reason:string,detail:unknown){await db.prepare("INSERT INTO training_cancellation_events (id,case_id,booking_id,event_type,actor_id,reason,detail_json,created_at) VALUES (?,?,?,?,?,?,?,?)").bind(crypto.randomUUID(),caseId,bookingId,eventType,actorId,reason,JSON.stringify(detail),Date.now()).run();}
async function context(db:D1Database,bookingId:string){await ensureTrainingCancellationTables(db);const row=await db.prepare("SELECT p.*,b.total_amount,b.currency,b.status booking_status,pay.id payment_id,pay.amount payment_amount,pay.amount_due_now,pay.status payment_status FROM training_programmes p JOIN canonical_bookings b ON b.id=p.booking_id LEFT JOIN booking_payments pay ON pay.booking_id=p.booking_id WHERE p.booking_id=?").bind(bookingId).first<Row>();if(!row)throw new Response("Canonical Training programme not found",{status:404});return row;}
async function calculate(db:D1Database,row:Row):Promise<Calculation|null>{const policy=await db.prepare("SELECT * FROM training_cancellation_policies WHERE city_id=?").bind(row.city_id).first<Row>();if(!policy||String(policy.status)!=="published"||!policy.fee_type||!policy.no_show_treatment)return null;const counts=await db.prepare("SELECT COUNT(*) total,SUM(CASE WHEN status='completed' THEN 1 ELSE 0 END) completed,SUM(CASE WHEN status='no_show' THEN 1 ELSE 0 END) no_show,SUM(CASE WHEN status='cancelled' THEN 1 ELSE 0 END) cancelled FROM training_sessions WHERE programme_id=?").bind(row.id).first<Row>();const totalSessions=Number(counts?.total||row.total_sessions||0),completedSessions=Number(counts?.completed||0),noShowSessions=Number(counts?.no_show||0),cancelledSessions=Number(counts?.cancelled||0),chargeableSessions=completedSessions+(String(policy.no_show_treatment)==="chargeable"?noShowSessions:0),commercialTotal=Number(row.total_amount||0),capturedAmount=String(row.payment_status)==="captured"?Number(row.amount_due_now||0):0,perSessionValue=totalSessions?Math.round(commercialTotal/totalSessions*100)/100:0,usedValue=Math.round(chargeableSessions*perSessionValue*100)/100,feeType=String(policy.fee_type),feeValue=Math.max(0,Number(policy.fee_value||0));let cancellationFee=feeType==="flat"?feeValue:feeType==="percent_captured"?Math.round(capturedAmount*feeValue)/100:0;cancellationFee=Math.round(Math.min(capturedAmount,cancellationFee)*100)/100;const calculatedRefund=Math.round(Math.max(0,Math.min(capturedAmount,capturedAmount-usedValue-cancellationFee))*100)/100,outstandingServiceValue=Math.round(Math.max(0,usedValue+cancellationFee-capturedAmount)*100)/100;return{policyVersion:Number(policy.version||1),totalSessions,completedSessions,noShowSessions,cancelledSessions,chargeableSessions,commercialTotal,capturedAmount,perSessionValue,usedValue,cancellationFee,calculatedRefund,outstandingServiceValue};}
async function writeCalculation(db:D1Database,caseId:string,calc:Calculation,status:string){await db.prepare("UPDATE training_cancellation_cases SET status=?,policy_version=?,total_sessions=?,completed_sessions=?,no_show_sessions=?,cancelled_sessions=?,chargeable_sessions=?,commercial_total=?,captured_amount=?,per_session_value=?,used_value=?,cancellation_fee=?,calculated_refund=?,outstanding_service_value=?,updated_at=? WHERE id=?").bind(status,calc.policyVersion,calc.totalSessions,calc.completedSessions,calc.noShowSessions,calc.cancelledSessions,calc.chargeableSessions,calc.commercialTotal,calc.capturedAmount,calc.perSessionValue,calc.usedValue,calc.cancellationFee,calc.calculatedRefund,calc.outstandingServiceValue,Date.now(),caseId).run();}

async function restoreCancelledBookingCredits(db:D1Database,row:Row,actorId:string){const bookingId=String(row.booking_id),customerId=String(row.customer_id);await ensurePawspaceWalletTables(db);const redeemedWallet=await db.prepare("SELECT customer_id,amount FROM pawspace_wallet_ledger WHERE idempotency_key=?").bind(`wallet-redeem:${bookingId}`).first<Row>();let wallet={bookingId,amountRestored:0,alreadyRestored:false,notRequired:true};if(redeemedWallet){if(String(redeemedWallet.customer_id)!==customerId)throw new Response("Redeemed wallet credit belongs to another customer",{status:409});const principal=Math.max(0,-Number(redeemedWallet.amount||0));if(principal>0){const result=await creditWallet(db,{customerId,amount:principal,source:"cancellation",sourceId:bookingId,idempotencyKey:`wallet-cancellation-restore:${bookingId}`,note:`Restored wallet principal after cancelled booking ${bookingId}`,actorId});wallet={bookingId,amountRestored:result.alreadyCredited?0:principal,alreadyRestored:Boolean(result.alreadyCredited),notRequired:false};}}const pawPoints=await restoreRedeemedPointsForCancelledBooking(db,{customerId,bookingId,actorId});return{wallet,pawPoints};}

export async function requestTrainingCancellation(db:D1Database,input:{bookingId:string;reason:string;idempotencyKey:string;actorId:string}){if(!input.bookingId||input.reason.trim().length<8||!input.idempotencyKey)throw new Response("Booking, clear cancellation reason and idempotency key are required",{status:400});const row=await context(db,input.bookingId);if(["completed","completed_with_exceptions","cancelled"].includes(String(row.status)))throw new Response("Terminal or cancelled Training programmes cannot open a new cancellation request",{status:409});const prior=await db.prepare("SELECT * FROM training_cancellation_cases WHERE request_idempotency_key=?").bind(input.idempotencyKey).first<Row>();if(prior)return{...prior,duplicatePrevented:true};const open=await db.prepare("SELECT * FROM training_cancellation_cases WHERE booking_id=? AND status NOT IN ('rejected','refund_completed_sandbox','approved_no_refund') ORDER BY created_at DESC LIMIT 1").bind(input.bookingId).first<Row>();if(open)return{...open,duplicatePrevented:true};const now=Date.now(),caseId=`TCAN-${crypto.randomUUID().slice(0,12).toUpperCase()}`,calc=await calculate(db,row),status=calc?(calc.outstandingServiceValue>0?"calculated_outstanding_review":"calculated"):"blocked_policy_configuration";await db.prepare("INSERT INTO training_cancellation_cases (id,programme_id,booking_id,customer_id,city_id,status,reason,request_idempotency_key,requested_by,updated_at,created_at) VALUES (?,?,?,?,?,?,?,?,?,?,?)").bind(caseId,row.id,row.booking_id,row.customer_id,row.city_id,status,input.reason.trim(),input.idempotencyKey,input.actorId,now,now).run();if(calc)await writeCalculation(db,caseId,calc,status);await cancellationEvent(db,caseId,input.bookingId,"requested",input.actorId,input.reason,{status,calculation:calc,liveRefund:false});return{caseId,status,calculation:calc,duplicatePrevented:false,liveRefund:false};}

export async function saveTrainingCancellationPolicy(db:D1Database,input:TrainingCancellationPolicyInput){await ensureTrainingCancellationTables(db);if(!input.cityId||!["none","flat","percent_captured"].includes(input.feeType)||!["chargeable","refundable"].includes(input.noShowTreatment)||!Number.isFinite(input.feeValue)||input.feeValue<0||(input.feeType==="percent_captured"&&input.feeValue>100)||!input.effectiveFrom||input.reason.trim().length<8)throw new Response("City, valid fee rule, no-show treatment, effective date and clear reason are required",{status:400});const current=await db.prepare("SELECT version FROM training_cancellation_policies WHERE city_id=?").bind(input.cityId).first<{version:number}>(),version=Number(current?.version||0)+1,now=Date.now();await db.prepare("INSERT INTO training_cancellation_policies (city_id,status,version,refund_basis,fee_type,fee_value,no_show_treatment,effective_from,effective_to,updated_by,reason,updated_at) VALUES (?,'published',?,'captured_less_pro_rata_used',?,?,?, ?,NULL,?,?,?) ON CONFLICT(city_id) DO UPDATE SET status='published',version=excluded.version,refund_basis=excluded.refund_basis,fee_type=excluded.fee_type,fee_value=excluded.fee_value,no_show_treatment=excluded.no_show_treatment,effective_from=excluded.effective_from,effective_to=NULL,updated_by=excluded.updated_by,reason=excluded.reason,updated_at=excluded.updated_at").bind(input.cityId,version,input.feeType,input.feeValue,input.noShowTreatment,input.effectiveFrom,input.actorId,input.reason,now).run();const blocked=await db.prepare("SELECT id,booking_id FROM training_cancellation_cases WHERE city_id=? AND status='blocked_policy_configuration'").bind(input.cityId).all<Row>();for(const item of blocked.results){const row=await context(db,String(item.booking_id)),calc=await calculate(db,row);if(calc)await writeCalculation(db,String(item.id),calc,calc.outstandingServiceValue>0?"calculated_outstanding_review":"calculated");}return{cityId:input.cityId,status:"published",version,refundBasis:"captured_less_pro_rata_used",feeType:input.feeType,feeValue:input.feeValue,noShowTreatment:input.noShowTreatment};}

export async function approveTrainingCancellation(db:D1Database,input:{caseId:string;reason:string;actorId:string;waiveOutstanding?:boolean}){await ensureTrainingCancellationTables(db);if(!input.caseId||input.reason.trim().length<8)throw new Response("Cancellation case and clear approval reason are required",{status:400});const caseRow=await db.prepare("SELECT * FROM training_cancellation_cases WHERE id=?").bind(input.caseId).first<Row>();if(!caseRow)throw new Response("Training cancellation case not found",{status:404});const caseStatus=String(caseRow.status),approvedStatuses=["approved_refund_ready","approved_no_refund","refund_processing_sandbox","refund_completed_sandbox","refund_failed_sandbox"];if(approvedStatuses.includes(caseStatus)){const cancelled=await context(db,String(caseRow.booking_id));await restoreCancelledBookingCredits(db,cancelled,input.actorId);throw new Response("Training cancellation case is not awaiting Finance approval",{status:409});}if(!["calculated","calculated_outstanding_review","blocked_policy_configuration"].includes(caseStatus))throw new Response("Training cancellation case is not awaiting Finance approval",{status:409});if(String(caseRow.requested_by)===String(input.actorId))throw new Response("Segregation of duties: the cancellation requester cannot approve their own refund",{status:409});const row=await context(db,String(caseRow.booking_id)),inFlight=await db.prepare("SELECT id,status FROM training_sessions WHERE programme_id=? AND status IN ('arrived','in_session') LIMIT 1").bind(row.id).first<Row>();if(inFlight)throw new Response(`Training programme cannot be cancelled while session ${String(inFlight.id)} is ${String(inFlight.status)}`,{status:409});const calc=await calculate(db,row);if(!calc)throw new Response("Training cancellation policy is not configured",{status:409});if(calc.outstandingServiceValue>0&&!input.waiveOutstanding)throw new Response("Consumed service value exceeds captured payment; Finance must explicitly waive the outstanding amount or resolve it before cancellation",{status:409});const active=await db.prepare("SELECT id,schedule_reservation_id FROM training_sessions WHERE programme_id=? AND status NOT IN ('completed','no_show','cancelled')").bind(row.id).all<Row>(),now=Date.now(),approvedRefund=calc.calculatedRefund,newCancelled=calc.cancelledSessions+active.results.length,statements=[];for(const session of active.results){statements.push(db.prepare("UPDATE training_sessions SET status='cancelled',updated_at=? WHERE id=?").bind(now,session.id));statements.push(db.prepare("UPDATE scheduling_reservations SET status='cancelled' WHERE id=?").bind(session.schedule_reservation_id));statements.push(db.prepare("INSERT OR IGNORE INTO training_session_events (id,session_id,programme_id,booking_id,event_type,actor_id,idempotency_key,detail_json,created_at) VALUES (?,?,?,?,?,?,?,?,?)").bind(crypto.randomUUID(),session.id,row.id,row.booking_id,"programme_cancelled",input.actorId,`${input.caseId}:cancel:${String(session.id)}`,JSON.stringify({caseId:input.caseId,reason:input.reason}),now));}
 const finalStatus=approvedRefund>0?"approved_refund_ready":"approved_no_refund";statements.push(db.prepare("UPDATE training_programmes SET status='cancelled',cancelled_sessions=?,updated_at=? WHERE id=?").bind(newCancelled,now,row.id));statements.push(db.prepare("UPDATE canonical_bookings SET status='cancelled',updated_at=? WHERE id=?").bind(now,row.booking_id));const workOrdersTable=await db.prepare("SELECT name FROM sqlite_master WHERE type='table' AND name='provider_work_orders'").first<Row>();if(workOrdersTable)statements.push(db.prepare("UPDATE provider_work_orders SET status='cancelled',updated_at=? WHERE booking_id=?").bind(now,row.booking_id));statements.push(db.prepare("UPDATE training_cancellation_cases SET status=?,policy_version=?,total_sessions=?,completed_sessions=?,no_show_sessions=?,cancelled_sessions=?,chargeable_sessions=?,commercial_total=?,captured_amount=?,per_session_value=?,used_value=?,cancellation_fee=?,calculated_refund=?,approved_refund=?,outstanding_service_value=?,waive_outstanding=?,approved_by=?,approved_at=?,updated_at=? WHERE id=?").bind(finalStatus,calc.policyVersion,calc.totalSessions,calc.completedSessions,calc.noShowSessions,newCancelled,calc.chargeableSessions,calc.commercialTotal,calc.capturedAmount,calc.perSessionValue,calc.usedValue,calc.cancellationFee,calc.calculatedRefund,approvedRefund,calc.outstandingServiceValue,input.waiveOutstanding?1:0,input.actorId,now,now,input.caseId));if(approvedRefund>0){const refundId=`TRF-${crypto.randomUUID().slice(0,12).toUpperCase()}`;statements.push(db.prepare("INSERT INTO training_refund_instructions (id,case_id,booking_id,payment_id,amount,currency,status,execution_mode,idempotency_key,live,created_at,updated_at) VALUES (?,?,?,?,?,'INR','instruction_ready_sandbox','sandbox_not_connected',?,0,?,?)").bind(refundId,input.caseId,row.booking_id,row.payment_id??null,approvedRefund,`training-refund:${input.caseId}`,now,now));const invoice=await db.prepare("SELECT id,invoice_number,status FROM training_finance_invoices WHERE booking_id=?").bind(row.booking_id).first<Row>();if(invoice?.invoice_number)statements.push(db.prepare("INSERT INTO training_credit_notes (id,case_id,booking_id,invoice_id,amount,currency,status,live_tax_filing,created_at,updated_at) VALUES (?,?,?,?,?,'INR','draft_ready_for_number',0,?,?)").bind(`TCN-${crypto.randomUUID().slice(0,12).toUpperCase()}`,input.caseId,row.booking_id,invoice.id,approvedRefund,now,now));}await db.batch(statements);const commercialRestoration=await restoreCancelledBookingCredits(db,row,input.actorId);await cancellationEvent(db,input.caseId,String(row.booking_id),"approved",input.actorId,input.reason,{approvedRefund,waiveOutstanding:Boolean(input.waiveOutstanding),cancelledFutureSessions:active.results.length,commercialRestoration,liveRefund:false});await refreshTrainingFinanceReadModel(db);return{caseId:input.caseId,status:finalStatus,approvedRefund,cancelledFutureSessions:active.results.length,outstandingServiceValue:calc.outstandingServiceValue,waiveOutstanding:Boolean(input.waiveOutstanding),refundExecution:approvedRefund>0?"instruction_ready_sandbox":"not_required",commercialRestoration,liveRefund:false};}

export async function updateTrainingRefundSandbox(db:D1Database,input:{caseId:string;nextStatus:"processing_sandbox"|"completed_sandbox"|"failed_sandbox";providerReference?:string;reason:string;actorId:string}){await ensureTrainingCancellationTables(db);if(!input.caseId||!input.reason||input.reason.trim().length<8)throw new Response("Refund case and clear status reason are required",{status:400});const refund=await db.prepare("SELECT * FROM training_refund_instructions WHERE case_id=?").bind(input.caseId).first<Row>();if(!refund)throw new Response("Training refund instruction not found",{status:404});const transitions:Record<string,string[]>={instruction_ready_sandbox:["processing_sandbox","failed_sandbox"],processing_sandbox:["completed_sandbox","failed_sandbox"],failed_sandbox:["processing_sandbox"]};if(!(transitions[String(refund.status)]||[]).includes(input.nextStatus))throw new Response(`Training refund cannot move from ${String(refund.status)} to ${input.nextStatus}`,{status:409});if(input.nextStatus==="completed_sandbox"&&!String(input.providerReference||"").trim())throw new Response("Sandbox provider reference is required to reconcile a completed refund",{status:400});const caseStatus=input.nextStatus==="completed_sandbox"?"refund_completed_sandbox":input.nextStatus==="failed_sandbox"?"refund_failed_sandbox":"refund_processing_sandbox",now=Date.now();await db.batch([db.prepare("UPDATE training_refund_instructions SET status=?,provider_reference=COALESCE(?,provider_reference),updated_at=? WHERE case_id=?").bind(input.nextStatus,input.providerReference??null,now,input.caseId),db.prepare("UPDATE training_cancellation_cases SET status=?,updated_at=? WHERE id=?").bind(caseStatus,now,input.caseId)]);await cancellationEvent(db,input.caseId,String(refund.booking_id),`refund.${input.nextStatus}`,input.actorId,input.reason,{providerReference:input.providerReference??null,live:false});return{caseId:input.caseId,status:caseStatus,refundStatus:input.nextStatus,providerReference:input.providerReference??null,liveRefund:false};}

export async function issueTrainingCreditNote(db:D1Database,input:{caseId:string;reason:string;actorId:string}){await ensureTrainingCancellationTables(db);if(!input.caseId||input.reason.trim().length<8)throw new Response("Cancellation case and clear credit-note reason are required",{status:400});const note=await db.prepare("SELECT n.*,c.city_id FROM training_credit_notes n JOIN training_cancellation_cases c ON c.id=n.case_id WHERE n.case_id=?").bind(input.caseId).first<Row>();if(!note)throw new Response("Training credit note is not required or not ready",{status:404});if(note.credit_note_number)return{caseId:input.caseId,creditNoteNumber:String(note.credit_note_number),status:String(note.status),duplicatePrevented:true,liveTaxFiling:false};if(String(note.status)!=="draft_ready_for_number")throw new Response("Training credit note is not ready for numbering",{status:409});const now=Date.now(),date=new Date(now),year=date.getUTCMonth()>=3?date.getUTCFullYear():date.getUTCFullYear()-1,financialYear=`${String(year).slice(-2)}-${String(year+1).slice(-2)}`,cityId=String(note.city_id),cityCode=cityId.toUpperCase();await db.prepare("INSERT OR IGNORE INTO training_credit_note_sequences (city_id,financial_year,next_number,updated_at) VALUES (?,?,0,?)").bind(cityId,financialYear,now).run();const seq=await db.prepare("UPDATE training_credit_note_sequences SET next_number=next_number+1,updated_at=? WHERE city_id=? AND financial_year=? RETURNING next_number").bind(now,cityId,financialYear).first<{next_number:number}>();if(!seq)throw new Response("Training credit note sequence could not be reserved",{status:409});const number=`TCN-${cityCode}-${financialYear}-${String(seq.next_number).padStart(6,"0")}`,result=await db.prepare("UPDATE training_credit_notes SET credit_note_number=?,status='issued_uat',updated_at=? WHERE case_id=? AND credit_note_number IS NULL AND status='draft_ready_for_number'").bind(number,now,input.caseId).run();if(Number(result.meta.changes||0)!==1){const raced=await db.prepare("SELECT credit_note_number,status FROM training_credit_notes WHERE case_id=?").bind(input.caseId).first<Row>();if(raced?.credit_note_number)return{caseId:input.caseId,creditNoteNumber:String(raced.credit_note_number),status:String(raced.status),duplicatePrevented:true,liveTaxFiling:false};throw new Response("Training credit note could not be issued",{status:409});}await cancellationEvent(db,input.caseId,String(note.booking_id),"credit_note.issued_uat",input.actorId,input.reason,{creditNoteNumber:number,liveTaxFiling:false});return{caseId:input.caseId,creditNoteNumber:number,status:"issued_uat",duplicatePrevented:false,liveTaxFiling:false};}

export async function listTrainingCancellationFinance(db:D1Database){await ensureTrainingCancellationTables(db);const[policies,cases,refunds,creditNotes]=await Promise.all([db.prepare("SELECT * FROM training_cancellation_policies ORDER BY city_id").all<Row>(),db.prepare("SELECT * FROM training_cancellation_cases ORDER BY updated_at DESC LIMIT 150").all<Row>(),db.prepare("SELECT * FROM training_refund_instructions ORDER BY updated_at DESC LIMIT 150").all<Row>(),db.prepare("SELECT * FROM training_credit_notes ORDER BY updated_at DESC LIMIT 150").all<Row>()]);return{policies:policies.results,cases:cases.results,refunds:refunds.results,creditNotes:creditNotes.results,liveRefund:false,liveTaxFiling:false};}
