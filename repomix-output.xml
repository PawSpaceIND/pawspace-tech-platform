<file path="lib/walking-finance-governance.ts">
import{ensureWalkingLifecycleTables}from"./walking-lifecycle";

type Row=Record<string,unknown>;
export type WalkingFinanceAction="request_cancel"|"approve_cancel"|"record_session_payment"|"record_refund"|"prepare_settlement"|"reconcile";
export type WalkingFinanceInput={bookingId:string;action:WalkingFinanceAction;actorId:string;idempotencyKey:string;reason?:string;sessionId?:string;paymentReference?:string;approvedRefundAmount?:number;refundReference?:string};
const parse=<T>(value:unknown,fallback:T):T=>{try{return JSON.parse(String(value??"")) as T}catch{return fallback}};
export async function ensureWalkingFinanceTables(db:D1Database){await ensureWalkingLifecycleTables(db);await db.batch([
 db.prepare("CREATE TABLE IF NOT EXISTS walking_finance_action_keys (idempotency_key TEXT PRIMARY KEY,booking_id TEXT NOT NULL,action TEXT NOT NULL,result_json TEXT NOT NULL,created_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS walking_cancellation_requests (id TEXT PRIMARY KEY,booking_id TEXT NOT NULL,requested_by TEXT NOT NULL,reason TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'policy_review_required',approved_refund_amount REAL,decision_by TEXT,decision_reason TEXT,created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS walking_cancellation_approval_claims (booking_id TEXT PRIMARY KEY NOT NULL,cancellation_request_id TEXT NOT NULL UNIQUE,created_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS walking_refund_ledger (id TEXT PRIMARY KEY,booking_id TEXT NOT NULL,cancellation_request_id TEXT,amount REAL NOT NULL,currency TEXT NOT NULL DEFAULT 'INR',status TEXT NOT NULL DEFAULT 'sandbox_pending',reference TEXT,policy_source TEXT NOT NULL,created_by TEXT NOT NULL,created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE UNIQUE INDEX IF NOT EXISTS idx_walking_refund_reference ON walking_refund_ledger(reference) WHERE reference IS NOT NULL"),
 db.prepare("CREATE UNIQUE INDEX IF NOT EXISTS idx_walking_payment_reference ON walking_session_payment_events(reference) WHERE reference IS NOT NULL"),
 db.prepare("CREATE TABLE IF NOT EXISTS walking_walker_settlement_ledger (booking_id TEXT PRIMARY KEY,provider_id TEXT NOT NULL,gross_paid_value REAL NOT NULL,currency TEXT NOT NULL DEFAULT 'INR',base_payout REAL,travel_allowance REAL,incentives REAL,penalties REAL,payout_amount REAL,payout_rule_status TEXT NOT NULL DEFAULT 'rule_pending',tax_status TEXT NOT NULL DEFAULT 'configuration_required',approval_status TEXT NOT NULL DEFAULT 'not_ready',payout_status TEXT NOT NULL DEFAULT 'not_instructed',eligible_at INTEGER,approved_by TEXT,payout_reference TEXT,created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS walking_finance_reconciliation (id TEXT PRIMARY KEY,booking_id TEXT NOT NULL,booking_total REAL NOT NULL,completed_due_total REAL NOT NULL,paid_total REAL NOT NULL,refund_total REAL NOT NULL,net_paid_total REAL NOT NULL,unpaid_completed_total REAL NOT NULL,settlement_amount REAL,settlement_state TEXT NOT NULL,tax_state TEXT NOT NULL,status TEXT NOT NULL,detail_json TEXT NOT NULL DEFAULT '{}',checked_by TEXT NOT NULL,created_at INTEGER NOT NULL)"),
]);await db.prepare("INSERT OR IGNORE INTO walking_cancellation_approval_claims (booking_id,cancellation_request_id,created_at) SELECT booking_id,id,updated_at FROM walking_cancellation_requests WHERE status='approved' ORDER BY updated_at").run()}
async function context(db:D1Database,bookingId:string){await ensureWalkingFinanceTables(db);const row=await db.prepare("SELECT b.*,w.status work_order_status,p.status payment_status FROM canonical_bookings b LEFT JOIN provider_work_orders w ON w.booking_id=b.id LEFT JOIN booking_payments p ON p.booking_id=b.id WHERE b.id=? AND b.service_code='dog_walking'").bind(bookingId).first<Row>();if(!row)throw new Response("Canonical Dog Walking booking not found",{status:404});return row}
async function prior(db:D1Database,key:string){const row=await db.prepare("SELECT result_json FROM walking_finance_action_keys WHERE idempotency_key=?").bind(key).first<Row>();return row?parse<Record<string,unknown>>(row.result_json,{}):null}
async function remember(db:D1Database,input:WalkingFinanceInput,result:Record<string,unknown>){await db.prepare("INSERT INTO walking_finance_action_keys (idempotency_key,booking_id,action,result_json,created_at) VALUES (?,?,?,?,?)").bind(input.idempotencyKey,input.bookingId,input.action,JSON.stringify(result),Date.now()).run();return result}
function reason(input:WalkingFinanceInput){const value=String(input.reason||"").trim();if(value.length<3)throw new Response("A reason is required",{status:400});return value}
async function totals(db:D1Database,bookingId:string){const rows=await db.prepare("SELECT amount,status FROM walking_session_payment_events WHERE booking_id=?").bind(bookingId).all<Row>(),completedDue=rows.results.reduce((sum,row)=>sum+Number(row.amount||0),0),paid=rows.results.filter(row=>String(row.status)==="sandbox_paid").reduce((sum,row)=>sum+Number(row.amount||0),0),unpaid=rows.results.filter(row=>String(row.status)==="due").reduce((sum,row)=>sum+Number(row.amount||0),0),refund=await db.prepare("SELECT COALESCE(SUM(amount),0) total FROM walking_refund_ledger WHERE booking_id=? AND status='sandbox_recorded'").bind(bookingId).first<Row>();return{completedDue,paid,unpaid,refund:Number(refund?.total||0)}}
function concurrentApprovalError(error:unknown){return /walking_cancellation_approval_claims|UNIQUE constraint failed.*walking_cancellation_approval_claims|NOT NULL constraint failed.*walking_cancellation_approval_claims/i.test(error instanceof Error?error.message:String(error))}

export async function mutateWalkingFinance(db:D1Database,input:WalkingFinanceInput){if(!input.bookingId||!input.action||!input.actorId||!input.idempotencyKey)throw new Response("Booking, action, actor and idempotency key are required",{status:400});await ensureWalkingFinanceTables(db);const old=await prior(db,input.idempotencyKey);if(old)return{...old,duplicatePrevented:true};const booking=await context(db,input.bookingId),now=Date.now(),status=String(booking.status);
 if(input.action==="request_cancel"){
  if(["cancelled","completed"].includes(status))throw new Response("Closed Dog Walking bookings cannot accept cancellation requests",{status:409});const existing=await db.prepare("SELECT id FROM walking_cancellation_requests WHERE booking_id=? AND status='policy_review_required' LIMIT 1").bind(input.bookingId).first<Row>(),claimed=await db.prepare("SELECT cancellation_request_id FROM walking_cancellation_approval_claims WHERE booking_id=?").bind(input.bookingId).first<Row>();if(existing||claimed)throw new Response("A Dog Walking cancellation is already pending or approved",{status:409});const active=await db.prepare("SELECT id FROM walking_sessions WHERE booking_id=? AND status='in_progress' LIMIT 1").bind(input.bookingId).first<Row>();if(active)throw new Response("An in-progress walk must use the Operations incident workflow before cancellation",{status:409});const id=crypto.randomUUID();await db.prepare("INSERT INTO walking_cancellation_requests (id,booking_id,requested_by,reason,status,created_at,updated_at) VALUES (?,?,?,?, 'policy_review_required',?,?)").bind(id,input.bookingId,input.actorId,reason(input),now,now).run();return remember(db,input,{requestId:id,bookingId:input.bookingId,status:"policy_review_required",refundPolicy:"configuration_required",bookingPreserved:true})
 }
 if(input.action==="approve_cancel"){
  if(["cancelled","completed"].includes(status))throw new Response("Closed Dog Walking booking cannot be cancelled again",{status:409});const active=await db.prepare("SELECT id FROM walking_sessions WHERE booking_id=? AND status='in_progress' LIMIT 1").bind(input.bookingId).first<Row>();if(active)throw new Response("An in-progress walk must be resolved before Finance cancellation",{status:409});const request=await db.prepare("SELECT * FROM walking_cancellation_requests WHERE booking_id=? AND status='policy_review_required' ORDER BY created_at DESC LIMIT 1").bind(input.bookingId).first<Row>();if(!request)throw new Response("No Dog Walking cancellation request is awaiting policy review",{status:409});if(String(request.requested_by)===String(input.actorId))throw new Response("Segregation of duties: the cancellation requester cannot approve their own refund",{status:409});const current=await totals(db,input.bookingId),amount=Number(input.approvedRefundAmount);if(!Number.isFinite(amount)||amount<0||amount>current.paid)throw new Response("Approved refund amount must be explicit and cannot exceed sandbox-paid completed walks",{status:409});const why=reason(input),refundId=amount>0?crypto.randomUUID():null,statements=[db.prepare("INSERT INTO walking_cancellation_approval_claims (booking_id,cancellation_request_id,created_at) VALUES ((SELECT b.id FROM canonical_bookings b JOIN walking_cancellation_requests c ON c.booking_id=b.id WHERE c.id=? AND c.status='policy_review_required' AND b.status NOT IN ('cancelled','completed')),?,?)").bind(request.id,request.id,now),db.prepare("UPDATE walking_cancellation_requests SET status='approved',approved_refund_amount=?,decision_by=?,decision_reason=?,updated_at=? WHERE id=? AND status='policy_review_required'").bind(amount,input.actorId,why,now,request.id),db.prepare("UPDATE walking_cancellation_requests SET status='superseded',decision_by=?,decision_reason='Superseded by approved cancellation',updated_at=? WHERE booking_id=? AND id<>? AND status='policy_review_required'").bind(input.actorId,now,input.bookingId,request.id),db.prepare("UPDATE canonical_bookings SET status='cancelled',updated_at=? WHERE id=? AND status NOT IN ('cancelled','completed')").bind(now,input.bookingId),db.prepare("UPDATE provider_work_orders SET status='cancelled',updated_at=? WHERE booking_id=?").bind(now,input.bookingId),db.prepare("UPDATE walking_sessions SET status='cancelled',updated_at=? WHERE booking_id=? AND status NOT IN ('completed','cancelled')").bind(now,input.bookingId),db.prepare("UPDATE scheduling_reservations SET status='cancelled' WHERE group_id=? AND status NOT IN ('completed','cancelled')").bind(booking.schedule_group_id)];if(refundId)statements.push(db.prepare("INSERT INTO walking_refund_ledger (id,booking_id,cancellation_request_id,amount,currency,status,reference,policy_source,created_by,created_at,updated_at) VALUES (?,?,?,?,'INR','sandbox_pending',NULL,'explicit_finance_approval',?,?,?)").bind(refundId,input.bookingId,request.id,amount,input.actorId,now,now));let results;try{results=await db.batch(statements)}catch(error){if(concurrentApprovalError(error))throw new Response("Dog Walking cancellation was already approved or the booking closed",{status:409});throw error}if(!Number(results[1]?.meta?.changes)||!Number(results[3]?.meta?.changes))throw new Response("Dog Walking cancellation state changed concurrently",{status:409});return remember(db,input,{bookingId:input.bookingId,status:"cancelled",completedWalkChargesPreserved:true,approvedRefundAmount:amount,refundId,refundStatus:refundId?"sandbox_pending":"not_required"})
 }
 if(input.action==="record_session_payment"){
  const sessionId=String(input.sessionId||"").trim(),reference=String(input.paymentReference||"").trim();if(!sessionId||!reference)throw new Response("Completed walk session and sandbox payment reference are required",{status:400});const payment=await db.prepare("SELECT * FROM walking_session_payment_events WHERE booking_id=? AND session_id=?").bind(input.bookingId,sessionId).first<Row>();if(!payment)throw new Response("Completed Dog Walking payment-due event not found",{status:404});if(String(payment.status)==="sandbox_paid")return remember(db,input,{bookingId:input.bookingId,sessionId,status:"sandbox_paid",reference:payment.reference,amount:Number(payment.amount),duplicatePayment:true});if(String(payment.status)!=="due")throw new Response("Dog Walking payment event is not payable",{status:409});const used=await db.prepare("SELECT id FROM walking_session_payment_events WHERE reference=?").bind(reference).first<Row>();if(used)throw new Response("Dog Walking sandbox payment reference was already used",{status:409});await db.prepare("UPDATE walking_session_payment_events SET status='sandbox_paid',reference=?,updated_at=? WHERE id=? AND status='due'").bind(reference,now,payment.id).run();const current=await totals(db,input.bookingId),openSessions=await db.prepare("SELECT COUNT(*) count FROM walking_sessions WHERE booking_id=? AND status NOT IN ('completed','cancelled')").bind(input.bookingId).first<{count:number}>(),aggregateStatus=current.paid>0&&current.unpaid===0&&Number(openSessions?.count||0)===0?"paid":"partial";await db.prepare("UPDATE booking_payments SET status=?,detail_json=?,updated_at=? WHERE booking_id=?").bind(aggregateStatus,JSON.stringify({source:"walking_session_ledger",completedDue:current.completedDue,paid:current.paid,unpaid:current.unpaid,liveMoney:false}),now,input.bookingId).run();return remember(db,input,{bookingId:input.bookingId,sessionId,status:"sandbox_paid",reference,amount:Number(payment.amount),aggregateStatus,liveMoney:false})
 }
 if(input.action==="record_refund"){
  const reference=String(input.refundReference||"").trim();if(!reference)throw new Response("Sandbox refund reference is required",{status:400});const refund=await db.prepare("SELECT * FROM walking_refund_ledger WHERE booking_id=? AND status='sandbox_pending' ORDER BY created_at DESC LIMIT 1").bind(input.bookingId).first<Row>();if(!refund)throw new Response("No Dog Walking sandbox refund is pending",{status:409});const used=await db.prepare("SELECT id FROM walking_refund_ledger WHERE reference=?").bind(reference).first<Row>();if(used&&String(used.id)!==String(refund.id))throw new Response("Dog Walking refund reference was already used",{status:409});await db.prepare("UPDATE walking_refund_ledger SET status='sandbox_recorded',reference=?,updated_at=? WHERE id=?").bind(reference,now,refund.id).run();return remember(db,input,{bookingId:input.bookingId,refundId:refund.id,status:"sandbox_recorded",amount:Number(refund.amount),reference})
 }
 if(input.action==="prepare_settlement"){
  if(status!=="completed")throw new Response("Walker settlement can be prepared only after all canonical walks complete",{status:409});const current=await totals(db,input.bookingId);if(current.unpaid>0)throw new Response("All completed Dog Walking sessions must be sandbox-paid before settlement readiness",{status:409});await db.prepare("INSERT INTO walking_walker_settlement_ledger (booking_id,provider_id,gross_paid_value,currency,payout_rule_status,tax_status,approval_status,payout_status,eligible_at,created_at,updated_at) VALUES (?,?,?,'INR','rule_pending','configuration_required','not_ready','not_instructed',?,?,?) ON CONFLICT(booking_id) DO UPDATE SET provider_id=excluded.provider_id,gross_paid_value=excluded.gross_paid_value,eligible_at=excluded.eligible_at,updated_at=excluded.updated_at").bind(input.bookingId,booking.provider_id,current.paid,now,now,now).run();return remember(db,input,{bookingId:input.bookingId,status:"not_ready",grossPaidValue:current.paid,payoutRule:"rule_pending",tax:"configuration_required",payout:"not_instructed"})
 }
 if(input.action==="reconcile"){
  const current=await totals(db,input.bookingId),settlement=await db.prepare("SELECT * FROM walking_walker_settlement_ledger WHERE booking_id=?").bind(input.bookingId).first<Row>(),net=Math.max(0,current.paid-current.refund),settlementState=settlement?String(settlement.approval_status):status==="completed"?"attention_required":"not_due",taxState=settlement?String(settlement.tax_status):"configuration_required",attention=current.unpaid>0||settlementState==="attention_required"||taxState==="configuration_required",id=crypto.randomUUID();await db.prepare("INSERT INTO walking_finance_reconciliation (id,booking_id,booking_total,completed_due_total,paid_total,refund_total,net_paid_total,unpaid_completed_total,settlement_amount,settlement_state,tax_state,status,detail_json,checked_by,created_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)").bind(id,input.bookingId,booking.total_amount,current.completedDue,current.paid,current.refund,net,current.unpaid,settlement?.payout_amount??null,settlementState,taxState,attention?"attention_required":"balanced",JSON.stringify({sandboxOnly:true,bookingPaymentStatus:booking.payment_status}),input.actorId,now).run();return remember(db,input,{bookingId:input.bookingId,reconciliationId:id,status:attention?"attention_required":"balanced",completedDueTotal:current.completedDue,paidTotal:current.paid,refundTotal:current.refund,unpaidCompletedTotal:current.unpaid,netPaidTotal:net,settlementState,taxState})
 }
 throw new Response("Unsupported Dog Walking finance action",{status:400})
}
