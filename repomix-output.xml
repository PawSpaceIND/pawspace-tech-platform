  const w = await world();
  globalThis.__PTJA_QUIET_ENV__ = { HAPTIK_OUTBOUND_API_KEY: "scratch-not-a-real-key", HAPTIK_OUTBOUND_URL: "https://haptik.invalid/outbound" };
