  // back instead of racing.
  db.prepare("INSERT INTO referral_rewards (id,claim_id,programme_id,referrer_customer_id,referred_customer_id,source_booking_id,amount,status,valid_until,policy_snapshot_json,released_at,created_at,updated_at) VALUES (?,?,(SELECT ? WHERE (SELECT COUNT(*) FROM referral_rewards WHERE programme_id=? AND referrer_customer_id=? AND created_at>=? AND status IN ('pending','released','uat_reserved'))<?),?,?,?,?,'released',?,?,?, ?,?)").bind(rewardId,input.claimId,claim.programme_id,claim.programme_id,claim.referrer_customer_id,monthStart(),limit,claim.referrer_customer_id,claim.referred_customer_id,input.bookingId,rewardAmount,validUntil,claim.policy_snapshot_json,now,now,now),
  db.prepare("INSERT INTO referral_reward_events (id,reward_id,event_type,amount,reason,actor_id,created_at) VALUES (?,?, 'pending',?, 'First completed paid booking qualified',?,?)").bind(id("RWE"),rewardId,rewardAmount,input.actorId,now),
  db.prepare("INSERT INTO referral_reward_events (id,reward_id,event_type,amount,reason,actor_id,created_at) VALUES (?,?, 'released',?, 'Qualification checks passed',?,?)").bind(id("RWE"),rewardId,rewardAmount,input.actorId,now),
]);return{qualified:true,reward:{id:rewardId,amount:rewardAmount,status:"released",validUntil,sourceBookingId:input.bookingId},duplicatePrevented:false,testOnly:true,liveMoney:false};}

export async function reviewReferralClaim(db:Db,input:{claimId:string;decision:"clear"|"hold"|"reject";reason:string}){await ensureReferralTables(db);if(!input.reason.trim())throw new Error("Referral review reason is required");const claim=await db.prepare("SELECT * FROM referral_claims WHERE id=?").bind(input.claimId).first<Row>();if(!claim)throw new Error("Referral claim not found");const now=Date.now();if(input.decision==="clear")await db.prepare("UPDATE referral_claims SET status=CASE WHEN first_booking_id IS NULL THEN 'pending_booking' ELSE status END,fraud_state='clear',review_reason=?,updated_at=? WHERE id=?").bind(input.reason.trim(),now,input.claimId).run();else if(input.decision==="hold")await db.prepare("UPDATE referral_claims SET status='held',fraud_state='hold',review_reason=?,updated_at=? WHERE id=?").bind(input.reason.trim(),now,input.claimId).run();else await db.prepare("UPDATE referral_claims SET status='rejected',fraud_state='rejected',review_reason=?,updated_at=? WHERE id=?").bind(input.reason.trim(),now,input.claimId).run();return{claimId:input.claimId,decision:input.decision,status:input.decision==="clear"?"pending_booking":input.decision==="hold"?"held":"rejected"};}

export async function reserveReferralReward(db:Db,input:{rewardId:string;bookingId:string;customerId:string;idempotencyKey:string}){await ensureReferralTables(db);if(!input.rewardId||!input.bookingId||!input.customerId||!input.idempotencyKey)throw new Error("Reward, booking, customer and idempotency key are required");const prior=await db.prepare("SELECT * FROM referral_reward_reservations WHERE idempotency_key=?").bind(input.idempotencyKey).first<Row>();if(prior){if(String(prior.reward_id)!==input.rewardId||String(prior.booking_id)!==input.bookingId||String(prior.customer_id)!==input.customerId)throw new Error("Referral reward idempotency key was already used for a different reservation");return{reservation:prior,duplicatePrevented:true,bookingPricingAuthoritative:false};}const reward=await db.prepare("SELECT * FROM referral_rewards WHERE id=?").bind(input.rewardId).first<Row>();if(!reward||String(reward.referrer_customer_id)!==input.customerId)throw new Error("Referral reward does not belong to this customer");if(String(reward.status)!=="released")throw new Error("Referral reward is not available");if(Number(reward.valid_until)<Date.now())throw new Error("Referral reward has expired");const booking=await db.prepare("SELECT id,customer_id,service_code,status FROM canonical_bookings WHERE id=?").bind(input.bookingId).first<Row>();if(!booking||String(booking.customer_id)!==input.customerId)throw new Error("Canonical booking does not belong to this customer");if(["cancelled","completed"].includes(String(booking.status)))throw new Error("Referral reward cannot be reserved against this booking state");const snapshot=JSON.parse(String(reward.policy_snapshot_json||"{}")) as Record<string,unknown>,allowed=(snapshot.rewardUseServices as string[]|undefined)||[];if(!allowed.includes(String(booking.service_code)))throw new Error("Referral reward is not eligible for this service");const now=Date.now(),reservationId=id("RRR");await db.batch([
