<file path="lib/boarding-stay-lifecycle.ts">
import{ensureBoardingGovernanceTables}from"./boarding-governance";
import{getStayPaymentSchedule}from"./stay-split-payments";

type Row=Record<string,unknown>;
export type BoardingStayAction="accept"|"decline"|"submit_care_plan"|"check_in"|"care_event"|"request_extension"|"host_unavailable"|"no_show"|"check_out";
export type BoardingCarePlan={feeding?:string;medication?:string;emergencyContact?:string;vet?:string;specialInstructions?:string};
export type BoardingStayMutation={stayId:string;action:BoardingStayAction;actorId:string;idempotencyKey:string;reason?:string;carePlan?:BoardingCarePlan;careEventType?:string;detail?:Record<string,unknown>;requestedEnd?:string};

export async function ensureBoardingStayLifecycleTables(db:D1Database){await ensureBoardingGovernanceTables(db);await db.batch([
 db.prepare("CREATE TABLE IF NOT EXISTS boarding_stay_action_keys (idempotency_key TEXT PRIMARY KEY,stay_id TEXT NOT NULL,action TEXT NOT NULL,result_json TEXT NOT NULL,created_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS boarding_capacity_locks (stay_id TEXT PRIMARY KEY,booking_id TEXT NOT NULL,provider_id TEXT NOT NULL,starts_at TEXT NOT NULL,ends_at TEXT NOT NULL,capacity_units INTEGER NOT NULL,family_key TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'active',created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE INDEX IF NOT EXISTS idx_boarding_capacity_overlap ON boarding_capacity_locks(provider_id,status,starts_at,ends_at)"),
 db.prepare("CREATE TABLE IF NOT EXISTS boarding_care_plan_snapshots (stay_id TEXT PRIMARY KEY,booking_id TEXT NOT NULL,plan_json TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'ready',updated_by TEXT NOT NULL,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS boarding_extension_requests (id TEXT PRIMARY KEY,stay_id TEXT NOT NULL,booking_id TEXT NOT NULL,requested_end TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'commercial_quote_required',reason TEXT NOT NULL,actor_id TEXT NOT NULL,created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS boarding_recovery_cases (id TEXT PRIMARY KEY,stay_id TEXT NOT NULL,booking_id TEXT NOT NULL,failed_provider_id TEXT NOT NULL,reason_code TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'ops_escalation',replacement_provider_id TEXT,detail_json TEXT NOT NULL DEFAULT '{}',opened_at INTEGER NOT NULL,resolved_at INTEGER,updated_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS booking_customer_notifications (id TEXT PRIMARY KEY,booking_id TEXT NOT NULL,customer_id TEXT,channel TEXT NOT NULL,template_code TEXT NOT NULL,message TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'queued',event_id TEXT NOT NULL,created_at INTEGER NOT NULL)"),
 ]);}

function parse<T>(value:unknown,fallback:T):T{try{return JSON.parse(String(value??"")) as T;}catch{return fallback;}}
async function stayRow(db:D1Database,stayId:string){await ensureBoardingStayLifecycleTables(db);return db.prepare("SELECT s.*,b.schedule_group_id,b.status booking_status,b.provider_id booking_provider_id FROM boarding_stays s JOIN canonical_bookings b ON b.id=s.booking_id WHERE s.id=? AND b.service_code='boarding'").bind(stayId).first<Row>();}
export async function getBoardingStay(db:D1Database,stayId:string){return stayRow(db,stayId);}

export async function listBoardingStays(db:D1Database,input:{providerId?:string;customerId?:string;bookingId?:string}){await ensureBoardingStayLifecycleTables(db);const where=["b.service_code='boarding'"],binds:unknown[]=[];if(input.providerId){where.push("s.host_provider_id=?");binds.push(input.providerId);}if(input.customerId){where.push("s.customer_id=?");binds.push(input.customerId);}if(input.bookingId){where.push("s.booking_id=?");binds.push(input.bookingId);}const rows=await db.prepare(`SELECT s.*,b.schedule_group_id,b.status booking_status,b.total_amount,pay.amount_due_now,b.package_name,pr.name provider_name FROM boarding_stays s JOIN canonical_bookings b ON b.id=s.booking_id LEFT JOIN booking_payments pay ON pay.booking_id=b.id LEFT JOIN provider_capacity_profiles pr ON pr.id=s.host_provider_id WHERE ${where.join(" AND ")} ORDER BY s.check_in_at DESC`).bind(...binds).all<Row>();const out=[];for(const row of rows.results){const care=await db.prepare("SELECT status,plan_json,updated_at FROM boarding_care_plan_snapshots WHERE stay_id=?").bind(row.id).first<Row>();const extension=await db.prepare("SELECT id,requested_end,status,reason,created_at FROM boarding_extension_requests WHERE stay_id=? ORDER BY created_at DESC LIMIT 1").bind(row.id).first<Row>();const events=await db.prepare("SELECT id,event_type,actor_id,detail_json,created_at FROM boarding_stay_events WHERE stay_id=? ORDER BY created_at DESC LIMIT 30").bind(row.id).all<Row>();out.push({...row,carePlan:care?{status:String(care.status),plan:parse(care.plan_json,{}),updatedAt:Number(care.updated_at)}:null,extension:extension??null,events:events.results.map(item=>({...item,detail:parse(item.detail_json,{})}))});}return out;}

async function event(db:D1Database,stay:Row,eventType:string,actorId:string,detail:unknown={}){const id=crypto.randomUUID();await db.prepare("INSERT INTO boarding_stay_events (id,stay_id,booking_id,event_type,actor_id,detail_json,created_at) VALUES (?,?,?,?,?,?,?)").bind(id,stay.id,stay.booking_id,eventType,actorId,JSON.stringify(detail),Date.now()).run();return id;}
async function notify(db:D1Database,stay:Row,eventId:string,message:string){for(const channel of ["push","whatsapp"])await db.prepare("INSERT INTO booking_customer_notifications (id,booking_id,customer_id,channel,template_code,message,status,event_id,created_at) VALUES (?,?,?,?,?,?, 'queued',?,?)").bind(crypto.randomUUID(),stay.booking_id,stay.customer_id,channel,"boarding_stay_update",message,eventId,Date.now()).run();}

async function assertCapacity(db:D1Database,stay:Row,providerId=String(stay.host_provider_id),endsAt=String(stay.check_out_at)){const profile=await db.prepare("SELECT h.max_guest_pets,h.one_family_only,h.active,h.home_verified,h.kyc_status,h.background_check_status,p.live,p.status provider_status,p.services_json,p.zones_json FROM boarding_host_profiles h JOIN provider_capacity_profiles p ON p.id=h.provider_id WHERE h.provider_id=?").bind(providerId).first<Row>();if(!profile||Number(profile.active)!==1||!Boolean(profile.live)||String(profile.provider_status)!=="active")throw new Response("Boarding host is not active",{status:409});if(Number(profile.home_verified)!==1||String(profile.kyc_status)!=="verified"||String(profile.background_check_status)!=="verified")throw new Response("Boarding host verification is incomplete",{status:409});if(!parse<string[]>(profile.services_json,[]).includes("boarding")||!parse<string[]>(profile.zones_json,[]).includes(String(stay.zone_id)))throw new Response("Boarding host is not eligible for this zone",{status:409});const blocked=await db.prepare("SELECT id FROM provider_unavailability WHERE provider_id=? AND status='active' AND starts_at<? AND ends_at>? LIMIT 1").bind(providerId,endsAt,stay.check_in_at).first<Row>();if(blocked)throw new Response("Boarding host is unavailable during this stay window",{status:409});const locks=await db.prepare("SELECT stay_id,capacity_units,family_key FROM boarding_capacity_locks WHERE provider_id=? AND status='active' AND stay_id!=? AND starts_at<? AND ends_at>?").bind(providerId,stay.id,endsAt,stay.check_in_at).all<Row>();if(Number(profile.one_family_only)===1&&locks.results.length)throw new Response("This host accepts only one family at a time",{status:409});const used=locks.results.reduce((sum,row)=>sum+Number(row.capacity_units||0),0),max=Math.max(1,Number(profile.max_guest_pets||1));if(used+Number(stay.pet_count)>max)throw new Response("Boarding host capacity is no longer available",{status:409});return{maxGuestPets:max,usedGuestPets:used,availableGuestPets:max-used,oneFamilyOnly:Boolean(profile.one_family_only)};}

async function lockCapacity(db:D1Database,stay:Row,endsAt=String(stay.check_out_at)){const capacity=await assertCapacity(db,stay,String(stay.host_provider_id),endsAt),now=Date.now();
 // Atomic capacity lock (TOCTOU guard): assertCapacity above gives friendly errors, but the lock
 // itself only lands when overlapping active locks still leave room at WRITE time - two concurrent
 // accept/check-in calls can no longer both pass the read check and overfill the host.
 const providerId=String(stay.host_provider_id),startsAt=String(stay.check_in_at),units=Number(stay.pet_count),oneFamily=capacity.oneFamilyOnly?1:0;
 const locked=await db.prepare("INSERT INTO boarding_capacity_locks (stay_id,booking_id,provider_id,starts_at,ends_at,capacity_units,family_key,status,created_at,updated_at) SELECT ?,?,?,?,?,?,?,'active',?,? WHERE (SELECT COALESCE(SUM(capacity_units),0) FROM boarding_capacity_locks WHERE provider_id=? AND status='active' AND stay_id!=? AND starts_at<? AND ends_at>?)+?<=? AND (?=0 OR (SELECT COUNT(*) FROM boarding_capacity_locks WHERE provider_id=? AND status='active' AND stay_id!=? AND starts_at<? AND ends_at>?)=0) ON CONFLICT(stay_id) DO UPDATE SET provider_id=excluded.provider_id,starts_at=excluded.starts_at,ends_at=excluded.ends_at,capacity_units=excluded.capacity_units,family_key=excluded.family_key,status='active',updated_at=excluded.updated_at")
  .bind(stay.id,stay.booking_id,providerId,startsAt,endsAt,units,stay.customer_id,now,now,providerId,stay.id,endsAt,startsAt,units,capacity.maxGuestPets,oneFamily,providerId,stay.id,endsAt,startsAt).run();
 if(!Number(locked.meta?.changes||0))throw new Response("Boarding host capacity is no longer available",{status:409});
 return capacity;}
async function releaseCapacity(db:D1Database,stayId:string){await db.prepare("UPDATE boarding_capacity_locks SET status='released',updated_at=? WHERE stay_id=? AND status='active'").bind(Date.now(),stayId).run();}


// An idempotency key identifies ONE mutation of ONE record. This lookup used to match on the key alone
// and ran BEFORE the record was loaded, so a second caller reusing a key - a different provider, acting
// on a different customer's booking - was answered 200, had its mutation silently discarded, and
// received the FIRST caller's identifiers in the response body. The same collision swallowed a walker's
// decline with the earlier accept, so no recovery case opened and nobody learned the job had no
// provider. The columns needed to tell a replay from a collision were already being written here and
// simply never read back. Reused for a different record or a different action, a key is a CONFLICT and
// is refused rather than answered with somebody else's record. [PTJA-P1-F23]
