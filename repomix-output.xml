 let facts:Row[]=[];if(latest)facts=(await db.prepare("SELECT f.*,u.name employee_name FROM sales_productivity_facts f LEFT JOIN app_users u ON u.email=f.employee_email WHERE f.run_id=? AND f.team_code=? ORDER BY f.employee_email").bind(latest.id,team).all<Row>()).results;
 const rows=facts.map(row=>{const clocks=num(row.first_response_clocks),met=num(row.first_response_met),firstResponseRate=clocks?Number((met/clocks*100).toFixed(1)):null;const metrics={net_collected_revenue:num(row.net_collected_revenue),booking_conversions:num(row.booking_conversions),first_response_rate:firstResponseRate??-1,qualified_leads:num(row.qualified_leads),meaningful_actions:num(row.meaningful_actions)};return{employeeEmail:text(row.employee_email),employeeName:text(row.employee_name)||text(row.employee_email),teamCode:text(row.team_code),leadsAssigned:num(row.leads_assigned),assignmentsAccepted:num(row.assignments_accepted),meaningfulActions:num(row.meaningful_actions),qualifiedLeads:num(row.qualified_leads),firstResponseClocks:clocks,firstResponseMet:met,firstResponseBreached:num(row.first_response_breached),firstResponseRate,bookingConversions:num(row.booking_conversions),bookedRevenue:num(row.booked_revenue),collectedRevenue:num(row.collected_revenue),refunds:num(row.refunds),netCollectedRevenue:num(row.net_collected_revenue),cxEscalations:num(row.cx_escalations),consentBlocks:num(row.opt_out_or_consent_blocks),dataQualityBlocks:num(row.data_quality_blocks),rankValue:metrics[metric]};}).sort((a,b)=>b.rankValue-a.rankValue||b.bookingConversions-a.bookingConversions||b.netCollectedRevenue-a.netCollectedRevenue||a.employeeEmail.localeCompare(b.employeeEmail)).map((row,index)=>({...row,rank:index+1}));
