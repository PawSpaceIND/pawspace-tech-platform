async function audit(db:Db,actor:string,entityType:string,entityId:string,action:string,after:unknown,reason:string,before:unknown=null){await db.prepare("INSERT INTO gst_accounting_audit_events (id,entity_type,entity_id,action,before_json,after_json,actor_id,reason,created_at) VALUES (?,?,?,?,?,?,?,?,?)").bind(id("ga_audit"),entityType,entityId,action,before?JSON.stringify(before):null,JSON.stringify(after),actor,reason,now()).run();}
async function locked(db:Db,date:string){const period=date.slice(0,7);const row=await db.prepare("SELECT status FROM finance_close_periods WHERE period_code=?").bind(period).first<{status:string}>();return row?.status==="locked";}
async function activePolicy(db:Db,entityId:string,date:string){const p=await db.prepare("SELECT * FROM tax_policy_versions WHERE entity_id=? AND status='active' AND effective_from<=? AND (effective_to IS NULL OR effective_to>=?) ORDER BY version DESC LIMIT 1").bind(entityId,date,date).first<Row>();if(!p)throw new ConfigurationRequired("active_tax_policy");return p;}
async function registration(db:Db,entityId:string,date:string){const r=await db.prepare("SELECT * FROM tax_registrations WHERE entity_id=? AND status='active' AND (effective_from IS NULL OR effective_from<=?) AND (effective_to IS NULL OR effective_to>=?) ORDER BY approved_at DESC LIMIT 1").bind(entityId,date,date).first<Row>();if(!r)throw new ConfigurationRequired("active_tax_registration");return r;}
async function nextDocumentNumber(db:Db,entityId:string,documentType:string){const row=await db.prepare("UPDATE finance_document_series SET next_number=next_number+1,updated_at=? WHERE entity_id=? AND document_type=? AND status='active' RETURNING prefix,next_number-1 AS allocated,padding").bind(now(),entityId,documentType).first<Row>();if(!row)throw new ConfigurationRequired(`${documentType}_series`);return `${text(row.prefix)}${String(Number(row.allocated)).padStart(Number(row.padding),"0")}`;}
async function sha256(value:string){const bytes=new TextEncoder().encode(value),digest=await crypto.subtle.digest("SHA-256",bytes);return [...new Uint8Array(digest)].map(x=>x.toString(16).padStart(2,"0")).join("");}

export async function saveConfiguration(db:Db,input:Row,actor:string){await ensureGstAccountingTables(db);const action=text(input.action),reason=text(input.reason);if(reason.length<5)throw new Error("reason_required");
 if(action==="save_entity"){const entityId=text(input.id)||id("entity"),t=now();await db.prepare("INSERT INTO finance_entities (id,legal_name,country_code,status,created_at,updated_at) VALUES (?,?,?,'draft',?,?) ON CONFLICT(id) DO UPDATE SET legal_name=excluded.legal_name,country_code=excluded.country_code,updated_at=excluded.updated_at").bind(entityId,text(input.legalName),text(input.countryCode),t,t).run();await audit(db,actor,"entity",entityId,"saved",input,reason);return{entityId,status:"draft"};}
 if(action==="approve_entity"){await db.prepare("UPDATE finance_entities SET status='active',approved_by=?,approved_at=?,updated_at=? WHERE id=?").bind(actor,now(),now(),text(input.id)).run();await audit(db,actor,"entity",text(input.id),"approved",{status:"active"},reason);return{id:text(input.id),status:"active"};}
 if(action==="save_registration"){const entity=await db.prepare("SELECT id FROM finance_entities WHERE id=? AND status='active'").bind(text(input.entityId)).first();if(!entity)throw new ConfigurationRequired("active_finance_entity");const rid=text(input.id)||id("taxreg"),t=now();await db.prepare("INSERT INTO tax_registrations (id,entity_id,jurisdiction,registration_type,registration_reference,status,effective_from,effective_to,created_at,updated_at) VALUES (?,?,?,?,?,'draft',?,?,?,?) ON CONFLICT(id) DO UPDATE SET jurisdiction=excluded.jurisdiction,registration_type=excluded.registration_type,registration_reference=excluded.registration_reference,effective_from=excluded.effective_from,effective_to=excluded.effective_to,updated_at=excluded.updated_at").bind(rid,text(input.entityId),text(input.jurisdiction),text(input.registrationType),text(input.registrationReference),text(input.effectiveFrom)||null,text(input.effectiveTo)||null,t,t).run();await audit(db,actor,"registration",rid,"saved",input,reason);return{id:rid,status:"draft"};}
 if(action==="approve_registration"){await db.prepare("UPDATE tax_registrations SET status='active',approved_by=?,approved_at=?,updated_at=? WHERE id=?").bind(actor,now(),now(),text(input.id)).run();await audit(db,actor,"registration",text(input.id),"approved",{status:"active"},reason);return{id:text(input.id),status:"active"};}
 if(action==="save_policy"){const policyJson=typeof input.policy==="object"&&input.policy?JSON.stringify(input.policy):"";if(!policyJson)throw new Error("policy_required");const pid=text(input.id)||id("taxpol"),t=now();await db.prepare("INSERT INTO tax_policy_versions (id,entity_id,version,status,effective_from,effective_to,policy_json,created_at,updated_at) VALUES (?,?,?,'draft',?,?,?, ?,?)").bind(pid,text(input.entityId),num(input.version),text(input.effectiveFrom),text(input.effectiveTo)||null,policyJson,t,t).run();await audit(db,actor,"tax_policy",pid,"saved",input,reason);return{id:pid,status:"draft"};}
 if(action==="approve_policy"){if(!text(input.approvalReference))throw new Error("approval_reference_required");await db.prepare("UPDATE tax_policy_versions SET status='active',approval_reference=?,approved_by=?,approved_at=?,updated_at=? WHERE id=?").bind(text(input.approvalReference),actor,now(),now(),text(input.id)).run();await audit(db,actor,"tax_policy",text(input.id),"approved",{status:"active",approvalReference:text(input.approvalReference)},reason);return{id:text(input.id),status:"active"};}
 if(action==="save_classification"){const cid=text(input.id)||id("taxclass"),components=input.taxComponents;if(!Array.isArray(components)||!components.length)throw new ConfigurationRequired("approved_tax_components");await db.prepare("INSERT INTO tax_classifications (id,policy_id,service_code,classification_code,tax_component_json,place_of_supply_rule,input_tax_rule,created_at) VALUES (?,?,?,?,?,?,?,?) ON CONFLICT(policy_id,service_code) DO UPDATE SET classification_code=excluded.classification_code,tax_component_json=excluded.tax_component_json,place_of_supply_rule=excluded.place_of_supply_rule,input_tax_rule=excluded.input_tax_rule").bind(cid,text(input.policyId),text(input.serviceCode),text(input.classificationCode),JSON.stringify(components),text(input.placeOfSupplyRule),text(input.inputTaxRule),now()).run();await audit(db,actor,"tax_classification",cid,"saved",input,reason);return{id:cid};}
 if(action==="save_series"){await db.prepare("INSERT INTO finance_document_series (id,entity_id,document_type,prefix,next_number,padding,policy_id,status,updated_at) VALUES (?,?,?,?,?,?,?,'active',?) ON CONFLICT(entity_id,document_type) DO UPDATE SET prefix=excluded.prefix,padding=excluded.padding,policy_id=excluded.policy_id,status='active',updated_at=excluded.updated_at").bind(text(input.id)||id("series"),text(input.entityId),text(input.documentType),text(input.prefix),Math.max(1,num(input.nextNumber)||1),Math.max(1,num(input.padding)||6),text(input.policyId),now()).run();await audit(db,actor,"document_series",`${text(input.entityId)}:${text(input.documentType)}`,"saved",input,reason);return{status:"active"};}
 if(action==="save_mapping"){const mapping=typeof input.mapping==="object"&&input.mapping?JSON.stringify(input.mapping):"";if(!mapping)throw new ConfigurationRequired("accounting_mapping");const mid=text(input.id)||id("acctmap"),t=now();await db.prepare("INSERT INTO accounting_mapping_versions (id,entity_id,version,status,effective_from,mapping_json,created_at,updated_at) VALUES (?,?,?,'draft',?,?,?,?)").bind(mid,text(input.entityId),num(input.version),text(input.effectiveFrom),mapping,t,t).run();await audit(db,actor,"accounting_mapping",mid,"saved",input,reason);return{id:mid,status:"draft"};}
 if(action==="approve_mapping"){if(!text(input.approvalReference))throw new Error("approval_reference_required");await db.prepare("UPDATE accounting_mapping_versions SET status='active',approval_reference=?,approved_by=?,approved_at=?,updated_at=? WHERE id=?").bind(text(input.approvalReference),actor,now(),now(),text(input.id)).run();await audit(db,actor,"accounting_mapping",text(input.id),"approved",{status:"active"},reason);return{id:text(input.id),status:"active"};}
 throw new Error("unsupported_configuration_action");}

export async function issueInvoice(db:Db,input:Row,actor:string){await ensureGstAccountingTables(db);const entityId=text(input.entityId),date=text(input.issueDate),eventKey=text(input.sourceEventKey);if(!entityId||!date||!eventKey)throw new Error("invoice_source_required");if(await locked(db,date))throw new Error("period_locked");const prior=await db.prepare("SELECT * FROM finance_invoices WHERE source_event_key=?").bind(eventKey).first<Row>();if(prior)return prior;const policy=await activePolicy(db,entityId,date),reg=await registration(db,entityId,date);const lines=Array.isArray(input.lines)?input.lines as Row[]:[];if(!lines.length)throw new Error("invoice_lines_required");let subtotal=0,taxTotal=0;const snapshots=[] as Row[];for(const line of lines){const service=text(line.serviceCode),classification=await db.prepare("SELECT * FROM tax_classifications WHERE policy_id=? AND service_code=?").bind(text(policy.id),service).first<Row>();if(!classification)throw new ConfigurationRequired(`tax_classification:${service}`);const taxable=num(line.taxableAmount),components=JSON.parse(text(classification.tax_component_json)||"[]") as Array<{code:string;rate:number}>;if(!components.length)throw new ConfigurationRequired(`tax_components:${service}`);const tax=components.reduce((s,c)=>s+taxable*(Number(c.rate)/100),0);subtotal+=taxable;taxTotal+=tax;snapshots.push({lineKey:text(line.lineKey)||String(snapshots.length+1),serviceCode:service,classificationCode:text(classification.classification_code),components,taxableAmount:taxable,taxAmount:tax});}
 const number=await nextDocumentNumber(db,entityId,"invoice"),invoiceId=id("inv"),snapshot={policyId:text(policy.id),policyVersion:num(policy.version),registrationId:text(reg.id),registrationReference:text(reg.registration_reference),lines:snapshots};await db.prepare("INSERT INTO finance_invoices (id,invoice_number,entity_id,customer_id,source_type,source_id,source_event_key,policy_id,registration_id,issue_date,currency,subtotal,tax_total,total,status,tax_snapshot_json,document_reference,created_by,created_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,'issued',?,?,?,?)").bind(invoiceId,number,entityId,text(input.customerId),text(input.sourceType),text(input.sourceId),eventKey,text(policy.id),text(reg.id),date,text(input.currency)||"INR",subtotal,taxTotal,subtotal+taxTotal,JSON.stringify(snapshot),text(input.documentReference)||null,actor,now()).run();for(let i=0;i<lines.length;i++){const l=lines[i],s=snapshots[i];await db.prepare("INSERT INTO finance_invoice_lines (id,invoice_id,line_key,description,service_code,taxable_amount,tax_amount,tax_snapshot_json) VALUES (?,?,?,?,?,?,?,?)").bind(id("invline"),invoiceId,text(s.lineKey),text(l.description),text(l.serviceCode),num(l.taxableAmount),num(s.taxAmount),JSON.stringify(s)).run();}for(const s of snapshots){for(const c of s.components as Array<{code:string;rate:number}>){const amount=num(s.taxableAmount)*(Number(c.rate)/100);await db.prepare("INSERT OR IGNORE INTO finance_tax_ledger (id,entity_id,registration_id,period_code,component,ledger_type,source_type,source_id,amount,source_event_key,created_at) VALUES (?,?,?,?,?,'output','invoice',?,?,?,?)").bind(id("tax"),entityId,text(reg.id),date.slice(0,7),c.code,invoiceId,amount,`${eventKey}:${text(s.lineKey)}:${c.code}`,now()).run();}}
 await audit(db,actor,"invoice",invoiceId,"issued",{invoiceNumber:number,subtotal,taxTotal,total:subtotal+taxTotal,sourceEventKey:eventKey},text(input.reason)||"Canonical invoice issue");return await db.prepare("SELECT * FROM finance_invoices WHERE id=?").bind(invoiceId).first<Row>();}

export async function issueAdjustment(db:Db,input:Row,actor:string){await ensureGstAccountingTables(db);const eventKey=text(input.sourceEventKey),invoiceId=text(input.invoiceId);const prior=await db.prepare("SELECT * FROM finance_adjustment_documents WHERE source_event_key=?").bind(eventKey).first<Row>();if(prior)return prior;const invoice=await db.prepare("SELECT * FROM finance_invoices WHERE id=?").bind(invoiceId).first<Row>();if(!invoice)throw new Error("invoice_not_found");if(await locked(db,text(invoice.issue_date)))throw new Error("period_locked");const kind=text(input.kind);if(!["credit_note","debit_note"].includes(kind))throw new Error("invalid_adjustment_kind");const amount=num(input.amount),tax=num(input.taxAmount);if(amount<=0||tax<0)throw new Error("invalid_adjustment_amount");if(kind==="credit_note"){const used=await db.prepare("SELECT COALESCE(SUM(amount),0) amount,COALESCE(SUM(tax_amount),0) tax FROM finance_adjustment_documents WHERE invoice_id=? AND kind='credit_note' AND status='issued'").bind(invoiceId).first<Row>();if(num(used?.amount)+amount>num(invoice.subtotal)+0.001||num(used?.tax)+tax>num(invoice.tax_total)+0.001)throw new Error("credit_note_exceeds_invoice");}
 const number=await nextDocumentNumber(db,text(invoice.entity_id),kind),aid=id("adj"),snapshot={invoiceNumber:text(invoice.invoice_number),originalTaxSnapshot:JSON.parse(text(invoice.tax_snapshot_json)||"{}"),amount,tax};await db.prepare("INSERT INTO finance_adjustment_documents (id,document_number,invoice_id,kind,source_event_key,reason,amount,tax_amount,status,snapshot_json,created_by,created_at) VALUES (?,?,?,?,?,?,?,?, 'issued',?,?,?)").bind(aid,number,invoiceId,kind,eventKey,text(input.reason),amount,tax,JSON.stringify(snapshot),actor,now()).run();await db.prepare("INSERT OR IGNORE INTO finance_tax_ledger (id,entity_id,registration_id,period_code,component,ledger_type,source_type,source_id,amount,source_event_key,created_at) VALUES (?,?,?,?,?,'adjustment',?,?,?, ?,?)").bind(id("tax"),text(invoice.entity_id),text(invoice.registration_id),text(invoice.issue_date).slice(0,7),"aggregate_tax",kind,aid,kind==="credit_note"?-tax:tax,eventKey,now()).run();await audit(db,actor,"adjustment",aid,"issued",{documentNumber:number,invoiceId,kind,amount,tax},text(input.reason));return await db.prepare("SELECT * FROM finance_adjustment_documents WHERE id=?").bind(aid).first<Row>();}

export async function reviewVendorTax(db:Db,input:Row,actor:string){await ensureGstAccountingTables(db);const bill=await db.prepare("SELECT * FROM finance_bills WHERE id=?").bind(text(input.billId)).first<Row>();if(!bill)throw new Error("bill_not_found");if(await locked(db,text(bill.bill_date)))throw new Error("period_locked");const status=text(input.reviewStatus);if(!["eligible","ineligible","held","review_required"].includes(status))throw new Error("invalid_review_status");const rid=text(input.id)||id("vtx"),eligible=status==="eligible"?num(input.eligibleTaxAmount):0;await db.prepare("INSERT INTO finance_vendor_tax_reviews (id,vendor_id,bill_id,supplier_invoice_number,supplier_registration_reference,eligible_tax_amount,review_status,review_reason,reviewed_by,reviewed_at,created_at,updated_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?) ON CONFLICT(vendor_id,supplier_invoice_number) DO UPDATE SET bill_id=excluded.bill_id,supplier_registration_reference=excluded.supplier_registration_reference,eligible_tax_amount=excluded.eligible_tax_amount,review_status=excluded.review_status,review_reason=excluded.review_reason,reviewed_by=excluded.reviewed_by,reviewed_at=excluded.reviewed_at,updated_at=excluded.updated_at").bind(rid,text(bill.vendor_id),text(bill.id),text(input.supplierInvoiceNumber),text(input.supplierRegistrationReference)||null,eligible,status,text(input.reason),actor,now(),now(),now()).run();await audit(db,actor,"vendor_tax_review",rid,"reviewed",{billId:text(bill.id),status,eligibleTaxAmount:eligible},text(input.reason));return{id:rid,status,eligibleTaxAmount:eligible};}

export async function generateStatutoryPackage(db:Db,input:Row,actor:string){await ensureGstAccountingTables(db);const entityId=text(input.entityId),regId=text(input.registrationId),period=text(input.periodCode);const [out,inputTax,adjustments]=await Promise.all([db.prepare("SELECT COALESCE(SUM(amount),0) total FROM finance_tax_ledger WHERE entity_id=? AND registration_id=? AND period_code=? AND ledger_type='output'").bind(entityId,regId,period).first<Row>(),db.prepare("SELECT COALESCE(SUM(eligible_tax_amount),0) total FROM finance_vendor_tax_reviews v JOIN finance_bills b ON b.id=v.bill_id WHERE v.review_status='eligible' AND substr(b.bill_date,1,7)=?").bind(period).first<Row>(),db.prepare("SELECT COALESCE(SUM(amount),0) total FROM finance_tax_ledger WHERE entity_id=? AND registration_id=? AND period_code=? AND ledger_type='adjustment'").bind(entityId,regId,period).first<Row>()]);const summary={outputTax:num(out?.total),eligibleInputTax:num(inputTax?.total),adjustments:num(adjustments?.total)};const variance=[] as Row[];const versionRow=await db.prepare("SELECT COALESCE(MAX(version),0)+1 version FROM finance_statutory_packages WHERE entity_id=? AND registration_id=? AND period_code=?").bind(entityId,regId,period).first<Row>(),pid=id("statpkg");const previous=await db.prepare("SELECT id FROM finance_statutory_packages WHERE entity_id=? AND registration_id=? AND period_code=? ORDER BY version DESC LIMIT 1").bind(entityId,regId,period).first<Row>();await db.prepare("INSERT INTO finance_statutory_packages (id,entity_id,registration_id,period_code,version,status,summary_json,variance_json,prepared_by,prepared_at,supersedes_id) VALUES (?,?,?,?,?,'draft',?,?,?,?,?)").bind(pid,entityId,regId,period,num(versionRow?.version),JSON.stringify(summary),JSON.stringify(variance),actor,now(),previous?text(previous.id):null).run();await audit(db,actor,"statutory_package",pid,"generated",{summary,variance,period},text(input.reason)||"Generate statutory review package");return{id:pid,status:"draft",version:num(versionRow?.version),summary,variance};}

export async function approveStatutoryPackage(db:Db,input:Row,actor:string){const row=await db.prepare("SELECT * FROM finance_statutory_packages WHERE id=?").bind(text(input.id)).first<Row>();if(!row)throw new Error("package_not_found");if(text(row.prepared_by)===actor)throw new Error("maker_checker_required");if(!text(input.approvalReference))throw new Error("approval_reference_required");await db.prepare("UPDATE finance_statutory_packages SET status='reviewed',reviewed_by=?,reviewed_at=?,approval_reference=? WHERE id=?").bind(actor,now(),text(input.approvalReference),text(input.id)).run();await audit(db,actor,"statutory_package",text(input.id),"reviewed",{status:"reviewed",approvalReference:text(input.approvalReference)},text(input.reason));return{id:text(input.id),status:"reviewed"};}

// GSTR-9 annual return: consolidates a full Indian financial year (April YYYY - March YYYY+1) of the
// real per-month output tax (finance_tax_ledger), eligible input tax credit (vendor tax reviews) and
// adjustments for one entity+registration. Produces a versioned DRAFT that a *different* human must
// approve (maker/checker). It is an internal statutory package only - actual filing to the GST portal
// is a not-connected integration, so liveFilingEnabled stays false, exactly like the monthly package.
export async function generateAnnualReturn(db:Db,input:Row,actor:string){await ensureGstAccountingTables(db);const entityId=text(input.entityId),regId=text(input.registrationId);if(!entityId||!regId)throw new Error("annual_return_source_required");
 const startYear=Number(text(input.financialYear).slice(0,4));if(!Number.isInteger(startYear)||startYear<2000||startYear>2100)throw new Error("valid_financial_year_required");
 const fyLabel=`${startYear}-${String((startYear+1)%100).padStart(2,"0")}`,fromPeriod=`${startYear}-04`,toPeriod=`${startYear+1}-03`;
 const months=[] as string[];for(let m=4;m<=12;m++)months.push(`${startYear}-${String(m).padStart(2,"0")}`);for(let m=1;m<=3;m++)months.push(`${startYear+1}-${String(m).padStart(2,"0")}`);
 const [components,monthly,adjustments,itc,packages]=await Promise.all([
  db.prepare("SELECT component,COALESCE(SUM(amount),0) total FROM finance_tax_ledger WHERE entity_id=? AND registration_id=? AND ledger_type='output' AND period_code BETWEEN ? AND ? GROUP BY component").bind(entityId,regId,fromPeriod,toPeriod).all<Row>(),
  db.prepare("SELECT period_code,COALESCE(SUM(amount),0) total FROM finance_tax_ledger WHERE entity_id=? AND registration_id=? AND ledger_type='output' AND period_code BETWEEN ? AND ? GROUP BY period_code").bind(entityId,regId,fromPeriod,toPeriod).all<Row>(),
  db.prepare("SELECT COALESCE(SUM(amount),0) total FROM finance_tax_ledger WHERE entity_id=? AND registration_id=? AND ledger_type='adjustment' AND period_code BETWEEN ? AND ?").bind(entityId,regId,fromPeriod,toPeriod).first<Row>(),
  db.prepare("SELECT COALESCE(SUM(eligible_tax_amount),0) total FROM finance_vendor_tax_reviews v JOIN finance_bills b ON b.id=v.bill_id WHERE v.review_status='eligible' AND substr(b.bill_date,1,7) BETWEEN ? AND ?").bind(fromPeriod,toPeriod).first<Row>(),
  db.prepare("SELECT period_code,status,version FROM finance_statutory_packages WHERE entity_id=? AND registration_id=? AND period_code BETWEEN ? AND ?").bind(entityId,regId,fromPeriod,toPeriod).all<Row>(),
 ]);
 const outputTaxByComponent={} as Record<string,number>;let totalOutputTax=0;for(const r of components.results){const c=text(r.component)||"aggregate_tax";outputTaxByComponent[c]=Math.round((num(outputTaxByComponent[c])+num(r.total))*100)/100;totalOutputTax+=num(r.total);}
 const monthlyOutputTax={} as Record<string,number>;for(const m of months)monthlyOutputTax[m]=0;for(const r of monthly.results)monthlyOutputTax[text(r.period_code)]=Math.round(num(r.total)*100)/100;
 const totalAdjustments=Math.round(num(adjustments?.total)*100)/100,totalEligibleItc=Math.round(num(itc?.total)*100)/100;totalOutputTax=Math.round(totalOutputTax*100)/100;
 const netTaxPayable=Math.round((totalOutputTax+totalAdjustments-totalEligibleItc)*100)/100;
 const approvedMonths=new Set(packages.results.filter(r=>text(r.status)==="reviewed").map(r=>text(r.period_code))),monthsMissingApprovedPackage=months.filter(m=>!approvedMonths.has(m));
 const summary={returnType:"GSTR-9",financialYear:fyLabel,fromPeriod,toPeriod,outputTaxByComponent,totalOutputTax,totalAdjustments,totalEligibleItc,netTaxPayable,monthlyOutputTax};
 const reconciliation={monthsInYear:months.length,monthsWithApprovedMonthlyReturn:months.length-monthsMissingApprovedPackage.length,monthsMissingApprovedMonthlyReturn:monthsMissingApprovedPackage,reconciled:monthsMissingApprovedPackage.length===0};
 const versionRow=await db.prepare("SELECT COALESCE(MAX(version),0)+1 version FROM finance_annual_returns WHERE entity_id=? AND registration_id=? AND financial_year=?").bind(entityId,regId,fyLabel).first<Row>();
 const previous=await db.prepare("SELECT id FROM finance_annual_returns WHERE entity_id=? AND registration_id=? AND financial_year=? ORDER BY version DESC LIMIT 1").bind(entityId,regId,fyLabel).first<Row>();
 const arid=id("gstr9");await db.prepare("INSERT INTO finance_annual_returns (id,entity_id,registration_id,financial_year,version,status,summary_json,reconciliation_json,prepared_by,prepared_at,supersedes_id) VALUES (?,?,?,?,?,'draft',?,?,?,?,?)").bind(arid,entityId,regId,fyLabel,num(versionRow?.version),JSON.stringify(summary),JSON.stringify(reconciliation),actor,now(),previous?text(previous.id):null).run();
 await audit(db,actor,"annual_return",arid,"generated",{financialYear:fyLabel,summary,reconciliation},text(input.reason)||"Generate GSTR-9 annual return draft");
 return{id:arid,status:"draft",version:num(versionRow?.version),financialYear:fyLabel,summary,reconciliation,liveFilingEnabled:false};}

export async function approveAnnualReturn(db:Db,input:Row,actor:string){await ensureGstAccountingTables(db);const row=await db.prepare("SELECT * FROM finance_annual_returns WHERE id=?").bind(text(input.id)).first<Row>();if(!row)throw new Error("annual_return_not_found");if(text(row.status)!=="draft")throw new Error("annual_return_not_draft");if(text(row.prepared_by)===actor)throw new Error("maker_checker_required");if(!text(input.approvalReference))throw new Error("approval_reference_required");await db.prepare("UPDATE finance_annual_returns SET status='reviewed',reviewed_by=?,reviewed_at=?,approval_reference=? WHERE id=?").bind(actor,now(),text(input.approvalReference),text(input.id)).run();await audit(db,actor,"annual_return",text(input.id),"reviewed",{status:"reviewed",approvalReference:text(input.approvalReference)},text(input.reason)||"Approve GSTR-9 annual return");return{id:text(input.id),status:"reviewed",liveFilingEnabled:false};}

export async function generateAccountingExport(db:Db,input:Row,actor:string){await ensureGstAccountingTables(db);const entityId=text(input.entityId),period=text(input.periodCode),target=text(input.target)||"generic";const mapping=await db.prepare("SELECT * FROM accounting_mapping_versions WHERE entity_id=? AND status='active' AND effective_from<=? ORDER BY version DESC LIMIT 1").bind(entityId,`${period}-31`).first<Row>();if(!mapping)throw new ConfigurationRequired("active_accounting_mapping");const journals=await db.prepare("SELECT id,entry_date,source_type,source_id,account_code,cost_centre,vertical,debit,credit,narration,period_code FROM finance_journal_entries WHERE period_code=? ORDER BY created_at,id").bind(period).all<Row>();const snapshot={period,target,mappingId:text(mapping.id),mappingVersion:num(mapping.version),journals:journals.results},raw=JSON.stringify(snapshot),checksum=await sha256(raw),existing=await db.prepare("SELECT * FROM accounting_export_runs WHERE entity_id=? AND period_code=? AND target=? AND mapping_id=? AND checksum=?").bind(entityId,period,target,text(mapping.id),checksum).first<Row>();if(existing)return existing;const eid=id("export");await db.prepare("INSERT INTO accounting_export_runs (id,entity_id,period_code,target,mapping_id,source_snapshot_json,checksum,status,generated_by,generated_at) VALUES (?,?,?,?,?,?,?,'generated',?,?)").bind(eid,entityId,period,target,text(mapping.id),raw,checksum,actor,now()).run();await audit(db,actor,"accounting_export",eid,"generated",{period,target,checksum,mappingId:text(mapping.id),productionPost:false},text(input.reason)||"Generate UAT accounting export");return{id:eid,status:"generated",checksum,productionPost:false};}

export async function acknowledgeAccountingExport(db:Db,input:Row,actor:string){const run=await db.prepare("SELECT * FROM accounting_export_runs WHERE id=?").bind(text(input.id)).first<Row>();if(!run)throw new Error("export_not_found");if(!text(input.ackReference))throw new Error("ack_reference_required");await db.prepare("UPDATE accounting_export_runs SET status='acknowledged',ack_reference=?,acknowledged_at=? WHERE id=?").bind(text(input.ackReference),now(),text(input.id)).run();await audit(db,actor,"accounting_export",text(input.id),"acknowledged",{ackReference:text(input.ackReference),productionPost:false},text(input.reason));return{id:text(input.id),status:"acknowledged",productionPost:false};}

export async function recordCloseEvidence(db:Db,input:Row,actor:string){await ensureGstAccountingTables(db);const eid=id("closeev"),variance=num(input.varianceAmount),status=variance===0?"reconciled":"variance";await db.prepare("INSERT OR IGNORE INTO finance_close_evidence (id,period_code,evidence_type,source_reference,status,variance_amount,detail_json,recorded_by,recorded_at) VALUES (?,?,?,?,?,?,?,?,?)").bind(eid,text(input.periodCode),text(input.evidenceType),text(input.sourceReference),status,variance,JSON.stringify(input.detail??{}),actor,now()).run();await audit(db,actor,"close_evidence",eid,"recorded",{period:text(input.periodCode),status,variance},text(input.reason));return{id:eid,status,variance};}

