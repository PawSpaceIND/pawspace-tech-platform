 if(mode==="retrieve"){const query=url.searchParams.get("query")||"",scopes=(url.searchParams.get("scopes")||"public").split(",").map(item=>item.trim()).filter(Boolean);if(!query)return json({error:"Knowledge query is required"},400);return json({data:await retrieveApprovedKnowledge(db,{query,visibilityScopes:scopes})});}return json({data:await aiBusinessConfigurationSnapshot(db)});}catch(error){return authError(error,"Unable to load AI business configuration");}}

