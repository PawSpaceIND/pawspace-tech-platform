<file path="app/api/relocation/route.ts">
import{authError,database,requireCustomerOwnership,requirePermission,resolveActor,securityAudit}from"../../../lib/server-auth";
import{createRelocationCase,getRelocationCase,listRelocationCases,mutateRelocationCase,relocationReadiness,type RelocationMode}from"../../../lib/relocation-governance";
import{hasPermission}from"../../../lib/platform-security";

type Body={action?:string;caseId?:string;customerId?:string;petName?:string;breed?:string;ageYears?:number;sizeClass?:string;travelMode?:RelocationMode;originCountry?:string;originCity?:string;destinationCountry?:string;destinationCity?:string;targetTravelDate?:string;crateRequirement?:string;documentType?:string;objectId?:string;reviewNote?:string;amount?:number;vendorCost?:number;validDays?:number;vendorId?:string;agentId?:string;milestoneCode?:string;note?:string;paymentReference?:string;refundAmount?:number;reason?:string;decision?:"approved"|"rejected"|"completed"};
const json=(value:unknown,status=200)=>Response.json(value,{status});

/*
 * Cross-tenant read (PTJA W2-17-F03 / F04). These non-customer read branches are written for STAFF, but
 * `bookings.view` does not say "staff": the service_provider role holds it too, so every onboarded
 * provider could list and fetch every customer's case - pickup address, alternate contact, travel dates
 * and destinations - with no relationship to the record. `customers.view` is the capability the platform
 * already defines for reading customer records: founder, superuser, admin, manager and associate hold
 * it; service_provider, customer, finance and auditor do not. No new rule, just the right one.
 */
export async function GET(request:Request){try{const url=new URL(request.url),db=await database(),actor=await resolveActor(request),caseId=String(url.searchParams.get("caseId")||""),customerId=String(url.searchParams.get("customerId")||""),customerScope=url.searchParams.get("scope")==="customer";if(caseId){const item=await getRelocationCase(db,caseId);if(!item)return json({error:"Relocation case not found"},404);if(customerScope){requirePermission(actor,"scheduling.book");await requireCustomerOwnership(db,actor,String((item as Record<string,unknown>).customer_id));}else requirePermission(actor,"customers.view");return json({data:item,readiness:relocationReadiness});}if(customerScope){requirePermission(actor,"scheduling.book");if(!customerId)return json({error:"Customer ID is required"},400);await requireCustomerOwnership(db,actor,customerId);return json({data:await listRelocationCases(db,{customerId}),readiness:relocationReadiness});}requirePermission(actor,"customers.view");return json({data:await listRelocationCases(db,{status:String(url.searchParams.get("status")||"")||undefined}),readiness:relocationReadiness});}catch(error){return authError(error,"Unable to load relocation cases");}}

export async function POST(request:Request){try{const body=await request.json() as Body,db=await database(),actor=await resolveActor(request),action=String(body.action||"create");if(action==="create"){requirePermission(actor,"scheduling.book");const customerId=String(body.customerId||"");await requireCustomerOwnership(db,actor,customerId);const data=await createRelocationCase(db,{customerId,petName:String(body.petName||""),breed:String(body.breed||""),ageYears:Number(body.ageYears||0),sizeClass:String(body.sizeClass||"medium"),travelMode:body.travelMode||"air",originCountry:String(body.originCountry||""),originCity:String(body.originCity||""),destinationCountry:String(body.destinationCountry||""),destinationCity:String(body.destinationCity||""),targetTravelDate:String(body.targetTravelDate||""),crateRequirement:String(body.crateRequirement||"assessment_required")},actor.email);await securityAudit(db,actor,"relocation.create","relocation_case",String((data as Record<string,unknown>)?.id||""),"completed",{liveMoney:false});return json({data,readiness:relocationReadiness},201);}const caseId=String(body.caseId||"");if(!caseId)return json({error:"Relocation case ID is required"},400);const existing=await getRelocationCase(db,caseId);if(!existing)return json({error:"Relocation case not found"},404);const customerActions=new Set(["register_document","accept_quote","request_refund","open_support"]),financeActions=new Set(["record_payment","resolve_refund"]);if(customerActions.has(action)){requirePermission(actor,"scheduling.book");await requireCustomerOwnership(db,actor,String((existing as Record<string,unknown>).customer_id));}else if(financeActions.has(action))requirePermission(actor,"finance.manage");else{requirePermission(actor,"bookings.manage");if(!hasPermission(actor.permissions,"bookings.manage"))return json({error:"Relocation operations permission required"},403);}const data=await mutateRelocationCase(db,{caseId,action,actorId:actor.email,documentType:body.documentType,objectId:body.objectId,reviewNote:body.reviewNote,amount:body.amount,vendorCost:body.vendorCost,validDays:body.validDays,vendorId:body.vendorId,agentId:body.agentId,milestoneCode:body.milestoneCode,note:body.note,paymentReference:body.paymentReference,refundAmount:body.refundAmount,reason:body.reason,decision:body.decision});await securityAudit(db,actor,`relocation.${action}`,"relocation_case",caseId,"completed",{liveMoney:false});return json({data,readiness:relocationReadiness});}catch(error){return authError(error,"Unable to update relocation case");}}
</file>

