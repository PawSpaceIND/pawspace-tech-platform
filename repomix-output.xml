function active(row:Row,at=new Date().toISOString()){const date=at.slice(0,10);return Number(row.active)===1&&date>=String(row.effective_from)&&(!row.effective_to||date<=String(row.effective_to))}
const stableIds=(values:string[])=>[...new Set(values.map(value=>String(value||"").trim()).filter(Boolean))].sort();
async function validateFoodPets(db:D1Database,input:{customerId:string;petIds:string[];petType:string}){const petIds=stableIds(input.petIds);if(!input.customerId||!petIds.length)throw new Response("Fresh Food requires at least one selected canonical pet",{status:400});for(const petId of petIds){const pet=await db.prepare("SELECT id,customer_id,species FROM canonical_pets WHERE id=?").bind(petId).first<Row>();if(!pet)throw new Response("Selected Fresh Food pet was not found",{status:404});if(String(pet.customer_id)!==input.customerId)throw new Response("Selected Fresh Food pet is not owned by this customer",{status:403});if(String(pet.species)!==input.petType)throw new Response(`Selected pet is not eligible for ${input.petType} food`,{status:409});}return petIds;}
async function quotePetRows(db:D1Database,quoteId:string){return(await db.prepare("SELECT pet_id,customer_id,pet_type FROM food_quote_pets WHERE quote_id=? ORDER BY pet_id").bind(quoteId).all<Row>()).results;}
export async function listFoodCatalogue(db:D1Database,zoneId="blr-east"){await ensureFoodGovernanceTables(db);const rows=await db.prepare("SELECT c.*,i.available_units,i.reserved_units,i.status inventory_status FROM food_catalogue_items c LEFT JOIN food_inventory_uat i ON i.sku=c.sku AND i.zone_id=? WHERE c.active=1 ORDER BY c.unit_price").bind(zoneId).all<Row>();return rows.results.filter(row=>active(row)).map(row=>({...row,uat_available_units:Math.max(0,Number(row.available_units||0)-Number(row.reserved_units||0)),inventory_mode:"uat_seed",production_inventory_verified:false}))}
export async function createFoodQuote(db:D1Database,input:{sku:string;quantity:number;zoneId:string;paymentMode:FoodPaymentMode;customerId:string;petIds:string[];couponCode?:string}){await ensureFoodGovernanceTables(db);if(input.paymentMode!=="sandbox_deferred")throw new Response("Food Gate 1 uses sandbox-deferred UAT payment only",{status:409});if(String(input.couponCode||"").trim())throw new Response("Food coupon policy is not enabled",{status:409});const row=await db.prepare("SELECT c.*,i.available_units,i.reserved_units FROM food_catalogue_items c JOIN food_inventory_uat i ON i.sku=c.sku AND i.zone_id=? WHERE c.sku=?").bind(input.zoneId,input.sku).first<Row>();if(!row||!active(row))throw new Response("Active UAT Food item not found",{status:404});const petType=String(row.pet_type),petIds=await validateFoodPets(db,{customerId:input.customerId,petIds:input.petIds,petType});const quantity=Math.floor(Number(input.quantity)),max=Math.max(1,Number(row.max_qty_per_order||1));if(quantity<1||quantity>max)throw new Response(`Food UAT quantity must be 1-${max}`,{status:409});const available=Math.max(0,Number(row.available_units||0)-Number(row.reserved_units||0));if(quantity>available)throw new Response("UAT Food inventory is insufficient for this quote",{status:409});const unitPrice=Number(row.unit_price),deliveryFee=0 as const,totalAmount=unitPrice*quantity,now=Date.now(),expiresAt=now+15*60_000,id=`FQ-${crypto.randomUUID().slice(0,12).toUpperCase()}`;await db.batch([db.prepare("INSERT INTO food_commercial_quotes (id,sku,item_version,quantity,zone_id,unit_price,delivery_fee,total_amount,amount_due_now,payment_mode,expires_at,status,created_at) VALUES (?,?,?,?,?,?,0,?,0,?,?,'open',?)").bind(id,row.sku,row.version,quantity,input.zoneId,unitPrice,totalAmount,input.paymentMode,expiresAt,now),...petIds.map(petId=>db.prepare("INSERT INTO food_quote_pets (quote_id,pet_id,customer_id,pet_type,created_at) VALUES (?,?,?,?,?)").bind(id,petId,input.customerId,petType,now))]);return{quoteId:id,sku:String(row.sku),name:String(row.name),version:Number(row.version),petType:petType as "dog"|"cat",petIds,packSize:String(row.pack_size),quantity,unitPrice,deliveryFee,totalAmount,amountDueNow:0 as const,currency:"INR" as const,zoneId:input.zoneId,paymentMode:input.paymentMode,expiresAt,inventoryMode:"uat_seed" as const,productionInventoryVerified:false as const,liveMoney:false as const} satisfies FoodQuote}
export async function createFoodOrder(db:D1Database,input:{idempotencyKey:string;quoteId:string;customerId:string;cityId:string;zoneId:string;actorId:string}){await ensureFoodGovernanceTables(db);const prior=await db.prepare("SELECT * FROM food_orders WHERE idempotency_key=?").bind(input.idempotencyKey).first<Row>();if(prior){if(String(prior.customer_id)!==input.customerId)throw new Response("Food order idempotency key belongs to a different customer",{status:403});const priorQuote=await db.prepare("SELECT id FROM food_commercial_quotes WHERE used_order_id=?").bind(prior.id).first<Row>();if(String(priorQuote?.id||"")!==input.quoteId||String(prior.city_id)!==input.cityId||String(prior.zone_id)!==input.zoneId)throw new Response("Food order idempotency key was already used for a different order context",{status:409});const pets=(await db.prepare("SELECT pet_id FROM food_order_pets WHERE order_id=? ORDER BY pet_id").bind(prior.id).all<Row>()).results.map(row=>String(row.pet_id));return{orderId:String(prior.id),status:String(prior.status),petIds:pets,duplicatePrevented:true};}const quote=await db.prepare("SELECT q.*,c.name,c.pet_type FROM food_commercial_quotes q JOIN food_catalogue_items c ON c.sku=q.sku AND c.version=q.item_version WHERE q.id=?").bind(input.quoteId).first<Row>();if(!quote||String(quote.status)!=="open")throw new Response("A valid open server Food quote is required",{status:409});if(Number(quote.expires_at)<Date.now())throw new Response("Food quote expired; refresh catalogue and UAT inventory",{status:409});if(String(quote.zone_id)!==input.zoneId)throw new Response("Food delivery zone changed after quote",{status:409});const petRows=await quotePetRows(db,input.quoteId);if(!petRows.length)throw new Response("Food quote is missing its canonical pet association",{status:409});if(petRows.some(row=>String(row.customer_id)!==input.customerId))throw new Response("Food quote belongs to a different customer",{status:403});if(petRows.some(row=>String(row.pet_type)!==String(quote.pet_type)))throw new Response("Food quote pet association does not match the quoted SKU",{status:409});const linked=await db.prepare("SELECT used_order_id FROM food_commercial_quotes WHERE id=? AND used_order_id IS NOT NULL").bind(input.quoteId).first<Row>();if(linked)throw new Response("Food quote is already linked to an order",{status:409});const inventory=await db.prepare("SELECT * FROM food_inventory_uat WHERE sku=? AND zone_id=?").bind(quote.sku,input.zoneId).first<Row>(),available=Math.max(0,Number(inventory?.available_units||0)-Number(inventory?.reserved_units||0)),quantity=Number(quote.quantity);if(available<quantity)throw new Response("UAT Food inventory changed after quote; refresh before ordering",{status:409});const now=Date.now(),orderId=`PS-UAT-FOOD-${now.toString(36).toUpperCase()}-${crypto.randomUUID().slice(0,4).toUpperCase()}`,lineId=`FL-${crypto.randomUUID().slice(0,8).toUpperCase()}`,reservationId=`FIR-${crypto.randomUUID().slice(0,8).toUpperCase()}`,paymentId=`FPAY-${crypto.randomUUID().slice(0,8).toUpperCase()}`;await db.prepare("UPDATE food_commercial_quotes SET status='used',used_at=?,used_order_id=? WHERE id=? AND status='open'").bind(now,orderId,input.quoteId).run();const claimed=await db.prepare("SELECT used_order_id FROM food_commercial_quotes WHERE id=?").bind(input.quoteId).first<Row>();if(String(claimed?.used_order_id||"")!==orderId)throw new Response("Food quote is already linked to an order",{status:409});const petStatements=petRows.map(row=>db.prepare("INSERT INTO food_order_pets (order_id,pet_id,customer_id,pet_type,source_quote_id,created_at) VALUES (?,?,?,?,?,?)").bind(orderId,row.pet_id,input.customerId,row.pet_type,input.quoteId,now));const reservation=await db.prepare("UPDATE food_inventory_uat SET reserved_units=reserved_units+?,updated_at=? WHERE sku=? AND zone_id=? AND reserved_units+?<=available_units").bind(quantity,now,quote.sku,input.zoneId,quantity).run();if(Number(reservation.meta?.changes||0)!==1){await db.prepare("UPDATE food_commercial_quotes SET status='open',used_at=NULL,used_order_id=NULL WHERE id=? AND used_order_id=?").bind(input.quoteId,orderId).run();throw new Response("UAT Food inventory changed after quote; refresh before ordering",{status:409})}try{await db.batch([db.prepare("INSERT INTO food_orders (id,idempotency_key,customer_id,city_id,zone_id,status,commercial_status,inventory_mode,delivery_status,total_amount,currency,created_by,created_at,updated_at) VALUES (?,?,?,?,?,'uat_reserved','uat_only','uat_seed','fulfilment_review_required',?,'INR',?,?,?)").bind(orderId,input.idempotencyKey,input.customerId,input.cityId,input.zoneId,quote.total_amount,input.actorId,now,now),db.prepare("INSERT INTO food_order_lines (id,order_id,sku,item_name,item_version,quantity,unit_price,line_total,currency) VALUES (?,?,?,?,?,?,?,?,'INR')").bind(lineId,orderId,quote.sku,quote.name,quote.item_version,quantity,quote.unit_price,quote.total_amount),...petStatements,db.prepare("INSERT INTO food_inventory_reservations (id,order_id,sku,zone_id,quantity,status,inventory_mode,created_at,updated_at) VALUES (?,?,?,?,?,'reserved','uat_seed',?,?)").bind(reservationId,orderId,quote.sku,input.zoneId,quantity,now,now),db.prepare("INSERT INTO food_order_payments (id,order_id,customer_id,amount,amount_due_now,currency,mode,status,gateway,detail_json,created_at,updated_at) VALUES (?,?,?, ?,0,'INR',?,'created','uat_sandbox',?,?,?)").bind(paymentId,orderId,input.customerId,quote.total_amount,quote.payment_mode,JSON.stringify({liveMoney:false,productionPaymentPolicy:"pending",deliveryFeePolicy:"configuration_required"}),now,now),db.prepare("INSERT INTO food_order_events (id,order_id,event_type,actor_id,detail_json,created_at) VALUES (?,?,?,?,?,?)").bind(crypto.randomUUID(),orderId,"food_order_reserved",input.actorId,JSON.stringify({quoteId:input.quoteId,petIds:petRows.map(row=>String(row.pet_id)),inventoryMode:"uat_seed",productionInventoryVerified:false,deliveryStatus:"fulfilment_review_required"}),now)])}catch(error){await db.batch([db.prepare("UPDATE food_inventory_uat SET reserved_units=reserved_units-?,updated_at=? WHERE sku=? AND zone_id=? AND reserved_units>=?").bind(quantity,Date.now(),quote.sku,input.zoneId,quantity),db.prepare("UPDATE food_commercial_quotes SET status='open',used_at=NULL,used_order_id=NULL WHERE id=? AND used_order_id=?").bind(input.quoteId,orderId)]);throw error}return{orderId,status:"uat_reserved",petIds:petRows.map(row=>String(row.pet_id)),lineId,reservationId,paymentId,totalAmount:Number(quote.total_amount),amountDueNow:0,inventoryMode:"uat_seed",productionInventoryVerified:false,deliveryStatus:"fulfilment_review_required",liveMoney:false,duplicatePrevented:false}}
