type Db=D1Database; type Row=Record<string,unknown>;
const text=(v:unknown)=>String(v??"").trim(); const uid=(p:string)=>`${p}-${crypto.randomUUID().slice(0,12).toUpperCase()}`;
export async function ensureAttendanceLeaveTables(db:Db){await db.batch([
 db.prepare("CREATE TABLE IF NOT EXISTS shift_policies (id TEXT PRIMARY KEY,name TEXT NOT NULL,version INTEGER NOT NULL,status TEXT NOT NULL DEFAULT 'draft',timezone TEXT NOT NULL,start_time TEXT,end_time TEXT,weekly_off_json TEXT NOT NULL DEFAULT '[]',location_rule TEXT NOT NULL DEFAULT 'not_required',approval_reference TEXT,effective_from INTEGER NOT NULL,effective_until INTEGER,created_by TEXT NOT NULL,created_at INTEGER NOT NULL,UNIQUE(name,version))"),
 db.prepare("CREATE TABLE IF NOT EXISTS employee_shift_assignments (id TEXT PRIMARY KEY,employee_id TEXT NOT NULL,shift_policy_id TEXT NOT NULL,effective_from INTEGER NOT NULL,effective_until INTEGER,reason TEXT NOT NULL,actor_id TEXT NOT NULL,created_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS attendance_events (id TEXT PRIMARY KEY,idempotency_key TEXT NOT NULL UNIQUE,employee_id TEXT NOT NULL,event_type TEXT NOT NULL,occurred_at INTEGER NOT NULL,source TEXT NOT NULL,detail_json TEXT NOT NULL DEFAULT '{}',actor_id TEXT NOT NULL,created_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS attendance_days (id TEXT PRIMARY KEY,employee_id TEXT NOT NULL,work_date TEXT NOT NULL,status TEXT NOT NULL,first_check_in INTEGER,last_check_out INTEGER,worked_minutes INTEGER,exception_code TEXT,source_policy_id TEXT,updated_at INTEGER NOT NULL,UNIQUE(employee_id,work_date))"),
 db.prepare("CREATE TABLE IF NOT EXISTS attendance_adjustment_requests (id TEXT PRIMARY KEY,employee_id TEXT NOT NULL,work_date TEXT NOT NULL,requested_status TEXT,requested_check_in INTEGER,requested_check_out INTEGER,reason TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'pending',requested_by TEXT NOT NULL,approved_by TEXT,approved_at INTEGER,created_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS leave_policies (id TEXT PRIMARY KEY,name TEXT NOT NULL,version INTEGER NOT NULL,status TEXT NOT NULL DEFAULT 'draft',leave_code TEXT NOT NULL,allow_negative INTEGER NOT NULL DEFAULT 0,entitlement_units REAL,approval_reference TEXT,effective_from INTEGER NOT NULL,effective_until INTEGER,created_by TEXT NOT NULL,created_at INTEGER NOT NULL,UNIQUE(name,version))"),
 db.prepare("CREATE TABLE IF NOT EXISTS employee_leave_balances (employee_id TEXT NOT NULL,leave_code TEXT NOT NULL,balance REAL NOT NULL DEFAULT 0,updated_at INTEGER NOT NULL,PRIMARY KEY(employee_id,leave_code))"),
 db.prepare("CREATE TABLE IF NOT EXISTS leave_requests (id TEXT PRIMARY KEY,employee_id TEXT NOT NULL,leave_code TEXT NOT NULL,start_date TEXT NOT NULL,end_date TEXT NOT NULL,units REAL NOT NULL,reason TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'pending',requested_by TEXT NOT NULL,approved_by TEXT,approved_at INTEGER,created_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS leave_ledger_events (id TEXT PRIMARY KEY,idempotency_key TEXT NOT NULL UNIQUE,employee_id TEXT NOT NULL,leave_code TEXT NOT NULL,event_type TEXT NOT NULL,units REAL NOT NULL,source_request_id TEXT,actor_id TEXT NOT NULL,created_at INTEGER NOT NULL)"),
 db.prepare("CREATE TABLE IF NOT EXISTS people_period_locks (id TEXT PRIMARY KEY,period_start INTEGER NOT NULL,period_end INTEGER NOT NULL,status TEXT NOT NULL,locked_by TEXT NOT NULL,locked_at INTEGER NOT NULL,UNIQUE(period_start,period_end))"),
]);}
async function isLocked(db:Db,ts:number){const r=await db.prepare("SELECT id FROM people_period_locks WHERE status='locked' AND period_start<=? AND period_end>=? LIMIT 1").bind(ts,ts).first<Row>();return Boolean(r);}
export async function saveShiftPolicy(db:Db,input:{name:string;timezone:string;startTime?:string|null;endTime?:string|null;weeklyOff?:string[];locationRule?:'not_required'|'policy_required';effectiveFrom:number;actorId:string}){await ensureAttendanceLeaveTables(db);if(!input.name.trim()||!input.timezone.trim()||!Number.isFinite(input.effectiveFrom))throw new Error("Shift name, timezone and effective date are required");const prior=await db.prepare("SELECT MAX(version) version FROM shift_policies WHERE name=?").bind(input.name.trim()).first<Row>(),version=Number(prior?.version||0)+1,id=uid("SHP");await db.prepare("INSERT INTO shift_policies (id,name,version,timezone,start_time,end_time,weekly_off_json,location_rule,effective_from,created_by,created_at) VALUES (?,?,?,?,?,?,?,?,?,?,?)").bind(id,input.name.trim(),version,input.timezone.trim(),input.startTime??null,input.endTime??null,JSON.stringify(input.weeklyOff||[]),input.locationRule||"not_required",input.effectiveFrom,input.actorId,Date.now()).run();return{id,version};}
export async function assignShift(db:Db,input:{employeeId:string;shiftPolicyId:string;effectiveFrom:number;reason:string;actorId:string}){await ensureAttendanceLeaveTables(db);if(input.reason.trim().length<8)throw new Error("Shift assignment reason is required");await db.prepare("UPDATE employee_shift_assignments SET effective_until=? WHERE employee_id=? AND effective_until IS NULL").bind(input.effectiveFrom-1,input.employeeId).run();const id=uid("ESA");await db.prepare("INSERT INTO employee_shift_assignments (id,employee_id,shift_policy_id,effective_from,reason,actor_id,created_at) VALUES (?,?,?,?,?,?,?)").bind(id,input.employeeId,input.shiftPolicyId,input.effectiveFrom,input.reason.trim(),input.actorId,Date.now()).run();return{id};}
export async function recordAttendance(db:Db,input:{employeeId:string;eventType:'check_in'|'check_out';occurredAt:number;idempotencyKey:string;actorId:string;source?:string}){await ensureAttendanceLeaveTables(db);if(await isLocked(db,input.occurredAt))throw new Error("Payroll period is locked; use an attendance adjustment workflow");const prior=await db.prepare("SELECT id FROM attendance_events WHERE idempotency_key=?").bind(input.idempotencyKey).first<Row>();if(prior)return{eventId:text(prior.id),duplicatePrevented:true};const id=uid("ATE"),now=Date.now();await db.prepare("INSERT INTO attendance_events (id,idempotency_key,employee_id,event_type,occurred_at,source,actor_id,created_at) VALUES (?,?,?,?,?,?,?,?)").bind(id,input.idempotencyKey,input.employeeId,input.eventType,input.occurredAt,input.source||"self_service",input.actorId,now).run();const date=new Date(input.occurredAt).toISOString().slice(0,10);const events=await db.prepare("SELECT event_type,occurred_at FROM attendance_events WHERE employee_id=? AND substr(datetime(occurred_at/1000,'unixepoch'),1,10)=? ORDER BY occurred_at").bind(input.employeeId,date).all<Row>();const cin=events.results.find(r=>text(r.event_type)==='check_in'),cout=[...events.results].reverse().find(r=>text(r.event_type)==='check_out');const worked=cin&&cout?Math.max(0,Math.floor((Number(cout.occurred_at)-Number(cin.occurred_at))/60000)):null,exception=cin&&!cout?'missing_checkout':null;await db.prepare("INSERT INTO attendance_days (id,employee_id,work_date,status,first_check_in,last_check_out,worked_minutes,exception_code,updated_at) VALUES (?,?,?,?,?,?,?,?,?) ON CONFLICT(employee_id,work_date) DO UPDATE SET status=excluded.status,first_check_in=excluded.first_check_in,last_check_out=excluded.last_check_out,worked_minutes=excluded.worked_minutes,exception_code=excluded.exception_code,updated_at=excluded.updated_at").bind(uid("ATD"),input.employeeId,date,"present",cin?Number(cin.occurred_at):null,cout?Number(cout.occurred_at):null,worked,exception,now).run();return{eventId:id,duplicatePrevented:false,workDate:date,exception};}
export async function requestAdjustment(db:Db,input:{employeeId:string;workDate:string;requestedStatus?:string|null;requestedCheckIn?:number|null;requestedCheckOut?:number|null;reason:string;actorId:string}){await ensureAttendanceLeaveTables(db);if(input.reason.trim().length<8)throw new Error("Attendance adjustment reason is required");const id=uid("AAR");await db.prepare("INSERT INTO attendance_adjustment_requests (id,employee_id,work_date,requested_status,requested_check_in,requested_check_out,reason,requested_by,created_at) VALUES (?,?,?,?,?,?,?,?,?)").bind(id,input.employeeId,input.workDate,input.requestedStatus??null,input.requestedCheckIn??null,input.requestedCheckOut??null,input.reason.trim(),input.actorId,Date.now()).run();return{id,status:'pending'};}
export async function approveAdjustment(db:Db,input:{requestId:string;actorId:string}){await ensureAttendanceLeaveTables(db);const r=await db.prepare("SELECT * FROM attendance_adjustment_requests WHERE id=? AND status='pending'").bind(input.requestId).first<Row>();if(!r)throw new Error("Pending attendance adjustment not found");await db.prepare("UPDATE attendance_adjustment_requests SET status='approved',approved_by=?,approved_at=? WHERE id=?").bind(input.actorId,Date.now(),input.requestId).run();await db.prepare("INSERT INTO attendance_days (id,employee_id,work_date,status,first_check_in,last_check_out,worked_minutes,exception_code,updated_at) VALUES (?,?,?,?,?,?,?,?,?) ON CONFLICT(employee_id,work_date) DO UPDATE SET status=excluded.status,first_check_in=excluded.first_check_in,last_check_out=excluded.last_check_out,worked_minutes=excluded.worked_minutes,exception_code=NULL,updated_at=excluded.updated_at").bind(uid("ATD"),r.employee_id,r.work_date,text(r.requested_status)||'present',r.requested_check_in??null,r.requested_check_out??null,r.requested_check_in&&r.requested_check_out?Math.max(0,Math.floor((Number(r.requested_check_out)-Number(r.requested_check_in))/60000)):null,null,Date.now()).run();return{requestId:input.requestId,status:'approved'};}
export async function saveLeavePolicy(db:Db,input:{name:string;leaveCode:string;allowNegative:boolean;entitlementUnits?:number|null;effectiveFrom:number;actorId:string}){await ensureAttendanceLeaveTables(db);if(!input.name.trim()||!input.leaveCode.trim())throw new Error("Leave policy name and code are required");const prior=await db.prepare("SELECT MAX(version) version FROM leave_policies WHERE name=?").bind(input.name.trim()).first<Row>(),version=Number(prior?.version||0)+1,id=uid("LVP");await db.prepare("INSERT INTO leave_policies (id,name,version,status,leave_code,allow_negative,entitlement_units,effective_from,created_by,created_at) VALUES (?,?,?,'active_uat',?,?,?,?,?,?)").bind(id,input.name.trim(),version,input.leaveCode.trim(),input.allowNegative?1:0,input.entitlementUnits??null,input.effectiveFrom,input.actorId,Date.now()).run();return{id,version};}
export async function requestLeave(db:Db,input:{employeeId:string;leaveCode:string;startDate:string;endDate:string;units:number;reason:string;actorId:string}){await ensureAttendanceLeaveTables(db);if(input.units<=0||input.reason.trim().length<4)throw new Error("Valid leave units and reason are required");const policy=await db.prepare("SELECT * FROM leave_policies WHERE leave_code=? AND status='active_uat' ORDER BY effective_from DESC LIMIT 1").bind(input.leaveCode).first<Row>();if(!policy)throw new Error("Active leave policy configuration is required");const bal=await db.prepare("SELECT balance FROM employee_leave_balances WHERE employee_id=? AND leave_code=?").bind(input.employeeId,input.leaveCode).first<Row>(),balance=Number(bal?.balance||0);if(Number(policy.allow_negative)!==1&&balance<input.units)throw new Error("Insufficient leave balance");const id=uid("LVR");await db.prepare("INSERT INTO leave_requests (id,employee_id,leave_code,start_date,end_date,units,reason,requested_by,created_at) VALUES (?,?,?,?,?,?,?,?,?)").bind(id,input.employeeId,input.leaveCode,input.startDate,input.endDate,input.units,input.reason.trim(),input.actorId,Date.now()).run();return{id,status:'pending'};}
export async function decideLeave(db:Db,input:{requestId:string;decision:'approved'|'rejected';reason:string;actorId:string}){await ensureAttendanceLeaveTables(db);const r=await db.prepare("SELECT * FROM leave_requests WHERE id=? AND status='pending'").bind(input.requestId).first<Row>();if(!r)throw new Error("Pending leave request not found");if(input.decision==='approved'&&text(r.requested_by)===text(input.actorId))throw new Error("Maker/checker: the requester cannot approve their own leave request");const now=Date.now();if(input.decision==='approved'){const policy=await db.prepare("SELECT allow_negative FROM leave_policies WHERE leave_code=? AND status='active_uat' ORDER BY effective_from DESC LIMIT 1").bind(r.leave_code).first<Row>(),bal=await db.prepare("SELECT balance FROM employee_leave_balances WHERE employee_id=? AND leave_code=?").bind(r.employee_id,r.leave_code).first<Row>(),next=Number(bal?.balance||0)-Number(r.units||0);if(Number(policy?.allow_negative)!==1&&next<0)throw new Error("Leave approval would create a negative balance");await db.batch([db.prepare("UPDATE leave_requests SET status=?,approved_by=?,approved_at=? WHERE id=?").bind(input.decision,input.actorId,now,input.requestId),db.prepare("INSERT INTO leave_ledger_events (id,idempotency_key,employee_id,leave_code,event_type,units,source_request_id,actor_id,created_at) VALUES (?,?,?,?,?,?,?,?,?)").bind(uid("LLE"),`leave:${input.requestId}:approved`,r.employee_id,r.leave_code,'debit',-Number(r.units||0),input.requestId,input.actorId,now),db.prepare("INSERT INTO employee_leave_balances (employee_id,leave_code,balance,updated_at) VALUES (?,?,?,?) ON CONFLICT(employee_id,leave_code) DO UPDATE SET balance=excluded.balance,updated_at=excluded.updated_at").bind(r.employee_id,r.leave_code,next,now)]);}else{await db.prepare("UPDATE leave_requests SET status=?,approved_by=?,approved_at=? WHERE id=?").bind(input.decision,input.actorId,now,input.requestId).run();}return{requestId:input.requestId,status:input.decision};}
export async function attendanceLeaveDirectory(db:Db){await ensureAttendanceLeaveTables(db);const [days,adjustments,leave]=await Promise.all([db.prepare("SELECT * FROM attendance_days ORDER BY work_date DESC LIMIT 100").all<Row>(),db.prepare("SELECT * FROM attendance_adjustment_requests WHERE status='pending' ORDER BY created_at").all<Row>(),db.prepare("SELECT * FROM leave_requests ORDER BY created_at DESC LIMIT 100").all<Row>()]);return{attendanceDays:days.results,pendingAdjustments:adjustments.results,leaveRequests:leave.results,truth:{hardcodedGraceMinutes:false,hardcodedLeaveEntitlement:false,hardcodedOvertimeRate:false,gpsRequired:false,productionReady:false}};}
