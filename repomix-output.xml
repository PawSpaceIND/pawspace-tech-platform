  if(body.action==="unblock_time"){if(!body.blockId||!body.reason||body.reason.trim().length<5)return json({error:"Block ID and reason are required"},400);const existing=await db.prepare("SELECT * FROM provider_unavailability WHERE id=? AND provider_id=? AND status='active'").bind(body.blockId,body.providerId).first<Row>();if(!existing)return json({error:"Active provider block not found"},404);await db.batch([
    db.prepare("UPDATE provider_unavailability SET status='cancelled',updated_at=? WHERE id=?").bind(now,body.blockId),
    db.prepare("UPDATE scheduling_reservations SET status='cancelled' WHERE group_id=?").bind(`BLOCK-${body.blockId}`),
  ]);await securityAudit(db,actor,"provider.unavailability.cancel","provider",body.providerId,"completed",{blockId:body.blockId,reason:body.reason});return json({data:{id:body.blockId,providerId:body.providerId,status:"cancelled"}});}
  if(!body.startsAt||!body.endsAt||!body.reason||body.reason.trim().length<5)return json({error:"Block start, end and reason are required"},400);const startsAt=new Date(body.startsAt),endsAt=new Date(body.endsAt);if(Number.isNaN(startsAt.getTime())||Number.isNaN(endsAt.getTime())||endsAt<=startsAt)return json({error:"Block end must be after start"},400);const provider=await db.prepare("SELECT city_id,zones_json FROM provider_capacity_profiles WHERE id=? AND status='active'").bind(body.providerId).first<Row>();if(!provider)return json({error:"Active provider profile not found"},404);const zones=parse<string[]>(provider.zones_json,[]),zoneId=body.zoneId||zones[0]||"all",id=`unavailable_${crypto.randomUUID().slice(0,12)}`,groupId=`BLOCK-${id}`;await db.batch([
    db.prepare("INSERT INTO provider_unavailability (id,provider_id,starts_at,ends_at,reason,status,created_by,created_at,updated_at) VALUES (?,?,?,?,?,'active',?,?,?)").bind(id,body.providerId,startsAt.toISOString(),endsAt.toISOString(),body.reason.trim(),actor.email,now,now),
    db.prepare("INSERT INTO scheduling_reservations (id,group_id,provider_id,service_code,city_id,zone_id,customer_id,pet_ids_json,scheduled_start,scheduled_end,capacity_units,occurrence_number,care_mode,status,explanation_json,created_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)").bind(`${groupId}_1`,groupId,body.providerId,"provider_unavailable",String(provider.city_id),zoneId,"OPS-BLOCK","[]",startsAt.toISOString(),endsAt.toISOString(),1,1,null,"assigned",JSON.stringify({reason:body.reason,source:"provider_unavailability",blockId:id}),now),
  ]);await securityAudit(db,actor,"provider.unavailability.create","provider",body.providerId,"completed",{blockId:id,startsAt:startsAt.toISOString(),endsAt:endsAt.toISOString(),reason:body.reason,capacityLocked:true});return json({data:{id,providerId:body.providerId,status:"active",capacityLocked:true}},201);}catch(error){return authError(error,"Unable to change provider availability");}}
