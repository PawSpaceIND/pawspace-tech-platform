 }
 if(input.action==="prepare_settlement"){
  if(status!=="completed")throw new Response("Sitter settlement can be prepared only after canonical checkout",{status:409});await db.prepare("INSERT INTO sitting_sitter_settlement_ledger (booking_id,provider_id,gross_booking_value,currency,payout_rule_status,tax_status,approval_status,payout_status,eligible_at,created_at,updated_at) VALUES (?,?,?,'INR','rule_pending','configuration_required','not_ready','not_instructed',?,?,?) ON CONFLICT(booking_id) DO UPDATE SET provider_id=excluded.provider_id,gross_booking_value=excluded.gross_booking_value,eligible_at=excluded.eligible_at,updated_at=excluded.updated_at").bind(input.bookingId,booking.provider_id,booking.total_amount,now,now,now).run();return remember(db,input,{bookingId:input.bookingId,status:"not_ready",payoutRule:"rule_pending",tax:"configuration_required",payout:"not_instructed"});
