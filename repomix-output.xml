export type SittingOpsSnapshot={source:string;generatedAt:number;metrics:{total:number;clear:number;needsAttention:number;recovery:number;openIncidents:number;financeReview:number;mediaBlocked:number};bookings:Array<Record<string,unknown>>;readiness:Record<string,unknown>};
export async function loadSittingOps(){const response=await fetch("/api/sitting-ops",{cache:"no-store"});const body=await response.json() as {data?:SittingOpsSnapshot;error?:string};if(!response.ok||!body.data)throw new Error(body.error??"Unable to load Sitting Operations queue");return body.data;}
export async function updateSittingOps(input:{bookingId:string;action:"assign_replacement"|"close_recovery"|"add_note";idempotencyKey:string;reason?:string;note?:string;providerId?:string}){const response=await fetch("/api/sitting-ops",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(input)});const body=await response.json() as {data?:Record<string,unknown>;error?:string};if(!response.ok||!body.data)throw new Error(body.error??"Unable to update Sitting Operations queue");return body.data;}
