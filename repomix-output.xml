export type FoodOpsSnapshot={source:string;generatedAt:number;metrics:{total:number;clear:number;needsAttention:number;stockRecovery:number;openIncidents:number;financeReview:number};orders:Array<Record<string,unknown>>;readiness:Record<string,unknown>};
export async function loadFoodOps(){const response=await fetch("/api/food-ops",{cache:"no-store"});const body=await response.json() as {data?:FoodOpsSnapshot;error?:string};if(!response.ok||!body.data)throw new Error(body.error??"Unable to load Food Operations queue");return body.data}
export async function updateFoodOps(input:{orderId:string;action:"resume_same_sku_stock"|"add_note";idempotencyKey:string;reason?:string;note?:string}){const response=await fetch("/api/food-ops",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(input)});const body=await response.json() as {data?:Record<string,unknown>;error?:string};if(!response.ok||!body.data)throw new Error(body.error??"Unable to update Food Operations queue");return body.data}
