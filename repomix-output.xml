export type BoardingIncident={id:string;severity:string;summary:string;action_taken:string;media_id?:string|null;mediaRef?:string|null;status:string;ops_status:string;notification_status:string;customer_acknowledged_at?:number|null;resolution?:string|null;resolved_at?:number|null;reported_at:number};
export type BoardingProofSnapshot={stay:{id:string;bookingId:string;providerId:string;customerId:string;status:string;carePlanStatus:string;checkInAt:string;checkOutAt:string};media:BoardingProofMedia[];medication:BoardingMedication[];incidents:BoardingIncident[];storage:{mode:string;adapterConnected:boolean;rawPublicUrls:boolean};communications:{mode:string;liveDelivery:boolean}};
