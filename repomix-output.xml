      const output = `${run.stdout ?? ""}\n${run.stderr ?? ""}`;
      assert.equal(run.status, 0, `${id} failed ${file} / ${pattern}\n${output.slice(-6_000)}`);
      assert.match(output, /pass [1-9][0-9]*/, `${id} pattern selected no passing behavioural test: ${file} / ${pattern}`);
    }
  });
}
