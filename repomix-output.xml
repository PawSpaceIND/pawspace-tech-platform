export type IdentitySubjectType="customer"|"provider";
export type IdentitySource="workspace"|"customer_otp"|"partner_otp"|"migration";
export type PrincipalType="email"|"identity_subject";
type Row=Record<string,unknown>;

export async function ensureIdentityBindingTables(db:D1Database){await db.batch([
  db.prepare("CREATE TABLE IF NOT EXISTS identity_bindings (id TEXT PRIMARY KEY,identity_source TEXT NOT NULL,principal_type TEXT NOT NULL,principal_key TEXT NOT NULL,subject_type TEXT NOT NULL,subject_id TEXT NOT NULL,city_id TEXT,status TEXT NOT NULL DEFAULT 'active',verification_state TEXT NOT NULL DEFAULT 'verified',verified_at INTEGER,expires_at INTEGER,metadata_json TEXT NOT NULL DEFAULT '{}',created_by TEXT NOT NULL,updated_by TEXT NOT NULL,created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL,UNIQUE(identity_source,principal_type,principal_key,subject_type))"),
  db.prepare("CREATE INDEX IF NOT EXISTS idx_identity_bindings_subject ON identity_bindings(subject_type,subject_id,status,verification_state)"),
  db.prepare("CREATE TABLE IF NOT EXISTS identity_binding_audit (id TEXT PRIMARY KEY,binding_id TEXT NOT NULL,action TEXT NOT NULL,before_json TEXT,after_json TEXT NOT NULL,actor_id TEXT NOT NULL,reason TEXT NOT NULL,created_at INTEGER NOT NULL)"),
]);}

export function normalizePrincipal(type:PrincipalType,value:string){const trimmed=value.trim();return type==="email"?trimmed.toLowerCase():trimmed;}

export async function findIdentityBinding(db:D1Database,input:{identitySource:IdentitySource;principalType:PrincipalType;principalKey:string;subjectType:IdentitySubjectType}){await ensureIdentityBindingTables(db);const principal=normalizePrincipal(input.principalType,input.principalKey),now=Date.now();return db.prepare("SELECT * FROM identity_bindings WHERE identity_source=? AND principal_type=? AND principal_key=? AND subject_type=? AND status='active' AND verification_state='verified' AND (expires_at IS NULL OR expires_at>?) ORDER BY updated_at DESC LIMIT 1").bind(input.identitySource,input.principalType,principal,input.subjectType,now).first<Row>();}

export async function assertIdentityOwnership(db:D1Database,input:{identitySource:IdentitySource;principalType:PrincipalType;principalKey:string;subjectType:IdentitySubjectType;subjectId:string}){const binding=await findIdentityBinding(db,input);if(!binding||String(binding.subject_id)!==input.subjectId)throw new Response(`${input.subjectType==="customer"?"Customer":"Provider"} ownership denied`,{status:403});return binding;}

export async function upsertIdentityBinding(db:D1Database,input:{identitySource:IdentitySource;principalType:PrincipalType;principalKey:string;subjectType:IdentitySubjectType;subjectId:string;cityId?:string|null;verificationState?:"verified"|"pending";expiresAt?:number|null;metadata?:Record<string,unknown>;actorId:string;reason:string}){await ensureIdentityBindingTables(db);const principal=normalizePrincipal(input.principalType,input.principalKey),now=Date.now();const prior=await db.prepare("SELECT * FROM identity_bindings WHERE identity_source=? AND principal_type=? AND principal_key=? AND subject_type=?").bind(input.identitySource,input.principalType,principal,input.subjectType).first<Row>();const id=prior?String(prior.id):`idbind_${crypto.randomUUID().slice(0,12)}`;const verification=input.verificationState??"verified";await db.prepare("INSERT INTO identity_bindings (id,identity_source,principal_type,principal_key,subject_type,subject_id,city_id,status,verification_state,verified_at,expires_at,metadata_json,created_by,updated_by,created_at,updated_at) VALUES (?,?,?,?,?,?,?,'active',?,?,?,?,?,?,?,?) ON CONFLICT(identity_source,principal_type,principal_key,subject_type) DO UPDATE SET subject_id=excluded.subject_id,city_id=excluded.city_id,status='active',verification_state=excluded.verification_state,verified_at=excluded.verified_at,expires_at=excluded.expires_at,metadata_json=excluded.metadata_json,updated_by=excluded.updated_by,updated_at=excluded.updated_at").bind(id,input.identitySource,input.principalType,principal,input.subjectType,input.subjectId,input.cityId??null,verification,verification==="verified"?now:null,input.expiresAt??null,JSON.stringify(input.metadata??{}),input.actorId,input.actorId,now,now).run();const after=await db.prepare("SELECT * FROM identity_bindings WHERE id=?").bind(id).first<Row>();await db.prepare("INSERT INTO identity_binding_audit (id,binding_id,action,before_json,after_json,actor_id,reason,created_at) VALUES (?,?,?,?,?,?,?,?)").bind(crypto.randomUUID(),id,prior?"rebound":"created",prior?JSON.stringify(prior):null,JSON.stringify(after),input.actorId,input.reason,now).run();return after;}

export async function revokeIdentityBinding(db:D1Database,input:{id:string;actorId:string;reason:string}){await ensureIdentityBindingTables(db);const before=await db.prepare("SELECT * FROM identity_bindings WHERE id=?").bind(input.id).first<Row>();if(!before)throw new Response("Identity binding not found",{status:404});const now=Date.now();await db.prepare("UPDATE identity_bindings SET status='revoked',updated_by=?,updated_at=? WHERE id=?").bind(input.actorId,now,input.id).run();const after=await db.prepare("SELECT * FROM identity_bindings WHERE id=?").bind(input.id).first<Row>();await db.prepare("INSERT INTO identity_binding_audit (id,binding_id,action,before_json,after_json,actor_id,reason,created_at) VALUES (?,?,?,?,?,?,?,?)").bind(crypto.randomUUID(),input.id,"revoked",JSON.stringify(before),JSON.stringify(after),input.actorId,input.reason,now).run();return after;}
