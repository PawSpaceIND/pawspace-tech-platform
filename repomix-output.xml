import{ensureWalkingOpsTables}from"./walking-ops-governance";
type Row=Record<string,unknown>;
const parse=<T>(value:unknown,fallback:T):T=>{try{return JSON.parse(String(value??"")) as T}catch{return fallback}};
export async function acceptWalkingReplacement(db:D1Database,input:{bookingId:string;providerId:string;actorId:string;idempotencyKey:string}){await ensureWalkingOpsTables(db);const prior=await db.prepare("SELECT result_json FROM walking_action_keys WHERE idempotency_key=?").bind(input.idempotencyKey).first<Row>();if(prior)return{...parse<Record<string,unknown>>(prior.result_json,{}),duplicatePrevented:true};const booking=await db.prepare("SELECT b.*,w.provider_id work_order_provider_id,w.status work_order_status FROM canonical_bookings b LEFT JOIN provider_work_orders w ON w.booking_id=b.id WHERE b.id=? AND b.service_code='dog_walking'").bind(input.bookingId).first<Row>();if(!booking)throw new Response("Canonical Dog Walking booking not found",{status:404});if(String(booking.status)!=="reassignment_offered")throw new Response("Dog Walking recovery is not awaiting replacement walker acceptance",{status:409});if(String(booking.provider_id)!==input.providerId||String(booking.work_order_provider_id)!==input.providerId)throw new Response("Replacement walker does not match the canonical booking/work order",{status:409});const recovery=await db.prepare("SELECT * FROM walking_recovery_cases WHERE booking_id=? AND status='replacement_offered' ORDER BY opened_at DESC LIMIT 1").bind(input.bookingId).first<Row>();if(!recovery||String(recovery.replacement_provider_id)!==input.providerId)throw new Response("No replacement Dog Walking recovery offer is open for this walker",{status:409});const groupId=String(booking.schedule_group_id),offer=await db.prepare("SELECT * FROM provider_assignment_offers WHERE group_id=?").bind(groupId).first<Row>();if(!offer||String(offer.provider_id)!==input.providerId||String(offer.status)!=="pending")throw new Response("No pending replacement walker offer is available",{status:409});const now=Date.now();if(Number(offer.expires_at)<now)throw new Response("Replacement walker acceptance offer expired; Operations recovery is required",{status:409});const future=await db.prepare("SELECT id,reservation_id,provider_id,status FROM walking_sessions WHERE booking_id=? AND status NOT IN ('completed','cancelled') ORDER BY occurrence_number").bind(input.bookingId).all<Row>();if(!future.results.length||future.results.some(row=>String(row.provider_id)!==input.providerId||String(row.status)!=="scheduled"))throw new Response("Remaining Dog Walking sessions are not consistently assigned to the replacement walker",{status:409});const reservations=await db.prepare("SELECT id,provider_id,status FROM scheduling_reservations WHERE group_id=? AND status='assigned'").bind(groupId).all<Row>();const futureReservationIds=new Set(future.results.map(row=>String(row.reservation_id)));const activeFuture=reservations.results.filter(row=>futureReservationIds.has(String(row.id)));if(activeFuture.length!==future.results.length||activeFuture.some(row=>String(row.provider_id)!==input.providerId))throw new Response("Replacement walker is inconsistent with future scheduling reservations",{status:409});const result={bookingId:input.bookingId,providerId:input.providerId,status:"assigned",recoveryId:String(recovery.id),remainingSessions:future.results.length,bookingPreserved:true,completedSessionsPreserved:true};await db.batch([db.prepare("UPDATE canonical_bookings SET status='assigned',updated_at=? WHERE id=? AND status='reassignment_offered'").bind(now,input.bookingId),db.prepare("UPDATE provider_work_orders SET status='accepted',updated_at=? WHERE booking_id=? AND provider_id=?").bind(now,input.bookingId,input.providerId),db.prepare("UPDATE provider_assignment_offers SET status='accepted',responded_at=?,response_reason='Replacement walker accepted remaining sessions',updated_at=? WHERE group_id=? AND provider_id=? AND status='pending'").bind(now,now,groupId,input.providerId),db.prepare("UPDATE scheduling_assignment_decisions SET status='assigned',actor_id=?,reason='Replacement walker accepted remaining sessions',updated_at=? WHERE group_id=? AND selected_provider_id=?").bind(input.actorId,now,groupId,input.providerId),db.prepare("UPDATE walking_recovery_cases SET status='replacement_accepted',detail_json=?,updated_at=? WHERE id=?").bind(JSON.stringify({...parse<Record<string,unknown>>(recovery.detail_json,{}),acceptedBy:input.actorId,acceptedAt:now,bookingPreserved:true,completedSessionsPreserved:true}),now,recovery.id),db.prepare("INSERT INTO walking_session_events (id,booking_id,session_id,provider_id,event_type,actor_id,detail_json,created_at) VALUES (?,?,?,?,?,?,?,?)").bind(crypto.randomUUID(),input.bookingId,null,input.providerId,"replacement_walker_accepted",input.actorId,JSON.stringify({recoveryId:recovery.id,remainingSessions:future.results.length,bookingPreserved:true,completedSessionsPreserved:true}),now),db.prepare("INSERT INTO walking_action_keys (idempotency_key,booking_id,action,result_json,created_at) VALUES (?,?,'accept',?,?)").bind(input.idempotencyKey,input.bookingId,JSON.stringify(result),now)]);return result}
