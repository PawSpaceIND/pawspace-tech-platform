]);return{reservation:{id:reservationId,rewardId:input.rewardId,bookingId:input.bookingId,amount:Number(reward.amount),status:"uat_reserved"},duplicatePrevented:false,bookingPricingAuthoritative:false,testOnly:true,liveMoney:false};}

export async function reverseReferralReward(db:Db,input:{rewardId:string;reason:string;actorId:string}){await ensureReferralTables(db);if(!input.reason.trim())throw new Error("Referral reward reversal reason is required");const reward=await db.prepare("SELECT * FROM referral_rewards WHERE id=?").bind(input.rewardId).first<Row>();if(!reward)throw new Error("Referral reward not found");if(String(reward.status)==="reversed")return{rewardId:input.rewardId,status:"reversed",duplicatePrevented:true};const snapshot=JSON.parse(String(reward.policy_snapshot_json||"{}")) as Record<string,unknown>;if(snapshot.reversalOnRefund!==true)throw new Error("Referral refund/reversal policy does not authorize automatic reversal");const now=Date.now();await db.batch([
