NODE_ENV=development
API_SECRET=replace-with-at-least-32-random-characters

# Default local development stays on memory. Finance UAT Preview uses branch-scoped MongoDB variables in Vercel; never commit the UAT URI.
DATABASE_DRIVER=memory
MONGODB_URI=
MONGODB_DATABASE=pawspace

# External connectors stay unavailable until explicitly configured.
OTP_PROVIDER=msg91
OTP_API_KEY=
WHATSAPP_PROVIDER=meta
WHATSAPP_ACCESS_TOKEN=
SMS_PROVIDER=msg91
SMS_API_KEY=
EMAIL_PROVIDER=transactional
EMAIL_API_KEY=
PUSH_PROVIDER=firebase
PUSH_SERVICE_ACCOUNT=

# Razorpay payments. Use test for UAT and live only for production credentials.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# RazorpayX payouts. Separate keys are optional; when blank the Razorpay keys above are used.
RAZORPAYX_MODE=test
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_FUND_ACCOUNT_MAP={}
RAZORPAYX_PAYOUT_MODE=IMPS
RAZORPAYX_IP_ALLOWLIST_CONFIRMED=false

MAPS_PROVIDER=google
MAPS_API_KEY=
COMMUNICATION_WEBHOOK_SECRET=
